if(${CMAKE_CXX_COMPILER_ID} MATCHES ".*Clang")
  if(PEANO_NVIDIA_GPU)
    target_compile_options(PeanoOptions INTERFACE $<$<COMPILE_LANGUAGE:CXX>:-fopenmp-targets=nvptx64-nvidia-cuda -Xopenmp-target=nvptx64-nvidia-cuda -march=${WITH_GPU_ARCH}>)
    target_link_options(PeanoOptions INTERFACE -fopenmp -fopenmp-targets=nvptx64-nvidia-cuda -Xopenmp-target=nvptx64-nvidia-cuda -march=${WITH_GPU_ARCH})
  elseif(PEANO_AMD_GPU)
    target_compile_options(PeanoOptions INTERFACE $<$<COMPILE_LANGUAGE:CXX>:-fopenmp-targets=amdgcn-amd-amdhsa -Xopenmp-target=amdgcn-amd-amdhsa -march=${WITH_GPU_ARCH}>)
    target_link_options(PeanoOptions INTERFACE -fopenmp -fopenmp-targets=amdgcn-amd-amdhsa -Xopenmp-target=amdgcn-amd-amdhsa -march=${WITH_GPU_ARCH})
  endif()
elseif(${CMAKE_CXX_COMPILER_ID} MATCHES "GNU")
  if(PEANO_NVIDIA_GPU)
    target_compile_options(PeanoOptions INTERFACE $<$<COMPILE_LANGUAGE:CXX>:-foffload=nvptx-none -march=native>)
    target_link_options(PeanoOptions INTERFACE -foffload=nvptx-none -march=native)
  elseif(PEANO_AMD_GPU)
    target_compile_options(PeanoOptions INTERFACE $<$<COMPILE_LANGUAGE:CXX>:-foffload=amdgcn-amdhs -march=native>)
    target_link_options(PeanoOptions INTERFACE -foffload=nvptx-none -march=native)
  endif()
elseif(${CMAKE_CXX_COMPILER_ID} MATCHES "NVHPC|PGI")
  if(PEANO_NVIDIA_GPU)
    target_compile_options(PeanoOptions INTERFACE $<$<COMPILE_LANGUAGE:CXX>:-mp=gpu -gpu=${WITH_GPU_ARCH}>)
    target_link_options(PeanoOptions INTERFACE -mp=gpu -gpu=${WITH_GPU_ARCH})
  endif()
elseif(${CMAKE_CXX_COMPILER_ID} MATCHES "Intel|IntelLLVM")
  if(PEANO_INTEL_GPU)
    target_compile_options(PeanoOptions INTERFACE $<$<COMPILE_LANGUAGE:CXX>:-fopenmp-targets=spir64)
    target_link_options(PeanoOptions INTERFACE -fopenmp-targets=spir64)
  endif()
endif()

target_compile_definitions(PeanoOptions INTERFACE GPUOffloadingOMP)
