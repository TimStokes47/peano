Bootstrap: docker
From: peanoframework/spack:latest
Stage: build

%files
  spack/compilers/intel/spack.yaml /spack.yaml

%post
  mkdir /opt/spack-environment && cd /opt/spack-environment
  cp /spack.yaml .

  . /opt/spack/share/spack/setup-env.sh
  spack -e . concretize
  spack -e . install
  spack gc -y
  spack clean
  spack compiler find
  spack env activate --sh -d . >> /opt/spack-environment/environment_modifications.sh

  . /opt/spack-environment/environment_modifications.sh
  curl -L "https://developer.codeplay.com/api/v1/products/download?product=oneapi&variant=nvidia&version=2024.1.0&filters[]=12.0&filters[]=linux" -o nvidia-plugin.sh
  curl -L "https://developer.codeplay.com/api/v1/products/download?product=oneapi&variant=amd&version=2024.1.0&filters[]=5.4.3&filters[]=linux" -o amd-plugin.sh
  bash nvidia-plugin.sh --install-dir $(spack location -i intel-oneapi-compilers) -y
  bash amd-plugin.sh --install-dir $(spack location -i intel-oneapi-compilers) -y
  rm amd-plugin.sh && rm nvidia-plugin.sh

Bootstrap: docker
From: peanoframework/base:latest
Stage: final

%environment
  TZ=UTC
  DEBIAN_FRONTEND=noninteractive

%files from build
  /opt/spack-environment /opt
  /opt/software /opt
  /opt/views /opt
  /opt/spack-environment/environment_modifications.sh /opt/spack-environment/environment_modifications.sh

%post
  export TZ=UTC
  export DEBIAN_FRONTEND=noninteractive

  # Symlink the old view location
  ln -s /opt/views/view /opt/view

  # Modify the environment without relying on sourcing shell specific files at startup
  cat /opt/spack-environment/environment_modifications.sh >> $SINGULARITY_ENVIRONMENT

%labels
  peano-framework.org http://www.peano-framework.org/
