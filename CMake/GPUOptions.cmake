# Parse WITH_GPU Option to determine whether we have an Nvidia or AMD gpu
# Ask what about intel gpus?
string(SUBSTRING "${GPU_ARCH}" 0 3 GPU_PREFIX)
if("${GPU_PREFIX}" STREQUAL "sm_")
    set(NVIDIA_GPU TRUE)
elseif("${GPU_PREFIX}" STREQUAL "gfx")
    set(NVIDIA_GPU FALSE)
endif()

if(${WITH_GPU} STREQUAL "omp")
    # Per compiler handling of the flags is done there
    find_package(OpenMP REQUIRED)
    include(FindOpenMP_Offloading)
elseif(${WITH_GPU} STREQUAL "cpp")
    if(${CMAKE_CXX_COMPILER_ID} MATCHES "NVHPC|PGI")
        add_compile_options("-mp=gpu -gpu=${GPU_ARCH}")
        add_link_options("-mp=gpu -gpu=${GPU_ARCH}")
    else()
        message(FATA_ERROR "C++ GPU Support only supports Nvidia compilers currently")
    endif()
elseif(${WITH_GPU} STREQUAL "sycl")
    message(FATAL_ERROR "CMake build system does not support Sycl GPU Support yet")
elseif(${WITH_GPU} STREQUAL "hip")
    message(FATAL_ERROR "CMake build system does not support HipSycl GPU Support yet")
endif()