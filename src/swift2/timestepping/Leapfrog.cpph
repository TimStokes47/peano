template <typename Particle>
void swift2::timestepping::computeLeapfrogDriftWithGlobalTimeStepSize(
  const std::vector< Particle* >&  localParticles
) {
  double timeStepSize = Particle::getSpecies().getMinTimeStepSize();
  for (auto& particle: localParticles) {
    if (
      particle->getMoveState()==Particle::MoveState::NotMovedYet
      and
      particle->getParallelState()==Particle::ParallelState::Local
    ) {
      /* Drift the particle (update position for a full time-step) */
      particle->setX( particle->getX() + timeStepSize * particle->getV() );

      /* Flag this particle as Moved */
      particle->setMoveState( Particle::MoveState::Moved );
    }
  }
}

template <typename Particle>
void swift2::timestepping::computeLeapfrogKickWithGlobalTimeStepSize(
  const std::vector< Particle* >&  localParticles,
  const int kickNumber
) {
  double timeStepSizeKick = 0.5 * Particle::getSpecies().getMinTimeStepSize();
  for (auto& particle: localParticles) {
    if (
      particle->getMoveState()==Particle::MoveState::NotMovedYet
      and
      particle->getParallelState()==Particle::ParallelState::Local
      and
      not particle->getCellHasUpdatedParticle()
    ) {
      /* Kick the particle */
//      localParticle->setV_full( localParticle->getV_full() + dt_kick_hydro * localParticle->getA() );
      particle->setV( particle->getV() + timeStepSizeKick * particle->getA() );

      assertion1(  std::isfinite(particle->getV(0)), particle->toString() );
      assertion1(  std::isfinite(particle->getV(1)), particle->toString() );

