#include "swift2/kernels/kernel_hydro.h"
#include "swift2/kernels/equation_of_state.h"



template <typename Particle>
void swift2::timestepping::computeLeapfrogDriftWithGlobalTimeStepSize(
  const std::vector< Particle* >&  localParticles
) {
  double timeStepSize = Particle::getSpecies().getMinTimeStepSize();
  for (auto* particle: localParticles) {
    if (
      particle->getMoveState()==Particle::MoveState::NotMovedYet
      and
      particle->getParallelState()==Particle::ParallelState::Local
    ) {
      /* Drift the particle (update position for a full time-step) */
      particle->setX( particle->getX() + timeStepSize * particle->getV() );

      /* Flag this particle as Moved */
      particle->setMoveState( Particle::MoveState::Moved );
    }
  }
}

template <typename Particle>
void swift2::timestepping::computeLeapfrogKickWithGlobalTimeStepSize(
  const std::vector< Particle* >&  localParticles,
  const int kickNumber,
  const bool isSPH
) {
  double timeStepSizeKick = 0.5 * Particle::getSpecies().getMinTimeStepSize();
  for (auto* particle: localParticles) {
    if (
      particle->getMoveState()==Particle::MoveState::NotMovedYet
      and
      particle->getParallelState()==Particle::ParallelState::Local
      and
      not particle->getCellHasUpdatedParticle()
    ) {

      if( isSPH ){
        /* Kick the particle */
        particle->setV_full( particle->getV_full() + timeStepSizeKick * particle->getA() );

        /* In SWIFT SPH, Kick 1 and Kick 2 are slightly different as Kick 2 does
         * some extra operations. Not relevant for non-hydro systems
         */
        if( kickNumber == 2 ){
          /*
           * Reset predicted values for next Drift step 
           * Done by "hydro_reset_predicted_values" in SWIFT
           */
          
          /* Re-set the predicted velocities */
          particle->setV( particle->getV_full() );
          
          /* Re-set the entropy */
          particle->setU( particle->getU_full() );

          /* Re-compute the pressure */
          const double pressure = 
            gas_pressure_from_internal_energy( particle->getDensity(), particle->getU() );

          /* Compute the new sound speed */
          const double soundspeed = gas_soundspeed_from_internal_energy( particle->getU() );
     
          /* Update variables */
          particle->setPressure(pressure);
          particle->setSoundSpeed(soundspeed);
          particle->setV_sig_AV( std::max(particle->getV_sig_AV(), 2.0 * soundspeed) );
        } // End if Kick 2

      } else { /* vanilla kick */
        particle->setV( particle->getV() + timeStepSizeKick * particle->getA() );
      }

    }
  }
}

