#include "tarch/la/ScalarOperations.h"
#include "tarch/la/VectorOperations.h"
#include "tarch/la/VectorVectorOperations.h"

template <typename ParticleContainer>
void swift2::timestepping::computeLeapfrogDriftWithGlobalTimeStepSize(const ParticleContainer& localParticles) {

  const double timeStepSize = std::remove_pointer<typename ParticleContainer::value_type>::type::getSpecies()
                                .getMinTimeStepSize();

  for (auto* particle : localParticles) {
    if (
      particle->getMoveState()==std::remove_pointer<typename ParticleContainer::value_type>::type::MoveState::NotMovedYet
      and
      particle->getParallelState()==std::remove_pointer<typename ParticleContainer::value_type>::type::ParallelState::Local
      and
      not particle->getIsBoundaryParticle()
    ) {

      // Drift the particle (update position for a full time-step). It's important
      // to take the "V_full" here, not the fluid velocity V. V_full doesn't get
      // touched outside of kicks. V will be interpolated/integrated in time as the
      // time step progresses. V_full is the correct choice here.

      particle->setX(particle->getX() + timeStepSize * particle->getV_full());

      assertion1(tarch::la::isEntryFinite(particle->getX()), particle->toString());

      // Note that original SWIFT predicts the velocities at this point. We moved that
      // into computePredictHydro()

      /* Flag this particle as Moved */
      particle->setMoveState(std::remove_pointer<typename ParticleContainer::value_type>::type::MoveState::Moved);
    }
  }
}


template <typename ParticleContainer>
void swift2::timestepping::computeLeapfrogKickWithGlobalTimeStepSize(const ParticleContainer& localParticles) {
  const double timeStepSizeKick = 0.5
                                  * std::remove_pointer<typename ParticleContainer::value_type>::type::getSpecies()
                                      .getMinTimeStepSize();
  for (auto* particle : localParticles) {
    if (
      particle->getParallelState()
      == std::remove_pointer<typename ParticleContainer::value_type>::type::ParallelState::Local
      and
      not particle->getIsBoundaryParticle()
    ) {

      // Kick the particle
      particle->setV_full(particle->getV_full() + timeStepSizeKick * particle->getA());

    }
  }
}



template <typename ParticleContainer>
void swift2::timestepping::computeSPHLeapfrogKickWithGlobalTimeStepSize(
  const ParticleContainer& localParticles, const int kickNumber
) {
  const double timeStepSizeKick = 0.5
                                  * std::remove_pointer<typename ParticleContainer::value_type>::type::getSpecies()
                                      .getMinTimeStepSize();
  for (auto* particle : localParticles) {
    if (
      particle->getParallelState()
      == std::remove_pointer<typename ParticleContainer::value_type>::type::ParallelState::Local
      // and
      // not particle->getIsBoundaryParticle()
    ) {

      /* @ TODO why do we need the isSPH check here? */
      /* Kick the particle */
      particle->setV_full(particle->getV_full() + timeStepSizeKick * particle->getA());

      swift2::kernelPlaceholders::hydro_kick_extra(particle);
      /* In SWIFT SPH, Kick 1 and Kick 2 are slightly different as Kick 2 does
       * some extra operations. Not relevant for non-hydro systems */
      if (kickNumber == 2) {
        swift2::kernelPlaceholders::hydro_reset_predicted_values(particle);
      }
    }
  }
}


template <typename ParticleContainer>
void swift2::timestepping::computePredictHydro(const ParticleContainer& localParticles) {

  for (auto* particle : localParticles) {
    if (
      particle->getParallelState()
      == std::remove_pointer<typename ParticleContainer::value_type>::type::ParallelState::Local
      // and
      // not particle->getIsBoundaryParticle()
    ) {

      swift2::kernelPlaceholders::hydro_predict_extra(particle);
    }
  }
}

/*
 *
 * Debugging:
 * Fake Drift step in which we move a particle into the midpoint of a cell.
 * Does that particle disappear from the simulation?
 *
 */

template <typename ParticleContainer>
void swift2::timestepping::moveParticleIntoCriticalLine(const ParticleContainer& localParticles) {
  double timeStepSize = std::remove_pointer<typename ParticleContainer::value_type>::type::getSpecies()
                          .getMinTimeStepSize();
  for (auto* particle : localParticles) {
    if (
      particle->getMoveState()==std::remove_pointer<typename ParticleContainer::value_type>::type::MoveState::NotMovedYet
      and
      particle->getParallelState()==std::remove_pointer<typename ParticleContainer::value_type>::type::ParallelState::Local
      and
      not particle->getIsBoundaryParticle()
    ) {

      /*
       * Disappearing particle test.
       * Just move the position to the central axis of a cell and watch it
       * disappear.
       */
      tarch::la::Vector<Dimensions, double> xCritical = {1.0 / 6.0, 0.5};
      particle->setX(xCritical);

      /* Flag this particle as Moved */
      particle->setMoveState(std::remove_pointer<typename ParticleContainer::value_type>::type::MoveState::Moved);
    }
  }
}
