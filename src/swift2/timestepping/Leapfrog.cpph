#include "swift2/kernels/equation_of_state.h"
#include "swift2/kernels/kernel_hydro.h"

template <typename ParticleContainer>
void swift2::timestepping::computeLeapfrogDriftWithGlobalTimeStepSize(const ParticleContainer& localParticles) {
  const double timeStepSize = std::remove_pointer<typename ParticleContainer::value_type>::type::getSpecies()
                          .getMinTimeStepSize();

  for (auto* particle : localParticles) {
    if (
      particle->getMoveState()==std::remove_pointer<typename ParticleContainer::value_type>::type::MoveState::NotMovedYet
      and
      particle->getParallelState()==std::remove_pointer<typename ParticleContainer::value_type>::type::ParallelState::Local
      and
      not particle->getIsBoundaryParticle()
    ) {

      // Drift the particle (update position for a full time-step). It's important
      // to take the "V_full" here, not the fluid velocity V. V_full doesn't get
      // touched outside of kicks. V will be interpolated/integrated in time as the
      // time step progresses. V_full is the correct choice here.

      // particle->setX(particle->getX() + timeStepSize * particle->getV_full());

      // Note that original SWIFT predicts the velocities at this point. We moved that
      // into computePredictHydro()


      /* Flag this particle as Moved */
      particle->setMoveState(std::remove_pointer<typename ParticleContainer::value_type>::type::MoveState::Moved);
    }
  }
}

template <typename Particle>
void swift2::timestepping::kickResetPredictedValues(Particle& localParticle) {

      /* Re-set the predicted velocities */
      localParticle->setV(localParticle->getV_full());

      /* Re-set the entropy */
      localParticle->setU(localParticle->getU_full());

      /* Re-compute the pressure */
      const double pressure = gas_pressure_from_internal_energy(localParticle->getDensity(), localParticle->getU());

      /* Compute the new sound speed */
      const double soundspeed = gas_soundspeed_from_pressure(localParticle->getDensity(), pressure);

      /* Update variables */
      localParticle->setPressure(pressure);
      localParticle->setSoundSpeed(soundspeed);
      localParticle->setV_sig_AV(std::max(localParticle->getV_sig_AV(), 2.0 * soundspeed));
}



template <typename ParticleContainer>
void swift2::timestepping::computeLeapfrogKickWithGlobalTimeStepSize(
  const ParticleContainer& localParticles, const int kickNumber, const bool isSPH
) {
  const double timeStepSizeKick = 0.5 * std::remove_pointer<typename ParticleContainer::value_type>::type::getSpecies().getMinTimeStepSize();
  for (auto* particle : localParticles) {
    if (
      particle->getParallelState()==std::remove_pointer<typename ParticleContainer::value_type>::type::ParallelState::Local
      // and
      // not particle->getIsBoundaryParticle()
    ) {

      if (isSPH) {
        /* @ TODO why do we need the isSPH check here? */
        /* Kick the particle */
        particle->setV_full(particle->getV_full() + timeStepSizeKick * particle->getA());

        swift2::timestepping::leapfrogKickExtraWithGlobalTimeStepSize(particle);
        /* In SWIFT SPH, Kick 1 and Kick 2 are slightly different as Kick 2 does
         * some extra operations. Not relevant for non-hydro systems */
        if (kickNumber == 2) {
          swift2::timestepping::kickResetPredictedValues(particle);

        } else { /* vanilla kick */
          particle->setV(particle->getV() + timeStepSizeKick * particle->getA());
        }
      }
    }
  }
}

template <typename Particle>
void swift2::timestepping::leapfrogKickExtraWithGlobalTimeStepSize(Particle& localParticle) {
  /* In principle, this time-step could be different than that used for normal kick */
  double dt_kick_therm = 0.5 * localParticle->getSpecies().getMinTimeStepSize();

// std::cout << "dt_therm " << dt_therm << std::endl;

  /* Integrate the internal energy forward in time */
  const double delta_u = localParticle->getUDot() * dt_kick_therm;

  /* Do not decrease the energy by more than a factor of 2 */
  localParticle->setU_full(std::max(localParticle->getU_full() + delta_u, localParticle->getU_full() * 0.5));

  /* Check against absolute minimum.
   * Default value is zero. */
  if (localParticle->getU_full() < 0.0) {
    localParticle->setU_full(0.0);
    localParticle->setUDot(0.0);
  }
}

template <typename ParticleContainer>
void swift2::timestepping::computePredictHydro(const ParticleContainer& localParticles, const int hydroDimensions) {
  const double timeStepSize = std::remove_pointer<typename ParticleContainer::value_type>::type::getSpecies()
                                .getMinTimeStepSize();
  const double dt_kick_hydro = timeStepSize;
  const double dt_drift      = timeStepSize;
  const double dt_therm      = dt_kick_hydro;
  // const double dt_kick_hydro = 0.;
  // const double dt_drift      = 0.;
  // const double dt_therm      = 0.;

  // @TODO: Mladen: This is only valid for the "Minimal" SPH scheme
  // Needs cleanup. Should be moved to a "swift kernels" file.

  for (auto* particle : localParticles) {
    if (
      particle->getParallelState()==std::remove_pointer<typename ParticleContainer::value_type>::type::ParallelState::Local
      // and
      // not particle->getIsBoundaryParticle()
    ) {

      // This corresponds to hydro_predict_extra() in original SWIFT.
      // TODO: move into SWIFT file.

      /* Predict velocities for hydro terms */
      particle->setV(particle->getV() + particle->getA() * dt_kick_hydro);

      /*
       * Predict additional particle fields forward in time after the Drift step
       */

      /* Predict the internal energy */
      particle->setU(particle->getU() + particle->getUDot() * dt_therm);

      /* Predict smoothing length */
      const double h_inv = 1.0 / particle->getSmoothingLength();
      const double w1    = particle->getHDot() * h_inv * dt_drift;
      particle->setSmoothingLength(particle->getSmoothingLength() * std::exp(w1));

      /* Predict density */
      const double w2 = -hydroDimensions * w1;
      particle->setDensity(particle->getDensity() * std::exp(w2));

      particle->setU(std::max(particle->getU(), 0.0));

      /* Compute the new pressure */
      const double pressure = gas_pressure_from_internal_energy(particle->getDensity(), particle->getU());

      /* Compute the new sound speed */
      const double soundspeed = gas_soundspeed_from_pressure(particle->getDensity(), pressure);

      particle->setPressure(pressure);
      particle->setSoundSpeed(soundspeed);
      particle->setV_sig_AV(std::max(particle->getV_sig_AV(), 2.0 * soundspeed));
    }
  }
}

/*
 *
 * Debugging:
 * Fake Drift step in which we move a particle into the midpoint of a cell.
 * Does that particle disappear from the simulation?
 *
 */

template <typename ParticleContainer>
void swift2::timestepping::moveParticleIntoCriticalLine(const ParticleContainer& localParticles) {
  double timeStepSize = std::remove_pointer<typename ParticleContainer::value_type>::type::getSpecies()
                          .getMinTimeStepSize();
  for (auto* particle : localParticles) {
    if (
      particle->getMoveState()==std::remove_pointer<typename ParticleContainer::value_type>::type::MoveState::NotMovedYet
      and
      particle->getParallelState()==std::remove_pointer<typename ParticleContainer::value_type>::type::ParallelState::Local
      and
      not particle->getIsBoundaryParticle()
    ) {

      /*
       * Disappearing particle test.
       * Just move the position to the central axis of a cell and watch it
       * disappear.
       */
      tarch::la::Vector<Dimensions, double> xCritical = {1.0 / 6.0, 0.5};
      particle->setX(xCritical);

      /* Flag this particle as Moved */
      particle->setMoveState(std::remove_pointer<typename ParticleContainer::value_type>::type::MoveState::Moved);
    }
  }
}
