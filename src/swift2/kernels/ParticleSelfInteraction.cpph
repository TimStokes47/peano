#include <type_traits>

#include "swift2/kernels/ParticleState.h"
#include "swift2/kernels/SwiftKernelPlaceholders.h"
#include "swift2/legacy/hydro_dimensions.h"
#include "tarch/logging/Log.h"

template <typename ParticleContainer, typename Particle>
void swift2::kernels::genericSelfInteraction(
  const ParticleContainer& localParticles, std::function<void(Particle* localParticle)> interaction
) {
  for (auto* particle : localParticles) {
    interaction(particle);
  }
}


template <typename ParticleContainer>
void swift2::kernels::prepareDensityCalculation(const ParticleContainer& localParticles) {

  // This will be necessary for SPH versions with non-constant search radii.
  // We don't have that just yet.
  static tarch::logging::Log _log("swift2::kernels");
  logError("prepareDensityCalculation", "Don't use this yet. You shouldn't need it.");

  for (auto* particle : localParticles) {
    swift2::kernelPlaceholders::hydro_init_part(particle);
  }
}


template <typename ParticleContainer>
void swift2::kernels::endDensityCalculation(const ParticleContainer& localParticles) {

  // macro expansions from swift2/legacy/kernels are cumbersome otherwise.
  using namespace swift2::legacy::kernelHydro;

  // This will be necessary for SPH versions with non-constant search radii.
  // We don't have that just yet.
  static tarch::logging::Log _log("swift2::kernels");
  logError("endDensityCalculation", "Don't use this. Not implemented yet.");

  /* Grab static parameters */
  const int hydroDimensions = std::remove_pointer<typename ParticleContainer::value_type>::type::getHydroDimensions();
  const double etaFactor    = std::remove_pointer<typename ParticleContainer::value_type>::type::getEtaFactor();
  const double alphaAV      = std::remove_pointer<typename ParticleContainer::value_type>::type::getAlphaAV();

  // define variables here until next MR that accesses the correct values properly
  const double hTolerance = 1.;
  const double hHydroMin  = 1.;
  const double hHydroMax  = 1.;

  for (auto* particle : localParticles) {
    // if (not particle->getIsBoundaryParticle()) {

    // @TODO add adds/multiplies the cosmological terms if need be.

    /* Retrieve some properties */
    const double m_a = particle->getMass();
    const double h_a = particle->getSmoothingLength();

    /* Some smoothing length multiples */
    const double h_inv              = 1.0 / h_a;
    const double h_inv_dim          = swift2::legacy::hydroDimensions::pow_dimension(h_inv);
    const double h_inv_dim_plus_one = h_inv_dim * h_inv;

    /* Final operation. Add the self-contributions (i.e. at q=0) */
    particle->setDensity((particle->getDensity() + m_a * kernel_root) * h_inv_dim);
    particle->setWcount((particle->getWcount() + kernel_root) * h_inv_dim);
    particle->setRho_dh((particle->getRho_dh() + m_a * (-hydroDimensions * kernel_root)) * h_inv_dim_plus_one);
    particle->setWcount_dh((particle->getWcount_dh() + (-hydroDimensions * kernel_root)) * h_inv_dim_plus_one);

    /* Not needed in SWIFT */

    /* Useful for debugging */
    particle->setNcount(particle->getNcount() + 1);

    const double rho_inv = 1.0 / particle->getDensity();
    // @TODO: implement cosmological factors
    const double a_inv2 = 1.0;

    /* Finish calculation of the velocity curl components */
    particle->setRot_v(particle->getRot_v() * h_inv_dim_plus_one * a_inv2 * rho_inv);

    /* Finish calculation of the velocity divergence */
    particle->setDiv_v(particle->getDiv_v() * h_inv_dim_plus_one * a_inv2 * rho_inv);

    assertion2(std::isfinite(particle->getDensity()), particle->toString(), h_inv_dim);
    assertion1(particle->getNcount() > 1, particle->toString());

    //
    // =============================
    // Newton's Apples
    // =============================
    //
    // @TODO Mladen: Why is this here???
    {
      //        const double timeStepSize = GLOBAL_TIME_STEP_SIZE;
      const double hydro_eta_dim = swift2::legacy::hydroDimensions::pow_dimension(etaFactor);
      const double eps           = hTolerance;

      /* h value at the start of iteration procedure
       * Here we use the last update on previous time-step */
      const double h_0 = particle->getSmoothingLengthPrevious();

      /* Set initial guess for NR */
      const double h_init = h_0;
      // Improved initial guess
      //        const double h_init = h_0 + particle->getHDot() * timeStepSize;

      /* Get some useful values */
      double h_old = particle->getSmoothingLength();

      if (particle->getIterCount() == 0) { /* use initial guess h_init */
        h_old = h_init;
      }

      const double h_old_dim           = swift2::legacy::hydroDimensions::pow_dimension(h_old);
      const double h_old_dim_minus_one = swift2::legacy::hydroDimensions::pow_dimension_minus_one(h_old);

      double h_new;

      /* Check that smoothing length from previous iteration is non-zero */
      assertion3(h_old > tarch::la::NUMERICAL_ZERO_DIFFERENCE, particle->toString(), h_init, h_0);

      if (particle->getWcount() < 1e-5) { /* No neighbours case */

        /* Flag that there were no neighbours */
        particle->setHasNoNeighbours(true);

        /* Verbose */
        //          logInfo( "touchVertexLastTime()", "no neighbour case for particle " << particle->toString() );

        /* Double h and try again */
        h_new = 2.0 * h_old;

      } else {

        /* Compute one step of the Newton-Raphson scheme */

        /* SWIFT's calcualtion based on Wcount */

        const double n_sum    = particle->getWcount() * h_old_dim;
        const double n_target = hydro_eta_dim;
        const double f        = n_sum - n_target;
        const double f_prime  = particle->getWcount_dh() * h_old_dim
                               + hydroDimensions * particle->getWcount() * h_old_dim_minus_one;

        // Debug
        assertion6(f_prime != 0, particle->toString(), f_prime, h_new, h_old, hHydroMin, hHydroMax);

        /* Skip if h is already h_max and we don't have enough neighbours */
        /* Same if we are below h_min */
        /* Same if we have hit the Peano search radius
         */

        //          tarch::la::Vector<Dimensions,double> GridSize = marker.h();
        //          const double GridSizeHalf = 0.5 * GridSize(0);

        /* TODO MLADEN: What exactly is going on here?? */
        const double GridSizeHalf  = 0.5 * 0.3;
        const double IactParticleH = kernel_gamma * particle->getSmoothingLength();

        if (((particle->getSmoothingLength() >= hHydroMax) && (f < 0.0)) || ((particle->getSmoothingLength() <= hHydroMin) && (f > 0.0)) || tarch::la::greaterEquals(IactParticleH, GridSizeHalf)) {

          /* We have a particle whose smoothing length is already set (wants
           * to be larger but has already hit the maximum OR wants to be
           * smaller but has already reached the minimum). So, just tidy up
           * as if the smoothing length had converged correctly  */

          /* Verbose about this particle */
          //            logInfo( "touchVertexLastTime()", " This particle is unable to shrink/grow anymore:  " <<
          //            particle->toString() );

          /* Re-set the value from previous time-step */
          h_new = h_0;
        }

        /* Normal case:
         * We are able to use Newton-Raphson to get a better value of h */

        /* Avoid floating point exception from f_prime = 0 */
        h_new = h_old - f / (f_prime + tarch::la::NUMERICAL_ZERO_DIFFERENCE);

        /* Safety check: truncate to the range [ h_old/2 , 2h_old ]. */
        h_new = std::min(h_new, 2.0 * h_old);
        h_new = std::max(h_new, 0.5 * h_old);

      } /* end of if( particle->getWcount() < 1e-5 ) else block */

      /* By now we have got h_new for either of the yes/no neighbour cases */

      /* Check convergence */
      const double residual = std::abs(h_new - h_old) / h_0;
      particle->setResidual(residual);

      if (residual > eps) { /* this particle has not converged */

        /* Ok, correct then */
        particle->setSmoothingLength(h_new);

        /* Increase the iteration counter */
        particle->setIterCount(particle->getIterCount() + 1);

      } else {

        /* No need to update */

        /* However, if this is iter 0, we still update */
        if (particle->getIterCount() == 0) {
          particle->setSmoothingLength(h_new);
        }

        /* Flag that particle has already converged */
        particle->setHasConverged(true);
      }

    } /* End of Newton-Raphson */
    // } is boundary particle
  }
}


template <typename ParticleContainer>
void swift2::kernels::endDensityCalculationWithConstantSmoothingLength(const ParticleContainer& localParticles) {

  static tarch::logging::Log _log("swift2::kernels");
  logError("endDensityCalculationWithConstantSmoothingLength", "Don't use this. Not implemented yet.");
}


template <typename ParticleContainer>
void swift2::kernels::prepareHydroForceCalculation(const ParticleContainer& localParticles) {

  for (auto* particle : localParticles) {
    if (localParticleCanBeWorkedOnVertexKernel(particle)) {
      swift2::kernelPlaceholders::hydro_prepare_force(particle);
      swift2::kernelPlaceholders::hydro_reset_acceleration(particle);
    }
  }
}

template <typename ParticleContainer>
void swift2::kernels::endHydroForceCalculation(const ParticleContainer& localParticles) {

  for (auto* particle : localParticles) {
    if (localParticleCanBeWorkedOnVertexKernel(particle)) {
      swift2::kernelPlaceholders::hydro_end_force(particle);
    }
  }
}


template <typename ParticleContainer>
void swift2::kernels::flagBoundaryParticles(
  const ParticleContainer&                     localParticles,
  const double                                 nparts,
  const tarch::la::Vector<Dimensions, double>& domainSize,
  const tarch::la::Vector<Dimensions, double>& domainOffset
) {

  /* TODO MLADEN: Document parameters? */
  for (auto* particle : localParticles) {
    if (localParticleCanBeWorkedOnVertexKernel(particle) and not particle->getIsBoundaryParticle()) {

      /* Flag if particle is at boundary of the simulation box */
      /* TODO MLADEN: Boundary particle width shouldn't be hardcoded like this. */
      const tarch::la::Vector<Dimensions, double> max_dist_boundary = 3. * (domainSize / nparts);
      const bool isBoundaryParticle = tarch::la::oneSmaller(particle->getX(), domainOffset + max_dist_boundary)
                                      or tarch::la::
                                        oneGreater(particle->getX(), domainOffset + domainSize - max_dist_boundary);
      particle->setIsBoundaryParticle(isBoundaryParticle);
    }
  }
}
