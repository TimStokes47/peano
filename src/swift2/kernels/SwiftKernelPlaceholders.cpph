#include "swift2/legacy/equation_of_state.h"
#include "swift2/legacy/hydro_dimensions.h"
#include "swift2/legacy/kernel_hydro.h"
#include "tarch/la/Vector.h"
#include "tarch/logging/Log.h"


template <typename Particle>
void swift2::kernelPlaceholders::hydro_prepare_density(Particle* localParticle) {
  // temporary to get things to work
  localParticle->setDensity(0.0);
  localParticle->setWcount(0.0);
  localParticle->setRho_dh(0.0);
  localParticle->setWcount_dh(0.0);
  localParticle->setDiv_v(0.0);
  localParticle->setRot_v(0.0);
}


template <typename Particle>
void swift2::kernelPlaceholders::hydro_update_smoothing_length_and_rerun_if_required(
  Particle* localParticle
) {

  // macro expansions from swift2/legacy/kernels are cumbersome otherwise.
  using namespace swift2::legacy::kernelHydro;

  static tarch::logging::Log _log("swift2::kernels");

  /* Grab static parameters */
  const int hydro_dimensions = localParticle->getHydroDimensions();

  /* Initialize some variables */
  double       hydro_h_max = std::min(localParticle->getSmlMax(), localParticle->getSearchRadius() / kernel_gamma);
  const double hydro_h_min = localParticle->getSmlMin();
  const double sml_tolerance_epsilon = localParticle->getSmlTolerance();
  const double eta                   = localParticle->getEtaFactor();
  const double eta_dim               = legacy::hydroDimensions::pow_dimension(eta);
  const int    max_iterations        = localParticle->getSmlMaxIterations();

  double left  = hydro_h_min;
  double right = hydro_h_max;

  // Now on to the smoothing length computation
  const double h_old               = localParticle->getSmoothingLength();
  const double h_old_dim           = legacy::hydroDimensions::pow_dimension(h_old);
  const double h_old_dim_minus_one = legacy::hydroDimensions::pow_dimension_minus_one(h_old);
  double       h_new;

  const int iteration = localParticle->getSmoothingLengthIterCount();
  localParticle->setSmoothingLengthIterCount(iteration + 1);

  // for now, make sure this fails even without debug mode
  // TODO: Mladen needs to fix this later.
  if (localParticle->getWcount() < 1.e-5 * kernel_root) {

    // No neighbours case
    // Double h and try again
    h_new = 2.f * h_old;

  } else {

    // If we are using alternative definition of number of neighbours, e.g.
    // mass weighted, then we'd need to make adaptations here.
    // p->density.wcount = p->rho * inv_mass;
    // p->density.wcount_dh = p->density.rho_dh * inv_mass;

    // Compute one step of the Newton-Raphson scheme
    const double wcount   = localParticle->getWcount();
    const double n_sum    = wcount * h_old_dim;
    const double n_target = eta_dim;
    const double f        = n_sum - n_target;
    const double f_prime  = localParticle->getWcount_dh() * h_old_dim + hydro_dimensions * wcount * h_old_dim_minus_one;

    // Improve the bisection bounds
    if (n_sum < n_target) {
      left = std::max(left, h_old);
    } else if (n_sum > n_target) {
      right = std::min(right, h_old);
    }

    // Skip if h is already h_max and we don't have enough neighbours
    // Same if we are below h_min
    if (((h_old >= hydro_h_max) && (f < 0.)) || ((h_old <= hydro_h_min) && (f > 0.))) {
      if (not localParticle->getIsBoundaryParticle()) {
        logWarning(
          "hydro_update_smoothing_length_and_rerun_if_required",
          "Aborting unsuccessful smoothing length computation"
            << " partID " << localParticle->getPartid() << " h_old " << h_old << " h_min " << hydro_h_min << " h_max "
            << hydro_h_max << " f " << f
        );
      }
      // We have a particle whose smoothing length is already set (wants
      // to be larger but has already hit the maximum OR wants to be
      // smaller but has already reached the minimum). So, just give up.
      // Leave things as they are and don't re-run.
      return;
    }

    // TODO MLaden: check this condition here.
    assertion3(
    //     localParticle->getIsBoundaryParticle()
    //     or
        (left < right),
        left, right, localParticle->toString()
    );

    // Normal case: Use Newton-Raphson to get a better value of h
    // Avoid floating point exception from f_prime = 0
    h_new = h_old - f / (f_prime + std::numeric_limits<double>::min());


    // Be verbose about the particles that struggle to converge
    // @todo Mladen and Tobias have to discuss how to avoid too many iterations

    if (iteration > max_iterations - 10) {
      logWarning(
        "hydro_update_smoothing_length_and_rerun_if_required",
        "Smoothing length convergence problem: iteration"
          << iteration << " part ID " << localParticle->getPartid() << " h_old " << h_old << " h_new " << h_new << " f "
          << f << "f_prime" << f_prime << " n_sum " << n_sum << " n_target " << n_target << " left " << left << "right "
          << right
      );
    }

    assertion1(
      not (((f > 0. && h_new > h_old) || (f < 0. && h_new < h_old)) && (h_old < 0.999 * hydro_h_max)),
      "Smoothing length correction not going in the right direction"
    );

    // Safety check: truncate to the range [ h_old/2 , 2h_old ].
    h_new = std::min(h_new, 2. * h_old);
    h_new = std::max(h_new, 0.5 * h_old);

    // Verify that we are actually progressing towards the answer
    h_new = std::max(h_new, left);
    h_new = std::min(h_new, right);
  } // if particle has neighbours


  // Check whether the particle has an appropriate smoothing length
  // @todo Mladen, Tobias: This criterion seems never to hold.
  if (
    std::abs(h_new - h_old) < sml_tolerance_epsilon * h_old
  ) {
    // we're done. Note that in SWIFT, they check the other way around.
    localParticle->setSmoothingLength(h_new);
    return;
  }

  // Ok, we're not done and need to correct

  // Case where we have been oscillating around the solution
  if ((h_new == left && h_old == right) || (h_old == left && h_new == right)) {

    // Bisect the remaining interval
    const double temp = 0.5 * (legacy::hydroDimensions::pow_dimension(left) + legacy::hydroDimensions::pow_dimension(right));
    localParticle->setSmoothingLength(1. / legacy::hydroDimensions::pow_dimension(temp));

  } else {

    // Normal case
    localParticle->setSmoothingLength(h_new);

  }


  // If within the allowed range, try again
  if (localParticle->getSmoothingLength() < hydro_h_max && localParticle->getSmoothingLength() > hydro_h_min) {
    // SWIFT calls hydro_init_part here. We do that at the start at the loop.
    // If we reach this point, we need to run again.
    localParticle->getSpecies().setRerunPreviousGridSweep();
    return;

  } else if (localParticle->getSmoothingLength() >= hydro_h_max) {

    // Ok, this particle is a lost cause...
    localParticle->setSmoothingLength(hydro_h_max);
    logWarning(
      "hydro_update_smoothing_length_and_rerun_if_required",
      "Got a particle that is lost cause. Setting h = h_max , id=" << localParticle->getPartid()
    );
    // Do some damage control if no neighbours at all were found
    // if (has_no_neighbours) {
    //   ...
    // }
  } else if (localParticle->getSmoothingLength() <= hydro_h_min) {
    // Ok, this particle is a lost cause...
    localParticle->setSmoothingLength(hydro_h_max);
    logWarning(
      "hydro_update_smoothing_length_and_rerun_if_required",
      "Got a particle that is lost cause. Setting h = h_max , id=" << localParticle->getPartid()
    );

  } else {
    logError(
      "hydro_update_smoothing_length_and_rerun_if_required",
      "Fundamental problem with the smoothing length iteration logic."
    );
  }
}


template <typename Particle>
void swift2::kernelPlaceholders::hydro_end_density(Particle* localParticle) {

  // macro expansions from swift2/legacy/kernels are cumbersome otherwise.
  using namespace swift2::legacy::kernelHydro;

  /* Grab static parameters */
  const int    hydroDimensions = localParticle->getHydroDimensions();
  const double etaFactor       = localParticle->getEtaFactor();
  const double alphaAV         = localParticle->getAlphaAV();

  /* Retrieve some properties */
  const double m_a = localParticle->getMass();
  const double h_a = localParticle->getSmoothingLength();

  /* Some smoothing length multiples */
  const double h_inv              = 1.0 / h_a;
  const double h_inv_dim          = swift2::legacy::hydroDimensions::pow_dimension(h_inv);
  const double h_inv_dim_plus_one = h_inv_dim * h_inv;

  /* Final operation. Add the self-contributions (i.e. at q=0) */
  localParticle->setDensity(localParticle->getDensity() + m_a * kernel_root);
  localParticle->setDensity(localParticle->getDensity() * h_inv_dim);

  localParticle->setWcount(localParticle->getWcount() + kernel_root);
  localParticle->setWcount(localParticle->getWcount() * h_inv_dim);

  localParticle->setRho_dh(localParticle->getRho_dh() - m_a * hydroDimensions * kernel_root);
  localParticle->setRho_dh(localParticle->getRho_dh() * h_inv_dim_plus_one);

  localParticle->setWcount_dh(localParticle->getWcount_dh() - hydroDimensions * kernel_root);
  localParticle->setWcount_dh(localParticle->getWcount_dh() * h_inv_dim_plus_one);

  const double rho_inv = 1.0 / localParticle->getDensity();
  // @TODO: implement cosmological factors
  const double a_inv2 = 1.0;

  /* Finish calculation of the velocity curl components */
  localParticle->setRot_v(localParticle->getRot_v() * h_inv_dim_plus_one * a_inv2 * rho_inv);

  /* Finish calculation of the velocity divergence */
  localParticle->setDiv_v(localParticle->getDiv_v() * h_inv_dim_plus_one * a_inv2 * rho_inv);

  assertion1(std::isfinite(localParticle->getDensity()), localParticle->toString());
  assertion1(localParticle->getDensity() >= 0., localParticle->toString());
  assertion1(std::isfinite(localParticle->getWcount()), localParticle->toString());
  assertion1(localParticle->getWcount() >= 0., localParticle->toString());
  assertion1(std::isfinite(localParticle->getRho_dh()), localParticle->toString());
  assertion1(std::isfinite(localParticle->getWcount_dh()), localParticle->toString());
}


template <typename Particle>
void swift2::kernelPlaceholders::hydro_prepare_force(Particle* localParticle) {

  // macro expansions from swift2/legacy/kernels are cumbersome otherwise.
  using namespace swift2::legacy::kernelHydro;

  static tarch::logging::Log _log("swift2::kernelPlaceholders");

  // Grab static parameters
  const int    hydroDimensions = localParticle->getHydroDimensions();
  const double alphaAV         = localParticle->getAlphaAV();
  double       hydro_h_max     = std::min(localParticle->getSmlMax(), localParticle->getSearchRadius() / kernel_gamma);

  // Retrieve basic properties of local and active particles
  const double rho_a = localParticle->getDensity();
  const double m_a   = localParticle->getMass();
  const double h_a   = localParticle->getSmoothingLength();
  const double u_a   = localParticle->getU();

  const double h_inv = 1.0 / h_a;

  // This is needed for cosmological integration.
  const double fac_balsara_eps = 1.;

  // Compute the norm of the curl
  double curl_v = 0;

  if (hydroDimensions != 3) { /* in 2D sims Rot_v is a scalar */
    curl_v = std::sqrt(localParticle->getRot_v() * localParticle->getRot_v());
  } else {
    assertionMsg(false, "3D curl_v term to be implemented (straightforward, but have only run 2D so far...)");
  }

  /* Compute the norm of div v */
  const double abs_div_v = tarch::la::abs(localParticle->getDiv_v());

  /* Compute the pressure */
  const double P_a = legacy::eos::gas_pressure_from_internal_energy(rho_a, u_a);
  assertion1(std::isfinite(P_a), localParticle->toString());
  assertion1(P_a > 0., localParticle->toString());

  /* Compute the sound speed */
  const double soundspeed = legacy::eos::gas_soundspeed_from_pressure(rho_a, P_a);
  assertion1(std::isfinite(soundspeed), localParticle->toString());

  /* Compute the "grad h" term  - Note here that we have \tilde{x}
   * as 1 as we use the local number density to find neighbours. This
   * introduces a j-component that is considered in the force loop,
   * meaning that this cached grad_h_term gives:
   *
   * f_ij = 1.f - grad_h_term_i / m_j */
  const double common_factor = h_a / hydroDimensions / localParticle->getWcount();

  float grad_h_term;
  // Ignore changing-kernel effects when h ~= h_max
  if (h_a > 0.9999 * hydro_h_max) {
    grad_h_term = 0.;
    logWarning(
      "hydro_prepare_force", "h ~ h_max for particle with ID " << localParticle->getPartid() << " h = " << h_a
    );
  } else {
    const double grad_W_term = common_factor * localParticle->getWcount_dh();
    if (grad_W_term < -0.9999) {
      /* if we get here, we either had very small neighbour contributions
         (which should be treated as a no neighbour case in the ghost) or
         a very weird particle distribution (e.g. particles sitting on
         top of each other). Either way, we cannot use the normal
         expression, since that would lead to overflow or excessive round
         off and cause excessively high accelerations in the force loop */
      grad_h_term = 0.;
      logWarning(
        "hydro_prepare_force",
        "grad_W_term very small for particle with ID "
          << localParticle->getPartid() << " h:" << h_a << " wcount:" << localParticle->getWcount() << " wcount_dh:"
          << localParticle->getWcount_dh() << " grad_W_term:" << grad_W_term << " common_factor:" << common_factor
      );
    } else {
      grad_h_term = common_factor * localParticle->getRho_dh() / (1. + grad_W_term);
    }
  }


  /* Compute the Balsara Switch */
  const double balsara = alphaAV * abs_div_v / (abs_div_v + curl_v + 0.0001 * fac_balsara_eps * soundspeed * h_inv);

  assertion6(std::isfinite(balsara), localParticle->toString(), balsara, abs_div_v, curl_v, soundspeed, alphaAV);

  /* Update variables */
  localParticle->setF(grad_h_term);
  localParticle->setPressure(P_a);
  localParticle->setSoundSpeed(soundspeed);
  localParticle->setBalsara(balsara);
}


template <typename Particle>
void swift2::kernelPlaceholders::hydro_reset_acceleration(Particle* localParticle) {

  /* Reset the acceleration*/
  localParticle->setA(0.0);

  /* Reset the time derivatives */
  localParticle->setUDot(0.0);
  localParticle->setHDot(0.0);
  localParticle->setV_sig_AV(2.0 * localParticle->getSoundSpeed());
}

template <typename Particle>
void swift2::kernelPlaceholders::hydro_end_force(Particle* localParticle) {

  const int    hydroDimensions    = localParticle->getHydroDimensions();
  const double hydroDimensionsInv = 1. / (double)hydroDimensions;

  localParticle->setHDot(localParticle->getHDot() * localParticle->getSmoothingLength() * hydroDimensionsInv);
  assertion2(std::isfinite(localParticle->getHDot()), localParticle->toString(), localParticle->getSmoothingLength());
}


template <typename Particle>
void swift2::kernelPlaceholders::hydro_predict_extra(Particle* localParticle) {

  const int    hydroDimensions = localParticle->getHydroDimensions();
  const double timeStepSize    = localParticle->getSpecies().getMinTimeStepSize();
  // When integrating in time with cosmology, the three times below will all have
  // different factors/powers of the expansion factor `a` absorbed in them. For
  // now, without cosmology, they are identical.
  const double dt_kick_hydro = timeStepSize;
  const double dt_drift      = timeStepSize;
  const double dt_therm      = timeStepSize;


  // Predict velocities for hydro terms
  localParticle->setV(localParticle->getV() + localParticle->getA() * dt_kick_hydro);

  // Predict additional particle fields forward in time after the Drift step

  // Predict the internal energy
  localParticle->setU(localParticle->getU() + localParticle->getUDot() * dt_therm);

  // Predict smoothing length
  const double h_inv = 1.0 / localParticle->getSmoothingLength();
  const double w1    = localParticle->getHDot() * h_inv * dt_drift;
  localParticle->setSmoothingLength(localParticle->getSmoothingLength() * std::exp(w1));

  // Predict density
  const double w2 = -hydroDimensions * w1;
  localParticle->setDensity(localParticle->getDensity() * std::exp(w2));

  localParticle->setU(std::max(localParticle->getU(), 0.0));

  // Compute the new pressure
  const double pressure = legacy::eos::gas_pressure_from_internal_energy(
    localParticle->getDensity(), localParticle->getU()
  );

  // Compute the new sound speed
  const double soundspeed = legacy::eos::gas_soundspeed_from_pressure(localParticle->getDensity(), pressure);

  localParticle->setPressure(pressure);
  localParticle->setSoundSpeed(soundspeed);
  localParticle->setV_sig_AV(std::max(localParticle->getV_sig_AV(), 2.0 * soundspeed));
}


template <typename Particle>
void swift2::kernelPlaceholders::hydro_kick_extra(Particle* localParticle) {

  /* In principle, this time-step could be different than that used for normal kick */
  double dt_kick_therm = 0.5 * localParticle->getSpecies().getMinTimeStepSize();

  /* Integrate the internal energy forward in time */
  const double delta_u = localParticle->getUDot() * dt_kick_therm;

  /* Do not decrease the energy by more than a factor of 2 */
  localParticle->setU_full(std::max(localParticle->getU_full() + delta_u, localParticle->getU_full() * 0.5));

  /* Check against absolute minimum.
   * Default value is zero. */
  if (localParticle->getU_full() < 0.0) {
    localParticle->setU_full(0.0);
    localParticle->setUDot(0.0);
  }
}

template <typename Particle>
void swift2::kernelPlaceholders::hydro_reset_predicted_values(Particle* localParticle) {

  /* Re-set the predicted velocities */
  localParticle->setV(localParticle->getV_full());

  /* Re-set the entropy */
  localParticle->setU(localParticle->getU_full());

  /* Re-compute the pressure */
  const double pressure = legacy::eos::gas_pressure_from_internal_energy(
    localParticle->getDensity(), localParticle->getU()
  );

  /* Compute the new sound speed */
  const double soundspeed = legacy::eos::gas_soundspeed_from_pressure(localParticle->getDensity(), pressure);

  /* Update variables */
  localParticle->setPressure(pressure);
  localParticle->setSoundSpeed(soundspeed);
  localParticle->setV_sig_AV(std::max(localParticle->getV_sig_AV(), 2.0 * soundspeed));
}
