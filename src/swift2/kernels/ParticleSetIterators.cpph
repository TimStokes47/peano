#include "swift2/kernels/ParticleUpdatePredicates.h"


template <typename ParticleContainer>
void swift2::forAllParticles(
    ParticleContainer& assignedParticles,
    ParticleUnaryOperator<typename ParticleContainer::DoFType>     f
) {
  for (auto* particle : assignedParticles) {
    f(*particle);
  }
}


template <typename ParticleContainer>
void swift2::forAllParticles(
  ParticleContainer& assignedParticles,
  ParticleUnaryOperatorWithPointerCallSemantics<typename ParticleContainer::DoFType>     f
) {
  for (auto* particle : assignedParticles) {
    f(particle);
  }
}


template <typename LocalParticleContainer, typename ActiveParticleContainer>
void swift2::forAllParticlePairs(
  const peano4::datamanagement::CellMarker&  marker,
  LocalParticleContainer&                    localParticles,
  ActiveParticleContainer&                   activeParticles,
  ParticleBinaryOperator<typename LocalParticleContainer::value_type, typename ActiveParticleContainer::value_type>  f
) {
  for (auto* localParticle : localParticles) {
    if (::swift2::kernels::localParticleCanBeWorkedOnCellKernel(localParticle, marker)) {
      for (auto* activeParticle : activeParticles) {
        f(localParticle, activeParticle);
        if (tarch::la::oneGreater(activeParticle->getCellH(), localParticle->getCellH())) {
          f(activeParticle, localParticle);
        }
      }
    }
  }
}
