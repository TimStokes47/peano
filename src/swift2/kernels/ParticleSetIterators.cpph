#include "peano4/utils/Loop.h"


#include <bit>
#include <list>



// ===============================
// Generic variants
// ===============================

template<auto ParticleOp, auto PredicateOp>
void swift2::kernels::forAllParticles(
  const peano4::datamanagement::VertexMarker &marker,
  auto &assignedParticles,
  int numberOfCoalescedAssignedParticles,
  auto realisation
) {
  [[clang::soa_conversion]]
    # ifdef SOA_OFFLOAD
  [[clang::soa_conversion_offload_compute]]
    #endif
  for (auto *particle : assignedParticles) {
    if (PredicateOp(marker, *particle)) {
      ParticleOp(marker, *particle);
    }
  }
}


template <auto ParticleOp, auto PredicateOp>
void swift2::kernels::forAllParticles(
  const peano4::datamanagement::CellMarker &marker,
  auto &assignedParticles,
  const std::vector<int> &numberOfCoalescedLocalParticles,
  auto realisation
) {
  [[clang::soa_conversion]]
  # ifdef SOA_OFFLOAD
  [[clang::soa_conversion_offload_compute]]
  #endif
  for (auto *particle : assignedParticles) {
    if (PredicateOp(marker, *particle)) {
      ParticleOp(marker, *particle);
    }
  }
}

template<auto PairOperator, auto LocalPredicate, auto PairPredicate>
void swift2::kernels::forAllParticlePairs(
  const swift2::CellMetaData&  cellMetaData,
  auto&                        localParticles,
  auto&                        activeParticles,
  auto                         realisation
) {
  [[clang::soa_conversion]]
# ifdef SOA_OFFLOAD
  [[clang::soa_conversion_offload_compute]]
#endif
  int currentParticle = -1;
  for (auto* localParticle : localParticles) {
    currentParticle++;
    if (LocalPredicate(cellMetaData.marker, cellMetaData.localParticleIsContainedInCell[currentParticle], *localParticle)) {
      [[clang::soa_conversion]]
      [[clang::soa_conversion_hoist(1)]]
      for (auto *activeParticle : activeParticles) {
        if (PairPredicate(cellMetaData.marker, *localParticle, *activeParticle)) {
          PairOperator(cellMetaData.marker, *localParticle, *activeParticle);
          if (tarch::la::oneGreater((*activeParticle).getCellH(), (*localParticle).getCellH())) {
            tarch::multicore::Lock lock(internal::_multiscaleInteractionSemaphore);
            PairOperator(cellMetaData.marker, *activeParticle, *localParticle);
          }
        }
      }
    }
  }
}

template <int SubChunkSize, typename LocalParticle, typename ActiveParticle>
std::pair< std::bitset<SubChunkSize>, std::bitset<SubChunkSize> >  swift2::kernels::internal::identifyInteractingParticlesFixedLocalParticle(
    const peano4::datamanagement::CellMarker&  marker,
    LocalParticle*                             localParticle,
    ActiveParticle*                            firstActiveParticleInSubchunk,
    int                                        thisSubchunkSize,
    UpdateParticlePairWithinCellPredicate<LocalParticle>   particlePairPredicate
) {
  std::bitset<SubChunkSize> updateParticleEffect(0);
  std::bitset<SubChunkSize> evaluateBottomUpParticleEffect(0);

  for (int particleIndexWithinThisSubchunk=0; particleIndexWithinThisSubchunk<thisSubchunkSize; particleIndexWithinThisSubchunk++) {
    ActiveParticle*  subChunkParticle = firstActiveParticleInSubchunk+particleIndexWithinThisSubchunk;

    updateParticleEffect[particleIndexWithinThisSubchunk]           = particlePairPredicate(marker, *localParticle, *subChunkParticle);
    evaluateBottomUpParticleEffect[particleIndexWithinThisSubchunk] = not tarch::la::equals(subChunkParticle->getCellH(), localParticle->getCellH());
  }

  return { updateParticleEffect, evaluateBottomUpParticleEffect };
}


template <int SubChunkSize, typename LocalParticle, typename ActiveParticle>
std::pair< std::bitset<SubChunkSize>, std::bitset<SubChunkSize> >  swift2::kernels::internal::identifyInteractingParticlesFixedActiveParticle(
    const peano4::datamanagement::CellMarker&  marker,
    LocalParticle*                             firstLocalParticleInSubchunk,
    int                                        thisSubchunkSize,
    ActiveParticle*                            activeParticle,
    UpdateParticlePairWithinCellPredicate<LocalParticle>   particlePairPredicate
) {
  std::bitset<SubChunkSize> updateParticleEffect(0);
  std::bitset<SubChunkSize> evaluateBottomUpParticleEffect(0);

  for (int particleIndexWithinThisSubchunk=0; particleIndexWithinThisSubchunk<thisSubchunkSize; particleIndexWithinThisSubchunk++) {
    LocalParticle*  subChunkParticle = firstLocalParticleInSubchunk+particleIndexWithinThisSubchunk;

    updateParticleEffect[particleIndexWithinThisSubchunk]           = particlePairPredicate(marker, *subChunkParticle, *activeParticle);
    evaluateBottomUpParticleEffect[particleIndexWithinThisSubchunk] = not tarch::la::equals(subChunkParticle->getCellH(), activeParticle->getCellH());
  }

  return { updateParticleEffect, evaluateBottomUpParticleEffect };
}


// ============================================
// Generic variants exploiting coalesced memory
// ============================================

template <auto ParticleOp, auto PredicateOp>
void swift2::kernels::forAllParticles(
  const peano4::datamanagement::VertexMarker&   marker,
  auto &assignedParticles,
  int numberOfAssignedParticles,
  ::swift2::kernels::kernelrealisation::CoalescedMemoryRealisation     realisation
) {
  auto *particles = *assignedParticles.begin();

  [[clang::soa_conversion_target("particles")]]
    # ifdef SOA_OFFLOAD
    [[clang::soa_conversion_offload_compute]]
    #endif
    for (int i = 0; i < numberOfAssignedParticles; i++) {
    if (PredicateOp(marker, particles[i])) {
      ParticleOp(marker, particles[i]);
    }
  }
}


template <auto ParticleOp, auto PredicateOp>
void swift2::kernels::forAllParticles(
  const peano4::datamanagement::CellMarker &marker,
  auto &localParticles,
  const std::vector<int> &numberOfLocalParticles,
  ::swift2::kernels::kernelrealisation::CoalescedMemoryRealisation     realisation
) {
  auto* pFirstParticle = *localParticles.begin();

  for (auto& chunkSize : numberOfLocalParticles) {
    [[clang::soa_conversion_target("pFirstParticle")]]
    # ifdef SOA_OFFLOAD
    [[clang::soa_conversion_offload_compute]]
    #endif
    for (int i = 0; i < chunkSize; i++) {
      if (PredicateOp(marker, pFirstParticle[i])) {
        ParticleOp(marker, pFirstParticle[i]);
      }
    }
    pFirstParticle += chunkSize;
  }
}


template <auto ParticlePairOp, auto LocalPredicateOp, auto ParticlePairPredicateOp>
void swift2::kernels::forAllParticlePairs(
  const swift2::CellMetaData&  cellMetaData,
  auto&                        localParticles,
  auto&                        activeParticles,
  ::swift2::kernels::kernelrealisation::CoalescedMemoryActiveLocalRealisation     realisation
) {
  int firstActiveParticleOfCurrentChunk  = 0;
  for (auto& activeParticleChunk: cellMetaData.numberOfCoalescedActiveParticlesPerVertex) {
    auto *pFirstActiveParticleOfCurrentChunk = *activeParticles.begin() + firstActiveParticleOfCurrentChunk;
    firstActiveParticleOfCurrentChunk += activeParticleChunk;

    [[clang::soa_conversion_target("pFirstActiveParticleOfCurrentChunk")]]
    for (int iActiveParticle=0; iActiveParticle<activeParticleChunk; iActiveParticle++) {

      int firstLocalParticleOfCurrentChunk  = 0;
      for (auto& localParticleChunk: cellMetaData.numberOfCoalescedLocalParticlesPerVertex) {
        auto *pFirstLocalParticleOfCurrentChunk  = *localParticles.begin() + firstLocalParticleOfCurrentChunk;
        firstLocalParticleOfCurrentChunk += localParticleChunk;

        [[clang::soa_conversion_target("pFirstLocalParticleOfCurrentChunk")]]
          # ifdef SOA_OFFLOAD
//          [[clang::soa_conversion_offload_compute]]
          #endif
        for (int iLocalParticle=0; iLocalParticle<localParticleChunk; iLocalParticle++) {
          if (
            LocalPredicateOp(cellMetaData.marker, cellMetaData.localParticleIsContainedInCell[firstLocalParticleOfCurrentChunk+iLocalParticle], pFirstLocalParticleOfCurrentChunk[iLocalParticle])
            and
            ParticlePairPredicateOp(cellMetaData.marker, pFirstLocalParticleOfCurrentChunk[iLocalParticle], pFirstActiveParticleOfCurrentChunk[iActiveParticle])
          ) {
            ParticlePairOp(cellMetaData.marker, pFirstLocalParticleOfCurrentChunk[iLocalParticle], pFirstActiveParticleOfCurrentChunk[iActiveParticle]);

            if (tarch::la::oneGreater(pFirstActiveParticleOfCurrentChunk[iActiveParticle].getCellH(), pFirstLocalParticleOfCurrentChunk[iLocalParticle].getCellH())) {
              tarch::multicore::Lock lock(internal::_multiscaleInteractionSemaphore);
              ParticlePairOp(cellMetaData.marker, pFirstActiveParticleOfCurrentChunk[iActiveParticle], pFirstLocalParticleOfCurrentChunk[iLocalParticle]);
            }
          }
        } // loop over local particles in current chunk
      } // loop over local chunks
    } // loop over active particles in current chunk
  } // loop over active chunks
}


