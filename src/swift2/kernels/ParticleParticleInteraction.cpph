#include "swift2/kernels/ParticleState.h"
#include "swift2/kernels/SmoothingLengthComputation.h"
#include "swift2/legacy/hydro_dimensions.h"
#include "swift2/legacy/kernel_hydro.h"
#include "tarch/accelerator/accelerator.h"
#include "tarch/compiler/CompilerSpecificSettings.h"
#include "toolbox/particles/MultiscaleTransitions.h"


template <typename Particle, typename ParticleContainer>
void swift2::kernels::genericInteraction(
  const peano4::datamanagement::CellMarker&                                          marker,
  const ParticleContainer&                                                           localParticles,
  const ParticleContainer&                                                           activeParticles,
  std::function<void(Particle* localParticle, const Particle* const activeParticle)> interaction
) {
  for (auto* localParticle : localParticles) {
    if (localParticleCanBeWorkedOnCellKernel(localParticle, marker)) {
      for (auto* activeParticle : activeParticles) {
        interaction(localParticle, activeParticle);
      }
    }
  }
}


template <typename Particle>
void swift2::kernels::densityKernel(Particle* localParticle, const Particle* activeParticle) {

  // macro expansions from swift2/legacy/kernels are cumbersome otherwise.
  using namespace swift2::legacy::kernelHydro;

  const double hydroDimensions = localParticle->getHydroDimensions();

  /* Retrieve basic properties of local and active particles */
  const double h_a = localParticle->getSmoothingLength();

  /* Distance between the particles */
  const tarch::la::Vector<Dimensions, double> dx = localParticle->getX() - activeParticle->getX();
  const double                                r  = tarch::la::norm2(dx);

  /* Compute the actual interaction radius */
  const double iactR = kernel_gamma * h_a;

  if (
    tarch::la::smaller(r, iactR) and tarch::la::greater(r, 0.0) /* Self-contribution is calculated elsewhere */
    // and
    // not localParticle->getIsBoundaryParticle()
  ) {

    const double m_b     = activeParticle->getMass();
    const double h_a_inv = 1. / h_a;
    // Normalized distance to evaluate kernel
    const double qa = r * h_a_inv;

    // Evaluate kernel and its derivative
    double w_a, dwa_dx;
    kernel_deval(qa, w_a, dwa_dx);
    const double dwa_dh = -(hydroDimensions * w_a + qa * dwa_dx);

    // Increment density
    localParticle->setDensity(localParticle->getDensity() + m_b * w_a);

    // Increment drho/dh. Note that minus sign was absorbed into dwa_dh
    localParticle->setRho_dh(localParticle->getRho_dh() + m_b * dwa_dh);

    // Increment fractional number density
    localParticle->setWcount(localParticle->getWcount() + w_a);

    // Increment dWcount/dh. Note that minus sign was absorbed into dwa_dh
    localParticle->setWcount_dh(localParticle->getWcount_dh() + dwa_dh);


    // Compute dv dot r
    // Velocity terms for viscosity
    tarch::la::Vector<Dimensions, double> dv;
    tarch::la::Vector<Dimensions, double> curlvr(0.0);

    /* Now we need to compute the div terms */
    const double r_inv = r ? 1.0 / r : 0.0;
    const double fac_a = m_b * dwa_dx * r_inv;

    dv                = localParticle->getV() - activeParticle->getV();
    const double dvdr = tarch::la::dot(dv, dx);
    localParticle->setDiv_v(localParticle->getDiv_v() - fac_a * dvdr);

    /* Compute dv cross r */
    /* 2D Term only has 1 component (z) */
    const double curlvr2D = dv[0] * dx[1] - dv[1] * dx[0];
    localParticle->setRot_v(localParticle->getRot_v() + fac_a * curlvr2D);
    // @TODO Mladen: Implement 3D curl
    if (hydroDimensions == 3)
      assertionMsg(false, "3D not implemented");

    /* Debug: Increment number of detected neighbours */
    localParticle->setNcount(localParticle->getNcount() + 1);

  } /* End if r<iactR */
}


template <typename Particle>
void swift2::kernels::forceKernel(Particle* localParticle, const Particle* activeParticle) {

  // macro expansions from swift2/legacy/kernels are cumbersome otherwise.
  using namespace swift2::legacy::kernelHydro;

  // Grab static parameters
  const int    hydroDimensions = localParticle->getHydroDimensions();
  const double alphaAV         = localParticle->getAlphaAV();
  const double betaAV          = localParticle->getBetaAV();

  // No cosmology yet: a^{(3 gamma - 5 )/ 2} = 1.
  const double fac_mu    = 1.;
  const double a2_Hubble = 0.; // a**2 * H, where H = da/dt / a. = 0 without cosmo

  // Distance between the two particles
  tarch::la::Vector<Dimensions, double> dx = localParticle->getX() - activeParticle->getX();

  const double r     = tarch::la::norm2(dx);
  const double r_inv = r ? 1.0 / r : 0.0;

  // Get actual interaction radius
  const double h_a   = localParticle->getSmoothingLength();
  const double iactR = kernel_gamma * h_a;

  if (tarch::la::smaller(r, iactR) and tarch::la::greater(r, 0.0)) {
    // and not localParticle->getIsBoundaryParticle()) {

    // Retrieve basic properties of local and active particles
    const double m_a = localParticle->getMass();
    const double m_b = activeParticle->getMass();

    const double rho_a = localParticle->getDensity();
    const double rho_b = activeParticle->getDensity();

    const double P_a = localParticle->getPressure();
    const double P_b = activeParticle->getPressure();

    // Get kernel for ha
    const double h_a_inv     = 1. / h_a;
    const double h_a_inv_dp1 = swift2::legacy::hydroDimensions::pow_dimension_plus_one(h_a_inv); // 1/h^{dim + 1}
    const double qa          = r * h_a_inv;
    double       wa, dwa_dqa;
    // Evaluate kernel and its derivative for particle a
    kernel_deval(qa, wa, dwa_dqa);
    const double dwa_dr = dwa_dqa * h_a_inv_dp1;


    // Dimensionless distance to evaluate kernel
    const double h_b         = activeParticle->getSmoothingLength();
    const double h_b_inv     = 1. / h_b;
    const double h_b_inv_dp1 = swift2::legacy::hydroDimensions::pow_dimension_plus_one(h_b_inv); // 1/h^{dim + 1}
    const double qb          = r * h_b_inv;
    double       wb, dwb_dqb;
    // Evaluate kernel and its derivative for particle b
    kernel_deval(qb, wb, dwb_dqb);
    const double dwb_dr = dwb_dqb * h_b_inv_dp1;

    // Variable smoothing length term

    // SWIFT "f"
    const double f_ab = 1.0 - localParticle->getF() / m_b;
    const double f_ba = 1.0 - activeParticle->getF() / m_a;

    // Compute gradient terms
    const double P_over_rho2_a = P_a / (rho_a * rho_a) * f_ab;
    const double P_over_rho2_b = P_b / (rho_b * rho_b) * f_ba;

    // Compute dv dot r.
    double dvdr = tarch::la::dot((localParticle->getV() - activeParticle->getV()), dx);

    // Add Hublle flow: Skipped for now
    const double dvdr_Hubble = 0.;

    /* Are the particles moving towards each others ? */
    const double omega_ab = std::min(dvdr, dvdr_Hubble);
    const double mu_ab    = fac_mu * r_inv * omega_ab; /* This is 0 or negative */

    /* Compute sound speeds and signal velocity */
    const double v_sig = localParticle->getSoundSpeed() + activeParticle->getSoundSpeed() - betaAV * mu_ab;

    /* Balsara term */
    const double balsara_a = localParticle->getBalsara();
    const double balsara_b = activeParticle->getBalsara();

    /* Construct the full viscosity term */
    const double rho_ab = 0.5 * (rho_a + rho_b);
    const double visc   = -0.25 * v_sig * mu_ab * (balsara_a + balsara_b) / rho_ab;

    /* Convolve with the kernel */
    const double visc_acc_term = 0.5 * visc * (dwa_dr * f_ab + dwb_dr * f_ba) * r_inv;

    /* SPH acceleration term */
    const double sph_acc_term = (P_over_rho2_a * dwa_dr + P_over_rho2_b * dwb_dr) * r_inv;

    // Assemble the acceleration
    const double acc = sph_acc_term + visc_acc_term;

    assertion9(
      std::isfinite(visc_acc_term),
      visc_acc_term,
      localParticle->toString(),
      activeParticle->toString(),
      dwa_dr,
      f_ab,
      dwb_dr,
      f_ba,
      r_inv,
      visc
    );
    assertion3(std::isfinite(sph_acc_term), sph_acc_term, localParticle->toString(), activeParticle->toString());

    // Use the force
    localParticle->setA(localParticle->getA() - m_b * acc * dx);

    /* Get the time derivative for u. */
    const double sph_du_term_a = P_over_rho2_a * dvdr * r_inv * dwa_dr;

    /* Viscosity term */
    const double visc_du_term = 0.5 * visc_acc_term * dvdr_Hubble;

    // Assemble the energy equation term
    const double du_dt_a = sph_du_term_a + visc_du_term;

    const double udot = localParticle->getUDot();

    // Internal energy time derivative
    localParticle->setUDot(localParticle->getUDot() + m_b * du_dt_a);

    /* Get the time derivative for h. */
    localParticle->setHDot(localParticle->getHDot() - m_b * dvdr * r_inv / rho_b * dwa_dr * f_ab);

    // Update the signal velocity
    localParticle->setV_sig_AV(std::max(localParticle->getV_sig_AV(), v_sig));

    assertion6(not std::isnan(localParticle->getHDot()), localParticle->toString(), dvdr, r_inv, dwa_dr, f_ab, f_ba);
    assertion7(
      not tarch::la::isEntryNan(localParticle->getA()),
      localParticle->toString(),
      sph_acc_term,
      visc_acc_term,
      f_ab,
      f_ba,
      activeParticle->getF(),
      activeParticle->getIsBoundaryParticle()
    );
  }
}


template <typename Particle>
bool swift2::kernels::forceKernelDistanceCheck(
  Particle* __restrict__ localParticle, const Particle* __restrict__ activeParticle
) {

  const double h_a = localParticle->getSmoothingLength();

  // Distance between the two particles
  tarch::la::Vector<Dimensions, double> dx = localParticle->getX() - activeParticle->getX();
  const double                          r  = tarch::la::norm2(dx);

  // Get actual interaction radius
  const double iactR = kernel_gamma * h_a;

  const bool result = tarch::la::smaller(r, iactR);

  return result;
}


template <typename Particle>
void swift2::kernels::forceKernelVectorised(
  Particle* __restrict__ localParticle, const Particle* __restrict__ activeParticle
) InlineMethod {

  // macro expansions from swift2/legacy/kernels are cumbersome otherwise.
  using namespace swift2::legacy::kernelHydro;

  // Grab static parameters
  const int    hydroDimensions = localParticle->getHydroDimensions();
  const double alphaAV         = localParticle->getAlphaAV();
  const double betaAV          = localParticle->getBetaAV();

  // Retrieve basic properties of local and active particles
  const double rho_a = localParticle->getDensity();
  const double rho_b = activeParticle->getDensity();

  const double P_a = localParticle->getPressure();
  const double P_b = activeParticle->getPressure();

  const double m_a = localParticle->getMass();
  const double m_b = activeParticle->getMass();

  const double h_a = localParticle->getSmoothingLength();
  const double h_b = activeParticle->getSmoothingLength();

  // Distance between the two particles
  tarch::la::Vector<Dimensions, double> dx    = localParticle->getX() - activeParticle->getX();
  const double                          r     = tarch::la::norm2(dx);
  const double                          r_inv = r ? 1.0 / r : 0.0;

  // Dimensionless distance to evaluate kernel
  const double h_a_inv = 1. / h_a;
  const double h_b_inv = 1. / h_b;
  const double q_a     = r * h_a_inv;
  const double q_b     = r * h_b_inv;

  // Get actual interaction radius
  const double iactR = kernel_gamma * h_a;

  // @Pawel I don't know if this vectorises anymore, but I think the second check is important
  //        I also don't know if a strict or non-strict boolean optimisation make a difference.
  //        If they do, please document it in the SWIFT optimisation pages.
  double mask = (tarch::la::smaller(r, iactR) & tarch::la::greater(r, 0.0)) ? 1.0 : 0.0;

  // Get actual interaction radius
  double wa, wb;
  double wa_dr, wb_dr;
  double dw_dqa, dw_dqb;

  // Evaluate kernel and its derivative for particle a
  kernel_deval(q_a, wa, dw_dqa);

  // Evaluate kernel and its derivative for particle b
  kernel_deval(q_b, wb, dw_dqb);

  wa_dr = dw_dqa * swift2::legacy::hydroDimensions::pow_dimension_plus_one(h_a_inv);
  wb_dr = dw_dqb * swift2::legacy::hydroDimensions::pow_dimension_plus_one(h_b_inv);

  // Variable smoothing length term

  // SWIFT "f"
  const double f_ab = 1.0 - localParticle->getF() / m_b;
  const double f_ba = 1.0 - activeParticle->getF() / m_a;

  // Compute gradient terms
  const double P_over_rho2_a = P_a / (rho_a * rho_a) * f_ab;
  const double P_over_rho2_b = P_b / (rho_b * rho_b) * f_ba;

  // Compute dv dot r.
  double dvdr = tarch::la::dot((localParticle->getV() - activeParticle->getV()), dx);


  // Are the particles moving towards each others ?
  const double omega_ab = std::min(dvdr, 0.0);
  const double mu_ab    = r_inv * omega_ab;

  // Compute sound speeds and signal velocity
  const double v_sig = localParticle->getSoundSpeed() + activeParticle->getSoundSpeed() - betaAV * mu_ab;

  // Balsara term
  const double balsara_a = localParticle->getBalsara();
  const double balsara_b = activeParticle->getBalsara();

  // Construct the full viscosity term
  const double rho_ab = 0.5 * (rho_a + rho_b);
  const double visc   = -0.25 * v_sig * mu_ab * (balsara_a + balsara_b) / rho_ab;

  // Convolve with the kernel
  const double visc_acc_term = 0.5 * visc * (wa_dr * f_ab + wb_dr * f_ba) * r_inv;

  // SPH acceleration term
  const double sph_acc_term = (P_over_rho2_a * wa_dr + P_over_rho2_b * wb_dr) * r_inv;

  // Assemble the acceleration
  const double acc = sph_acc_term + visc_acc_term;

  assertion9(
    std::isfinite(visc_acc_term),
    visc_acc_term,
    localParticle->toString(),
    activeParticle->toString(),
    wa_dr,
    f_ab,
    wb_dr,
    f_ba,
    r_inv,
    visc
  );
  assertion3(std::isfinite(sph_acc_term), sph_acc_term, localParticle->toString(), activeParticle->toString());

  // Use the force
  localParticle->setA(localParticle->getA() - mask * m_b * acc * dx);

  // Get the time derivative for u.
  const double sph_du_term_a = P_over_rho2_a * dvdr * r_inv * wa_dr;

  // Viscosity term
  const double visc_du_term = 0.5 * visc_acc_term * dvdr;

  // Assemble the energy equation term
  const double du_dt_a = sph_du_term_a + visc_du_term;

  const double udot = localParticle->getUDot();

  // Internal energy time derivative
  localParticle->setUDot(localParticle->getUDot() + mask * m_b * du_dt_a);

  // Get the time derivative for h.
  localParticle->setHDot(localParticle->getHDot() - mask * m_b * dvdr * r_inv / rho_b * wa_dr * f_ab);

  // Update the signal velocity
  // localParticle->setV_sig_AV(std::max(localParticle->getV_sig_AV(), mask * v_sig));
  const double currentAV = localParticle->getV_sig_AV();
  const double biggerAV  = mask * v_sig;
  const double newAV     = biggerAV > currentAV ? biggerAV : currentAV;
  localParticle->setV_sig_AV(newAV);

  assertion6(not std::isnan(localParticle->getHDot()), localParticle->toString(), dvdr, r_inv, wa_dr, f_ab, f_ba);
  assertion7(
    not tarch::la::isEntryNan(localParticle->getA()),
    localParticle->toString(),
    sph_acc_term,
    visc_acc_term,
    f_ab,
    f_ba,
    activeParticle->getF(),
    activeParticle->getIsBoundaryParticle()
  );
}


