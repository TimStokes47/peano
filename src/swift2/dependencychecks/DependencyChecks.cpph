#pragma once

#include <iomanip>
#include <iostream>




#if PeanoDebug==0
#else
template <typename Particle>
static std::string swift2::dependencychecks::outputParticle(
  const Particle*                                             particle,
  typename std::remove_pointer<Particle>::type::DependencyChecksAlgorithmStepLastUpdated    algorithmStep,
  typename std::remove_pointer<Particle>::type::DependencyChecksPeanoEventUsedBySwift    sweepStageMarkerEnum,
  const int                                                   errors,
  const std::string                                           call_identifier
) {

  using PartType = std::remove_pointer<Particle>::type;

  const int nsteps  = static_cast<int>(PartType::DependencyChecksAlgorithmStepLastUpdated::count);
  const int nstages = static_cast<int>(PartType::DependencyChecksPeanoEventUsedBySwift::count);


  std::ostringstream msg;

  msg <<  "-----------------------------------------" << std::endl;
  msg <<  "Main Algorithm Step Dependency check [" << call_identifier << "]" << std::endl;
  msg <<  "Particle " << particle->getPartid() << " - found " << errors << " dependency error(s)" << std::endl;
  msg <<  "Failed at " << PartType::toString(algorithmStep) << " / " << PartType::toString(sweepStageMarkerEnum) << std::endl;

  constexpr int ColumnWidth = 40;

  // Set up "header" of the table
  msg << "Dependency checks:" << std::endl;
  msg << std::setw(ColumnWidth) << std::left << "Algorithm step";
  for (int s = 0; s < nstages; s++) {
    // all stage names that we account for
    msg << std::setw(ColumnWidth) << PartType::toString(static_cast<PartType::DependencyChecksPeanoEventUsedBySwift>(s));
  }

  // write out what particle has actually done
  int i = 0;
  for (int a = 0; a < nsteps; a++) {
    // write out algorithm step name
    msg << std::endl << std::setw(ColumnWidth)
        << std::setw(ColumnWidth) << std::left << PartType::toString(static_cast<PartType::DependencyChecksAlgorithmStepLastUpdated>(a));

    // write out counters for sweep stages of that algorithm step
    for (int s = 0; s < nstages; s++) {
      if (particle->getDependencyChecksAlgorithmStepUpdates(i)<0) {
        msg << std::setw(ColumnWidth) << "masked out (" + std::to_string(-particle->getDependencyChecksAlgorithmStepUpdates(i)) + "x)";
      }
      else if (particle->getDependencyChecksAlgorithmStepUpdates(i)==0) {
        msg << std::setw(ColumnWidth) << "not considered";
      }
      else {
        msg << std::setw(ColumnWidth) << "updated (" + std::to_string(particle->getDependencyChecksAlgorithmStepUpdates(i)) + "x)";
      }
      i++;
    }
  }

  msg << std::endl << "Particle data:" << particle->toString() << std::endl;

  return msg.str();
}


template <typename Particle>
static std::string swift2::dependencychecks::outputParticle(
  const Particle*                                             particle,
  typename std::remove_pointer<Particle>::type::DependencyChecksInitStepLastUpdated    algorithmStep,
  typename std::remove_pointer<Particle>::type::DependencyChecksPeanoEventUsedBySwift    sweepStageMarkerEnum,
  const int                                                   errors,
  const std::string                                           call_identifier
) {

  using PartType = std::remove_pointer<Particle>::type;

  const int nsteps  = static_cast<int>(PartType::DependencyChecksInitStepLastUpdated::count);
  const int nstages = static_cast<int>(PartType::DependencyChecksPeanoEventUsedBySwift::count);


  std::ostringstream msg;

  msg <<  "-----------------------------------------" << std::endl;
  msg <<  "Main Algorithm Step Dependency check [" << call_identifier << "]" << std::endl;
  msg <<  "Particle " << particle->getPartid() << " - found " << errors << " dependency error(s)" << std::endl;
  msg <<  "Failed at " << PartType::toString(algorithmStep) << " / " << PartType::toString(sweepStageMarkerEnum) << std::endl;

  constexpr int ColumnWidth = 40;

  // Set up "header" of the table
  msg << "Dependency checks:" << std::endl;
  msg << std::setw(ColumnWidth) << std::left << "Algorithm step";
  for (int s = 0; s < nstages; s++) {
    // all stage names that we account for
    msg << std::setw(ColumnWidth) << PartType::toString(static_cast<PartType::DependencyChecksPeanoEventUsedBySwift>(s));
  }

  // write out what particle has actually done
  int i = 0;
  for (int a = 0; a < nsteps; a++) {
    // write out algorithm step name
    msg << std::endl << std::setw(ColumnWidth)
        << std::setw(ColumnWidth) << std::left << PartType::toString(static_cast<PartType::DependencyChecksInitStepLastUpdated>(a));

    // write out counters for sweep stages of that algorithm step
    for (int s = 0; s < nstages; s++) {
      if (particle->getDependencyChecksInitStepUpdates(i)<0) {
        msg << std::setw(ColumnWidth) << "masked out (" + std::to_string(-particle->getDependencyChecksInitStepUpdates(i)) + "x)";
      }
      else if (particle->getDependencyChecksInitStepUpdates(i)==0) {
        msg << std::setw(ColumnWidth) << "not considered";
      }
      else {
        msg << std::setw(ColumnWidth) << "updated (" + std::to_string(particle->getDependencyChecksInitStepUpdates(i)) + "x)";
      }
      i++;
    }
  }

  msg << std::endl << "Particle data:" << particle->toString() << std::endl;

  return msg.str();
}


template <typename ParticleContainer, typename Marker>
static void swift2::dependencychecks::markAlgorithmStep(
  const ParticleContainer&                                                                  localParticles,
  const Marker&                                                                             marker,
  typename std::remove_pointer<typename ParticleContainer::value_type>::type::DependencyChecksAlgorithmStepLastUpdated algorithmStep,
  typename std::remove_pointer<typename ParticleContainer::value_type>::type::DependencyChecksPeanoEventUsedBySwift    action,
  bool                                                                                      stepMovedParticle,
  bool (*workOnParticle)(const typename std::remove_pointer<typename ParticleContainer::value_type>::type*, const Marker&)
) {

  using PartType = std::remove_pointer<typename ParticleContainer::value_type>::type;

  const int algorithmStepMarker = static_cast<int>(algorithmStep);
  const int sweepStageMarker    = static_cast<int>(action);

  const int nstages = static_cast<int>(PartType::DependencyChecksPeanoEventUsedBySwift::count);
  const int nsteps  = static_cast<int>(PartType::DependencyChecksAlgorithmStepLastUpdated::count);

  const int index_this_stage = algorithmStepMarker * nstages + sweepStageMarker;

  for (auto* particle : localParticles) {

    // Mark what we have just completed, but only if the particle was actually touched!
    if (workOnParticle(particle, marker)) {
      assertion1(
        particle->getDependencyChecksAlgorithmStepUpdates()[index_this_stage]>=0,
        outputParticle(
          particle,
          algorithmStep,
          action,
          1, // errors,
          "want to increment marker, as step modifies particle, but particle had been identified as masked out before"
        )
      );
      particle->setDependencyChecksAlgorithmStepUpdates(
        index_this_stage, particle->getDependencyChecksAlgorithmStepUpdates()[index_this_stage] + 1
      );
    }
    else if (stepMovedParticle) {
      assertion1(
        particle->getDependencyChecksAlgorithmStepUpdates()[index_this_stage]>=0,
        outputParticle(
          particle,
          algorithmStep,
          action,
          1, // errors,
          "want to increment marker, as step modifies particle, but particle had been identified as masked out before"
        )
      );
    }
    else {
      assertion1(
        particle->getDependencyChecksAlgorithmStepUpdates()[index_this_stage]<=0,
        outputParticle(
          particle,
          algorithmStep,
          action,
          1, // errors,
          "want to decrement marker, as step masked out particle, but particle had been identified as to-be-updated before"
        )
      );
      // Freshly moved particles may not be sieved correctly into being local particles yet.
      // See docu in Toolbox/Particles/Mesh Traversal.
      // So if `workOnParticle()` has a check whether the particle is local, it may be skipped.
      // Anticipate this, and mark it by using negative counters.
      particle->setDependencyChecksAlgorithmStepUpdates(
        index_this_stage, particle->getDependencyChecksAlgorithmStepUpdates()[index_this_stage] - 1
      );
    }
  }
}


template <typename ParticleContainer, typename Marker>
static void swift2::dependencychecks::markInitStep(
  const ParticleContainer&                                                               localParticles,
  const Marker&                                                                          marker,
  typename std::remove_pointer<typename ParticleContainer::value_type>::type::DependencyChecksInitStepLastUpdated   initStepMarkerEnum,
  typename std::remove_pointer<typename ParticleContainer::value_type>::type::DependencyChecksPeanoEventUsedBySwift action,
  bool                                                                                   stepMovedParticle,
  bool (*workOnParticle)(const typename std::remove_pointer<typename ParticleContainer::value_type>::type*, const Marker&)
) {

  using PartType = std::remove_pointer<typename ParticleContainer::value_type>::type;

  const int initStepMarker   = static_cast<int>(initStepMarkerEnum);
  const int sweepStageMarker = static_cast<int>(action);

  const int nstages = static_cast<int>(PartType::DependencyChecksPeanoEventUsedBySwift::count);
  const int nsteps  = static_cast<int>(PartType::DependencyChecksInitStepLastUpdated::count);

  const int index_this_stage = initStepMarker * nstages + sweepStageMarker;

  for (auto* particle : localParticles) {

    // Mark what we have just completed, but only if the particle was actually touched!
    if (workOnParticle(particle, marker)) {

      particle->setDependencyChecksInitStepUpdates(
        index_this_stage, particle->getDependencyChecksInitStepUpdates()[index_this_stage] + 1
      );
    } else if (stepMovedParticle) {
      // Freshly moved particles may not be sieved correctly into being local particles yet.
      // See docu in Toolbox/Particles/Mesh Traversal.
      // So if `workOnParticle()` has a check whether the particle is local, it may be skipped.
      // Anticipate this, and mark it by using negative counters.
      particle->setDependencyChecksInitStepUpdates(
        index_this_stage, particle->getDependencyChecksInitStepUpdates()[index_this_stage] - 1
      );
    }
  }
}


static int swift2::dependencychecks::checkPastStages(
  const int currentStep, const int currentStage, const int nsteps, const int nstages, const int* sweepStateProgression
) {

  int errors = 0;

  // Check everything else before this stage, and check that everything
  // that should've run until now actually has run.
  for (int step = 0; step < currentStep; step++) {

    for (int stage = 0; stage < nstages; stage++) {

      const int index     = step * nstages + stage;
      const int partStage = sweepStateProgression[index];

      if (partStage == 0)
        errors++;
    }
  }


  // for the current sweep, only check up to the current stage.
  for (int stage = 0; stage < currentStage; stage++) {

    const int index     = currentStep * nstages + stage;
    const int partStage = sweepStateProgression[index];

    if (partStage == 0)
      errors++;
  }

  return errors;
}


static int swift2::dependencychecks::checkFutureStages(
  const int currentStep, const int currentStage, const int nsteps, const int nstages, const int* sweepStateProgression
) {

  int errors = 0;

  // Check everything *after* this stage, and check that everything
  // that shouldn't have run until now actually hasn't run.
  for (int step = currentStep + 1; step < nsteps; step++) {

    for (int stage = 0; stage < nstages; stage++) {

      const int index     = step * nstages + stage;
      const int partStage = sweepStateProgression[index];

      if (partStage != 0)
        errors++;
    }
  }

  // for the current sweep, only check beginning with the next stage.
  for (int stage = currentStage + 1; stage < nstages; stage++) {

    const int index     = currentStep * nstages + stage;
    const int partStage = sweepStateProgression[index];

    if (partStage != 0)
      errors++;
  }

  return errors;
}


template <typename ParticleContainer, typename Marker>
static void swift2::dependencychecks::checkAlgorithmStep(
  const ParticleContainer&                                                                  localParticles,
  const Marker&                                                                             marker,
  typename std::remove_pointer<typename ParticleContainer::value_type>::type::DependencyChecksAlgorithmStepLastUpdated algorithmStep,
  typename std::remove_pointer<typename ParticleContainer::value_type>::type::DependencyChecksPeanoEventUsedBySwift    action,
  bool (*workOnParticle)(const typename std::remove_pointer<typename ParticleContainer::value_type>::type*, const Marker&)
) {

  using PartType = std::remove_pointer<typename ParticleContainer::value_type>::type;

  const int algorithmStepMarker = static_cast<int>(algorithmStep);
  const int sweepStageMarker    = static_cast<int>(action);

  const int nstages = static_cast<int>(PartType::DependencyChecksPeanoEventUsedBySwift::count);
  const int nsteps  = static_cast<int>(PartType::DependencyChecksAlgorithmStepLastUpdated::count);


  for (auto* particle : localParticles) {

    int        errors = 0;
    const int* arr    = particle->getDependencyChecksAlgorithmStepUpdates();

    errors = checkPastStages(algorithmStepMarker, sweepStageMarker, nsteps, nstages, arr);

    // If there are any errors, print out a detailed report and exit.
    assertionEquals1(
      errors, 0,
      outputParticle(
        particle,
        algorithmStep,
        action,
        errors,
        "localParticle check each step and sweep stage - Something in the past has not been completed"
      )
    );

    errors = checkFutureStages(algorithmStepMarker, sweepStageMarker, nsteps, nstages, arr);

    // If there are any errors, print out a detailed report and exit.
    assertionEquals1(
      errors, 0,
      outputParticle(
        particle,
        algorithmStep,
        action,
        errors,
        "localParticle check each step and sweep stage - Something in the future has been done too early (or markers haven't been reset correctly)"
      )
    );
  }
}


template <typename ParticleContainer>
static void swift2::dependencychecks::checkParticlesAssignedToVertexInTouchLastTimeAlgorithmStep(
  const ParticleContainer&                                                                  activeParticles,
  typename std::remove_pointer<typename ParticleContainer::value_type>::type::DependencyChecksAlgorithmStepLastUpdated algorithmStep
) {

  using PartType = std::remove_pointer<typename ParticleContainer::value_type>::type;

  const int algorithmStepMarker = static_cast<int>(algorithmStep);
  const int touchVertexLastTime = static_cast<int>(PartType::DependencyChecksPeanoEventUsedBySwift::touchVertexLastTime);

  const int nstages = static_cast<int>(PartType::DependencyChecksPeanoEventUsedBySwift::count);
  const int nsteps  = static_cast<int>(PartType::DependencyChecksAlgorithmStepLastUpdated::count);

  for (auto* particle : activeParticles) {

    int        errors = 0;
    const int* arr    = particle->getDependencyChecksAlgorithmStepUpdates();

    errors = checkPastStages(algorithmStepMarker, touchVertexLastTime, nsteps, nstages, arr);

    // If there are any errors, print out a detailed report and exit.
    assertionEquals1(
      errors, 0,
      outputParticle(
        particle,
        algorithmStep,
        PartType::DependencyChecksPeanoEventUsedBySwift::touchVertexLastTime,
        errors,
        "activeParticles dependency check in TouchVertexLastTime"
      )
    );


    errors = checkFutureStages(algorithmStepMarker, touchVertexLastTime, nsteps, nstages, arr);

    // If there are any errors, print out a detailed report and exit.
    assertionEquals1(
      errors, 0,
      outputParticle(
        particle,
        algorithmStep,
        PartType::DependencyChecksPeanoEventUsedBySwift::touchVertexLastTime,
        errors,
        "activeParticles dependency check in TouchVertexLastTime - Something in the future has been done too early (or markers haven't been reset correctly)"
      )
    );
  }
}


template <typename ParticleContainer, typename Marker>
static void swift2::dependencychecks::checkInitStep(
  const ParticleContainer&                                                               localParticles,
  const Marker&                                                                          marker,
  typename std::remove_pointer<typename ParticleContainer::value_type>::type::DependencyChecksInitStepLastUpdated  initStepMarkerEnum,
  typename std::remove_pointer<typename ParticleContainer::value_type>::type::DependencyChecksPeanoEventUsedBySwift action,
  bool (*workOnParticle)(const typename std::remove_pointer<typename ParticleContainer::value_type>::type*, const Marker&)
) {

  using PartType = std::remove_pointer<typename ParticleContainer::value_type>::type;

  const int initStepMarker   = static_cast<int>(initStepMarkerEnum);
  const int sweepStageMarker = static_cast<int>(action);

  const int nstages = static_cast<int>(PartType::DependencyChecksPeanoEventUsedBySwift::count);
  const int nsteps  = static_cast<int>(PartType::DependencyChecksInitStepLastUpdated::count);


  for (auto* particle : localParticles) {

    int        errors = 0;
    const int* arr    = particle->getDependencyChecksInitStepUpdates();

    errors = checkPastStages(initStepMarker, sweepStageMarker, nsteps, nstages, arr);

    // If there are any errors, print out a detailed report and exit.
    assertionEquals1(
      errors, 0,
      outputParticle(
        particle, initStepMarkerEnum, action, errors, "localParticle check each step and sweep stage"
      )
    );

    errors = checkFutureStages(initStepMarker, sweepStageMarker, nsteps, nstages, arr);

    // If there are any errors, print out a detailed report and exit.
    assertionEquals1(
      errors, 0,
      outputParticle(
        particle,
        initStepMarkerEnum,
        action,
        errors,
        "localParticle check each step and sweep stage - Something in the future has been done too early (or markers haven't been reset correctly)"
      )
    );
  }
}


template <typename ParticleContainer>
static void swift2::dependencychecks::checkParticlesAssignedToVertexInTouchLastTimeInitStep(
  const ParticleContainer&                                                             activeParticles,
  typename std::remove_pointer<typename ParticleContainer::value_type>::type::DependencyChecksInitStepLastUpdated  initStepMarkerEnum
) {

  using PartType = std::remove_pointer<typename ParticleContainer::value_type>::type;

  const int initStepMarker      = static_cast<int>(initStepMarkerEnum);
  const int touchVertexLastTime = static_cast<int>(PartType::DependencyChecksPeanoEventUsedBySwift::touchVertexLastTime);

  const int nstages = static_cast<int>(PartType::DependencyChecksPeanoEventUsedBySwift::count);
  const int nsteps  = static_cast<int>(PartType::DependencyChecksInitStepLastUpdated::count);

  for (auto* particle : activeParticles) {

    int        errors = 0;
    const int* arr    = particle->getDependencyChecksInitStepUpdates();
    errors            = checkPastStages(initStepMarker, touchVertexLastTime, nsteps, nstages, arr);

    // If there are any errors, print out a detailed report and exit.
    assertionEquals1(
      errors, 0,
      outputParticle(
        particle,
        initStepMarkerEnum,
        PartType::DependencyChecksPeanoEventUsedBySwift::touchVertexLastTime,
        errors,
        "activeParticles dependency check in TouchVertexLastTime"
      )
    );

    errors = checkFutureStages(initStepMarker, touchVertexLastTime, nsteps, nstages, arr);

    // If there are any errors, print out a detailed report and exit.
    assertionEquals1(
      errors, 0,
      outputParticle(
        particle,
        initStepMarkerEnum,
        PartType::DependencyChecksPeanoEventUsedBySwift::touchVertexLastTime,
        errors,
        "activeParticles dependency check in TouchVertexLastTime - Something in the future has been done too early (or markers haven't been reset correctly)"
      )
    );
  }
}


template <typename ParticleContainer>
static void swift2::dependencychecks::clearDependencyChecksAlgorithmStep(const ParticleContainer& localParticles) {

  using PartType    = std::remove_pointer<typename ParticleContainer::value_type>::type;
  const int nstages = static_cast<int>(PartType::DependencyChecksPeanoEventUsedBySwift::count);
  const int nsteps  = static_cast<int>(PartType::DependencyChecksAlgorithmStepLastUpdated::count);

  for (auto* particle : localParticles) {
    for (int i = 0; i < nsteps * nstages; i++) {
      particle->setDependencyChecksAlgorithmStepUpdates(i, 0);
    }
  }
}


template <typename ParticleContainer>
static void swift2::dependencychecks::clearDependencyChecksInitStep(const ParticleContainer& localParticles) {

  using PartType    = std::remove_pointer<typename ParticleContainer::value_type>::type;
  const int nstages = static_cast<int>(PartType::DependencyChecksPeanoEventUsedBySwift::count);
  const int nsteps  = static_cast<int>(PartType::DependencyChecksInitStepLastUpdated::count);

  for (auto* particle : localParticles) {
    for (int i = 0; i < nsteps * nstages; i++) {
      particle->setDependencyChecksInitStepUpdates(i, 0);
    }
  }
}

#endif
