#include "peano4/parallel/parallel.h"
#include "peano4/utils/Loop.h"


template <typename ParticleSet>
int swift2::VertexTask<ParticleSet>::TaskTypeId = peano4::parallel::getTaskType( "swift2::VertexTask<ParticleSet>::" );


template <typename ParticleSet>
swift2::VertexTask<ParticleSet>::VertexTask(
  const ParticleSet&  assignedParticles,
  Functor             functor,
  bool                fuseAndPortToGPU
):
  tarch::multicore::Task(
    fuseAndPortToGPU ? TaskTypeId : tarch::multicore::Task::DontFuse,
    tarch::multicore::Task::DefaultPriority
  ),
  _assignedParticles(assignedParticles),
  _functor(functor) {}


template <typename ParticleSet>
bool swift2::VertexTask<ParticleSet>::run() {
  _functor(_assignedParticles);
  return false;
}


template <typename Vertex>
std::set<int> swift2::getVertexNumbersOfParentVertices(
  tarch::la::Vector< Dimensions, int >              position,
  peano4::datamanagement::VertexEnumerator<Vertex>  coarseGridVertices,
  int                                               dimension
) {
  if (dimension==-1) {
    std::set<int> result;
    result.insert( coarseGridVertices( peano4::utils::dLinearised(position,2) ).getNumber() );
    return result;
  }
  else if (position(dimension)==0) {
    return getVertexNumbersOfParentVertices(position,coarseGridVertices,dimension-1);
  }
  else if (position(dimension)==3) {
    position(dimension)=1;
    return getVertexNumbersOfParentVertices(position,coarseGridVertices,dimension-1);
  }
  else {
    std::set<int> result;
    position(dimension) = 0;
    std::set<int> left = getVertexNumbersOfParentVertices(position,coarseGridVertices,dimension-1);
    position(dimension) = 1;
    std::set<int> right = getVertexNumbersOfParentVertices(position,coarseGridVertices,dimension-1);
    result.insert( left.begin(), left.end() );
    result.insert( right.begin(), right.end() );
    return result;
  }
}


template <typename Vertex>
std::set<int> swift2::getVertexNumbersOfParentVertices(
  const peano4::datamanagement::VertexMarker&       marker,
  peano4::datamanagement::VertexEnumerator<Vertex>  coarseGridVertices
) {
  return getVertexNumbersOfParentVertices(
    marker.getRelativePositionWithinFatherCell(),
    coarseGridVertices,
    Dimensions-1
  );
}
