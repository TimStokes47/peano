#include "exaparty/kernels/kernel_hydro.h"
#include "exaparty/kernels/equation_of_state.h"


template <typename ParticleContainer>
void exaparty::kernels::gravity::computeGravitationalForce(
  const ParticleContainer&   localParticles,
  const ParticleContainer&   activeParticles
) {
  for (auto* localParticle: localParticles ) {
    if ( not localParticle->getCellHasUpdatedParticle() ) {
      for (auto* activeParticle: activeParticles ) {

        #if Dimensions==2
        tarch::la::Vector<Dimensions,double> pos_sun = {benchmarks::exaparty::planetorbit::SUN_X_COORD,benchmarks::exaparty::planetorbit::SUN_Y_COORD};
        #else
        tarch::la::Vector<Dimensions,double> pos_sun = {benchmarks::exaparty::planetorbit::SUN_X_COORD,benchmarks::exaparty::planetorbit::SUN_Y_COORD,0.0};
        #endif

         /* G_NEWTON in internal units */
        double const L3 = benchmarks::exaparty::planetorbit::LENGTH_UNIT * benchmarks::exaparty::planetorbit::LENGTH_UNIT * benchmarks::exaparty::planetorbit::LENGTH_UNIT;
        double const T2 = benchmarks::exaparty::planetorbit::PERIOD * benchmarks::exaparty::planetorbit::PERIOD;
        double const GN = benchmarks::exaparty::planetorbit::G_NEWTON * benchmarks::exaparty::planetorbit::M_SUN * T2 / L3;

        tarch::la::Vector<Dimensions,double> earthSunDistance = localParticle->getX() - pos_sun;
        const double r = tarch::la::norm2(earthSunDistance);
        if (tarch::la::greater(r,0.0) ) {
          const double r_inv =  1.0 / r;     
          localParticle->setA( - GN * earthSunDistance * (r_inv * r_inv * r_inv) );

          /* Update Energy */
          const double vel = tarch::la::norm2( localParticle->getV() );
          const double E_kin = 0.5 * vel * vel;
          const double E_pot = - GN * r_inv;

          /* Update total energy (overall minus sign) */
          localParticle->setEnergyKin( E_kin );
          localParticle->setEnergyPot(-E_pot );
          localParticle->setEnergyTot( - ( E_kin + E_pot ) );
        }


      }
    }
  }
}

