#include "peano4/utils/Loop.h"

#include <bit>
#include <cstring>
#include <list>

inline auto __rdtscp() {
  unsigned long rax, rdx;
  unsigned long ecx;
  asm volatile ( "rdtscp\n" : "=a" (rax), "=d" (rdx), "=c" (ecx) : : );
  return (rdx << 32) + rax;
}


// ===============================
// Generic variants
// ===============================
template <auto ParticleOp, auto PredicateOp>
void exaparty::kernels::forAllParticles(
  const peano4::datamanagement::VertexMarker& marker,
  auto&                                       assignedParticles,
  int  numberOfCoalescedAssignedParticles,
  ::exaparty::kernels::kernelrealisation::GenericRealisation realisation
) {
  [[clang::soa_conversion]]
//#ifdef SOA_TIME
//  [[clang::soa_conversion_time("__rdtscp()")]]
//#endif
  for (auto* particle : assignedParticles) {
    if (PredicateOp(marker, *particle)) {
      ParticleOp(marker, *particle);
    }
  }
}


template <auto PairOperator, auto LocalPredicate, auto PairPredicate>
void exaparty::kernels::forAllParticlePairs(
  const exaparty::CellMetaData& cellMetaData,
  auto&                       localParticles,
  auto&                       activeParticles,
  ::exaparty::kernels::kernelrealisation::GenericRealisation                        realisation
) {
  int currentParticle = -1;
  [[clang::soa_conversion]]
//#ifdef SOA_TIME
//  [[clang::soa_conversion_time("__rdtscp()")]]
//#endif
  for (auto* localParticle : localParticles) {
    currentParticle++;
    assertion( currentParticle<cellMetaData.localParticleIsContainedInCell.size());
    if (LocalPredicate(
          cellMetaData.marker,
          cellMetaData.localParticleIsContainedInCell[currentParticle],
          *localParticle
        )) {
      bool evaluateMultiscaleRelations = false;

      [[clang::soa_conversion_simd]]
      [[clang::soa_conversion_hoist(1)]]
//#ifdef SOA_TIME
//      [[clang::soa_conversion_time("__rdtscp()")]]
//#endif
      for (auto* activeParticle : activeParticles) {
        if (PairPredicate(cellMetaData.marker, *localParticle, *activeParticle)) {
          PairOperator(cellMetaData.marker, *localParticle, *activeParticle);
          evaluateMultiscaleRelations |= tarch::la::oneGreater(
                (*activeParticle).getCellH(),
                (*localParticle).getCellH()
          );
        }
      }

      if (!evaluateMultiscaleRelations) continue;

      tarch::multicore::Lock lock(internal::_multiscaleInteractionSemaphore);
      for (auto* activeParticle : activeParticles) {
        if (tarch::la::oneGreater(
                (*activeParticle).getCellH(),
                (*localParticle).getCellH()
        )) {
            PairOperator(cellMetaData.marker, *activeParticle, *localParticle);
        }
      }
    }
  }
}


// ===============================
// Generic offloading variants
// ===============================
template <auto ParticleOp, auto PredicateOp>
void exaparty::kernels::forAllParticles(
  const peano4::datamanagement::VertexMarker& marker,
  auto&                                       assignedParticles,
  int numberOfCoalescedAssignedParticles,
  ::exaparty::kernels::kernelrealisation::GenericOffloadRealisation
) {
  [[clang:: soa_conversion]]
  [[clang:: soa_conversion_offload_compute]]
  [[clang::soa_conversion_offload_map("to: marker")]]
//#ifdef SOA_TIME
//  [[clang::soa_conversion_time("__rdtscp()")]]
//#endif
  for (auto* particle : assignedParticles) {
    if (PredicateOp(marker, *particle)) {
      ParticleOp(marker, *particle);
    }
  }
}


template <auto PairOperator, auto LocalPredicate, auto PairPredicate>
void exaparty::kernels::forAllParticlePairs(
  const exaparty::CellMetaData& cellMetaData,
  auto&                       localParticles,
  auto&                       activeParticles,
  ::exaparty::kernels::kernelrealisation::GenericOffloadRealisation
) {
    int currentParticle = -1;
//    bool evaluateMultiscaleRelations = false;

    auto marker = cellMetaData.marker;
    auto *localParticleIsContainedInCell = cellMetaData.localParticleIsContainedInCell.data();

  [[clang::soa_conversion]]
    [[clang::soa_conversion_offload_compute]]
    [[clang::soa_conversion_offload_map("to: marker", "to: localParticleIsContainedInCell[0:localParticles.size()]")]]
  for (auto* localParticle : localParticles) {
    currentParticle++;
    if (LocalPredicate(
          marker,
          localParticleIsContainedInCell[currentParticle],
          *localParticle
        )) {
      [[clang::soa_conversion]] [[clang::soa_conversion_hoist(1)]]
      for (auto* activeParticle : activeParticles) {
        if (PairPredicate(marker, *localParticle, *activeParticle)) {
          PairOperator(marker, *localParticle, *activeParticle);
//          evaluateMultiscaleRelations |= tarch::la::oneGreater(
//            (*activeParticle).getCellH(),
//            (*localParticle).getCellH()
//          );
        }
      }
    }

//    if (!evaluateMultiscaleRelations) continue;
//    tarch::multicore::Lock lock(internal::_multiscaleInteractionSemaphore);
//    for (auto* activeParticle : activeParticles) {
//        if (tarch::la::oneGreater(
//                (*activeParticle).getCellH(),
//                (*localParticle).getCellH()
//        )) {
//            PairOperator(cellMetaData.marker, *activeParticle, *localParticle);
//        }
//    }
  }
}


// ============================================
// Generic variants exploiting coalesced memory
// ============================================
template <auto ParticleOp, auto PredicateOp>
void exaparty::kernels::forAllParticles(
  const peano4::datamanagement::VertexMarker& marker,
  auto&                                       assignedParticles,
  int                                         numberOfAssignedParticles,
  ::exaparty::kernels::kernelrealisation::CoalescedMemoryRealisation realisation
) {
  auto* particles = assignedParticles.begin()[0];

  [[clang::soa_conversion_target("particles")]]
//#ifdef SOA_TIME
//  [[clang::soa_conversion_time("__rdtscp()")]]
//#endif
  for (int i = 0; i < numberOfAssignedParticles; i++) {
    if (PredicateOp(marker, particles[i])) {
      ParticleOp(marker, particles[i]);
    }
  }
}


template <auto ParticleOp, auto PredicateOp>
void exaparty::kernels::forAllParticles(
  const peano4::datamanagement::CellMarker& marker,
  auto&                                     localParticles,
  const std::vector<int>&                   numberOfLocalParticles,
  ::exaparty::kernels::kernelrealisation::CoalescedMemoryRealisation realisation
) {
  auto chunkStartIdx = 0;
  for (auto chunkSize: numberOfLocalParticles) {
    auto *localChunk = localParticles.begin()[chunkStartIdx];
    [[clang::soa_conversion_target("localChunk")]]
//#ifdef SOA_TIME
//    [[clang::soa_conversion_time("__rdtscp()")]]
//#endif
    for (int i = 0; i < chunkSize; i++) {
      if (PredicateOp(marker, localChunk[i])) {
        ParticleOp(marker, localChunk[i]);
      }
    }
    chunkStartIdx += chunkSize;
  }
}

template <
  auto ParticlePairOp,
  auto LocalPredicateOp,
  auto ParticlePairPredicateOp>
void forAllParticlePairsCoalescedLocalActiveChunk(
  const exaparty::CellMetaData& cellMetaData,
  auto * localParticles,
  auto localParticlesSize,
  auto * activeParticles,
  auto activeParticlesSize,
  const auto &localContainedBuf,
  auto localContainedBufOffset
) {


}

template <
  auto ParticlePairOp,
  auto LocalPredicateOp,
  auto ParticlePairPredicateOp>
void forAllParticlePairsCoalescedLocalActiveChunk_Offload(
  const exaparty::CellMetaData& cellMetaData,
  auto * localParticles,
  auto localParticlesSize,
  auto * activeParticles,
  auto activeParticlesSize,
  const auto &localContainedBuf,
  auto localContainedBufOffset
) {
  auto marker = cellMetaData.marker;
  auto *localParticleIsContainedInCell = localContainedBuf.data() + localContainedBufOffset;

  [[clang::soa_conversion_offload_compute]]
  [[clang::soa_conversion_target("localParticles")]]
  [[clang::soa_conversion_offload_map("to: marker", "to: localParticleIsContainedInCell[0:localParticlesSize]")]]
  for (int lId = 0; lId < localParticlesSize; lId++) {
    if (!LocalPredicateOp(marker, localParticleIsContainedInCell[lId], localParticles[lId]))
      [[unlikely]] continue;

    [[clang::soa_conversion_hoist(1)]]
    [[clang::soa_conversion_target("activeParticles")]]
    for (int aId = 0; aId < activeParticlesSize; aId++) {
      if (!ParticlePairPredicateOp(marker, localParticles[lId], activeParticles[aId]))
        [[unlikely]] continue;

      ParticlePairOp(
        marker,
        localParticles[lId],
        activeParticles[aId]
      );
    }
  }
}

template <
  auto ParticlePairOp,
  auto LocalPredicateOp,
  auto ParticlePairPredicateOp>
void forAllParticlePairsCoalescedLocalActiveChunk_EvaluatePredicatesInPrologue(
  const exaparty::CellMetaData& cellMetaData,
  auto * localParticles,
  auto localParticlesSize,
  auto * activeParticles,
  auto activeParticlesSize,
  const auto &localContainedBuf,
  auto localContainedBufOffset
) {
  [[clang::soa_conversion_target("localParticles")]]
  for (int lId = 0; lId < localParticlesSize; lId++) {
    if (!LocalPredicateOp(cellMetaData.marker, localContainedBuf[localContainedBufOffset + lId], localParticles[lId]))
      [[unlikely]] continue;

    bool predicates[activeParticlesSize];

    [[clang::soa_conversion_hoist(1)]]
    [[clang::soa_conversion_simd]]
    [[clang::soa_conversion_target("activeParticles")]]
    for (int aId = 0; aId < activeParticlesSize; aId++) {
      predicates[aId] = ParticlePairPredicateOp(cellMetaData.marker, localParticles[lId], activeParticles[aId]);
    }

    [[clang::soa_conversion_hoist(1)]]
    [[clang::soa_conversion_simd]]
    [[clang::soa_conversion_target("activeParticles")]]
    for (int aId = 0; aId < activeParticlesSize; aId++) {
      if (!predicates[aId]) [[unlikely]] continue;

      ParticlePairOp(
        cellMetaData.marker,
        localParticles[lId],
        activeParticles[aId]
      );
    }
  }
}

template <
  auto ParticlePairOp,
  auto LocalPredicateOp,
  auto ParticlePairPredicateOp>
void forAllParticlePairsCoalescedActiveLocalChunk(
  const exaparty::CellMetaData& cellMetaData,
  auto *localParticles,
  auto localParticlesSize,
  auto *activeParticles,
  auto activeParticlesSize,
  const auto &localContainedBuf,
  auto localContainedBufOffset
) {
  [[clang::soa_conversion_target("activeParticles")]]
//#ifdef SOA_TIME
//  [[clang::soa_conversion_time("__rdtscp()")]]
//#endif
  for (int aId = 0; aId < activeParticlesSize; aId++) {

    [[clang::soa_conversion_hoist(1)]]
    [[clang::soa_conversion_simd]]
    [[clang::soa_conversion_target("localParticles")]]
//#ifdef SOA_TIME
//    [[clang::soa_conversion_time("__rdtscp()")]]
//#endif
    for (int lId = 0; lId < localParticlesSize; lId++) {
      auto localPredicateVal = LocalPredicateOp(cellMetaData.marker, localContainedBuf[localContainedBufOffset + lId], localParticles[lId]);
      auto pairPredicateVal = ParticlePairPredicateOp(cellMetaData.marker, localParticles[lId], activeParticles[aId]);
      if (!(localPredicateVal && pairPredicateVal)) [[unlikely]] continue;

      ParticlePairOp(
        cellMetaData.marker,
        localParticles[lId],
        activeParticles[aId]
      );
    }
  }
}

template <
  auto ParticlePairOp,
  auto LocalPredicateOp,
  auto ParticlePairPredicateOp>
void forAllParticlePairsCoalescedActiveLocalChunk_Offload(
  const exaparty::CellMetaData& cellMetaData,
  auto *localParticles,
  auto localParticlesSize,
  auto *activeParticles,
  auto activeParticlesSize,
  const auto &localContainedBuf,
  auto localContainedBufOffset
) {
  auto marker = cellMetaData.marker;
  auto *localParticleIsContainedInCell = localContainedBuf.data() + localContainedBufOffset;

  [[clang::soa_conversion_offload_compute]]
  [[clang::soa_conversion_target("activeParticles")]]
  [[clang::soa_conversion_offload_map("to: marker", "to: localParticleIsContainedInCell[0:localParticlesSize]")]]
  for (int aId = 0; aId < activeParticlesSize; aId++) {

    [[clang::soa_conversion_hoist(1)]]
    [[clang::soa_conversion_target("localParticles")]]
    for (int lId = 0; lId < localParticlesSize; lId++) {
      auto localPredicateVal = LocalPredicateOp(marker, localParticleIsContainedInCell[lId], localParticles[lId]);
      auto pairPredicateVal = ParticlePairPredicateOp(marker, localParticles[lId], activeParticles[aId]);
      if (!(localPredicateVal && pairPredicateVal)) [[unlikely]] continue;

      ParticlePairOp(
        marker,
        localParticles[lId],
        activeParticles[aId]
      );
    }
  }
}

template <
  auto ParticlePairOp,
  auto LocalPredicateOp,
  auto ParticlePairPredicateOp>
void forAllParticlePairsCoalescedActiveLocalChunk_EvaluatePredicatesInPrologue(
  const exaparty::CellMetaData& cellMetaData,
  auto *localParticles,
  auto localParticlesSize,
  auto *activeParticles,
  auto activeParticlesSize,
  const auto &localContainedBuf,
  auto localContainedBufOffset
) {
  bool localPredicates[localParticlesSize];

  [[clang::soa_conversion_simd]]
  [[clang::soa_conversion_target("localParticles")]]
  for (int lId = 0; lId < localParticlesSize; lId++) {
    auto localPredicateVal = LocalPredicateOp(cellMetaData.marker, localContainedBuf[localContainedBufOffset + lId], localParticles[lId]);
    localPredicates[lId] = localPredicateVal;
  }

  [[clang::soa_conversion_target("activeParticles")]]
  for (int aId = 0; aId < activeParticlesSize; aId++) {
    bool pairPredicates[localParticlesSize];

    [[clang::soa_conversion_hoist(1)]]
    [[clang::soa_conversion_simd]]
    [[clang::soa_conversion_target("localParticles")]]
    for (int lId = 0; lId < localParticlesSize; lId++) {
      auto pairPredicateVal = ParticlePairPredicateOp(cellMetaData.marker, localParticles[lId], activeParticles[aId]);
      pairPredicates[lId] = pairPredicateVal;
    }

    [[clang::soa_conversion_hoist(1)]]
    [[clang::soa_conversion_simd]]
    [[clang::soa_conversion_target("localParticles")]]
    for (int lId = 0; lId < localParticlesSize; lId++) {

      if (!(localPredicates[lId] && pairPredicates[lId])) [[unlikely]] continue;

      ParticlePairOp(
        cellMetaData.marker,
        localParticles[lId],
        activeParticles[aId]
      );
    }
  }
}

template <
  auto ParticlePairOp,
  auto LocalPredicateOp,
  auto ParticlePairPredicateOp>
void exaparty::kernels::forAllParticlePairs(
  const exaparty::CellMetaData& cellMetaData,
  auto&                       localParticles,
  auto&                       activeParticles,
  ::exaparty::kernels::kernelrealisation::CoalescedMemoryActiveLocalRealisation
    realisation
) {

  int activeChunkIdx = 0;
  for (auto& activeChunkSize : cellMetaData.numberOfCoalescedActiveParticlesPerVertex) {
    auto *activeChunk = activeParticles.begin()[activeChunkIdx];

    int localChunkIdx = 0;
    for (auto& localChunkSize : cellMetaData.numberOfCoalescedLocalParticlesPerVertex) {
      auto *localChunk = localParticles.begin()[localChunkIdx];

      forAllParticlePairsCoalescedActiveLocalChunk<
        ParticlePairOp,
        LocalPredicateOp,
        ParticlePairPredicateOp
        >(cellMetaData, localChunk, localChunkSize, activeChunk, activeChunkSize, cellMetaData.localParticleIsContainedInCell, localChunkIdx);

      localChunkIdx += localChunkSize;
    }

    activeChunkIdx += activeChunkSize;
  }
}


template <
  auto ParticlePairOp,
  auto LocalPredicateOp,
  auto ParticlePairPredicateOp>
void exaparty::kernels::forAllParticlePairs(
  const exaparty::CellMetaData& cellMetaData,
  auto&                       localParticleZ,
  auto&                       activeParticleZ,
  ::exaparty::kernels::kernelrealisation::CoalescedMemoryLocalActiveRealisation
    realisation
) {
  int localChunkIdx = 0;
  for (auto& localChunkSize : cellMetaData.numberOfCoalescedLocalParticlesPerVertex) {
    auto *localChunk = localParticleZ.begin()[localChunkIdx];

    int activeChunkIdx = 0;
    for (auto& activeChunkSize : cellMetaData.numberOfCoalescedActiveParticlesPerVertex) {
      auto *activeChunk = activeParticleZ.begin()[activeChunkIdx];

      auto *localParticles = localChunk;
      auto localParticlesSize = localChunkSize;
      auto *activeParticles = activeChunk;
      auto activeParticlesSize = activeChunkSize;
      auto &localContainedBuf = cellMetaData.localParticleIsContainedInCell;
      auto localContainedBufOffset = localChunkIdx;

//      [[clang::soa_conversion_time("__rdtscp()")]]
      [[clang::soa_conversion_target("localParticles")]]
      for (int lId = 0; lId < localParticlesSize; lId++) {
        if (!LocalPredicateOp(cellMetaData.marker, localContainedBuf[localContainedBufOffset + lId], localParticles[lId]))
          [[unlikely]] continue;

        [[clang::soa_conversion_hoist(1)]]
        [[clang::soa_conversion_simd]]
        [[clang::soa_conversion_target("activeParticles")]]
        for (int aId = 0; aId < activeParticlesSize; aId++) {
          if (!ParticlePairPredicateOp(cellMetaData.marker, localParticles[lId], activeParticles[aId]))
            [[unlikely]] continue;

          ParticlePairOp(
            cellMetaData.marker,
            localParticles[lId],
            activeParticles[aId]
          );
        }
      }

      activeChunkIdx += activeChunkSize;
    }

    localChunkIdx += localChunkSize;
  }
}

// ============================================
// Generic offload variants exploiting coalesced memory
// ============================================
template <auto ParticleOp, auto PredicateOp>
void exaparty::kernels::forAllParticles(
  const peano4::datamanagement::VertexMarker& marker,
  auto&                                       assignedParticles,
  int                                         numberOfAssignedParticles,
  ::exaparty::kernels::kernelrealisation::CoalescedMemoryOffloadRealisation realisation
) {
  auto* particles = assignedParticles.begin()[0];

  [[clang::soa_conversion_offload_compute]]
  [[clang::soa_conversion_target("particles")]]
  [[clang::soa_conversion_offload_map("to: marker")]]
#ifdef SOA_TIME
  [[clang::soa_conversion_time("__rdtscp()")]]
#endif
  for (int i = 0; i < numberOfAssignedParticles; i++) {
    if (PredicateOp(marker, particles[i])) {
      ParticleOp(marker, particles[i]);
    }
  }
}


template <auto ParticleOp, auto PredicateOp>
void exaparty::kernels::forAllParticles(
  const peano4::datamanagement::CellMarker& marker,
  auto&                                     localParticles,
  const std::vector<int>&                   numberOfLocalParticles,
  ::exaparty::kernels::kernelrealisation::CoalescedMemoryOffloadRealisation realisation
) {
  auto chunkStartIdx = 0;
  for (auto chunkSize: numberOfLocalParticles) {
    auto *localChunk = localParticles.begin()[chunkStartIdx];

    [[clang::soa_conversion_offload_compute]]
    [[clang::soa_conversion_target("localChunk")]]
    [[clang::soa_conversion_offload_map("to: marker")]]
//#ifdef SOA_TIME
//    [[clang::soa_conversion_time("__rdtscp()")]]
//#endif
    for (int i = 0; i < chunkSize; i++) {
      if (PredicateOp(marker, localChunk[i])) {
        ParticleOp(marker, localChunk[i]);
      }
    }
    chunkStartIdx += chunkSize;
  }
}

template <
  auto ParticlePairOp,
  auto LocalPredicateOp,
  auto ParticlePairPredicateOp>
void exaparty::kernels::forAllParticlePairs(
  const exaparty::CellMetaData& cellMetaData,
  auto&                       localParticles,
  auto&                       activeParticles,
  ::exaparty::kernels::kernelrealisation::CoalescedMemoryActiveLocalOffloadRealisation
    realisation
) {

  int activeChunkIdx = 0;
  for (auto& activeChunkSize : cellMetaData.numberOfCoalescedActiveParticlesPerVertex) {
    auto *activeChunk = activeParticles.begin()[activeChunkIdx];

    int localChunkIdx = 0;
    for (auto& localChunkSize : cellMetaData.numberOfCoalescedLocalParticlesPerVertex) {
      auto *localChunk = localParticles.begin()[localChunkIdx];

      forAllParticlePairsCoalescedActiveLocalChunk_Offload<
        ParticlePairOp,
        LocalPredicateOp,
        ParticlePairPredicateOp
        >(cellMetaData, localChunk, localChunkSize, activeChunk, activeChunkSize, cellMetaData.localParticleIsContainedInCell, localChunkIdx);

      localChunkIdx += localChunkSize;
    }

    activeChunkIdx += activeChunkSize;
  }
}


template <
  auto ParticlePairOp,
  auto LocalPredicateOp,
  auto ParticlePairPredicateOp>
void exaparty::kernels::forAllParticlePairs(
  const exaparty::CellMetaData& cellMetaData,
  auto&                       localParticles,
  auto&                       activeParticles,
  ::exaparty::kernels::kernelrealisation::CoalescedMemoryLocalActiveOffloadRealisation
    realisation
) {
  int localChunkIdx = 0;
  for (auto& localChunkSize : cellMetaData.numberOfCoalescedLocalParticlesPerVertex) {
    auto *localChunk = localParticles.begin()[localChunkIdx];

    int activeChunkIdx = 0;
    for (auto& activeChunkSize : cellMetaData.numberOfCoalescedActiveParticlesPerVertex) {
      auto *activeChunk = activeParticles.begin()[activeChunkIdx];

      forAllParticlePairsCoalescedLocalActiveChunk_Offload<
        ParticlePairOp,
        LocalPredicateOp,
        ParticlePairPredicateOp
        >(cellMetaData, localChunk, localChunkSize, activeChunk, activeChunkSize, cellMetaData.localParticleIsContainedInCell, localChunkIdx);

      activeChunkIdx += activeChunkSize;
    }

    localChunkIdx += localChunkSize;
  }
}

// ============================================
// Generic variants exploiting coalesced memory which moves the checks out into
// an explicit preamble.
// ============================================
template <auto ParticleOp, auto PredicateOp>
void exaparty::kernels::forAllParticles(
  const peano4::datamanagement::VertexMarker& marker,
  auto&                                       assignedParticles,
  int numberOfCoalescedAssignedParticles,
  ::exaparty::kernels::kernelrealisation::EvaluatePredicateInPrologueRealisation
) {
  auto* particles  = *assignedParticles.begin();
  bool predicates[numberOfCoalescedAssignedParticles];

  [[clang::soa_conversion_target("particles")]]
  for (int i = 0; i < numberOfCoalescedAssignedParticles; i++) {
    predicates[i] = PredicateOp(marker, particles[i]);
  }

  [[clang::soa_conversion_target("particles")]]
  for (int i = 0; i < numberOfCoalescedAssignedParticles; i++) {
    if (predicates[i]) {
      ParticleOp(marker, particles[i]);
    }
  }
}


template <auto ParticleOp, auto PredicateOp>
void exaparty::kernels::forAllParticles(
  const peano4::datamanagement::CellMarker& marker,
  auto&                                     assignedParticles,
  const std::vector<int>&                   numberOfCoalescedLocalParticles,
  ::exaparty::kernels::kernelrealisation::EvaluatePredicateInPrologueRealisation
) {
  bool predicates[assignedParticles.size()];

  auto chunkStartIdx = 0;
  for (auto chunkSize: numberOfCoalescedLocalParticles) {
    auto *localChunk = assignedParticles[chunkStartIdx];
    for (int i = 0; i < chunkSize; i++) {
      predicates[i] = PredicateOp(marker, localChunk[i]);
    }
    chunkStartIdx += chunkSize;
  }

  chunkStartIdx = 0;
  for (auto chunkSize : numberOfCoalescedLocalParticles) {
    auto *localChunk = assignedParticles[chunkStartIdx];
    for (int i = 0; i < chunkSize; i++) {
      if (predicates[i]) {
        ParticleOp(marker, localChunk[i]);
      }
    }
      chunkStartIdx += chunkSize;
  }
}

template <
  auto ParticlePairOp,
  auto LocalPredicateOp,
  auto ParticlePairPredicateOp>
void exaparty::kernels::forAllParticlePairs(
  const exaparty::CellMetaData& cellMetaData,
  auto&                       localParticles,
  auto&                       activeParticles,
  ::exaparty::kernels::kernelrealisation::EvaluatePredicateInPrologueActiveLocalRealisation
    realisation
) {

  int activeChunkIdx = 0;
  for (auto& activeChunkSize : cellMetaData.numberOfCoalescedActiveParticlesPerVertex) {
    auto *activeChunk = activeParticles.begin()[activeChunkIdx];

    int localChunkIdx = 0;
    for (auto& localChunkSize : cellMetaData.numberOfCoalescedLocalParticlesPerVertex) {
      auto *localChunk = localParticles.begin()[localChunkIdx];

      forAllParticlePairsCoalescedActiveLocalChunk_EvaluatePredicatesInPrologue<
        ParticlePairOp,
        LocalPredicateOp,
        ParticlePairPredicateOp
        >(cellMetaData, localChunk, localChunkSize, activeChunk, activeChunkSize, cellMetaData.localParticleIsContainedInCell, localChunkIdx);

      localChunkIdx += localChunkSize;
    }

    activeChunkIdx += activeChunkSize;
  }
}


template <
  auto ParticlePairOp,
  auto LocalPredicateOp,
  auto ParticlePairPredicateOp>
void exaparty::kernels::forAllParticlePairs(
  const exaparty::CellMetaData& cellMetaData,
  auto&                       localParticles,
  auto&                       activeParticles,
  ::exaparty::kernels::kernelrealisation::EvaluatePredicateInPrologueLocalActiveRealisation
    realisation
) {
  int localChunkIdx = 0;
  for (auto& localChunkSize : cellMetaData.numberOfCoalescedLocalParticlesPerVertex) {
    auto *localChunk = localParticles.begin()[localChunkIdx];

    int activeChunkIdx = 0;
    for (auto& activeChunkSize : cellMetaData.numberOfCoalescedActiveParticlesPerVertex) {
      auto *activeChunk = activeParticles.begin()[activeChunkIdx];

      forAllParticlePairsCoalescedLocalActiveChunk_EvaluatePredicatesInPrologue<
        ParticlePairOp,
        LocalPredicateOp,
        ParticlePairPredicateOp
        >(cellMetaData, localChunk, localChunkSize, activeChunk, activeChunkSize, cellMetaData.localParticleIsContainedInCell, localChunkIdx);

      activeChunkIdx += activeChunkSize;
    }

    localChunkIdx += localChunkSize;
  }
}



// ====================================
// Helper functions
// ====================================
template <int SubChunkSize, typename LocalParticle, typename ActiveParticle>
std::pair<std::bitset<SubChunkSize>, std::bitset<SubChunkSize>> exaparty::
  kernels::internal::identifyInteractingParticlesFixedLocalParticle(
    const peano4::datamanagement::CellMarker& marker,
    LocalParticle*                            localParticle,
    ActiveParticle*                           firstActiveParticleInSubchunk,
    int                                       thisSubchunkSize,
    UpdateParticlePairWithinCellPredicate<LocalParticle> particlePairPredicate
  ) {
  std::bitset<SubChunkSize> updateParticleEffect(0);
  std::bitset<SubChunkSize> evaluateBottomUpParticleEffect(0);

  for (int particleIndexWithinThisSubchunk = 0;
       particleIndexWithinThisSubchunk < thisSubchunkSize;
       particleIndexWithinThisSubchunk++) {
    ActiveParticle* subChunkParticle = firstActiveParticleInSubchunk
                                       + particleIndexWithinThisSubchunk;

    updateParticleEffect[particleIndexWithinThisSubchunk] = particlePairPredicate(
      marker,
      *localParticle,
      *subChunkParticle
    );
    evaluateBottomUpParticleEffect[particleIndexWithinThisSubchunk]
      = not tarch::la::
          equals(subChunkParticle->getCellH(), localParticle->getCellH());
  }

  return {updateParticleEffect, evaluateBottomUpParticleEffect};
}


template <int SubChunkSize, typename LocalParticle, typename ActiveParticle>
std::pair<std::bitset<SubChunkSize>, std::bitset<SubChunkSize>> exaparty::
  kernels::internal::identifyInteractingParticlesFixedActiveParticle(
    const peano4::datamanagement::CellMarker& marker,
    LocalParticle*                            firstLocalParticleInSubchunk,
    int                                       thisSubchunkSize,
    ActiveParticle*                           activeParticle,
    UpdateParticlePairWithinCellPredicate<LocalParticle> particlePairPredicate
  ) {
  std::bitset<SubChunkSize> updateParticleEffect(0);
  std::bitset<SubChunkSize> evaluateBottomUpParticleEffect(0);

  for (int particleIndexWithinThisSubchunk = 0;
       particleIndexWithinThisSubchunk < thisSubchunkSize;
       particleIndexWithinThisSubchunk++) {
    LocalParticle* subChunkParticle = firstLocalParticleInSubchunk
                                      + particleIndexWithinThisSubchunk;

    updateParticleEffect[particleIndexWithinThisSubchunk] = particlePairPredicate(
      marker,
      *subChunkParticle,
      *activeParticle
    );
    evaluateBottomUpParticleEffect[particleIndexWithinThisSubchunk]
      = not tarch::la::
          equals(subChunkParticle->getCellH(), activeParticle->getCellH());
  }

  return {updateParticleEffect, evaluateBottomUpParticleEffect};
}
