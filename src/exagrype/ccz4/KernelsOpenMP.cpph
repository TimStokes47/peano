    const double Ghat_2 = Q[15];
  
    double Z_0 = 0.5 * CCZ4ds * g_cov_00 * (Ghat_0 - Gtilde_0) + 0.5 * CCZ4ds * g_cov_01 * (Ghat_1 - Gtilde_1) + 0.5 * CCZ4ds * g_cov_02 * (Ghat_2 - Gtilde_2);
