    RicciPlusNablaZSrc_00 -= (np + 1.0) * g_cov_00 * g_contr_11 * PP_1 * PP_1 / (np * np * chi * chi);
    RicciPlusNablaZSrc_00 += g_contr_10 * ( Christoffel_tilde_101 * Christoffel_tilde_down_010 + Christoffel_tilde_101 * Christoffel_tilde_down_010 + Christoffel_tilde_001 * Christoffel_tilde_down_110 ) - g_cov_00 * g_contr_10 * Christoffel_tilde_101 * PP_1 / (np*chi);
    RicciPlusNablaZSrc_00 += g_contr_11 * ( Christoffel_tilde_101 * Christoffel_tilde_down_011 + Christoffel_tilde_101 * Christoffel_tilde_down_011 + Christoffel_tilde_011 * Christoffel_tilde_down_110 ) - g_cov_00 * g_contr_11 * Christoffel_tilde_111 * PP_1 / (np*chi);
    RicciPlusNablaZSrc_00 += g_contr_12 * ( Christoffel_tilde_101 * Christoffel_tilde_down_012 + Christoffel_tilde_101 * Christoffel_tilde_down_012 + Christoffel_tilde_021 * Christoffel_tilde_down_110 ) - g_cov_00 * g_contr_12 * Christoffel_tilde_121 * PP_1 / (np*chi);
