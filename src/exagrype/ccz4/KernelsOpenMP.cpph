    RicciPlusNablaZSrc_00 += g_contr_21 * ( Christoffel_tilde_201 * Christoffel_tilde_down_011 + Christoffel_tilde_201 * Christoffel_tilde_down_011 + Christoffel_tilde_011 * Christoffel_tilde_down_120 ) - g_cov_00 * g_contr_21 * Christoffel_tilde_211 * PP_1 / (np*chi);
