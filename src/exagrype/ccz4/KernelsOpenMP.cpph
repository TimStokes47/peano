    double RicciPlusNablaZSrc_00 = - (np - 1.0) * PP_0 * PP_0 / (np * np * chi * chi);
    RicciPlusNablaZSrc_00 += Ghat_0 * DD_000 - PP_0 * Christoffel_tilde_000 / (np * chi) + 2.0 * Zup_0 / (np*chi*phi2) * (g_cov_00 * PP_0 + g_cov_00 * PP_0 - g_cov_00 * PP_0);
    RicciPlusNablaZSrc_00 -= (np + 1.0) * g_cov_00 * g_contr_00 * PP_0 * PP_0 / (np * np * chi * chi);
