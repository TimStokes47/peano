               BB_12 * DD_211 + BB_12 * DD_121 + BB_12 * DD_121 - 2./3. * BB_22 * DD_111;
    dtD_112 -= AA_1 * Aex_12;
    dtD_112 += BB_10 * DD_012 + BB_20 * DD_101 + BB_10 * DD_102 - 2./3. * BB_00 * DD_112 +
               BB_11 * DD_112 + BB_21 * DD_111 + BB_11 * DD_112 - 2./3. * BB_11 * DD_112 +
               BB_12 * DD_212 + BB_22 * DD_121 + BB_12 * DD_122 - 2./3. * BB_22 * DD_112;
    dtD_120 -= AA_1 * Aex_20;
    dtD_120 += BB_10 * DD_020 + BB_00 * DD_102 + BB_20 * DD_100 - 2./3. * BB_00 * DD_120 +
               BB_11 * DD_120 + BB_01 * DD_112 + BB_21 * DD_110 - 2./3. * BB_11 * DD_120 +
               BB_12 * DD_220 + BB_02 * DD_122 + BB_22 * DD_120 - 2./3. * BB_22 * DD_120;
    dtD_121 -= AA_1 * Aex_21;
    dtD_121 += BB_10 * DD_021 + BB_10 * DD_102 + BB_20 * DD_101 - 2./3. * BB_00 * DD_121 +
               BB_11 * DD_121 + BB_11 * DD_112 + BB_21 * DD_111 - 2./3. * BB_11 * DD_121 +
               BB_12 * DD_221 + BB_12 * DD_122 + BB_22 * DD_121 - 2./3. * BB_22 * DD_121;
    dtD_122 -= AA_1 * Aex_22;
    dtD_122 += BB_10 * DD_022 + BB_20 * DD_102 + BB_20 * DD_102 - 2./3. * BB_00 * DD_122 +
               BB_11 * DD_122 + BB_21 * DD_112 + BB_21 * DD_112 - 2./3. * BB_11 * DD_122 +
               BB_12 * DD_222 + BB_22 * DD_122 + BB_22 * DD_122 - 2./3. * BB_22 * DD_122;

    dtD_200 -= AA_2 * Aex_00;
    dtD_200 += BB_20 * DD_000 + BB_00 * DD_200 + BB_00 * DD_200 - 2./3. * BB_00 * DD_200 +
               BB_21 * DD_100 + BB_01 * DD_210 + BB_01 * DD_210 - 2./3. * BB_11 * DD_200 +
               BB_22 * DD_200 + BB_02 * DD_220 + BB_02 * DD_220 - 2./3. * BB_22 * DD_200;
    dtD_201 -= AA_2 * Aex_01;
    dtD_201 += BB_20 * DD_001 + BB_10 * DD_200 + BB_00 * DD_201 - 2./3. * BB_00 * DD_201 +
               BB_21 * DD_101 + BB_11 * DD_210 + BB_01 * DD_211 - 2./3. * BB_11 * DD_201 +
               BB_22 * DD_201 + BB_12 * DD_220 + BB_02 * DD_221 - 2./3. * BB_22 * DD_201;
    dtD_202 -= AA_2 * Aex_02;
    dtD_202 += BB_20 * DD_002 + BB_20 * DD_200 + BB_00 * DD_202 - 2./3. * BB_00 * DD_202 +
               BB_21 * DD_102 + BB_21 * DD_210 + BB_01 * DD_212 - 2./3. * BB_11 * DD_202 +
               BB_22 * DD_202 + BB_22 * DD_220 + BB_02 * DD_222 - 2./3. * BB_22 * DD_202;
    dtD_210 -= AA_2 * Aex_10;
    dtD_210 += BB_20 * DD_010 + BB_00 * DD_201 + BB_10 * DD_200 - 2./3. * BB_00 * DD_210 +
               BB_21 * DD_110 + BB_01 * DD_211 + BB_11 * DD_210 - 2./3. * BB_11 * DD_210 +
               BB_22 * DD_210 + BB_02 * DD_221 + BB_12 * DD_220 - 2./3. * BB_22 * DD_210;
    dtD_211 -= AA_2 * Aex_11;
    dtD_211 += BB_20 * DD_011 + BB_10 * DD_201 + BB_10 * DD_201 - 2./3. * BB_00 * DD_211 +
               BB_21 * DD_111 + BB_11 * DD_211 + BB_11 * DD_211 - 2./3. * BB_11 * DD_211 +
               BB_22 * DD_211 + BB_12 * DD_221 + BB_12 * DD_221 - 2./3. * BB_22 * DD_211;
    dtD_212 -= AA_2 * Aex_12;
    dtD_212 += BB_20 * DD_012 + BB_20 * DD_201 + BB_10 * DD_202 - 2./3. * BB_00 * DD_212 +
               BB_21 * DD_112 + BB_21 * DD_211 + BB_11 * DD_212 - 2./3. * BB_11 * DD_212 +
               BB_22 * DD_212 + BB_22 * DD_221 + BB_12 * DD_222 - 2./3. * BB_22 * DD_212;
    dtD_220 -= AA_2 * Aex_20;
    dtD_220 += BB_20 * DD_020 + BB_00 * DD_202 + BB_20 * DD_200 - 2./3. * BB_00 * DD_220 +
               BB_21 * DD_120 + BB_01 * DD_212 + BB_21 * DD_210 - 2./3. * BB_11 * DD_220 +
               BB_22 * DD_220 + BB_02 * DD_222 + BB_22 * DD_220 - 2./3. * BB_22 * DD_220;
    dtD_221 -= AA_2 * Aex_21;
    dtD_221 += BB_20 * DD_021 + BB_10 * DD_202 + BB_20 * DD_201 - 2./3. * BB_00 * DD_221 +
               BB_21 * DD_121 + BB_11 * DD_212 + BB_21 * DD_211 - 2./3. * BB_11 * DD_221 +
               BB_22 * DD_221 + BB_12 * DD_222 + BB_22 * DD_221 - 2./3. * BB_22 * DD_221;
    dtD_222 -= AA_2 * Aex_22;
    dtD_222 += BB_20 * DD_022 + BB_20 * DD_202 + BB_20 * DD_202 - 2./3. * BB_00 * DD_222 +
               BB_21 * DD_122 + BB_21 * DD_212 + BB_21 * DD_212 - 2./3. * BB_11 * DD_222 +
               BB_22 * DD_222 + BB_22 * DD_222 + BB_22 * DD_222 - 2./3. * BB_22 * DD_222;

    double dtP_0 = BB_00 * PP_0 + BB_01 * PP_1 + BB_02 * PP_2;
    double dtP_1 = BB_10 * PP_0 + BB_11 * PP_1 + BB_12 * PP_2;
    double dtP_2 = BB_20 * PP_0 + BB_21 * PP_1 + BB_22 * PP_2;

    temp = dgup_000 * Aex_00 + dgup_001 * Aex_01 + dgup_002 * Aex_02 + 
           dgup_010 * Aex_10 + dgup_011 * Aex_11 + dgup_012 * Aex_12 + 
           dgup_020 * Aex_20 + dgup_021 * Aex_21 + dgup_022 * Aex_22;
    dtP_0 += np / 3. * AA_0 * traceK * chi;
    dtP_0 += np / 3. * (alpha * traceK - traceB) * PP_0;
    dtP_0 += np / 3. * CCZ4helper * alpha * CCZ4sk * temp * chi;

    temp = dgup_100 * Aex_00 + dgup_101 * Aex_01 + dgup_102 * Aex_02 + 
           dgup_110 * Aex_10 + dgup_111 * Aex_11 + dgup_112 * Aex_12 + 
           dgup_120 * Aex_20 + dgup_121 * Aex_21 + dgup_122 * Aex_22;
    dtP_1 += np / 3. * AA_1 * traceK * chi;
    dtP_1 += np / 3. * (alpha * traceK - traceB) * PP_1;
    dtP_1 += np / 3. * CCZ4helper * alpha * CCZ4sk * temp * chi;

    temp = dgup_200 * Aex_00 + dgup_201 * Aex_01 + dgup_202 * Aex_02 + 
           dgup_210 * Aex_10 + dgup_211 * Aex_11 + dgup_212 * Aex_12 + 
           dgup_220 * Aex_20 + dgup_221 * Aex_21 + dgup_222 * Aex_22;
    dtP_2 += np / 3. * AA_2 * traceK * chi;
    dtP_2 += np / 3. * (alpha * traceK - traceB) * PP_2;
    dtP_2 += np / 3. * CCZ4helper * alpha * CCZ4sk * temp * chi;

    S[0]  = dtgamma_00;
    S[1]  = dtgamma_01;
    S[2]  = dtgamma_02;
    S[3]  = dtgamma_11;
    S[4]  = dtgamma_12;
    S[5]  = dtgamma_22;
    S[6]  = dtK_00;
    S[7]  = dtK_01;
    S[8]  = dtK_02;
    S[9]  = dtK_11;
    S[10] = dtK_12;
    S[11] = dtK_22;
    //S[12] = 0.0;
    S[12] = dtTheta;
    S[13] = dtGhat_0;
    S[14] = dtGhat_1;
    S[15] = dtGhat_2;
    S[16] = dtalpha;
    S[17] = dtbeta_0;
    S[18] = dtbeta_1;
    S[19] = dtbeta_2;
    S[20] = dtbb_0;
    S[21] = dtbb_1;
    S[22] = dtbb_2;
    S[23] = dtA_0;
    S[24] = dtA_1;
    S[25] = dtA_2;
    S[26] = dtB_00;
    S[27] = dtB_01;
    S[28] = dtB_02;
    S[29] = dtB_10;
    S[30] = dtB_11;
    S[31] = dtB_12;
    S[32] = dtB_20;
    S[33] = dtB_21;
    S[34] = dtB_22;
    S[35] = dtD_000;
    S[36] = dtD_001;
    S[37] = dtD_002;
    S[38] = dtD_011;
    S[39] = dtD_012;
    S[40] = dtD_022;
    S[41] = dtD_100;
    S[42] = dtD_101;
    S[43] = dtD_102;
    S[44] = dtD_111;
    S[45] = dtD_112;
    S[46] = dtD_122;
    S[47] = dtD_200;
    S[48] = dtD_201;
    S[49] = dtD_202;
    S[50] = dtD_211;
    S[51] = dtD_212;
    S[52] = dtD_222;
    S[53] = dtTraceK;
    S[54] = dtchi;
    S[55] = dtP_0;
    S[56] = dtP_1;
    S[57] = dtP_2;
    S[58] = 0;
    //used only in soccz4
    if (CCZ4SO==1){
        for (int i = 23; i < 53; i++) S[i] = 0.0;
        for (int i = 0; i < 3; i++) S[55+i] = 0.0;
    }
}


