    const double chi = pow(phi,np); 				// Baojiu-13-06-23: new change of variable

    const double PP_0 = Q[55];
    const double PP_1 = Q[56]; 
    const double PP_2 = Q[57];

    double Christoffel_tilde_000 = g_contr_00 * (DD_000 + DD_000 - DD_000) + g_contr_01 * (DD_001 + DD_001 - DD_100) + g_contr_02 * (DD_002 + DD_002 - DD_200);
    double Christoffel_tilde_001 = g_contr_10 * (DD_000 + DD_000 - DD_000) + g_contr_11 * (DD_001 + DD_001 - DD_100) + g_contr_12 * (DD_002 + DD_002 - DD_200);
    double Christoffel_tilde_002 = g_contr_20 * (DD_000 + DD_000 - DD_000) + g_contr_21 * (DD_001 + DD_001 - DD_100) + g_contr_22 * (DD_002 + DD_002 - DD_200);
    double Christoffel_tilde_010 = g_contr_00 * (DD_010 + DD_100 - DD_001) + g_contr_01 * (DD_011 + DD_101 - DD_101) + g_contr_02 * (DD_012 + DD_102 - DD_201);
    double Christoffel_tilde_011 = g_contr_10 * (DD_010 + DD_100 - DD_001) + g_contr_11 * (DD_011 + DD_101 - DD_101) + g_contr_12 * (DD_012 + DD_102 - DD_201);
    double Christoffel_tilde_012 = g_contr_20 * (DD_010 + DD_100 - DD_001) + g_contr_21 * (DD_011 + DD_101 - DD_101) + g_contr_22 * (DD_012 + DD_102 - DD_201);
    double Christoffel_tilde_020 = g_contr_00 * (DD_020 + DD_200 - DD_002) + g_contr_01 * (DD_021 + DD_201 - DD_102) + g_contr_02 * (DD_022 + DD_202 - DD_202);
    double Christoffel_tilde_021 = g_contr_10 * (DD_020 + DD_200 - DD_002) + g_contr_11 * (DD_021 + DD_201 - DD_102) + g_contr_12 * (DD_022 + DD_202 - DD_202);
    double Christoffel_tilde_022 = g_contr_20 * (DD_020 + DD_200 - DD_002) + g_contr_21 * (DD_021 + DD_201 - DD_102) + g_contr_22 * (DD_022 + DD_202 - DD_202);

    double Christoffel_tilde_100 = g_contr_00 * (DD_100 + DD_010 - DD_010) + g_contr_01 * (DD_101 + DD_011 - DD_110) + g_contr_02 * (DD_102 + DD_012 - DD_210);
    double Christoffel_tilde_101 = g_contr_10 * (DD_100 + DD_010 - DD_010) + g_contr_11 * (DD_101 + DD_011 - DD_110) + g_contr_12 * (DD_102 + DD_012 - DD_210);
    double Christoffel_tilde_102 = g_contr_20 * (DD_100 + DD_010 - DD_010) + g_contr_21 * (DD_101 + DD_011 - DD_110) + g_contr_22 * (DD_102 + DD_012 - DD_210);
    double Christoffel_tilde_110 = g_contr_00 * (DD_110 + DD_110 - DD_011) + g_contr_01 * (DD_111 + DD_111 - DD_111) + g_contr_02 * (DD_112 + DD_112 - DD_211);
    double Christoffel_tilde_111 = g_contr_10 * (DD_110 + DD_110 - DD_011) + g_contr_11 * (DD_111 + DD_111 - DD_111) + g_contr_12 * (DD_112 + DD_112 - DD_211);
    double Christoffel_tilde_112 = g_contr_20 * (DD_110 + DD_110 - DD_011) + g_contr_21 * (DD_111 + DD_111 - DD_111) + g_contr_22 * (DD_112 + DD_112 - DD_211);
    double Christoffel_tilde_120 = g_contr_00 * (DD_120 + DD_210 - DD_012) + g_contr_01 * (DD_121 + DD_211 - DD_112) + g_contr_02 * (DD_122 + DD_212 - DD_212);
    double Christoffel_tilde_121 = g_contr_10 * (DD_120 + DD_210 - DD_012) + g_contr_11 * (DD_121 + DD_211 - DD_112) + g_contr_12 * (DD_122 + DD_212 - DD_212);
    double Christoffel_tilde_122 = g_contr_20 * (DD_120 + DD_210 - DD_012) + g_contr_21 * (DD_121 + DD_211 - DD_112) + g_contr_22 * (DD_122 + DD_212 - DD_212);

