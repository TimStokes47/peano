    RicciPlusNablaZSrc_00 += g_contr_02 * ( Christoffel_tilde_002 * Christoffel_tilde_down_022 + Christoffel_tilde_002 * Christoffel_tilde_down_022 + Christoffel_tilde_022 * Christoffel_tilde_down_200 ) - g_cov_00 * g_contr_02 * Christoffel_tilde_022 * PP_2 / (np*chi);
    RicciPlusNablaZSrc_00 -= (np + 1.0) * g_cov_00 * g_contr_21 * PP_2 * PP_1 / (np * np * chi * chi);
    RicciPlusNablaZSrc_00 += g_contr_10 * ( Christoffel_tilde_102 * Christoffel_tilde_down_020 + Christoffel_tilde_102 * Christoffel_tilde_down_020 + Christoffel_tilde_002 * Christoffel_tilde_down_210 ) - g_cov_00 * g_contr_10 * Christoffel_tilde_102 * PP_2 / (np*chi);
    RicciPlusNablaZSrc_00 += g_contr_11 * ( Christoffel_tilde_102 * Christoffel_tilde_down_021 + Christoffel_tilde_102 * Christoffel_tilde_down_021 + Christoffel_tilde_012 * Christoffel_tilde_down_210 ) - g_cov_00 * g_contr_11 * Christoffel_tilde_112 * PP_2 / (np*chi);
    RicciPlusNablaZSrc_00 += g_contr_12 * ( Christoffel_tilde_102 * Christoffel_tilde_down_022 + Christoffel_tilde_102 * Christoffel_tilde_down_022 + Christoffel_tilde_022 * Christoffel_tilde_down_210 ) - g_cov_00 * g_contr_12 * Christoffel_tilde_122 * PP_2 / (np*chi);
    RicciPlusNablaZSrc_00 -= (np + 1.0) * g_cov_00 * g_contr_22 * PP_2 * PP_2 / (np * np * chi * chi);
