void exagrype::ccz4::maxEigenvalue(
        const double* const Q,
        int                 normal,
        const double        CCZ4e,
        const double        CCZ4ds,
        const double        CCZ4GLMc,
        const double        CCZ4GLMd,
        double*             maxEigenvalue
) {
    const double np = 1.0;
    const double qmin = std::fmin(std::fmin(Q[0],Q[3]), Q[5]);
    const double alpha = std::fmax(1.0, Q[16]) * std::fmax(1.0, pow(Q[54],1.0/np))/std::sqrt(qmin);

    constexpr double sqrtwo = 1.4142135623730951;
    const double tempA = alpha * std::fmax(std::fmax(std::fmax(std::fmax(sqrtwo, CCZ4e), CCZ4ds), CCZ4GLMc/alpha), CCZ4GLMd/alpha);
    const double tempB = Q[17+normal];//DOT_PRODUCT(Q(18:20),nv(:))
    maxEigenvalue[0] = std::fmax(std::fmax(1.0, std::abs(-tempA-tempB)), std::abs(tempA-tempB));
}

//this version use alpha and phi
void exagrype::ccz4::source(double* S, const double* const Q,
      const int CCZ4LapseType,
      const double CCZ4ds,
      const double CCZ4c,
      const double CCZ4e,
      const double CCZ4f,
      const double CCZ4bs,
      const double CCZ4sk,
      const double CCZ4xi,
      const double CCZ4itau,
      const double CCZ4eta,
      const double CCZ4k1,
      const double CCZ4k2,
      const double CCZ4k3,
      const double CCZ4SO
      )
{
    const double CCZ4helper = (CCZ4SO==1)? 0.0 : 1.0; //19-02-24: add control parameter CCZ4helperSet
    // Baojiu-01-08-22: alpha now is larger than 0.0001, in agreement with 2112.10567
    //const double alpha = std::exp(std::fmax(-20., std::fmin(20.,Q[16]))); 
    const double alpha = std::fmax(1e-4,Q[16]); 
    //printf("alpha %f\n",alpha);
    double fa  = 1.0;
    double faa = 0.0;
    if (CCZ4LapseType==1)
    {
      fa  =  2./alpha;
      faa = -fa/alpha;
    }

    // Note g_cov is symmetric
    //const double g_cov[3][3] = { {Q[0], Q[1], Q[2]}, {Q[1], Q[3], Q[4]}, {Q[2], Q[4], Q[5]} };
    const double g_cov_00 = Q[0]; const double g_cov_01 = Q[1]; const double g_cov_02 = Q[2];
    const double g_cov_10 = Q[1]; const double g_cov_11 = Q[3]; const double g_cov_12 = Q[4];
    const double g_cov_20 = Q[2]; const double g_cov_21 = Q[4]; const double g_cov_22 = Q[5];

    const double det = Q[0]*Q[3]*Q[5] - Q[0]*Q[4]*Q[4] - Q[1]*Q[1]*Q[5] + 2*Q[1]*Q[2]*Q[4] -Q[2]*Q[2]*Q[3];
    const double invdet = 1./det;

    const double g_contr_00 =  ( Q[3]*Q[5]-Q[4]*Q[4])*invdet; const double g_contr_01 = -( Q[1]*Q[5]-Q[2]*Q[4])*invdet; const double g_contr_02 = -(-Q[1]*Q[4]+Q[2]*Q[3])*invdet;
    const double g_contr_10 = -( Q[1]*Q[5]-Q[4]*Q[2])*invdet; const double g_contr_11 =  ( Q[0]*Q[5]-Q[2]*Q[2])*invdet; const double g_contr_12 = -( Q[0]*Q[4]-Q[2]*Q[1])*invdet;
    const double g_contr_20 = -(-Q[1]*Q[4]+Q[3]*Q[2])*invdet; const double g_contr_21 = -( Q[0]*Q[4]-Q[1]*Q[2])*invdet; const double g_contr_22 =  ( Q[0]*Q[3]-Q[1]*Q[1])*invdet;

    // NOTE Aex is symmetric
    double Aex_00 =Q[6]; double Aex_01 = Q[7];  double Aex_02 = Q[8];
    double Aex_10 =Q[7]; double Aex_11 = Q[9];  double Aex_12 = Q[10];
    double Aex_20 =Q[8]; double Aex_21 = Q[10]; double Aex_22 = Q[11];
    
    double traceA = g_contr_00 * Aex_00 + g_contr_01 * Aex_01 + g_contr_02 * Aex_02 + 
                    g_contr_10 * Aex_10 + g_contr_11 * Aex_11 + g_contr_12 * Aex_12 +
                    g_contr_20 * Aex_20 + g_contr_21 * Aex_21 + g_contr_22 * Aex_22;
    
    Aex_00 -= 1./3. * traceA * g_cov_00;
    Aex_01 -= 1./3. * traceA * g_cov_01;
    Aex_02 -= 1./3. * traceA * g_cov_02;
    Aex_10 -= 1./3. * traceA * g_cov_10;
    Aex_11 -= 1./3. * traceA * g_cov_11;
    Aex_12 -= 1./3. * traceA * g_cov_12;
    Aex_20 -= 1./3. * traceA * g_cov_20;
    Aex_21 -= 1./3. * traceA * g_cov_21;
    Aex_22 -= 1./3. * traceA * g_cov_22;

    // Matrix multiplications Amix = matmul(g_contr, Aex) Aup  = matmul(g_contr, transpose(Amix))
    double Amix_00 = g_contr_00 * Aex_00 + g_contr_01 * Aex_10 + g_contr_02 * Aex_20;
    double Amix_01 = g_contr_00 * Aex_01 + g_contr_01 * Aex_11 + g_contr_02 * Aex_21;
    double Amix_02 = g_contr_00 * Aex_02 + g_contr_01 * Aex_12 + g_contr_02 * Aex_22;
    double Amix_10 = g_contr_10 * Aex_00 + g_contr_11 * Aex_10 + g_contr_12 * Aex_20;
    double Amix_11 = g_contr_10 * Aex_01 + g_contr_11 * Aex_11 + g_contr_12 * Aex_21;
    double Amix_12 = g_contr_10 * Aex_02 + g_contr_11 * Aex_12 + g_contr_12 * Aex_22;
    double Amix_20 = g_contr_20 * Aex_00 + g_contr_21 * Aex_10 + g_contr_22 * Aex_20;
    double Amix_21 = g_contr_20 * Aex_01 + g_contr_21 * Aex_11 + g_contr_22 * Aex_21;
    double Amix_22 = g_contr_20 * Aex_02 + g_contr_21 * Aex_12 + g_contr_22 * Aex_22;

    double Aup_00 = g_contr_00 * Amix_00 + g_contr_01 * Amix_01 + g_contr_02 * Amix_02;
    double Aup_01 = g_contr_00 * Amix_10 + g_contr_01 * Amix_11 + g_contr_02 * Amix_12;
    double Aup_02 = g_contr_00 * Amix_20 + g_contr_01 * Amix_21 + g_contr_02 * Amix_22;
    double Aup_10 = g_contr_10 * Amix_00 + g_contr_11 * Amix_01 + g_contr_12 * Amix_02;
    double Aup_11 = g_contr_10 * Amix_10 + g_contr_11 * Amix_11 + g_contr_12 * Amix_12;
    double Aup_12 = g_contr_10 * Amix_20 + g_contr_11 * Amix_21 + g_contr_12 * Amix_22;
    double Aup_20 = g_contr_20 * Amix_00 + g_contr_21 * Amix_01 + g_contr_22 * Amix_02;
    double Aup_21 = g_contr_20 * Amix_10 + g_contr_21 * Amix_11 + g_contr_22 * Amix_12;
    double Aup_22 = g_contr_20 * Amix_20 + g_contr_21 * Amix_21 + g_contr_22 * Amix_22;

    const double Theta = Q[12]; // needed later

    const double DD_000 = Q[35]; const double DD_001 = Q[36]; const double DD_002 = Q[37];
    const double DD_010 = Q[36]; const double DD_011 = Q[38]; const double DD_012 = Q[39];
    const double DD_020 = Q[37]; const double DD_021 = Q[39]; const double DD_022 = Q[40];

    const double DD_100 = Q[41]; const double DD_101 = Q[42]; const double DD_102 = Q[43];
    const double DD_110 = Q[42]; const double DD_111 = Q[44]; const double DD_112 = Q[45];
    const double DD_120 = Q[43]; const double DD_121 = Q[45]; const double DD_122 = Q[46];

    const double DD_200 = Q[47]; const double DD_201 = Q[48]; const double DD_202 = Q[49];
    const double DD_210 = Q[48]; const double DD_211 = Q[50]; const double DD_212 = Q[51];
    const double DD_220 = Q[49]; const double DD_221 = Q[51]; const double DD_222 = Q[52];

    double dgup_000 = -2.0 * g_contr_00 * g_contr_00 * DD_000 - 2.0 * g_contr_00 * g_contr_10 * DD_001 - 2.0 * g_contr_00 * g_contr_20 * DD_002 
                     - 2.0 * g_contr_01 * g_contr_00 * DD_010 - 2.0 * g_contr_01 * g_contr_10 * DD_011 - 2.0 * g_contr_01 * g_contr_20 * DD_012 
                     - 2.0 * g_contr_02 * g_contr_00 * DD_020 - 2.0 * g_contr_02 * g_contr_10 * DD_021 - 2.0 * g_contr_02 * g_contr_20 * DD_022;
    double dgup_001 = -2.0 * g_contr_00 * g_contr_01 * DD_000 - 2.0 * g_contr_00 * g_contr_11 * DD_001 - 2.0 * g_contr_00 * g_contr_21 * DD_002 
                     - 2.0 * g_contr_01 * g_contr_01 * DD_010 - 2.0 * g_contr_01 * g_contr_11 * DD_011 - 2.0 * g_contr_01 * g_contr_21 * DD_012 
                     - 2.0 * g_contr_02 * g_contr_01 * DD_020 - 2.0 * g_contr_02 * g_contr_11 * DD_021 - 2.0 * g_contr_02 * g_contr_21 * DD_022;
    double dgup_002 = -2.0 * g_contr_00 * g_contr_02 * DD_000 - 2.0 * g_contr_00 * g_contr_12 * DD_001 - 2.0 * g_contr_00 * g_contr_22 * DD_002 
                     - 2.0 * g_contr_01 * g_contr_02 * DD_010 - 2.0 * g_contr_01 * g_contr_12 * DD_011 - 2.0 * g_contr_01 * g_contr_22 * DD_012 
                     - 2.0 * g_contr_02 * g_contr_02 * DD_020 - 2.0 * g_contr_02 * g_contr_12 * DD_021 - 2.0 * g_contr_02 * g_contr_22 * DD_022;
    double dgup_010 = -2.0 * g_contr_10 * g_contr_00 * DD_000 - 2.0 * g_contr_10 * g_contr_10 * DD_001 - 2.0 * g_contr_10 * g_contr_20 * DD_002 
                     - 2.0 * g_contr_11 * g_contr_00 * DD_010 - 2.0 * g_contr_11 * g_contr_10 * DD_011 - 2.0 * g_contr_11 * g_contr_20 * DD_012 
                     - 2.0 * g_contr_12 * g_contr_00 * DD_020 - 2.0 * g_contr_12 * g_contr_10 * DD_021 - 2.0 * g_contr_12 * g_contr_20 * DD_022;
    double dgup_011 = -2.0 * g_contr_10 * g_contr_01 * DD_000 - 2.0 * g_contr_10 * g_contr_11 * DD_001 - 2.0 * g_contr_10 * g_contr_21 * DD_002 
                     - 2.0 * g_contr_11 * g_contr_01 * DD_010 - 2.0 * g_contr_11 * g_contr_11 * DD_011 - 2.0 * g_contr_11 * g_contr_21 * DD_012 
                     - 2.0 * g_contr_12 * g_contr_01 * DD_020 - 2.0 * g_contr_12 * g_contr_11 * DD_021 - 2.0 * g_contr_12 * g_contr_21 * DD_022;
    double dgup_012 = -2.0 * g_contr_10 * g_contr_02 * DD_000 - 2.0 * g_contr_10 * g_contr_12 * DD_001 - 2.0 * g_contr_10 * g_contr_22 * DD_002 
                     - 2.0 * g_contr_11 * g_contr_02 * DD_010 - 2.0 * g_contr_11 * g_contr_12 * DD_011 - 2.0 * g_contr_11 * g_contr_22 * DD_012 
                     - 2.0 * g_contr_12 * g_contr_02 * DD_020 - 2.0 * g_contr_12 * g_contr_12 * DD_021 - 2.0 * g_contr_12 * g_contr_22 * DD_022;
    double dgup_020 = -2.0 * g_contr_20 * g_contr_00 * DD_000 - 2.0 * g_contr_20 * g_contr_10 * DD_001 - 2.0 * g_contr_20 * g_contr_20 * DD_002 
                     - 2.0 * g_contr_21 * g_contr_00 * DD_010 - 2.0 * g_contr_21 * g_contr_10 * DD_011 - 2.0 * g_contr_21 * g_contr_20 * DD_012 
                     - 2.0 * g_contr_22 * g_contr_00 * DD_020 - 2.0 * g_contr_22 * g_contr_10 * DD_021 - 2.0 * g_contr_22 * g_contr_20 * DD_022;
    double dgup_021 = -2.0 * g_contr_20 * g_contr_01 * DD_000 - 2.0 * g_contr_20 * g_contr_11 * DD_001 - 2.0 * g_contr_20 * g_contr_21 * DD_002 
                     - 2.0 * g_contr_21 * g_contr_01 * DD_010 - 2.0 * g_contr_21 * g_contr_11 * DD_011 - 2.0 * g_contr_21 * g_contr_21 * DD_012 
                     - 2.0 * g_contr_22 * g_contr_01 * DD_020 - 2.0 * g_contr_22 * g_contr_11 * DD_021 - 2.0 * g_contr_22 * g_contr_21 * DD_022;
    double dgup_022 = -2.0 * g_contr_20 * g_contr_02 * DD_000 - 2.0 * g_contr_20 * g_contr_12 * DD_001 - 2.0 * g_contr_20 * g_contr_22 * DD_002 
                     - 2.0 * g_contr_21 * g_contr_02 * DD_010 - 2.0 * g_contr_21 * g_contr_12 * DD_011 - 2.0 * g_contr_21 * g_contr_22 * DD_012 
                     - 2.0 * g_contr_22 * g_contr_02 * DD_020 - 2.0 * g_contr_22 * g_contr_12 * DD_021 - 2.0 * g_contr_22 * g_contr_22 * DD_022;

    double dgup_100 = -2.0 * g_contr_00 * g_contr_00 * DD_100 - 2.0 * g_contr_00 * g_contr_10 * DD_101 - 2.0 * g_contr_00 * g_contr_20 * DD_102 
                     - 2.0 * g_contr_01 * g_contr_00 * DD_110 - 2.0 * g_contr_01 * g_contr_10 * DD_111 - 2.0 * g_contr_01 * g_contr_20 * DD_112 
                     - 2.0 * g_contr_02 * g_contr_00 * DD_120 - 2.0 * g_contr_02 * g_contr_10 * DD_121 - 2.0 * g_contr_02 * g_contr_20 * DD_122;
    double dgup_101 = -2.0 * g_contr_00 * g_contr_01 * DD_100 - 2.0 * g_contr_00 * g_contr_11 * DD_101 - 2.0 * g_contr_00 * g_contr_21 * DD_102 
                     - 2.0 * g_contr_01 * g_contr_01 * DD_110 - 2.0 * g_contr_01 * g_contr_11 * DD_111 - 2.0 * g_contr_01 * g_contr_21 * DD_112 
                     - 2.0 * g_contr_02 * g_contr_01 * DD_120 - 2.0 * g_contr_02 * g_contr_11 * DD_121 - 2.0 * g_contr_02 * g_contr_21 * DD_122;
    double dgup_102 = -2.0 * g_contr_00 * g_contr_02 * DD_100 - 2.0 * g_contr_00 * g_contr_12 * DD_101 - 2.0 * g_contr_00 * g_contr_22 * DD_102 
                     - 2.0 * g_contr_01 * g_contr_02 * DD_110 - 2.0 * g_contr_01 * g_contr_12 * DD_111 - 2.0 * g_contr_01 * g_contr_22 * DD_112 
                     - 2.0 * g_contr_02 * g_contr_02 * DD_120 - 2.0 * g_contr_02 * g_contr_12 * DD_121 - 2.0 * g_contr_02 * g_contr_22 * DD_122;
    double dgup_110 = -2.0 * g_contr_10 * g_contr_00 * DD_100 - 2.0 * g_contr_10 * g_contr_10 * DD_101 - 2.0 * g_contr_10 * g_contr_20 * DD_102 
                     - 2.0 * g_contr_11 * g_contr_00 * DD_110 - 2.0 * g_contr_11 * g_contr_10 * DD_111 - 2.0 * g_contr_11 * g_contr_20 * DD_112 
                     - 2.0 * g_contr_12 * g_contr_00 * DD_120 - 2.0 * g_contr_12 * g_contr_10 * DD_121 - 2.0 * g_contr_12 * g_contr_20 * DD_122;
    double dgup_111 = -2.0 * g_contr_10 * g_contr_01 * DD_100 - 2.0 * g_contr_10 * g_contr_11 * DD_101 - 2.0 * g_contr_10 * g_contr_21 * DD_102 
                     - 2.0 * g_contr_11 * g_contr_01 * DD_110 - 2.0 * g_contr_11 * g_contr_11 * DD_111 - 2.0 * g_contr_11 * g_contr_21 * DD_112 
                     - 2.0 * g_contr_12 * g_contr_01 * DD_120 - 2.0 * g_contr_12 * g_contr_11 * DD_121 - 2.0 * g_contr_12 * g_contr_21 * DD_122;
    double dgup_112 = -2.0 * g_contr_10 * g_contr_02 * DD_100 - 2.0 * g_contr_10 * g_contr_12 * DD_101 - 2.0 * g_contr_10 * g_contr_22 * DD_102 
                     - 2.0 * g_contr_11 * g_contr_02 * DD_110 - 2.0 * g_contr_11 * g_contr_12 * DD_111 - 2.0 * g_contr_11 * g_contr_22 * DD_112 
                     - 2.0 * g_contr_12 * g_contr_02 * DD_120 - 2.0 * g_contr_12 * g_contr_12 * DD_121 - 2.0 * g_contr_12 * g_contr_22 * DD_122;
    double dgup_120 = -2.0 * g_contr_20 * g_contr_00 * DD_100 - 2.0 * g_contr_20 * g_contr_10 * DD_101 - 2.0 * g_contr_20 * g_contr_20 * DD_102 
                     - 2.0 * g_contr_21 * g_contr_00 * DD_110 - 2.0 * g_contr_21 * g_contr_10 * DD_111 - 2.0 * g_contr_21 * g_contr_20 * DD_112 
                     - 2.0 * g_contr_22 * g_contr_00 * DD_120 - 2.0 * g_contr_22 * g_contr_10 * DD_121 - 2.0 * g_contr_22 * g_contr_20 * DD_122;
    double dgup_121 = -2.0 * g_contr_20 * g_contr_01 * DD_100 - 2.0 * g_contr_20 * g_contr_11 * DD_101 - 2.0 * g_contr_20 * g_contr_21 * DD_102 
                     - 2.0 * g_contr_21 * g_contr_01 * DD_110 - 2.0 * g_contr_21 * g_contr_11 * DD_111 - 2.0 * g_contr_21 * g_contr_21 * DD_112 
                     - 2.0 * g_contr_22 * g_contr_01 * DD_120 - 2.0 * g_contr_22 * g_contr_11 * DD_121 - 2.0 * g_contr_22 * g_contr_21 * DD_122;
    double dgup_122 = -2.0 * g_contr_20 * g_contr_02 * DD_100 - 2.0 * g_contr_20 * g_contr_12 * DD_101 - 2.0 * g_contr_20 * g_contr_22 * DD_102 
                     - 2.0 * g_contr_21 * g_contr_02 * DD_110 - 2.0 * g_contr_21 * g_contr_12 * DD_111 - 2.0 * g_contr_21 * g_contr_22 * DD_112 
                     - 2.0 * g_contr_22 * g_contr_02 * DD_120 - 2.0 * g_contr_22 * g_contr_12 * DD_121 - 2.0 * g_contr_22 * g_contr_22 * DD_122;
    
    double dgup_200 = -2.0 * g_contr_00 * g_contr_00 * DD_200 - 2.0 * g_contr_00 * g_contr_10 * DD_201 - 2.0 * g_contr_00 * g_contr_20 * DD_202 
                     - 2.0 * g_contr_01 * g_contr_00 * DD_210 - 2.0 * g_contr_01 * g_contr_10 * DD_211 - 2.0 * g_contr_01 * g_contr_20 * DD_212 
                     - 2.0 * g_contr_02 * g_contr_00 * DD_220 - 2.0 * g_contr_02 * g_contr_10 * DD_221 - 2.0 * g_contr_02 * g_contr_20 * DD_222;
    double dgup_201 = -2.0 * g_contr_00 * g_contr_01 * DD_200 - 2.0 * g_contr_00 * g_contr_11 * DD_201 - 2.0 * g_contr_00 * g_contr_21 * DD_202 
                     - 2.0 * g_contr_01 * g_contr_01 * DD_210 - 2.0 * g_contr_01 * g_contr_11 * DD_211 - 2.0 * g_contr_01 * g_contr_21 * DD_212 
                     - 2.0 * g_contr_02 * g_contr_01 * DD_220 - 2.0 * g_contr_02 * g_contr_11 * DD_221 - 2.0 * g_contr_02 * g_contr_21 * DD_222;
    double dgup_202 = -2.0 * g_contr_00 * g_contr_02 * DD_200 - 2.0 * g_contr_00 * g_contr_12 * DD_201 - 2.0 * g_contr_00 * g_contr_22 * DD_202 
                     - 2.0 * g_contr_01 * g_contr_02 * DD_210 - 2.0 * g_contr_01 * g_contr_12 * DD_211 - 2.0 * g_contr_01 * g_contr_22 * DD_212 
                     - 2.0 * g_contr_02 * g_contr_02 * DD_220 - 2.0 * g_contr_02 * g_contr_12 * DD_221 - 2.0 * g_contr_02 * g_contr_22 * DD_222;
    double dgup_210 = -2.0 * g_contr_10 * g_contr_00 * DD_200 - 2.0 * g_contr_10 * g_contr_10 * DD_201 - 2.0 * g_contr_10 * g_contr_20 * DD_202 
                     - 2.0 * g_contr_11 * g_contr_00 * DD_210 - 2.0 * g_contr_11 * g_contr_10 * DD_211 - 2.0 * g_contr_11 * g_contr_20 * DD_212 
                     - 2.0 * g_contr_12 * g_contr_00 * DD_220 - 2.0 * g_contr_12 * g_contr_10 * DD_221 - 2.0 * g_contr_12 * g_contr_20 * DD_222;
    double dgup_211 = -2.0 * g_contr_10 * g_contr_01 * DD_200 - 2.0 * g_contr_10 * g_contr_11 * DD_201 - 2.0 * g_contr_10 * g_contr_21 * DD_202 
                     - 2.0 * g_contr_11 * g_contr_01 * DD_210 - 2.0 * g_contr_11 * g_contr_11 * DD_211 - 2.0 * g_contr_11 * g_contr_21 * DD_212 
                     - 2.0 * g_contr_12 * g_contr_01 * DD_220 - 2.0 * g_contr_12 * g_contr_11 * DD_221 - 2.0 * g_contr_12 * g_contr_21 * DD_222;
    double dgup_212 = -2.0 * g_contr_10 * g_contr_02 * DD_200 - 2.0 * g_contr_10 * g_contr_12 * DD_201 - 2.0 * g_contr_10 * g_contr_22 * DD_202 
                     - 2.0 * g_contr_11 * g_contr_02 * DD_210 - 2.0 * g_contr_11 * g_contr_12 * DD_211 - 2.0 * g_contr_11 * g_contr_22 * DD_212 
                     - 2.0 * g_contr_12 * g_contr_02 * DD_220 - 2.0 * g_contr_12 * g_contr_12 * DD_221 - 2.0 * g_contr_12 * g_contr_22 * DD_222;
    double dgup_220 = -2.0 * g_contr_20 * g_contr_00 * DD_200 - 2.0 * g_contr_20 * g_contr_10 * DD_201 - 2.0 * g_contr_20 * g_contr_20 * DD_202 
                     - 2.0 * g_contr_21 * g_contr_00 * DD_210 - 2.0 * g_contr_21 * g_contr_10 * DD_211 - 2.0 * g_contr_21 * g_contr_20 * DD_212 
                     - 2.0 * g_contr_22 * g_contr_00 * DD_220 - 2.0 * g_contr_22 * g_contr_10 * DD_221 - 2.0 * g_contr_22 * g_contr_20 * DD_222;
    double dgup_221 = -2.0 * g_contr_20 * g_contr_01 * DD_200 - 2.0 * g_contr_20 * g_contr_11 * DD_201 - 2.0 * g_contr_20 * g_contr_21 * DD_202 
                     - 2.0 * g_contr_21 * g_contr_01 * DD_210 - 2.0 * g_contr_21 * g_contr_11 * DD_211 - 2.0 * g_contr_21 * g_contr_21 * DD_212 
                     - 2.0 * g_contr_22 * g_contr_01 * DD_220 - 2.0 * g_contr_22 * g_contr_11 * DD_221 - 2.0 * g_contr_22 * g_contr_21 * DD_222;
    double dgup_222 = -2.0 * g_contr_20 * g_contr_02 * DD_200 - 2.0 * g_contr_20 * g_contr_12 * DD_201 - 2.0 * g_contr_20 * g_contr_22 * DD_202 
                     - 2.0 * g_contr_21 * g_contr_02 * DD_210 - 2.0 * g_contr_21 * g_contr_12 * DD_211 - 2.0 * g_contr_21 * g_contr_22 * DD_212 
                     - 2.0 * g_contr_22 * g_contr_02 * DD_220 - 2.0 * g_contr_22 * g_contr_12 * DD_221 - 2.0 * g_contr_22 * g_contr_22 * DD_222;

    // Baojiu-01-08-22: moved here because phi will be needed in the new Christoffel
    // Baojiu-01-08-22: now phi^2 is bound to be larger than 0.0001, in agreement with 2112.10567
    //const double phi = std::exp(std::fmax(-20., std::fmin(20.,Q[54]))); 
    const double np = 1.0;  					// Baojiu-13-06-23: chi=phi^n, np is the index n here
