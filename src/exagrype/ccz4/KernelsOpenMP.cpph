    RicciPlusNablaZSrc_00 += g_contr_21 * ( Christoffel_tilde_200 * Christoffel_tilde_down_001 + Christoffel_tilde_200 * Christoffel_tilde_down_001 + Christoffel_tilde_010 * Christoffel_tilde_down_020 ) - g_cov_00 * g_contr_21 * Christoffel_tilde_210 * PP_0 / (np*chi);
    RicciPlusNablaZSrc_00 += g_contr_22 * ( Christoffel_tilde_200 * Christoffel_tilde_down_002 + Christoffel_tilde_200 * Christoffel_tilde_down_002 + Christoffel_tilde_020 * Christoffel_tilde_down_020 ) - g_cov_00 * g_contr_22 * Christoffel_tilde_220 * PP_0 / (np*chi);
    RicciPlusNablaZSrc_00 += Ghat_1 * DD_100 - PP_1 * Christoffel_tilde_001 / (np * chi) + 2.0 * Zup_1 / (np*chi*phi2) * (g_cov_01 * PP_0 + g_cov_01 * PP_0 - g_cov_00 * PP_1);
