    double Christoffel_tilde_201 = g_contr_10 * (DD_200 + DD_020 - DD_020) + g_contr_11 * (DD_201 + DD_021 - DD_120) + g_contr_12 * (DD_202 + DD_022 - DD_220);
    double Christoffel_tilde_202 = g_contr_20 * (DD_200 + DD_020 - DD_020) + g_contr_21 * (DD_201 + DD_021 - DD_120) + g_contr_22 * (DD_202 + DD_022 - DD_220);
    double Christoffel_tilde_210 = g_contr_00 * (DD_210 + DD_120 - DD_021) + g_contr_01 * (DD_211 + DD_121 - DD_121) + g_contr_02 * (DD_212 + DD_122 - DD_221);
    double Christoffel_tilde_211 = g_contr_10 * (DD_210 + DD_120 - DD_021) + g_contr_11 * (DD_211 + DD_121 - DD_121) + g_contr_12 * (DD_212 + DD_122 - DD_221);
    double Christoffel_tilde_212 = g_contr_20 * (DD_210 + DD_120 - DD_021) + g_contr_21 * (DD_211 + DD_121 - DD_121) + g_contr_22 * (DD_212 + DD_122 - DD_221);
