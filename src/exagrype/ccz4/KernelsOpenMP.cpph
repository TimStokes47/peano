    RicciPlusNablaZNCP_11 += 0.5 * g_cov_11 * (g_contr_10 * (dPP_10 + dPP_01) + g_contr_11 * (dPP_11 + dPP_11) + g_contr_12 * (dPP_12 + dPP_21)) / (np * chi);
    RicciPlusNablaZNCP_11 += 0.5 * g_cov_11 * (g_contr_20 * (dPP_20 + dPP_02) + g_contr_21 * (dPP_21 + dPP_12) + g_contr_22 * (dPP_22 + dPP_22)) / (np * chi);

    double RicciPlusNablaZNCP_12 = 0.5 * (dPP_12 + dPP_21) / (np * chi);
    RicciPlusNablaZNCP_12 += 0.5 * (g_cov_01 * dGhat_20 + g_cov_02 * dGhat_10) + 0.5 * (g_cov_11 * dGhat_21 + g_cov_12 * dGhat_11) + 0.5 * (g_cov_21 * dGhat_22 + g_cov_22 * dGhat_12);
    RicciPlusNablaZNCP_12 -= 0.5 * g_contr_00 * (dDD_0012 + dDD_0012) + 0.5 * g_contr_01 * (dDD_0112 + dDD_1012) + 0.5 * g_contr_02 * (dDD_0212 + dDD_2012);
    RicciPlusNablaZNCP_12 -= 0.5 * g_contr_10 * (dDD_1012 + dDD_0112) + 0.5 * g_contr_11 * (dDD_1112 + dDD_1112) + 0.5 * g_contr_12 * (dDD_1212 + dDD_2112);
    RicciPlusNablaZNCP_12 -= 0.5 * g_contr_20 * (dDD_2012 + dDD_0212) + 0.5 * g_contr_21 * (dDD_2112 + dDD_1212) + 0.5 * g_contr_22 * (dDD_2212 + dDD_2212);
    RicciPlusNablaZNCP_12 += 0.5 * g_cov_12 * (g_contr_00 * (dPP_00 + dPP_00) + g_contr_01 * (dPP_01 + dPP_10) + g_contr_02 * (dPP_02 + dPP_20)) / (np * chi);
    RicciPlusNablaZNCP_12 += 0.5 * g_cov_12 * (g_contr_10 * (dPP_10 + dPP_01) + g_contr_11 * (dPP_11 + dPP_11) + g_contr_12 * (dPP_12 + dPP_21)) / (np * chi);
    RicciPlusNablaZNCP_12 += 0.5 * g_cov_12 * (g_contr_20 * (dPP_20 + dPP_02) + g_contr_21 * (dPP_21 + dPP_12) + g_contr_22 * (dPP_22 + dPP_22)) / (np * chi);


    double RicciPlusNablaZNCP_20 = 0.5 * (dPP_20 + dPP_02) / (np * chi);
    RicciPlusNablaZNCP_20 += 0.5 * (g_cov_02 * dGhat_00 + g_cov_00 * dGhat_20) + 0.5 * (g_cov_12 * dGhat_01 + g_cov_10 * dGhat_21) + 0.5 * (g_cov_22 * dGhat_02 + g_cov_20 * dGhat_22);
    RicciPlusNablaZNCP_20 -= 0.5 * g_contr_00 * (dDD_0020 + dDD_0020) + 0.5 * g_contr_01 * (dDD_0120 + dDD_1020) + 0.5 * g_contr_02 * (dDD_0220 + dDD_2020);
    RicciPlusNablaZNCP_20 -= 0.5 * g_contr_10 * (dDD_1020 + dDD_0120) + 0.5 * g_contr_11 * (dDD_1120 + dDD_1120) + 0.5 * g_contr_12 * (dDD_1220 + dDD_2120);
    RicciPlusNablaZNCP_20 -= 0.5 * g_contr_20 * (dDD_2020 + dDD_0220) + 0.5 * g_contr_21 * (dDD_2120 + dDD_1220) + 0.5 * g_contr_22 * (dDD_2220 + dDD_2220);
    RicciPlusNablaZNCP_20 += 0.5 * g_cov_20 * (g_contr_00 * (dPP_00 + dPP_00) + g_contr_01 * (dPP_01 + dPP_10) + g_contr_02 * (dPP_02 + dPP_20)) / (np * chi);
    RicciPlusNablaZNCP_20 += 0.5 * g_cov_20 * (g_contr_10 * (dPP_10 + dPP_01) + g_contr_11 * (dPP_11 + dPP_11) + g_contr_12 * (dPP_12 + dPP_21)) / (np * chi);
    RicciPlusNablaZNCP_20 += 0.5 * g_cov_20 * (g_contr_20 * (dPP_20 + dPP_02) + g_contr_21 * (dPP_21 + dPP_12) + g_contr_22 * (dPP_22 + dPP_22)) / (np * chi);

    double RicciPlusNablaZNCP_21 = 0.5 * (dPP_21 + dPP_12) / (np * chi);
    RicciPlusNablaZNCP_21 += 0.5 * (g_cov_02 * dGhat_10 + g_cov_01 * dGhat_20) + 0.5 * (g_cov_12 * dGhat_11 + g_cov_11 * dGhat_21) + 0.5 * (g_cov_22 * dGhat_12 + g_cov_21 * dGhat_22);
    RicciPlusNablaZNCP_21 -= 0.5 * g_contr_00 * (dDD_0021 + dDD_0021) + 0.5 * g_contr_01 * (dDD_0121 + dDD_1021) + 0.5 * g_contr_02 * (dDD_0221 + dDD_2021);
    RicciPlusNablaZNCP_21 -= 0.5 * g_contr_10 * (dDD_1021 + dDD_0121) + 0.5 * g_contr_11 * (dDD_1121 + dDD_1121) + 0.5 * g_contr_12 * (dDD_1221 + dDD_2121);
    RicciPlusNablaZNCP_21 -= 0.5 * g_contr_20 * (dDD_2021 + dDD_0221) + 0.5 * g_contr_21 * (dDD_2121 + dDD_1221) + 0.5 * g_contr_22 * (dDD_2221 + dDD_2221);
    RicciPlusNablaZNCP_21 += 0.5 * g_cov_21 * (g_contr_00 * (dPP_00 + dPP_00) + g_contr_01 * (dPP_01 + dPP_10) + g_contr_02 * (dPP_02 + dPP_20)) / (np * chi);
    RicciPlusNablaZNCP_21 += 0.5 * g_cov_21 * (g_contr_10 * (dPP_10 + dPP_01) + g_contr_11 * (dPP_11 + dPP_11) + g_contr_12 * (dPP_12 + dPP_21)) / (np * chi);
    RicciPlusNablaZNCP_21 += 0.5 * g_cov_21 * (g_contr_20 * (dPP_20 + dPP_02) + g_contr_21 * (dPP_21 + dPP_12) + g_contr_22 * (dPP_22 + dPP_22)) / (np * chi);

    double RicciPlusNablaZNCP_22 = 0.5 * (dPP_22 + dPP_22) / (np * chi);
    RicciPlusNablaZNCP_22 += 0.5 * (g_cov_02 * dGhat_20 + g_cov_02 * dGhat_20) + 0.5 * (g_cov_12 * dGhat_21 + g_cov_12 * dGhat_21) + 0.5 * (g_cov_22 * dGhat_22 + g_cov_22 * dGhat_22);
    RicciPlusNablaZNCP_22 -= 0.5 * g_contr_00 * (dDD_0022 + dDD_0022) + 0.5 * g_contr_01 * (dDD_0122 + dDD_1022) + 0.5 * g_contr_02 * (dDD_0222 + dDD_2022);
    RicciPlusNablaZNCP_22 -= 0.5 * g_contr_10 * (dDD_1022 + dDD_0122) + 0.5 * g_contr_11 * (dDD_1122 + dDD_1122) + 0.5 * g_contr_12 * (dDD_1222 + dDD_2122);
    RicciPlusNablaZNCP_22 -= 0.5 * g_contr_20 * (dDD_2022 + dDD_0222) + 0.5 * g_contr_21 * (dDD_2122 + dDD_1222) + 0.5 * g_contr_22 * (dDD_2222 + dDD_2222);
    RicciPlusNablaZNCP_22 += 0.5 * g_cov_22 * (g_contr_00 * (dPP_00 + dPP_00) + g_contr_01 * (dPP_01 + dPP_10) + g_contr_02 * (dPP_02 + dPP_20)) / (np * chi);
    RicciPlusNablaZNCP_22 += 0.5 * g_cov_22 * (g_contr_10 * (dPP_10 + dPP_01) + g_contr_11 * (dPP_11 + dPP_11) + g_contr_12 * (dPP_12 + dPP_21)) / (np * chi);
    RicciPlusNablaZNCP_22 += 0.5 * g_cov_22 * (g_contr_20 * (dPP_20 + dPP_02) + g_contr_21 * (dPP_21 + dPP_12) + g_contr_22 * (dPP_22 + dPP_22)) / (np * chi);

    double RPlusTwoNablaZNCP = g_contr_00 * RicciPlusNablaZNCP_00 + g_contr_01 * RicciPlusNablaZNCP_01 + g_contr_02 * RicciPlusNablaZNCP_02 +
                               g_contr_10 * RicciPlusNablaZNCP_10 + g_contr_11 * RicciPlusNablaZNCP_11 + g_contr_12 * RicciPlusNablaZNCP_12 +
                               g_contr_20 * RicciPlusNablaZNCP_20 + g_contr_21 * RicciPlusNablaZNCP_21 + g_contr_22 * RicciPlusNablaZNCP_22;
    RPlusTwoNablaZNCP*=phi2;

    double nablaijalphaNCP_00 = 0.5 * (dAA_00 + dAA_00);
    double nablaijalphaNCP_01 = 0.5 * (dAA_01 + dAA_10);
    double nablaijalphaNCP_02 = 0.5 * (dAA_02 + dAA_20);
    double nablaijalphaNCP_10 = 0.5 * (dAA_10 + dAA_01);
    double nablaijalphaNCP_11 = 0.5 * (dAA_11 + dAA_11);
    double nablaijalphaNCP_12 = 0.5 * (dAA_12 + dAA_21);
    double nablaijalphaNCP_20 = 0.5 * (dAA_20 + dAA_02);
    double nablaijalphaNCP_21 = 0.5 * (dAA_21 + dAA_12);
    double nablaijalphaNCP_22 = 0.5 * (dAA_22 + dAA_22);

    double nablanablaalphaNCP = g_contr_00 * nablaijalphaNCP_00 + g_contr_01 * nablaijalphaNCP_01 + g_contr_02 * nablaijalphaNCP_02 +
                               g_contr_10 * nablaijalphaNCP_10 + g_contr_11 * nablaijalphaNCP_11 + g_contr_12 * nablaijalphaNCP_12 +
                               g_contr_20 * nablaijalphaNCP_20 + g_contr_21 * nablaijalphaNCP_21 + g_contr_22 * nablaijalphaNCP_22;
    nablanablaalphaNCP*=phi2;

    double SecondOrderTermsNCP_00 = -nablaijalphaNCP_00 + alpha*RicciPlusNablaZNCP_00;
    double SecondOrderTermsNCP_01 = -nablaijalphaNCP_01 + alpha*RicciPlusNablaZNCP_01;
    double SecondOrderTermsNCP_02 = -nablaijalphaNCP_02 + alpha*RicciPlusNablaZNCP_02;
    double SecondOrderTermsNCP_10 = -nablaijalphaNCP_10 + alpha*RicciPlusNablaZNCP_10;
    double SecondOrderTermsNCP_11 = -nablaijalphaNCP_11 + alpha*RicciPlusNablaZNCP_11;
    double SecondOrderTermsNCP_12 = -nablaijalphaNCP_12 + alpha*RicciPlusNablaZNCP_12;
    double SecondOrderTermsNCP_20 = -nablaijalphaNCP_20 + alpha*RicciPlusNablaZNCP_20;
    double SecondOrderTermsNCP_21 = -nablaijalphaNCP_21 + alpha*RicciPlusNablaZNCP_21;
    double SecondOrderTermsNCP_22 = -nablaijalphaNCP_22 + alpha*RicciPlusNablaZNCP_22;

    double traceNCP = g_contr_00 * SecondOrderTermsNCP_00 + g_contr_01 * SecondOrderTermsNCP_01 + g_contr_02 * SecondOrderTermsNCP_02 +
                      g_contr_10 * SecondOrderTermsNCP_10 + g_contr_11 * SecondOrderTermsNCP_11 + g_contr_12 * SecondOrderTermsNCP_12 +
                      g_contr_20 * SecondOrderTermsNCP_20 + g_contr_21 * SecondOrderTermsNCP_21 + g_contr_22 * SecondOrderTermsNCP_22;

    SecondOrderTermsNCP_00 -= 1./3. * traceNCP * g_cov_00;
    SecondOrderTermsNCP_01 -= 1./3. * traceNCP * g_cov_01;
    SecondOrderTermsNCP_02 -= 1./3. * traceNCP * g_cov_02;
    SecondOrderTermsNCP_10 -= 1./3. * traceNCP * g_cov_10;
    SecondOrderTermsNCP_11 -= 1./3. * traceNCP * g_cov_11;
    SecondOrderTermsNCP_12 -= 1./3. * traceNCP * g_cov_12;
    SecondOrderTermsNCP_20 -= 1./3. * traceNCP * g_cov_20;
    SecondOrderTermsNCP_21 -= 1./3. * traceNCP * g_cov_21;
    SecondOrderTermsNCP_22 -= 1./3. * traceNCP * g_cov_22;

    const double beta_0 = Q[17];
    const double beta_1 = Q[18];
    const double beta_2 = Q[19];

    const double dAex_000 = gradQin_60; const double dAex_001 = gradQin_70;  const double dAex_002 = gradQin_80;
    const double dAex_010 = gradQin_70; const double dAex_011 = gradQin_90;  const double dAex_012 = gradQin_100;
    const double dAex_020 = gradQin_80; const double dAex_021 = gradQin_100; const double dAex_022 = gradQin_110;

    const double dAex_100 = gradQin_61; const double dAex_101 = gradQin_71;  const double dAex_102 = gradQin_81;
    const double dAex_110 = gradQin_71; const double dAex_111 = gradQin_91;  const double dAex_112 = gradQin_101;
    const double dAex_120 = gradQin_81; const double dAex_121 = gradQin_101; const double dAex_122 = gradQin_111;

    const double dAex_200 = gradQin_62; const double dAex_201 = gradQin_72;  const double dAex_202 = gradQin_82;
    const double dAex_210 = gradQin_72; const double dAex_211 = gradQin_92;  const double dAex_212 = gradQin_102;
    const double dAex_220 = gradQin_82; const double dAex_221 = gradQin_102; const double dAex_222 = gradQin_112;


    double dtK_00 = phi2 * SecondOrderTermsNCP_00 + advec * (beta_0 * dAex_000 + beta_1 * dAex_100 + beta_2 * dAex_200);
    double dtK_01 = phi2 * SecondOrderTermsNCP_01 + advec * (beta_0 * dAex_001 + beta_1 * dAex_101 + beta_2 * dAex_201);
    double dtK_02 = phi2 * SecondOrderTermsNCP_02 + advec * (beta_0 * dAex_002 + beta_1 * dAex_102 + beta_2 * dAex_202);

    double dtK_10 = phi2 * SecondOrderTermsNCP_10 + advec * (beta_0 * dAex_010 + beta_1 * dAex_110 + beta_2 * dAex_210);
    double dtK_11 = phi2 * SecondOrderTermsNCP_11 + advec * (beta_0 * dAex_011 + beta_1 * dAex_111 + beta_2 * dAex_211);
    double dtK_12 = phi2 * SecondOrderTermsNCP_12 + advec * (beta_0 * dAex_012 + beta_1 * dAex_112 + beta_2 * dAex_212);

    double dtK_20 = phi2 * SecondOrderTermsNCP_20 + advec * (beta_0 * dAex_020 + beta_1 * dAex_120 + beta_2 * dAex_220);
    double dtK_21 = phi2 * SecondOrderTermsNCP_21 + advec * (beta_0 * dAex_021 + beta_1 * dAex_121 + beta_2 * dAex_221);
    double dtK_22 = phi2 * SecondOrderTermsNCP_22 + advec * (beta_0 * dAex_022 + beta_1 * dAex_122 + beta_2 * dAex_222);


    const double dtraceK_0 = gradQin_530;
    const double dtraceK_1 = gradQin_531;
    const double dtraceK_2 = gradQin_532;

    double dtTraceK = -nablanablaalphaNCP + alpha*RPlusTwoNablaZNCP + advec*(beta_0*dtraceK_0 + beta_1*dtraceK_1 + beta_2*dtraceK_2);

    const double BB_00 = Q[26]; const double BB_01 = Q[27]; const double BB_02 = Q[28];
    const double BB_10 = Q[29]; const double BB_11 = Q[30]; const double BB_12 = Q[31];
    const double BB_20 = Q[32]; const double BB_21 = Q[33]; const double BB_22 = Q[34];

    double traceB = BB_00 + BB_11 + BB_22; // TODO direct from Q!

    double Aupdown = Aex_00 * Aup_00 + Aex_01 * Aup_01 + Aex_02 * Aup_02 +
                     Aex_10 * Aup_10 + Aex_11 * Aup_11 + Aex_12 * Aup_12 +
                     Aex_20 * Aup_20 + Aex_21 * Aup_21 + Aex_22 * Aup_22;


    const double dTheta_0 = gradQin_120;
    const double dTheta_1 = gradQin_121;
    const double dTheta_2 = gradQin_122;
    double dtTheta = 0.5*alpha*CCZ4e*CCZ4e*RPlusTwoNablaZNCP + advec*(beta_0*dTheta_0 + beta_1*dTheta_1 + beta_2*dTheta_2);

    const double dBB_000 = CCZ4sk * gradQin_260; const double dBB_001 = CCZ4sk * gradQin_270; const double dBB_002 = CCZ4sk * gradQin_280;
    const double dBB_010 = CCZ4sk * gradQin_290; const double dBB_011 = CCZ4sk * gradQin_300; const double dBB_012 = CCZ4sk * gradQin_310;
    const double dBB_020 = CCZ4sk * gradQin_320; const double dBB_021 = CCZ4sk * gradQin_330; const double dBB_022 = CCZ4sk * gradQin_340;

    const double dBB_100 = CCZ4sk * gradQin_260; const double dBB_101 = CCZ4sk * gradQin_271; const double dBB_102 = CCZ4sk * gradQin_281;
    const double dBB_110 = CCZ4sk * gradQin_290; const double dBB_111 = CCZ4sk * gradQin_301; const double dBB_112 = CCZ4sk * gradQin_311;
    const double dBB_120 = CCZ4sk * gradQin_320; const double dBB_121 = CCZ4sk * gradQin_331; const double dBB_122 = CCZ4sk * gradQin_341;

    const double dBB_200 = CCZ4sk * gradQin_262; const double dBB_201 = CCZ4sk * gradQin_272; const double dBB_202 = CCZ4sk * gradQin_282;
    const double dBB_210 = CCZ4sk * gradQin_292; const double dBB_211 = CCZ4sk * gradQin_302; const double dBB_212 = CCZ4sk * gradQin_312;
    const double dBB_220 = CCZ4sk * gradQin_322; const double dBB_221 = CCZ4sk * gradQin_332; const double dBB_222 = CCZ4sk * gradQin_342;

    double temp, temp2;
    
    temp = g_contr_00 * dtraceK_0 + g_contr_01 * dtraceK_1 + g_contr_02 * dtraceK_2;
    temp2 = g_contr_00 * dTheta_0 + g_contr_10 * dTheta_1 + g_contr_20 * dTheta_2;
    //printf("Temp1: %f\n", temp);
    //printf("Temp2: %f\n", temp2);
    double dtGhat_0 = -4./3. * alpha*temp + 2 * alpha * temp2 + advec * (beta_0 * dGhat_00 + beta_1 * dGhat_10 + beta_2 * dGhat_20);
    
    //printf("dtGhat: %f\n", dtGhat_0);
    dtGhat_0 += g_contr_00 * 0.5 * (dBB_000 + dBB_000) + 1./3. * g_contr_00 * 0.5 * (dBB_000 + dBB_000);
    dtGhat_0 += g_contr_10 * 0.5 * (dBB_100 + dBB_010) + 1./3. * g_contr_01 * 0.5 * (dBB_100 + dBB_010);
    dtGhat_0 += g_contr_20 * 0.5 * (dBB_200 + dBB_020) + 1./3. * g_contr_02 * 0.5 * (dBB_200 + dBB_020);
    dtGhat_0 += g_contr_01 * 0.5 * (dBB_010 + dBB_100) + 1./3. * g_contr_00 * 0.5 * (dBB_011 + dBB_101);
    dtGhat_0 += g_contr_11 * 0.5 * (dBB_110 + dBB_110) + 1./3. * g_contr_01 * 0.5 * (dBB_111 + dBB_111);
    dtGhat_0 += g_contr_21 * 0.5 * (dBB_210 + dBB_120) + 1./3. * g_contr_02 * 0.5 * (dBB_211 + dBB_121);
    dtGhat_0 += g_contr_02 * 0.5 * (dBB_020 + dBB_200) + 1./3. * g_contr_00 * 0.5 * (dBB_022 + dBB_202);
    dtGhat_0 += g_contr_12 * 0.5 * (dBB_120 + dBB_210) + 1./3. * g_contr_01 * 0.5 * (dBB_122 + dBB_212);
    dtGhat_0 += g_contr_22 * 0.5 * (dBB_220 + dBB_220) + 1./3. * g_contr_02 * 0.5 * (dBB_222 + dBB_222);
    //printf("dtGhat: %f\n", dtGhat_0);
    //printf("dtGhat B: %f\n", dtGhat_0);

    temp = g_contr_10 * dtraceK_0 + g_contr_11 * dtraceK_1 + g_contr_12 * dtraceK_2;
    temp2 = g_contr_01 * dTheta_0 + g_contr_11 * dTheta_1 + g_contr_21 * dTheta_2;
    //printf("Temp1: %f\n", temp);
    //printf("Temp2: %f\n", temp2);
    double dtGhat_1 = -4./3. * alpha*temp + 2 * alpha * temp2 + advec * (beta_0 * dGhat_01 + beta_1 * dGhat_11 + beta_2 * dGhat_21);
    //printf("dtGhat: %f\n", dtGhat_1);
    dtGhat_1 += g_contr_00 * 0.5 * (dBB_001 + dBB_001) + 1./3. * g_contr_10 * 0.5 * (dBB_000 + dBB_000);
    dtGhat_1 += g_contr_10 * 0.5 * (dBB_101 + dBB_011) + 1./3. * g_contr_11 * 0.5 * (dBB_100 + dBB_010);
    dtGhat_1 += g_contr_20 * 0.5 * (dBB_201 + dBB_021) + 1./3. * g_contr_12 * 0.5 * (dBB_200 + dBB_020);
    dtGhat_1 += g_contr_01 * 0.5 * (dBB_011 + dBB_101) + 1./3. * g_contr_10 * 0.5 * (dBB_011 + dBB_101);
    dtGhat_1 += g_contr_11 * 0.5 * (dBB_111 + dBB_111) + 1./3. * g_contr_11 * 0.5 * (dBB_111 + dBB_111);
    dtGhat_1 += g_contr_21 * 0.5 * (dBB_211 + dBB_121) + 1./3. * g_contr_12 * 0.5 * (dBB_211 + dBB_121);
    dtGhat_1 += g_contr_02 * 0.5 * (dBB_021 + dBB_201) + 1./3. * g_contr_10 * 0.5 * (dBB_022 + dBB_202);
    dtGhat_1 += g_contr_12 * 0.5 * (dBB_121 + dBB_211) + 1./3. * g_contr_11 * 0.5 * (dBB_122 + dBB_212);
    dtGhat_1 += g_contr_22 * 0.5 * (dBB_221 + dBB_221) + 1./3. * g_contr_12 * 0.5 * (dBB_222 + dBB_222);
    //printf("dtGhat: %f\n", dtGhat_1);

    temp = g_contr_20 * dtraceK_0 + g_contr_21 * dtraceK_1 + g_contr_22 * dtraceK_2;
    temp2 = g_contr_02 * dTheta_0 + g_contr_12 * dTheta_1 + g_contr_22 * dTheta_2;
    //printf("Temp1: %f\n", temp);
    //printf("Temp2: %f\n", temp2);
    double dtGhat_2 = -4./3. * alpha*temp + 2 * alpha * temp2 + advec * (beta_0 * dGhat_02 + beta_1 * dGhat_12 + beta_2 * dGhat_22);
    //printf("dtGhat: %f\n", dtGhat_2);
    dtGhat_2 += g_contr_00 * 0.5 * (dBB_002 + dBB_002) + 1./3. * g_contr_20 * 0.5 * (dBB_000 + dBB_000);
    dtGhat_2 += g_contr_10 * 0.5 * (dBB_102 + dBB_012) + 1./3. * g_contr_21 * 0.5 * (dBB_100 + dBB_010);
    dtGhat_2 += g_contr_20 * 0.5 * (dBB_202 + dBB_022) + 1./3. * g_contr_22 * 0.5 * (dBB_200 + dBB_020);
    dtGhat_2 += g_contr_01 * 0.5 * (dBB_012 + dBB_102) + 1./3. * g_contr_20 * 0.5 * (dBB_011 + dBB_101);
    dtGhat_2 += g_contr_11 * 0.5 * (dBB_112 + dBB_112) + 1./3. * g_contr_21 * 0.5 * (dBB_111 + dBB_111);
    dtGhat_2 += g_contr_21 * 0.5 * (dBB_212 + dBB_122) + 1./3. * g_contr_22 * 0.5 * (dBB_211 + dBB_121);
    dtGhat_2 += g_contr_02 * 0.5 * (dBB_022 + dBB_202) + 1./3. * g_contr_20 * 0.5 * (dBB_022 + dBB_202);
    dtGhat_2 += g_contr_12 * 0.5 * (dBB_122 + dBB_212) + 1./3. * g_contr_21 * 0.5 * (dBB_122 + dBB_212);
    dtGhat_2 += g_contr_22 * 0.5 * (dBB_222 + dBB_222) + 1./3. * g_contr_22 * 0.5 * (dBB_222 + dBB_222);
    //printf("dtGhat: %f\n", dtGhat_2);

