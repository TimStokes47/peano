    RicciPlusNablaZSrc_00 += g_contr_11 * ( Christoffel_tilde_100 * Christoffel_tilde_down_001 + Christoffel_tilde_100 * Christoffel_tilde_down_001 + Christoffel_tilde_010 * Christoffel_tilde_down_010 ) - g_cov_00 * g_contr_11 * Christoffel_tilde_110 * PP_0 / (np*chi);
    RicciPlusNablaZSrc_00 += g_contr_12 * ( Christoffel_tilde_100 * Christoffel_tilde_down_002 + Christoffel_tilde_100 * Christoffel_tilde_down_002 + Christoffel_tilde_020 * Christoffel_tilde_down_010 ) - g_cov_00 * g_contr_12 * Christoffel_tilde_120 * PP_0 / (np*chi);
    RicciPlusNablaZSrc_00 -= (np + 1.0) * g_cov_00 * g_contr_02 * PP_0 * PP_2 / (np * np * chi * chi);
