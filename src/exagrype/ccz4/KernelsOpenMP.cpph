    RicciPlusNablaZSrc_00 += g_contr_01 * ( Christoffel_tilde_000 * Christoffel_tilde_down_001 + Christoffel_tilde_000 * Christoffel_tilde_down_001 + Christoffel_tilde_010 * Christoffel_tilde_down_000 ) - g_cov_00 * g_contr_01 * Christoffel_tilde_010 * PP_0 / (np*chi);
    RicciPlusNablaZSrc_00 += g_contr_02 * ( Christoffel_tilde_000 * Christoffel_tilde_down_002 + Christoffel_tilde_000 * Christoffel_tilde_down_002 + Christoffel_tilde_020 * Christoffel_tilde_down_000 ) - g_cov_00 * g_contr_02 * Christoffel_tilde_020 * PP_0 / (np*chi);
    RicciPlusNablaZSrc_00 -= (np + 1.0) * g_cov_00 * g_contr_01 * PP_0 * PP_1 / (np * np * chi * chi);
