    RicciPlusNablaZSrc_00 += g_contr_01 * ( Christoffel_tilde_001 * Christoffel_tilde_down_011 + Christoffel_tilde_001 * Christoffel_tilde_down_011 + Christoffel_tilde_011 * Christoffel_tilde_down_100 ) - g_cov_00 * g_contr_01 * Christoffel_tilde_011 * PP_1 / (np*chi);
