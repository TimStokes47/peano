#include "tarch/accelerator/accelerator.h"
#include "tarch/accelerator/GPUMemoryManager.h"
#include <cstring>

template<typename inType, typename outType>
exahype2::CellData<inType, outType>::CellData(
  inType*                                      QIn_,
  const tarch::la::Vector<Dimensions, double>& cellCentre_,
  const tarch::la::Vector<Dimensions, double>& cellSize_,
  double                                       t_,
  double                                       dt_,
  outType*                                     QOut_,
  tarch::MemoryLocation                        memoryLocation_,
  int                                          targetDevice_,
  peano4::datamanagement::PatchWithHaloDeviceMemoryStatus   deviceMemoryStatus_ 
):
  CellData(1, memoryLocation_, targetDevice_) {
  QIn[0]          = QIn_;
  cellCentre[0]   = cellCentre_;
  cellSize[0]     = cellSize_;
  t[0]            = t_;
  dt[0]           = dt_;
  QOut[0]         = QOut_;
  deviceMemoryStatus[0] = deviceMemoryStatus_;
  id[0]           = -1;
}

template<typename inType, typename outType>
exahype2::CellData<inType, outType>::CellData(
  int                   numberOfCells_,
  tarch::MemoryLocation memoryLocation_,
  int                   targetDevice_
):
  numberOfCells(numberOfCells_),
  memoryLocation(memoryLocation_),
  targetDevice(targetDevice_) {
  QIn           = tarch::allocateMemory<inType*>(numberOfCells_, memoryLocation_, targetDevice_);
  cellCentre    = tarch::allocateMemory<tarch::la::Vector<Dimensions, double>>(numberOfCells_, memoryLocation_, targetDevice_);
  cellSize      = tarch::allocateMemory<tarch::la::Vector<Dimensions, double>>(numberOfCells_, memoryLocation_, targetDevice_);
  t             = tarch::allocateMemory<double>(numberOfCells_, memoryLocation_, targetDevice_);
  dt            = tarch::allocateMemory<double>(numberOfCells_, memoryLocation_, targetDevice_);
  id            = tarch::allocateMemory<int>(numberOfCells_, memoryLocation_, targetDevice_);
  QOut          = tarch::allocateMemory<outType*>(numberOfCells_, memoryLocation_, targetDevice_);
  maxEigenvalue = tarch::allocateMemory<double>(numberOfCells_, memoryLocation_, targetDevice_);
  deviceMemoryStatus  = tarch::allocateMemory<peano4::datamanagement::PatchWithHaloDeviceMemoryStatus>(numberOfCells_, memoryLocation_, tarch::accelerator::Device::HostDevice);
}

template<typename inType, typename outType>
exahype2::CellData<inType, outType>::~CellData() {
  tarch::freeMemory(QIn, memoryLocation, targetDevice);
  tarch::freeMemory(cellCentre, memoryLocation, targetDevice);
  tarch::freeMemory(cellSize, memoryLocation, targetDevice);
  tarch::freeMemory(t, memoryLocation, targetDevice);
  tarch::freeMemory(dt, memoryLocation, targetDevice);
  tarch::freeMemory(QOut, memoryLocation, targetDevice);
  tarch::freeMemory(id, memoryLocation, targetDevice);
  tarch::freeMemory(maxEigenvalue, memoryLocation, targetDevice);
}

template<typename inType, typename outType>
std::string exahype2::CellData<inType, outType>::toString() const {
  std::ostringstream msg;
  msg << "[";
  for (int i = 0; i < numberOfCells; i++) {
    msg << "(x=" << cellCentre[i] << ",h=" << cellSize[i] << ",t=" << t[i] << ",dt=" << dt[i] << ",id=" << id[i]
        << ",lambda=" << maxEigenvalue[i] << ")";
  }
  msg << "]";
  return msg.str();
}

#if defined(GPUOffloadingSYCL)
template<typename inType, typename outType>
exahype2::CopyCellDataGPU<inType, outType>::CopyCellDataGPU(
  const CellData<inType, outType>& cellData,
  int inputPatchSize,
  int outputPatchSize,
  int device
):
  numberOfCells(cellData.numberOfCells),
  memoryLocation(cellData.memoryLocation),
  targetDevice(device),
  QInStride(inputPatchSize),
  QOutStride(outputPatchSize) {
  sycl::queue& queue = tarch::accelerator::getSYCLQueue(targetDevice);
  QIn           = tarch::accelerator::GPUMemoryManager::getInstance().allocate<inType>(cellData.numberOfCells * inputPatchSize, queue);
  QOut          = tarch::accelerator::GPUMemoryManager::getInstance().allocate<inType>(cellData.numberOfCells * outputPatchSize, queue);
  cellCentre    = tarch::accelerator::GPUMemoryManager::getInstance().allocate<tarch::la::Vector<Dimensions, double>>(cellData.numberOfCells, queue);
  cellSize      = tarch::accelerator::GPUMemoryManager::getInstance().allocate<tarch::la::Vector<Dimensions, double>>(cellData.numberOfCells, queue);
  t             = tarch::accelerator::GPUMemoryManager::getInstance().allocate<double>(cellData.numberOfCells, queue);
  dt            = tarch::accelerator::GPUMemoryManager::getInstance().allocate<double>(cellData.numberOfCells, queue);
  id            = tarch::accelerator::GPUMemoryManager::getInstance().allocate<int>(cellData.numberOfCells, queue);
  maxEigenvalue = tarch::accelerator::GPUMemoryManager::getInstance().allocate<double>(cellData.numberOfCells, queue);
  QInHost = cellData.QIn;
  QOutHost = cellData.QOut;
  maxEigenvalueHost = cellData.maxEigenvalue;

  std::vector<::sycl::event> copyEvent(numberOfCells + 6);
  for (int i = 0; i < numberOfCells; i++){
    copyEvent[i] = queue.memcpy(&QIn[i * QInStride], cellData.QIn[i], QInStride * sizeof(inType));
  }
  copyEvent[numberOfCells + 0] = queue.memcpy(cellCentre, cellData.cellCentre, numberOfCells * sizeof(tarch::la::Vector<Dimensions, double>));
  copyEvent[numberOfCells + 1] = queue.memcpy(cellSize, cellData.cellSize, numberOfCells * sizeof(tarch::la::Vector<Dimensions, double>));
  copyEvent[numberOfCells + 2] = queue.memcpy(t, cellData.t, numberOfCells * sizeof(double));
  copyEvent[numberOfCells + 3] = queue.memcpy(dt, cellData.dt, numberOfCells * sizeof(double));
  copyEvent[numberOfCells + 4] = queue.memcpy(id, cellData.id, numberOfCells * sizeof(int));
  copyEvent[numberOfCells + 5] = queue.memcpy(maxEigenvalue, cellData.maxEigenvalue, numberOfCells * sizeof(double));
  
  ::sycl::event::wait(copyEvent);
}

template<typename inType, typename outType>
void exahype2::CopyCellDataGPU<inType, outType>::copyBackAndDestroy() {
  auto queue = tarch::accelerator::getSYCLQueue(targetDevice);

  std::vector<::sycl::event> copyEvent(numberOfCells + 1);
  for (int i = 0; i < numberOfCells; i++){
    copyEvent[i] = queue.memcpy(QOutHost[i], &QOut[i * QOutStride], QOutStride * sizeof(outType));
  }
  copyEvent[numberOfCells] = queue.memcpy(maxEigenvalueHost, maxEigenvalue, numberOfCells * sizeof(double));
  ::sycl::event::wait(copyEvent);

  tarch::accelerator::GPUMemoryManager::getInstance().free(QIn, queue);
  tarch::accelerator::GPUMemoryManager::getInstance().free(QOut, queue);
  tarch::accelerator::GPUMemoryManager::getInstance().free(cellCentre, queue);
  tarch::accelerator::GPUMemoryManager::getInstance().free(cellSize, queue);
  tarch::accelerator::GPUMemoryManager::getInstance().free(t, queue);
  tarch::accelerator::GPUMemoryManager::getInstance().free(dt, queue);
  tarch::accelerator::GPUMemoryManager::getInstance().free(id, queue);
  tarch::accelerator::GPUMemoryManager::getInstance().free(maxEigenvalue, queue);
}

