template<typename inType, typename outType>
exahype2::CopyCellDataGPU<inType, outType>::CopyCellDataGPU(
  const CellData<inType, outType>& cellData,
  int inputPatchSize,
  int outputPatchSize,
  int device
):
  numberOfCells(cellData.numberOfCells),
  memoryLocation(cellData.memoryLocation),
  QInStride(inputPatchSize),
  QOutStride(outputPatchSize),
  targetDevice(0)
  {
  QIn           = tarch::accelerator::GPUMemoryManager::getInstance().allocate<inType>(cellData.numberOfCells * inputPatchSize, targetDevice);
  QOut          = tarch::accelerator::GPUMemoryManager::getInstance().allocate<outType>(cellData.numberOfCells * outputPatchSize, targetDevice);
  cellCentre    = tarch::accelerator::GPUMemoryManager::getInstance().allocate<tarch::la::Vector<Dimensions, double>>(cellData.numberOfCells, targetDevice);
  cellSize      = tarch::accelerator::GPUMemoryManager::getInstance().allocate<tarch::la::Vector<Dimensions, double>>(cellData.numberOfCells, targetDevice);
  t             = tarch::accelerator::GPUMemoryManager::getInstance().allocate<double>(cellData.numberOfCells, targetDevice);
  dt            = tarch::accelerator::GPUMemoryManager::getInstance().allocate<double>(cellData.numberOfCells, targetDevice);
  id            = tarch::accelerator::GPUMemoryManager::getInstance().allocate<int>(cellData.numberOfCells, targetDevice);
  maxEigenvalue = tarch::accelerator::GPUMemoryManager::getInstance().allocate<double>(cellData.numberOfCells, targetDevice);
  QInHost = cellData.QIn;
  QOutHost = cellData.QOut;
  maxEigenvalueHost = cellData.maxEigenvalue;

  for (int i = 0; i < numberOfCells; i++){
    if (cellData.deviceMemoryStatus[i] == peano4::datamanagement::PatchWithHaloDeviceMemoryStatus::Exclusive) {
      omp_target_memcpy(&QIn[i * QInStride], cellData.QIn[i], QInStride * sizeof(inType), 0, 0, targetDevice, targetDevice);
    } else {
      omp_target_memcpy(&QIn[i * QInStride], cellData.QIn[i], QInStride * sizeof(inType), 0, 0, targetDevice, omp_get_initial_device());
    }
  }
  omp_target_memcpy(cellCentre, cellData.cellCentre, numberOfCells * sizeof(tarch::la::Vector<Dimensions, double>), 0, 0, targetDevice, omp_get_initial_device());
  omp_target_memcpy(cellSize, cellData.cellSize, numberOfCells * sizeof(tarch::la::Vector<Dimensions, double>), 0, 0, targetDevice, omp_get_initial_device());
  omp_target_memcpy(t, cellData.t, numberOfCells * sizeof(double), 0, 0, targetDevice, omp_get_initial_device());
  omp_target_memcpy(dt, cellData.dt, numberOfCells * sizeof(double), 0, 0, targetDevice, omp_get_initial_device());
  omp_target_memcpy(id, cellData.id, numberOfCells * sizeof(int), 0, 0, targetDevice, omp_get_initial_device());
  omp_target_memcpy(maxEigenvalue, cellData.maxEigenvalue, numberOfCells * sizeof(double), 0, 0, targetDevice, omp_get_initial_device());
}

template<typename inType, typename outType>
void exahype2::CopyCellDataGPU<inType, outType>::copyBackAndDestroy() {
  for (int i = 0; i < numberOfCells; i++){
    omp_target_memcpy(QOutHost[i], &QOut[i * QOutStride], QOutStride * sizeof(outType), 0, 0, omp_get_initial_device(), targetDevice);
  }
  omp_target_memcpy(maxEigenvalueHost, maxEigenvalue, numberOfCells * sizeof(double), 0, 0, omp_get_initial_device(), targetDevice);

  tarch::accelerator::GPUMemoryManager::getInstance().free(QIn, targetDevice);
  tarch::accelerator::GPUMemoryManager::getInstance().free(QOut, targetDevice);
  tarch::accelerator::GPUMemoryManager::getInstance().free(cellCentre, targetDevice);
  tarch::accelerator::GPUMemoryManager::getInstance().free(cellSize, targetDevice);
  tarch::accelerator::GPUMemoryManager::getInstance().free(t, targetDevice);
  tarch::accelerator::GPUMemoryManager::getInstance().free(dt, targetDevice);
  tarch::accelerator::GPUMemoryManager::getInstance().free(id, targetDevice);
  tarch::accelerator::GPUMemoryManager::getInstance().free(maxEigenvalue, targetDevice);
}
#else
template<typename inType, typename outType>
exahype2::CopyCellDataGPU<inType, outType>::CopyCellDataGPU(
  const CellData<inType, outType>& cellData,
  int inputPatchSize,
  int outputPatchSize,
  int device
):
  numberOfCells(cellData.numberOfCells),
  memoryLocation(cellData.memoryLocation),
  QInStride(inputPatchSize),
  QOutStride(outputPatchSize),
  targetDevice(device == -1 ? cellData.targetDevice : device) 
  {
  QIn           = tarch::allocateMemory<inType>(cellData.numberOfCells * inputPatchSize, memoryLocation, targetDevice);
  cellCentre    = tarch::allocateMemory<tarch::la::Vector<Dimensions, double>>(cellData.numberOfCells, memoryLocation, targetDevice);
  cellSize      = tarch::allocateMemory<tarch::la::Vector<Dimensions, double>>(cellData.numberOfCells, memoryLocation, targetDevice);
  t             = tarch::allocateMemory<double>(cellData.numberOfCells, memoryLocation, targetDevice);
  dt            = tarch::allocateMemory<double>(cellData.numberOfCells, memoryLocation, targetDevice);
  id            = tarch::allocateMemory<int>(cellData.numberOfCells, memoryLocation, targetDevice);
  QOut          = tarch::allocateMemory<outType>(cellData.numberOfCells * outputPatchSize, memoryLocation, targetDevice);
  maxEigenvalue = tarch::allocateMemory<double>(cellData.numberOfCells, memoryLocation, targetDevice);
  QInHost = cellData.QIn;
  QOutHost = cellData.QOut;
  maxEigenvalueHost = cellData.maxEigenvalue;
  
  for (int i = 0; i < numberOfCells; i++){
    std::memcpy(&QOut[i * QOutStride], cellData.QOut[i], QOutStride * sizeof(outType));
  }
  std::memcpy(cellCentre, cellData.cellCentre, numberOfCells * sizeof(tarch::la::Vector<Dimensions, double>));
  std::memcpy(cellSize, cellData.cellSize, numberOfCells * sizeof(tarch::la::Vector<Dimensions, double>));
  std::memcpy(t, cellData.t, numberOfCells * sizeof(double));
  std::memcpy(dt, cellData.dt, numberOfCells * sizeof(double));
  std::memcpy(id, cellData.id, numberOfCells * sizeof(int));
  std::memcpy(maxEigenvalue, cellData.maxEigenvalue, numberOfCells * sizeof(double));
}

template<typename inType, typename outType>
void exahype2::CopyCellDataGPU<inType, outType>::copyBackAndDestroy() {
  for (int i = 0; i < numberOfCells; i++){
    std::memcpy(QOutHost[i], &QOut[i * QOutStride], QOutStride * sizeof(outType));
  }

  tarch::freeMemory(QIn, memoryLocation, targetDevice);
  tarch::freeMemory(cellCentre, memoryLocation, targetDevice);
  tarch::freeMemory(cellSize, memoryLocation, targetDevice);
  tarch::freeMemory(t, memoryLocation, targetDevice);
  tarch::freeMemory(dt, memoryLocation, targetDevice);
  tarch::freeMemory(QOut, memoryLocation, targetDevice);
  tarch::freeMemory(id, memoryLocation, targetDevice);
  tarch::freeMemory(maxEigenvalue, memoryLocation, targetDevice);
}
#endif

template<typename inType, typename outType>
std::string exahype2::CopyCellDataGPU<inType, outType>::toString() const {
  std::ostringstream msg;
  msg << "[";
  for (int i = 0; i < numberOfCells; i++) {
    msg << "(x=" << cellCentre[i] << ",h=" << cellSize[i] << ",t=" << t[i] << ",dt=" << dt[i] << ",id=" << id[i]
        << ",lambda=" << maxEigenvalue[i] << ")";
  }
  msg << "]";
  return msg.str();
}
