// use, please see the copyright notice at www.peano-framework.org

#include <cstring>

#include "exahype2/aderdg/KernelUtils.h"

#if Dimensions == 3

/*
 * For the linear kernels, we need the material parameters in the
 * space-time predictor lQi, time-averaged predictor lQhi,
 * and extrapolated predictor lQhbnd.
 * Currently we simply copy them over from the solution array.
 */
template <
  bool EvaluatePointSource,
  bool EvaluateAlgebraicSource,
  bool EvaluateFlux,
  bool EvaluateNonconservativeProduct,
  bool EvaluateMaterialParameters,
  class SolverType,
  class pCompType,
  class pStoreType>
void exahype2::aderdg::generic::spaceTimePredictorLinearFused(
  pStoreType* lQbnd,
  pStoreType* lFbnd,
  pCompType*  lQi,
  pCompType*  lFi,
  pCompType*  gradQ,
  pCompType*  PSi,
  pCompType*  PSderivatives,
  pCompType*  tmp_PSderivatives,
  pCompType*  lQhi,
  pCompType*  lFhi,
  int         targetDevice,
  CellData&   cellData,
  int         numberOfResultValues
) {
  // Define constants
  static constexpr int NumberOfUnknowns           = SolverType::NumberOfUnknowns;
  static constexpr int NumberOfAuxiliaryVariables = SolverType::NumberOfAuxiliaryVariables;
  static constexpr int NumberOfData               = NumberOfUnknowns + NumberOfAuxiliaryVariables;
  static constexpr int BasisSize                  = SolverType::Order + 1;
  static constexpr int BasisSize2                 = BasisSize * BasisSize;
  static constexpr int BasisSize3                 = BasisSize2 * BasisSize;
  static constexpr int BasisSize4                 = BasisSize2 * BasisSize2;
  static constexpr int Order                      = BasisSize - 1;
  static constexpr int SourceIndex                = Dimensions;

  #if Dimensions==2
  static constexpr int spaceBasisSize     = (Order + 1) * (Order + 1);
  static constexpr int spaceFaceSize      = (Order + 1);
#else
  static constexpr int spaceBasisSize     = (Order + 1) * (Order + 1) * (Order + 1);
  static constexpr int spaceFaceSize      = (Order + 1) * (Order + 1);
#endif

  static constexpr int spaceTimeBasisSize = spaceBasisSize * (Order + 1);

  static constexpr int basisElementsPerFace  = spaceFaceSize * (NumberOfUnknowns + NumberOfAuxiliaryVariables);
  static constexpr int fluxElementsPerFace   = spaceFaceSize * NumberOfUnknowns;

  static constexpr int sizeLQi   = (NumberOfUnknowns+NumberOfAuxiliaryVariables) * spaceTimeBasisSize * (Order + 1);
  static constexpr int sizeRhs   = sizeLQi;
  static constexpr int sizeLFi   = (Dimensions + 1) * NumberOfUnknowns * spaceTimeBasisSize; // Dimensions + 1 because this is also used for lShi, which contains source terms. TODO: Make its own storage.
  static constexpr int sizeGradQ = Dimensions * NumberOfUnknowns * spaceBasisSize;

  static constexpr int sizeLQhi = (NumberOfUnknowns + NumberOfAuxiliaryVariables) * spaceBasisSize;
  static constexpr int sizeLFhi = (Dimensions + 1) * NumberOfUnknowns * spaceBasisSize;

  static constexpr int sizeLduh = sizeLQhi;

  const int     numberOfCells          = cellData.numberOfCells;
  const double* rawPointerToCellCentre = cellData.cellCentre[0].data();
  const double* rawPointerToCellSize   = cellData.cellSize[0].data();
  const double* rawPointerToT          = cellData.t;
  const double* rawPointerToDt         = cellData.dt;
  double*       mappedPointersToQIn    = new double[numberOfCells * numberOfResultValues];
  for (int cellIndex = 0; cellIndex < numberOfCells; cellIndex++) {
    std::memcpy(&mappedPointersToQIn[cellIndex * numberOfResultValues], cellData.QIn[cellIndex], numberOfResultValues * sizeof(double));
  }

  // clang-format off
#pragma omp target teams distribute device(targetDevice) \
  map(to : \
    rawPointerToCellCentre[0 : numberOfCells * Dimensions], \
    rawPointerToCellSize[0 : numberOfCells * Dimensions], \
    rawPointerToT[0 : numberOfCells], \
    rawPointerToDt[0 : numberOfCells], \
    mappedPointersToQIn[0 : numberOfCells * numberOfResultValues], \
    lQi[0 : sizeLQi], \
    lFi[0 : sizeLFi], \
    gradQ[0 : sizeGradQ], \
    lQhi[0 : sizeLQhi], \
    lFhi[0 : sizeLFhi] \
  ) \
  map(from : \
    lQbnd[0 : 2*Dimensions*spaceFaceSize*(NumberOfUnknowns+NumberOfAuxiliaryVariables)], \
    lFbnd[0 : 2*Dimensions*spaceFaceSize*NumberOfUnknowns] \
  )
  // clang-format on
  for (int cellIndex = 0; cellIndex < numberOfCells; cellIndex++) {
    const pCompType* const                       luh        = &mappedPointersToQIn[cellIndex * numberOfResultValues];
    const tarch::la::Vector<Dimensions, double>& cellCenter = rawPointerToCellCentre[cellIndex];
    const tarch::la::Vector<Dimensions, double>& dx         = rawPointerToCellSize[cellIndex];
    const pCompType                              t          = rawPointerToT[cellIndex];
    const pCompType                              dt         = rawPointerToDt[cellIndex];
    const pCompType                              invDt      = 1.0 / dt;
    const tarch::la::Vector<Dimensions, double>& invDx      = tarch::la::invertEntries(dx);

    // Matrices

    // double* PSi = tempPointForceSources[0]; // nullptr if bnot EvaluatePointSource, size: BasisSize3 * (BasisSize + 1) * NumberOfUnknowns
    idx5 idx_PSi(BasisSize + 1, BasisSize, BasisSize, BasisSize, NumberOfUnknowns);

    // double* PSderivatives = tempPointForceSources[1]; // nullptr if bnot EvaluatePointSource, size: BasisSize3 * (BasisSize + 1) * NumberOfUnknowns
    // double* tmp_PSderivatives = tempSpaceTimeFluxUnknowns[0]; // it's actually lFi used here as a temp array // TODO: do something cleaner?
    idx5 idx_PSderivatives(BasisSize, BasisSize, BasisSize, BasisSize, NumberOfUnknowns); // No need for 0th time derivative

    // double* lQi = tempSpaceTimeUnknowns[0]; // size: BasisSize3 * (BasisSize + 1) * NumberOfData;
    idx5 idx_lQi(BasisSize + 1, BasisSize, BasisSize, BasisSize, NumberOfData);
    std::fill_n(lQi, BasisSize3 * (BasisSize + 1) * NumberOfData, 0.0);

    // double* lFi = tempSpaceTimeFluxUnknowns[0]; // size: BasisSize4 * Dimensions+1 * NumberOfUnknowns
    idx6 idx_lFi(BasisSize, BasisSize, BasisSize, BasisSize, Dimensions + 1, NumberOfUnknowns);
    std::fill_n(lFi, BasisSize4 * (Dimensions + 1) * NumberOfUnknowns, 0.0);

    // double* gradQ = tempSpaceTimeFluxUnknowns[1]; // nullptr if not EvaluateNonconservativeProduct, size: BasisSize3 * Dimensions * NumberOfUnknowns
    idx5 idx_gradQ(BasisSize, BasisSize, BasisSize, Dimensions, NumberOfUnknowns);

    idx4 idx_luh(BasisSize, BasisSize, BasisSize, NumberOfData);

    // Local tmp array
    pCompType fluxDerivative[BasisSize * NumberOfUnknowns];
    idx2      idx_fluxDerivative(BasisSize, NumberOfUnknowns);

    pCompType ncpResult[NumberOfUnknowns] = {0.0};

    //***************************
    //**** Cauchy-Kovalewski ****
    //***************************

    // 1. Initialise time derivative
    // The zeroth time derivative (time dof number 1) is the initial condition

#if defined(GPUOffloadingOMP)
#pragma omp parallel for simd collapse(3) schedule(static, 1)
#endif
    for (int i = 0; i < BasisSize; i++) {
      for (int j = 0; j < BasisSize; j++) {
        for (int k = 0; k < BasisSize; k++) {
          // Copy auxiliary variables here
          std::copy_n(luh + idx_luh(i, j, k, 0), NumberOfData, lQi + idx_lQi(0, i, j, k, 0));
        }
      }
    }

    // 2. Add point source (if required) to the zeroth time derivative
    if constexpr (EvaluatePointSource) {
#if defined(GPUOffloadingOMP)
#pragma omp parallel for simd collapse(5) schedule(static, 1)
#endif
      for (int j = 0; j < BasisSize; j++) {
        for (int k = 0; k < BasisSize; k++) {
          for (int l = 0; l < BasisSize; l++) {
            for (int m = 0; m < NumberOfUnknowns; m++) { // Skip auxiliary variables
              pCompType sum = 0.0;
              for (int n = 1; n < BasisSize + 1; n++) {
                // #if defined(_GLL)
                // const double weight = gaussLobattoWeights[Order][n-1];
                // #else
                // const double weight = gaussLegendreWeights[Order][n-1];
                // #endif
                const double weight = exahype2::aderdg::ADERDGSolver::weights[Order][n - 1];
                sum                 = sum + weight * PSi[idx_PSi(n, j, k, l, m)];
              }
              lQi[idx_lQi(0, j, k, l, m)] += dt * sum;
            }
          }
        }
      }

      // Copy the source vector at the quadrature nodes into the temporary array PSderivatives (remove 0th time derivative)
      std::copy_n(PSi + idx_PSi(1, 0, 0, 0, 0), BasisSize3 * BasisSize * NumberOfUnknowns, PSderivatives);

      // Add point source to the first time derivative
#if defined(GPUOffloadingOMP)
#pragma omp parallel for simd collapse(3) schedule(static, 1)
#endif
      for (int j = 0; j < BasisSize; j++) {
        for (int k = 0; k < BasisSize; k++) {
          for (int l = 0; l < BasisSize; l++) {
            for (int n = 0; n < NumberOfUnknowns; n++) { // Skip auxiliary variables
              lQi[idx_lQi(1, j, k, l, n)] += PSi[idx_PSi(0, j, k, l, n)];
            }
          }
        }
      }

      for (int i = 2; i < BasisSize; i++) {
        std::fill_n(tmp_PSderivatives, BasisSize3 * BasisSize * NumberOfUnknowns, 0.0); // Zero out tmp array
                                                                                        // Compute (t+1)-th derivative in time of point source
#if defined(GPUOffloadingOMP)
#pragma omp parallel for simd collapse(4) schedule(static, 1)
#endif
        for (int t = 0; t < BasisSize; t++) {
          for (int j = 0; j < BasisSize; j++) {
            for (int k = 0; k < BasisSize; k++) {
              for (int l = 0; l < BasisSize; l++) {
                for (int n = 0; n < NumberOfUnknowns; n++) { // Skip auxiliary variables
                  for (int s = 0; s < BasisSize; s++) {
                    tmp_PSderivatives[idx_PSderivatives(
                      t, j, k, l, n
                    )] += PSderivatives[idx_PSderivatives(s, j, k, l, n)] * exahype2::aderdg::ADERDGSolver::dudx[Order][t][s] * invDt;
                  } // s
                }   // n
              }     // l
            }       // k
          }         // j
        }           // t

        // Project derivative on to t_n
#if defined(GPUOffloadingOMP)
#pragma omp parallel for simd collapse(3) schedule(static, 1)
#endif
        for (int j = 0; j < BasisSize; j++) {
          for (int k = 0; k < BasisSize; k++) {
            for (int l = 0; l < BasisSize; l++) {
              for (int n = 0; n < NumberOfUnknowns; n++) { // Skip auxiliary variables
                for (int t = 0; t < BasisSize; t++) {
                  lQi[idx_lQi(i, j, k, l, n)] += tmp_PSderivatives[idx_PSderivatives(t, j, k, l, n)] * exahype2::aderdg::ADERDGSolver::FCoeff[Order][0][t];
                } // t
              }   // n
            }     // l
          }       // k
        }         // j

        // Store (t+1)-th derivative in PSderivatives
        std::copy_n(tmp_PSderivatives, BasisSize3 * BasisSize * NumberOfUnknowns, PSderivatives);

      }                                                                        // i
      std::fill_n(lFi, BasisSize4 * (Dimensions + 1) * NumberOfUnknowns, 0.0); // Zero out sources
    }                                                                          // EvaluatePointSource

    // 3. Cauchy-Kovalewski procedure
    for (int i = 0; i < BasisSize; i++) { // Time DOFs
      if constexpr (EvaluateFlux) {
#if defined(GPUOffloadingOMP)
#pragma omp parallel for simd collapse(3) schedule(static, 1)
#endif
        for (int j = 0; j < BasisSize; j++) {
          for (int k = 0; k < BasisSize; k++) {
            for (int l = 0; l < BasisSize; l++) {
              SolverType::flux(&lQi[idx_lQi(i, j, k, l, 0)], cellCenter, dx, t, dt, 0, &lFi[idx_lFi(i, j, k, l, 0, 0)], ::exahype2::Solver::Offloadable::Yes); // x
              SolverType::flux(&lQi[idx_lQi(i, j, k, l, 0)], cellCenter, dx, t, dt, 1, &lFi[idx_lFi(i, j, k, l, 1, 0)], ::exahype2::Solver::Offloadable::Yes); // y
              SolverType::flux(&lQi[idx_lQi(i, j, k, l, 0)], cellCenter, dx, t, dt, 2, &lFi[idx_lFi(i, j, k, l, 2, 0)], ::exahype2::Solver::Offloadable::Yes); // y
            }
          }
        }

        // dflux1 dx
#if defined(GPUOffloadingOMP)
#pragma omp parallel for simd collapse(2) schedule(static, 1)
#endif
        for (int j = 0; j < BasisSize; j++) {
          for (int k = 0; k < BasisSize; k++) {
            std::fill_n(&fluxDerivative[0], BasisSize * NumberOfUnknowns, 0.0);
            for (int l = 0; l < BasisSize; l++) {
              for (int m = 0; m < NumberOfUnknowns; m++) {
                for (int n = 0; n < BasisSize; n++) {
                  fluxDerivative[idx_fluxDerivative(l, m)] += lFi[idx_lFi(i, j, k, n, 0, m)] * invDx[0];
                }
              }
            }
            for (int l = 0; l < BasisSize; l++) {
              for (int m = 0; m < NumberOfUnknowns; m++) {
                lFi[idx_lFi(i, j, k, l, 0, m)] = fluxDerivative[idx_fluxDerivative(l, m)];
              }
            }
          }
        }

        // dflux2 dy
#if defined(GPUOffloadingOMP)
#pragma omp parallel for simd collapse(2) schedule(static, 1)
#endif
        for (int j = 0; j < BasisSize; j++) {
          for (int k = 0; k < BasisSize; k++) {
            std::fill_n(&fluxDerivative[0], BasisSize * NumberOfUnknowns, 0.0);
            for (int l = 0; l < BasisSize; l++) {
              for (int m = 0; m < NumberOfUnknowns; m++) {
                for (int n = 0; n < BasisSize; n++) {
                  fluxDerivative[idx_fluxDerivative(l, m)] += lFi[idx_lFi(i, j, n, k, 1, m)] * invDx[1];
                }
              }
            }
            for (int l = 0; l < BasisSize; l++) {
              for (int m = 0; m < NumberOfUnknowns; m++) {
                lFi[idx_lFi(i, j, l, k, 1, m)] = fluxDerivative[idx_fluxDerivative(l, m)];
              }
            }
          }
        }

        // dflux3 dz
#if defined(GPUOffloadingOMP)
#pragma omp parallel for simd collapse(2) schedule(static, 1)
#endif
        for (int j = 0; j < BasisSize; j++) {
          for (int k = 0; k < BasisSize; k++) {
            std::fill_n(&fluxDerivative[0], BasisSize * NumberOfUnknowns, 0.0);
            for (int l = 0; l < BasisSize; l++) {
              for (int m = 0; m < NumberOfUnknowns; m++) {
                for (int n = 0; n < BasisSize; n++) {
                  fluxDerivative[idx_fluxDerivative(l, m)] += lFi[idx_lFi(i, n, j, k, 2, m)] * invDx[2];
                }
              }
            }
            for (int l = 0; l < BasisSize; l++) {
              for (int m = 0; m < NumberOfUnknowns; m++) {
                lFi[idx_lFi(i, l, j, k, 2, m)] = fluxDerivative[idx_fluxDerivative(l, m)];
              }
            }
          }
        }
      } // EvaluateFlux

      if constexpr (EvaluateNonconservativeProduct) {
        std::fill_n(gradQ, BasisSize3 * Dimensions * NumberOfUnknowns, 0.0); // Reset gradQ
        // Compute the derivatives in x-direction (independent from the y- and z-derivatives)
#if defined(GPUOffloadingOMP)
#pragma omp parallel for simd collapse(5) schedule(static, 1)
#endif
        for (int j = 0; j < BasisSize; j++) {   // y-loop
          for (int k = 0; k < BasisSize; k++) { // z-loop
            // Fortran: gradQ(:,1,:,k,j,i) = 1.0/dx(1) * lqh(:,:,k,j,i) * dudx(:,:)^T
            for (int l = 0; l < BasisSize; l++) {          // x-loop
              for (int m = 0; m < NumberOfUnknowns; m++) { // Skip auxiliary variables
                for (int n = 0; n < BasisSize; n++) {
                  gradQ[idx_gradQ(j, k, l, 0, m)] += lQi[idx_lQi(i, j, k, n, m)] * invDx[0];
                }
              }
            }
          }
        }

        // y-direction (independent from the x- and z-derivatives)
#if defined(GPUOffloadingOMP)
#pragma omp parallel for simd collapse(5) schedule(static, 1)
#endif
        for (int j = 0; j < BasisSize; j++) {
          for (int k = 0; k < BasisSize; k++) {
            // Fortran: gradQ(:,2,k,:,j,i) = 1.0/dx(2) * lqh(:,k,:,j,i) * dudx(:,:)^T
            for (int l = 0; l < BasisSize; l++) {
              for (int m = 0; m < NumberOfUnknowns; m++) { // Skip auxiliary variables
                for (int n = 0; n < BasisSize; n++) {
                  gradQ[idx_gradQ(j, l, k, 1, m)] += lQi[idx_lQi(i, j, n, k, m)] * invDx[1];
                }
              }
            }
          }
        }

        // z-direction (independent from the x- and y-derivatives)
#if defined(GPUOffloadingOMP)
#pragma omp parallel for simd collapse(5) schedule(static, 1)
#endif
        for (int j = 0; j < BasisSize; j++) {
          for (int k = 0; k < BasisSize; k++) {
            // Fortran: gradQ(:,3,k,j,:,i) = 1.0/dx(3) * lqh(:,k,j,:,i) * dudx(:,:)^T
            for (int l = 0; l < BasisSize; l++) {
              for (int m = 0; m < NumberOfUnknowns; m++) { // Skip auxiliary variables
                for (int n = 0; n < BasisSize; n++) {
                  gradQ[idx_gradQ(l, j, k, 2, m)] += lQi[idx_lQi(i, n, j, k, m)] * invDx[2];
                }
              }
            }
          }
        }

#if defined(GPUOffloadingOMP)
#pragma omp parallel for simd collapse(3) schedule(static, 1)
#endif
        for (int j = 0; j < BasisSize; j++) {
          for (int k = 0; k < BasisSize; k++) {
            for (int l = 0; l < BasisSize; l++) {
              for (int d = 0; d < Dimensions; d++) {
                std::fill_n(ncpResult, NumberOfUnknowns, 0.0); // Zero out ncpResult
                SolverType::nonconservativeProduct(&lQi[idx_lQi(i, j, k, l, 0)], &gradQ[idx_gradQ(j, k, l, d, 0)], cellCenter, dx, t, dt, d, ncpResult, ::exahype2::Solver::Offloadable::Yes);
                for (int n = 0; n < NumberOfUnknowns; n++) {
                  lFi[idx_lFi(i, j, k, l, d, n)] += ncpResult[n];
                }
              }
            }
          }
        }
      } // EvaluateNonconservativeProduct

      if constexpr (EvaluateMaterialParameters) {
#if defined(GPUOffloadingOMP)
#pragma omp parallel for simd collapse(3) schedule(static, 1)
#endif
        for (int j = 0; j < BasisSize; j++) {
          for (int k = 0; k < BasisSize; k++) {
            for (int l = 0; l < BasisSize; l++) {
              SolverType::multiplyMaterialParameterMatrix(&lQi[idx_lQi(i, j, k, l, 0)], cellCenter, dx, t, dt, 0, &lFi[idx_lFi(i, j, k, l, 0, 0)], ::exahype2::Solver::Offloadable::Yes);
              SolverType::multiplyMaterialParameterMatrix(&lQi[idx_lQi(i, j, k, l, 0)], cellCenter, dx, t, dt, 1, &lFi[idx_lFi(i, j, k, l, 1, 0)], ::exahype2::Solver::Offloadable::Yes);
              SolverType::multiplyMaterialParameterMatrix(&lQi[idx_lQi(i, j, k, l, 0)], cellCenter, dx, t, dt, 2, &lFi[idx_lFi(i, j, k, l, 2, 0)], ::exahype2::Solver::Offloadable::Yes);
            }
          }
        }
      } // EvaluateMaterialParameters

      if constexpr (EvaluateAlgebraicSource) {
#if defined(GPUOffloadingOMP)
#pragma omp parallel for simd collapse(3) schedule(static, 1)
#endif
        for (int j = 0; j < BasisSize; j++) {
          for (int k = 0; k < BasisSize; k++) {
            for (int l = 0; l < BasisSize; l++) {
              const double                          ti     = t + 1.0 * dt;
              const double                          x      = cellCenter[0] + (1. / invDx[0]);
              const double                          y      = cellCenter[1] + (1. / invDx[1]);
              const double                          z      = cellCenter[2] + (1. / invDx[2]);
              tarch::la::Vector<Dimensions, double> coords = {x, y, z};
              SolverType::algebraicSource(&lQi[idx_lQi(i, j, k, l, 0)], coords, dx, ti, dt, &lFi[idx_lFi(i, j, k, l, SourceIndex, 0)], ::exahype2::Solver::Offloadable::Yes);
            }
          }
        }
      } // EvaluateAlgebraicSource

#if defined(GPUOffloadingOMP)
#pragma omp parallel for simd collapse(3) schedule(static, 1)
#endif
      for (int j = 0; j < BasisSize; j++) {
        for (int k = 0; k < BasisSize; k++) {
          for (int l = 0; l < BasisSize; l++) {
            // lQi(:,l,k,j,i+1) -= SUM(lFi(:,1:nDim,l,k,j,i), dim=2)
            for (int m = 0; m < Dimensions; m++) {
              for (int n = 0; n < NumberOfUnknowns; n++) { // Skip auxiliary variables
                lQi[idx_lQi(i + 1, j, k, l, n)] -= lFi[idx_lFi(i, j, k, l, m, n)];
              }
            }
            if constexpr (EvaluateAlgebraicSource) {
              for (int n = 0; n < NumberOfUnknowns; n++) { // Skip auxiliary variables
                lQi[idx_lQi(i + 1, j, k, l, n)] -= lFi[idx_lFi(i, j, k, l, SourceIndex, n)];
              }
            }
          }
        }
      }

      // Copy auxiliary variables
      if constexpr (NumberOfAuxiliaryVariables > 0) {
#if defined(GPUOffloadingOMP)
#pragma omp parallel for simd collapse(3) schedule(static, 1)
#endif
        for (int j = 0; j < BasisSize; j++) {
          for (int k = 0; k < BasisSize; k++) {
            for (int l = 0; l < BasisSize; l++) {
              for (int n = NumberOfUnknowns; n < NumberOfData; n++) {
                lQi[idx_lQi(i + 1, j, k, l, n)] = lQi[idx_lQi(i, j, k, l, n)];
              }
            }
          }
        }
      }
    } // i

    //*****************************
    //**** Averaging over time ****
    //*****************************

    // double* lQhi = tempUnknowns;
    idx4 idx_lQhi(BasisSize, BasisSize, BasisSize, NumberOfData);

    // double* lFhi = tempFluxUnknowns;
    idx5 idx_lFhi(Dimensions + 1, BasisSize, BasisSize, BasisSize, NumberOfUnknowns);
    std::fill_n(lFhi, (Dimensions + 1) * BasisSize3 * NumberOfUnknowns, 0.0);

    // Immediately compute the time-averaged space-time polynomials
    // Fortran: lQhi(:,:,:,:) = lQi(:,:,:,:,1)
    std::copy_n(lQi, BasisSize3 * NumberOfData, lQhi);

    double dtavFac = 0.5 * dt;
    for (int i = 1; i < BasisSize; i++) {
      // Fortran: lQhi(:,:,:,:) += dtavFac * lQi(:,i,:,:,:)
#if defined(GPUOffloadingOMP)
#pragma omp parallel for simd collapse(4) schedule(static, 1)
#endif
      for (int j = 0; j < BasisSize; j++) {
        for (int k = 0; k < BasisSize; k++) {
          for (int l = 0; l < BasisSize; l++) {
            for (int m = 0; m < NumberOfUnknowns; m++) { // Skip auxiliary variables
              lQhi[idx_lQhi(j, k, l, m)] += dtavFac * lQi[idx_lQi(i, j, k, l, m)];
            }
          }
        }
      }
      dtavFac *= dt / (i + 2);
    }

    // lFhi(m,l,k,j,i) = lFi(m,i,l,k,j,1)
#if defined(GPUOffloadingOMP)
#pragma omp parallel for simd collapse(5) schedule(static, 1)
#endif
    for (int i = 0; i < Dimensions; i++) {
      for (int j = 0; j < BasisSize; j++) {
        for (int k = 0; k < BasisSize; k++) {
          for (int l = 0; l < BasisSize; l++) {
            for (int m = 0; m < NumberOfUnknowns; m++) {
              lFhi[idx_lFhi(i, j, k, l, m)] = lFi[idx_lFi(0, j, k, l, i, m)];
            }
          }
        }
      }
    }

    if constexpr (EvaluateAlgebraicSource) {
#if defined(GPUOffloadingOMP)
#pragma omp parallel for simd collapse(4) schedule(static, 1)
#endif
      for (int j = 0; j < BasisSize; j++) {
        for (int k = 0; k < BasisSize; k++) {
          for (int l = 0; l < BasisSize; l++) {
            for (int m = 0; m < NumberOfUnknowns; m++) {
              lFhi[idx_lFhi(SourceIndex, j, k, l, m)] = lFi[idx_lFi(0, j, k, l, SourceIndex, m)];
            }
          }
        }
      }
    }

    dtavFac = 0.5 * dt;
    for (int i = 1; i < BasisSize; i++) {
      // Fortran: lFhi(n,m,l,k,j) += dtavFac*lFi(n,j,m,l,k,i)
#if defined(GPUOffloadingOMP)
#pragma omp parallel for simd collapse(5) schedule(static, 1)
#endif
      for (int j = 0; j < Dimensions; j++) {
        for (int k = 0; k < BasisSize; k++) {
          for (int l = 0; l < BasisSize; l++) {
            for (int m = 0; m < BasisSize; m++) {
              for (int n = 0; n < NumberOfUnknowns; n++) {
                lFhi[idx_lFhi(j, k, l, m, n)] += dtavFac * lFi[idx_lFi(i, k, l, m, j, n)];
              }
            }
          }
        }
      }

      if constexpr (EvaluateAlgebraicSource) {
#if defined(GPUOffloadingOMP)
#pragma omp parallel for simd collapse(4) schedule(static, 1)
#endif
        for (int k = 0; k < BasisSize; k++) {
          for (int l = 0; l < BasisSize; l++) {
            for (int m = 0; m < BasisSize; m++) {
              for (int n = 0; n < NumberOfUnknowns; n++) {
                lFhi[idx_lFhi(SourceIndex, k, l, m, n)] += dtavFac * lFi[idx_lFi(i, k, l, m, SourceIndex, n)];
              }
            }
          }
        }
      }

      dtavFac *= dt / (i + 2);
    }

    // Add point source to the right hand side
    if constexpr (EvaluatePointSource) {
#if defined(GPUOffloadingOMP)
#pragma omp parallel for simd collapse(6) schedule(static, 1)
#endif
      for (int j = 0; j < Dimensions; j++) {
        for (int k = 0; k < BasisSize; k++) {
          for (int l = 0; l < BasisSize; l++) {
            for (int m = 0; m < BasisSize; m++) {
              for (int n = 0; n < NumberOfUnknowns; n++) {
                pCompType sum = 0.0;
                for (int n0 = 1; n0 < BasisSize + 1; n0++) {
                  // #if defined(_GLL)
                  // const double weight = gaussLobattoWeights[Order][n0-1];
                  // #else
                  // const double weight = gaussLegendreWeights[Order][n0-1];
                  // #endif
                  const double weight = exahype2::aderdg::ADERDGSolver::weights[Order][n0 - 1];
                  sum += weight * PSi[idx_PSi(n0, k, l, m, n)];
                }
                lFhi[idx_lFhi(j, k, l, m, n)] += sum / Dimensions;
              }
            }
          }
        }
      }
    }

    //***********************
    //**** Extrapolation ****
    //***********************

    idx4 idx_lQbnd(2 * Dimensions, BasisSize, BasisSize, NumberOfData);
    std::fill_n(lQbnd, 2 * Dimensions * BasisSize2 * NumberOfData, 0.0);

    idx4 idx_lFbnd(2 * Dimensions, BasisSize, BasisSize, NumberOfUnknowns);
    std::fill_n(lFbnd, 2 * Dimensions * BasisSize2 * NumberOfUnknowns, 0.0);

    // x-direction: face 1 (left) and face 2 (right)
    for (int i = 0; i < BasisSize; i++) {
      for (int j = 0; j < BasisSize; j++) {
        // lQbnd(:,j,i,1) = lQhi(:,:,j,i) * FLCoeff(:)
        // lQbnd(:,j,i,2) = lQhi(:,:,j,i) * FRCoeff(:)
#if defined(GPUOffloadingOMP)
#pragma omp parallel for simd collapse(2) schedule(static, 1)
#endif
        for (int k = 0; k < NumberOfData; k++) {
          for (int l = 0; l < BasisSize; l++) {
            // left
            lQbnd[idx_lQbnd(0, i, j, k)] += lQhi[idx_lQhi(i, j, l, k)];
            // right
            lQbnd[idx_lQbnd(1, i, j, k)] += lQhi[idx_lQhi(i, j, l, k)];
          }
        }
        // lFbnd(:,j,i,1) = lFhi(:,:,j,i,1) * FLCoeff(:)
        // lFbnd(:,j,i,2) = lFhi(:,:,j,i,1) * FRCoeff(:)
#if defined(GPUOffloadingOMP)
#pragma omp parallel for simd collapse(2) schedule(static, 1)
#endif
        for (int k = 0; k < NumberOfUnknowns; k++) {
          for (int l = 0; l < BasisSize; l++) {
            // left
            lFbnd[idx_lFbnd(0, i, j, k)] += lFhi[idx_lFhi(0, i, j, l, k)];
            // right
            lFbnd[idx_lFbnd(1, i, j, k)] += lFhi[idx_lFhi(0, i, j, l, k)];
          }
        }
      }
    }

    // y-direction: face 3 (left) and face 4 (right)
    for (int i = 0; i < BasisSize; i++) {
      for (int j = 0; j < BasisSize; j++) {
        // lQbnd(:,j,i,3) = lQhi(:,j,:,i) * FLCoeff(:)
        // lQbnd(:,j,i,4) = lQhi(:,j,:,i) * FRCoeff(:)
#if defined(GPUOffloadingOMP)
#pragma omp parallel for simd collapse(2) schedule(static, 1)
#endif
        for (int k = 0; k < NumberOfData; k++) {
          for (int l = 0; l < BasisSize; l++) {
            // left
            lQbnd[idx_lQbnd(2, i, j, k)] += lQhi[idx_lQhi(i, l, j, k)];
            // right
            lQbnd[idx_lQbnd(3, i, j, k)] += lQhi[idx_lQhi(i, l, j, k)];
          }
        }
        // lFbnd(:,j,i,3) = lFhi(:,j,:,i,2) * FLCoeff(:)
        // lFbnd(:,j,i,4) = lFhi(:,j,:,i,2) * FRCoeff(:)
#if defined(GPUOffloadingOMP)
#pragma omp parallel for simd collapse(2) schedule(static, 1)
#endif
        for (int k = 0; k < NumberOfUnknowns; k++) {
          for (int l = 0; l < BasisSize; l++) {
            // left
            lFbnd[idx_lFbnd(2, i, j, k)] += lFhi[idx_lFhi(1, i, l, j, k)];
            // right
            lFbnd[idx_lFbnd(3, i, j, k)] += lFhi[idx_lFhi(1, i, l, j, k)];
          }
        }
      }
    }

    // z-direction: face 5 (left) and face 6 (right)
    for (int i = 0; i < BasisSize; i++) {
      for (int j = 0; j < BasisSize; j++) {
        // lQbnd(:,j,i,5) = lQhi(:,j,i,:) * FLCoeff(:)
        // lQbnd(:,j,i,6) = lQhi(:,j,i,:) * FRCoeff(:)
#if defined(GPUOffloadingOMP)
#pragma omp parallel for simd collapse(2) schedule(static, 1)
#endif
        for (int k = 0; k < NumberOfData; k++) {
          for (int l = 0; l < BasisSize; l++) {
            // left
            lQbnd[idx_lQbnd(4, i, j, k)] += lQhi[idx_lQhi(l, i, j, k)];
            // right
            lQbnd[idx_lQbnd(5, i, j, k)] += lQhi[idx_lQhi(l, i, j, k)];
          }
        }
        // lFbnd(:,j,i,5) = lFhi(:,j,i,:,3) * FLCoeff(:)
        // lFbnd(:,j,i,6) = lFhi(:,j,i,:,3) * FRCoeff(:)
#if defined(GPUOffloadingOMP)
#pragma omp parallel for simd collapse(2) schedule(static, 1)
#endif
        for (int k = 0; k < NumberOfUnknowns; k++) {
          for (int l = 0; l < BasisSize; l++) {
            // left
            lFbnd[idx_lFbnd(4, i, j, k)] += lFhi[idx_lFhi(2, l, i, j, k)];
            // right
            lFbnd[idx_lFbnd(5, i, j, k)] += lFhi[idx_lFhi(2, l, i, j, k)];
          }
        }
      }
    }
  } // cellIndex, end of target offloading block.
}

#endif // Dimensions == 3
