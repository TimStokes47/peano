#include "Rusanov.h"
#include "GPUCellData.h"
#include "tarch/compiler/CompilerSpecificSettings.h"
#include "tarch/accelerator/accelerator.h"
#include "exahype2/fv/rusanov/LoopBody.h"
#define NSEC_IN_SEC 1000000000.0


template <
  typename Solver,
  std::size_t  numberOfVolumesPerAxisInPatch,
  std::size_t  haloSize,
  std::size_t  unknowns,
  std::size_t  auxiliaryVariables,
  typename TempDataEnumerator
>
void exahype2::fv::rusanov::sycl::timeStepWithRusanov_patchwise_static_calls(
  int                     targetDevice,
  ::exahype2::CellData&   hostPatchData,
  bool                    evaluateFlux,
  bool                    evaluateNonconservativeProduct,
  bool                    evaluateSource,
  bool                    evaluateMaximumEigenvalueAfterTimeStep
) {
  #if defined(GPUOffloadingSYCL)
  //::sycl::property_list prop_list{::sycl::property::queue::enable_profiling()};
  //::sycl::queue queue{::sycl::gpu_selector_v, prop_list};
  ::sycl::queue& queue = tarch::accelerator::getSYCLQueue(targetDevice);
  constexpr int solversHaloSize        = 1;

  exahype2::enumerator::AoSLexicographicEnumerator QInEnumerator       (                        1, numberOfVolumesPerAxisInPatch, haloSize, unknowns, auxiliaryVariables);
  exahype2::enumerator::AoSLexicographicEnumerator QOutEnumerator      (                        1, numberOfVolumesPerAxisInPatch,        0, unknowns, auxiliaryVariables);
  TempDataEnumerator fluxEnumerator      (hostPatchData.numberOfCells, numberOfVolumesPerAxisInPatch,   solversHaloSize, unknowns, 0);
  TempDataEnumerator ncpEnumerator       (hostPatchData.numberOfCells, numberOfVolumesPerAxisInPatch+1, solversHaloSize, unknowns, 0);
  TempDataEnumerator eigenvalueEnumerator(hostPatchData.numberOfCells, numberOfVolumesPerAxisInPatch,   solversHaloSize,        1, 0);

  double* tempFluxX                   = evaluateFlux ?                                     ::sycl::malloc_device<double>(fluxEnumerator.size(), queue) : nullptr;
  double* tempFluxY                   = evaluateFlux ?                                     ::sycl::malloc_device<double>(fluxEnumerator.size(), queue) : nullptr;
  double* tempFluxZ                   = evaluateFlux and Dimensions==3 ?                   ::sycl::malloc_device<double>(fluxEnumerator.size(), queue) : nullptr;
  double* tempNonconservativeProductX = evaluateNonconservativeProduct ?                   ::sycl::malloc_device<double>(ncpEnumerator.size(), queue) : nullptr;
  double* tempNonconservativeProductY = evaluateNonconservativeProduct ?                   ::sycl::malloc_device<double>(ncpEnumerator.size(), queue) : nullptr;
  double* tempNonconservativeProductZ = evaluateNonconservativeProduct and Dimensions==3 ? ::sycl::malloc_device<double>(ncpEnumerator.size(), queue) : nullptr;
  double* tempEigenvalueX             = ::sycl::malloc_device<double>(eigenvalueEnumerator.size(), queue);
  double* tempEigenvalueY             = ::sycl::malloc_device<double>(eigenvalueEnumerator.size(), queue);
  double* tempEigenvalueZ             = ::sycl::malloc_device<double>(eigenvalueEnumerator.size(), queue);

  const std::size_t numberOfPatches = hostPatchData.numberOfCells;
  GPUCellData  patchData( hostPatchData, QInEnumerator, QOutEnumerator, queue );
  ::sycl::range<3> totalWorkItem{numberOfVolumesPerAxisInPatch, numberOfVolumesPerAxisInPatch+2*solversHaloSize, unknowns+auxiliaryVariables};
  ::sycl::range<3> workgroupSize{numberOfVolumesPerAxisInPatch, numberOfVolumesPerAxisInPatch+2*solversHaloSize, unknowns+auxiliaryVariables};
  ::std::vector<::sycl::event> queueSubmission(numberOfPatches);
  for (int patchIndex=0; patchIndex < numberOfPatches; patchIndex++) {
  queueSubmission[patchIndex] = queue.submit(
    [&](::sycl::handler &handle) {
      handle.parallel_for(
      ::sycl::nd_range<3> {totalWorkItem, workgroupSize},
      [=] (::sycl::nd_item<3> i) {/*
        if (Dimensions==2 and evaluateSource) {
          handle.parallel_for( // -> should be parallel_for_work_items
                ::sycl::range<2>{numberOfVolumesPerAxisInPatch,numberOfVolumesPerAxisInPatch},
                [&] (::sycl::item<2> i) {
                  int x          = i[0];
                  int y          = i[1];
                  internal::copySolutionAndAddSourceTerm_LoopBody<Solver>(
                    patchData.QIn + patchIndex * QInEnumerator.size(),
                    QInEnumerator,
                    patchData.cellCentre[patchIndex],
                    patchData.cellSize[patchIndex],
                    patchIndex,
                    volumeIndex2d(x,y),
                    patchData.t[patchIndex],
                    patchData.dt[patchIndex],
                    patchData.QOut + patchIndex * QOutEnumerator.size(),
                    QOutEnumerator
                  );
                }
          );
        }
        else if (Dimensions==3 and evaluateSource) {
          handle.parallel_for(
                ::sycl::range<3>{numberOfVolumesPerAxisInPatch,numberOfVolumesPerAxisInPatch,numberOfVolumesPerAxisInPatch},
                [=] (::sycl::item<3> i) {
                  int x          = i[0];
                  int y          = i[1];
                  int z          = i[2];
                  internal::copySolutionAndAddSourceTerm_LoopBody<Solver>(
                      patchData.QIn + patchIndex * QInEnumerator.size(),
                      QInEnumerator,
                      patchData.cellCentre[patchIndex],
                      patchData.cellSize[patchIndex],
                      patchIndex,
                      volumeIndex3d(x,y,z),
                      patchData.t[patchIndex],
                      patchData.dt[patchIndex],
                      patchData.QOut + patchIndex * QOutEnumerator.size(),
                      QOutEnumerator
                   );
                }
          );
        }*/
        if (Dimensions==2) {
                  int x             = i.get_local_id(0);
                  int y             = i.get_local_id(1);
				  int unknown       = i.get_local_id(2);

				  if (y < numberOfVolumesPerAxisInPatch) {
                    internal::copySolution_LoopBody(
                      patchData.QIn + patchIndex * QInEnumerator.size(),
                      QInEnumerator,
                      patchIndex,
                      volumeIndex2d(x,y),
                      unknown,
                      patchData.QOut + patchIndex * QOutEnumerator.size(),
                      QOutEnumerator
                    );
					//patchData.QOut + patchIndex * QOutEnumerator.size()[QOutEnumerator(patchIndex,volumeIndex2d(x,y),unknown)] = patchData.QIn + patchIndex * QInEnumerator.size()[QInEnumerator(patchIndex,volumeIndex2d(x,y),unknown)];

					}

				  }
                
		/*
        else {
          handle.parallel_for(
                ::sycl::range<3>{unknowns,numberOfVolumesPerAxisInPatch,numberOfVolumesPerAxisInPatch},
                [=] (::sycl::item<3> i) {
                  int unknown    = i[0];
                  int x          = i[1];
                  int y          = i[2];
                  for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++) {
                    internal::copySolution_LoopBody(
                      patchData.QIn + patchIndex * QInEnumerator.size(),
                      QInEnumerator,
                      patchIndex,
                      volumeIndex3d(x,y,z),
                      unknown,
                      patchData.QOut + patchIndex * QOutEnumerator.size(),
                      QOutEnumerator
                    );
                  }
                }
          );
        }*/

        if (Dimensions==2) {
                  int y          = i.get_local_id(0);
                  int x          = i.get_local_id(1)-solversHaloSize;
				  int unknown       = i.get_local_id(2);
                  
				  if (unknown == 0) {
                    internal::computeMaxEigenvalue_LoopBody<Solver>(
                      patchData.QIn + patchIndex * QInEnumerator.size(),
                      QInEnumerator,
                      patchData.cellCentre[patchIndex],
                      patchData.cellSize[patchIndex],
                      patchIndex,
                      volumeIndex2d(x,y),
                      patchData.t[patchIndex], patchData.dt[patchIndex],
                      0,
                      tempEigenvalueX,
                      eigenvalueEnumerator
                    );
			      }
				  

                  y          = i.get_local_id(1)-solversHaloSize;
                  x          = i.get_local_id(0);

                  if (unknown == 0) {
                    internal::computeMaxEigenvalue_LoopBody<Solver>(
                      patchData.QIn + patchIndex * QInEnumerator.size(),
                      QInEnumerator,
                      patchData.cellCentre[patchIndex],
                      patchData.cellSize[patchIndex],
                      patchIndex,
                      volumeIndex2d(x,y),
                      patchData.t[patchIndex], patchData.dt[patchIndex],
                      1,
                      tempEigenvalueY,
                      eigenvalueEnumerator
                    );
				  }

				  i.barrier();
                  y          = i.get_local_id(1);
                  x          = i.get_local_id(0);

                  if (unknown < unknowns && y < numberOfVolumesPerAxisInPatch) {
                    internal::updateSolutionWithEigenvalueDamping_LoopBody(
                      patchData.QIn + patchIndex * QInEnumerator.size(),
                      QInEnumerator,
                      tempEigenvalueX,
                      tempEigenvalueY,
                      tempEigenvalueZ,
                      eigenvalueEnumerator,
                      patchData.cellCentre[patchIndex],
                      patchData.cellSize[patchIndex],
                      patchIndex,
                      volumeIndex2d(x,y),
                      unknown,
                      patchData.dt[patchIndex],
                      patchData.QOut + patchIndex * QOutEnumerator.size(),
                      QOutEnumerator
                    );
				  }
        }/*
        else {  // 3d of eigenvalue damping
          handle.parallel_for(
                ::sycl::range<3>{numberOfVolumesPerAxisInPatch+2*solversHaloSize,numberOfVolumesPerAxisInPatch,numberOfVolumesPerAxisInPatch},
                [=] (::sycl::item<3> i) {
                  int x          = i[0]-solversHaloSize;
                  int z          = i[1];
