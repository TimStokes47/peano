                        patchData.dt[patchIndex]
                      )
                    );
                  }
                  patchData.maxEigenvalue[patchIndex] = newMaxEigenvalue;
	          }
			  */
			  if (x < numberOfVolumesPerAxisInPatch)
			  tempEigenvalueX[patchIndex*numberOfVolumesPerAxisInPatch*numberOfVolumesPerAxisInPatch*(numberOfVolumesPerAxisInPatch+2*solversHaloSize) + numberOfVolumesPerAxisInPatch*(numberOfVolumesPerAxisInPatch+2*solversHaloSize) * z + (numberOfVolumesPerAxisInPatch+2*solversHaloSize) * y + x] = internal::reduceMaxEigenvalue_LoopBody<Solver>(
                        patchData.QOut + patchIndex * QOutEnumerator.size(),
                        QOutEnumerator,
                        patchData.cellCentre[patchIndex],
                        patchData.cellSize[patchIndex],
                        patchIndex,
                        volumeIndex3d(x,y,z),
                        patchData.t[patchIndex],
                        patchData.dt[patchIndex]
						);
			  else
			  tempEigenvalueX[patchIndex*numberOfVolumesPerAxisInPatch*numberOfVolumesPerAxisInPatch*(numberOfVolumesPerAxisInPatch+2*solversHaloSize) + numberOfVolumesPerAxisInPatch*(numberOfVolumesPerAxisInPatch+2*solversHaloSize) * z + (numberOfVolumesPerAxisInPatch+2*solversHaloSize) * y + x] = 0;

			  patchData.maxEigenvalue[patchIndex] = ::sycl::reduce_over_group(i.get_group(), tempEigenvalueX[patchIndex*numberOfVolumesPerAxisInPatch*numberOfVolumesPerAxisInPatch*(numberOfVolumesPerAxisInPatch+2*solversHaloSize) + numberOfVolumesPerAxisInPatch*(numberOfVolumesPerAxisInPatch+2*solversHaloSize) * z + (numberOfVolumesPerAxisInPatch+2*solversHaloSize) * y + x], ::sycl::maximum<>());
          }
    });
    }
  );
  event.wait();
  auto start = event.get_profiling_info<::sycl::info::event_profiling::command_start>();
  auto stop = event.get_profiling_info<::sycl::info::event_profiling::command_end>();
  auto duration = static_cast<double>(stop - start) / NSEC_IN_SEC;
  if (evaluateMaximumEigenvalueAfterTimeStep == true) {
    ::std::cout << "Patchwise kernel execution time with reduction:" << duration << ::std::endl;
  }
  else {
    ::std::cout << "Patchwise kernel execution time without reduction:" << duration << ::std::endl;
  }
  before = ::std::chrono::system_clock::now();
  patchData.destroy(  hostPatchData, QOutEnumerator, evaluateMaximumEigenvalueAfterTimeStep, queue  );
  end = ::std::chrono::system_clock::now() - before;
  //::std::cout << "GPU patch destroy time:" << end.count() << ::std::endl;

  if (tempFluxX!=nullptr)                   ::sycl::free( tempFluxX, queue);
  if (tempFluxY!=nullptr)                   ::sycl::free( tempFluxY, queue);
  if (tempFluxZ!=nullptr)                   ::sycl::free( tempFluxZ, queue);
  if (tempNonconservativeProductX!=nullptr) ::sycl::free( tempNonconservativeProductX, queue);
  if (tempNonconservativeProductY!=nullptr) ::sycl::free( tempNonconservativeProductY, queue);
  if (tempNonconservativeProductZ!=nullptr) ::sycl::free( tempNonconservativeProductZ, queue);
  if (tempEigenvalueX!=nullptr)             ::sycl::free( tempEigenvalueX, queue);
  if (tempEigenvalueY!=nullptr)             ::sycl::free( tempEigenvalueY, queue);
  if (tempEigenvalueZ!=nullptr)             ::sycl::free( tempEigenvalueZ, queue);
  #else
  assertionMsg(false, "this routine should only be used in combination with SYCL offloading, as it has a device parameter" );
  #endif
}



