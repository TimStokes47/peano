                      patchData.QOut + patchIndex * QOutEnumerator.size(),
                      QOutEnumerator
                    );
                  }
                }
          );
        }


        if (evaluateNonconservativeProduct and Dimensions==2) {
          handle.parallel_for(
                ::sycl::range<2>{numberOfVolumesPerAxisInPatch+2*solversHaloSize,numberOfVolumesPerAxisInPatch},
                [=] (::sycl::item<2> i) {
                  int x = i[0]-solversHaloSize;
