#include <cstdlib>

#include "GPUCellData.h"
#include "Rusanov.h"
#include "tarch/accelerator/accelerator.h"
#include "tarch/compiler/CompilerSpecificSettings.h"
#include "exahype2/fv/rusanov/LoopBody.h"
#define NSEC_IN_SEC 1000000000.0

/*
This implementation only submits one (huge) kernel
to the SYCL queue. The patches are divided into
individual workgroup manually
*/

template <
  typename Solver,
  std::size_t numberOfVolumesPerAxisInPatch,
  std::size_t haloSize,
  std::size_t unknowns,
  std::size_t auxiliaryVariables,
  typename TempDataEnumerator>
void exahype2::fv::rusanov::sycl::timeStepWithRusanov_patchwise_usm_static_calls(
  int                   targetDevice,
  ::exahype2::CellData& hostPatchData,
  bool                  evaluateFlux,
  bool                  evaluateNonconservativeProduct,
  bool                  evaluateSource,
  bool                  evaluateMaximumEigenvalueAfterTimeStep
) {
#if defined(GPUOffloadingSYCL)
  ::sycl::property_list prop_list{::sycl::property::queue::enable_profiling()};
  ::sycl::queue         queue{::sycl::gpu_selector_v, prop_list}; // Queue is hard-coded to GPU
  //::sycl::queue& queue = tarch::accelerator::getSYCLQueue(targetDevice);

  constexpr int solversHaloSize = 1;

  exahype2::enumerator::AoSLexicographicEnumerator QInEnumerator(
    1, numberOfVolumesPerAxisInPatch, haloSize, unknowns, auxiliaryVariables
  );
  exahype2::enumerator::AoSLexicographicEnumerator QOutEnumerator(
    1, numberOfVolumesPerAxisInPatch, 0, unknowns, auxiliaryVariables
  );
  TempDataEnumerator fluxEnumerator(
    hostPatchData.numberOfCells, numberOfVolumesPerAxisInPatch, solversHaloSize, unknowns, 0
  );
  TempDataEnumerator ncpEnumerator(
    hostPatchData.numberOfCells, numberOfVolumesPerAxisInPatch + 1, solversHaloSize, unknowns, 0
  );
  TempDataEnumerator eigenvalueEnumerator(
    hostPatchData.numberOfCells, numberOfVolumesPerAxisInPatch, solversHaloSize, 1, 0
  );

  double* tempFluxX = evaluateFlux ? ::sycl::malloc_device<double>(fluxEnumerator.size(), queue) : nullptr;
  double* tempFluxY = evaluateFlux ? ::sycl::malloc_device<double>(fluxEnumerator.size(), queue) : nullptr;
  double* tempFluxZ = evaluateFlux and Dimensions == 3
                        ? ::sycl::malloc_device<double>(fluxEnumerator.size(), queue)
                        : nullptr;
  double* tempNonconservativeProductX = evaluateNonconservativeProduct
                                          ? ::sycl::malloc_device<double>(ncpEnumerator.size(), queue)
                                          : nullptr;
  double* tempNonconservativeProductY = evaluateNonconservativeProduct
                                          ? ::sycl::malloc_device<double>(ncpEnumerator.size(), queue)
                                          : nullptr;
  double* tempNonconservativeProductZ = evaluateNonconservativeProduct and Dimensions == 3
                                          ? ::sycl::malloc_device<double>(ncpEnumerator.size(), queue)
                                          : nullptr;
  double* tempEigenvalueX             = ::sycl::malloc_device<double>(eigenvalueEnumerator.size(), queue);
  double* tempEigenvalueY             = ::sycl::malloc_device<double>(eigenvalueEnumerator.size(), queue);
  double* tempEigenvalueZ             = ::sycl::malloc_device<double>(eigenvalueEnumerator.size(), queue);

  const std::size_t numberOfPatches = hostPatchData.numberOfCells;
  GPUCellData       patchData(hostPatchData, QInEnumerator, QOutEnumerator, queue);

#if Dimensions == 2
  ::sycl::range<2> totalWorkItem{
    numberOfVolumesPerAxisInPatch, (numberOfVolumesPerAxisInPatch + 2 * solversHaloSize) * numberOfPatches};
  ::sycl::range<2> workgroupSize{numberOfVolumesPerAxisInPatch, numberOfVolumesPerAxisInPatch + 2 * solversHaloSize};
#else
  ::sycl::range<3> totalWorkItem{
    numberOfVolumesPerAxisInPatch,
    numberOfVolumesPerAxisInPatch,
    (numberOfVolumesPerAxisInPatch + 2 * solversHaloSize) * numberOfPatches};
  ::sycl::range<3> workgroupSize{
    numberOfVolumesPerAxisInPatch, numberOfVolumesPerAxisInPatch, numberOfVolumesPerAxisInPatch + 2 * solversHaloSize};
#endif

  ::sycl::event event = queue.submit([&](::sycl::handler& handle) {
    handle.parallel_for(
#if Dimensions == 2
      ::sycl::nd_range<2>{totalWorkItem, workgroupSize},
      [=](::sycl::nd_item<2> i) {
        int patchIndex = i.get_group(1);
        int y          = i.get_local_id(0);
        int x          = i.get_local_id(1);
        int z;

#else
      ::sycl::nd_range<3>{totalWorkItem, workgroupSize},
      [=](::sycl::nd_item<3> i) {
        int patchIndex = i.get_group(2);
        int z          = i.get_local_id(0);
        int y          = i.get_local_id(1);
        int x          = i.get_local_id(2);
#endif

        if (Dimensions == 2 and evaluateSource) {
          if (x < numberOfVolumesPerAxisInPatch) {
            internal::copySolutionAndAddSourceTerm_LoopBody<Solver>(
              patchData.QIn + patchIndex * QInEnumerator.size(),
              QInEnumerator,
              patchData.cellCentre[patchIndex],
              patchData.cellSize[patchIndex],
              patchIndex,
              volumeIndex2d(x, y),
              patchData.t[patchIndex],
              patchData.dt[patchIndex],
              patchData.QOut + patchIndex * QOutEnumerator.size(),
              QOutEnumerator
            );
          }
        }

        else if (Dimensions == 3 and evaluateSource) {
          if (x < numberOfVolumesPerAxisInPatch) {
            internal::copySolutionAndAddSourceTerm_LoopBody<Solver>(
              patchData.QIn + patchIndex * QInEnumerator.size(),
              QInEnumerator,
              patchData.cellCentre[patchIndex],
              patchData.cellSize[patchIndex],
              patchIndex,
              volumeIndex3d(x, y, z),
              patchData.t[patchIndex],
              patchData.dt[patchIndex],
              patchData.QOut + patchIndex * QOutEnumerator.size(),
              QOutEnumerator
            );
          }
        }

        if (Dimensions == 2) {
          if (x < numberOfVolumesPerAxisInPatch) {
            for (int unknown = 0; unknown < unknowns + auxiliaryVariables; unknown++) {
              internal::copySolution_LoopBody(
                patchData.QIn + patchIndex * QInEnumerator.size(),
                QInEnumerator,
                patchIndex,
                volumeIndex2d(x, y),
                unknown,
                patchData.QOut + patchIndex * QOutEnumerator.size(),
                QOutEnumerator
              );
            }
          }
        }

        else {
          if (x < numberOfVolumesPerAxisInPatch) {
            for (int unknown = 0; unknown < unknowns + auxiliaryVariables; unknown++) {
              internal::copySolution_LoopBody(
                patchData.QIn + patchIndex * QInEnumerator.size(),
                QInEnumerator,
                patchIndex,
                volumeIndex3d(x, y, z),
                unknown,
                patchData.QOut + patchIndex * QOutEnumerator.size(),
                QOutEnumerator
              );
            }
          }
        }

        if (Dimensions == 2) {
          x = i.get_local_id(1) - solversHaloSize;
          internal::computeMaxEigenvalue_LoopBody<Solver>(
            patchData.QIn + patchIndex * QInEnumerator.size(),
            QInEnumerator,
            patchData.cellCentre[patchIndex],
            patchData.cellSize[patchIndex],
            patchIndex,
            volumeIndex2d(x, y),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            0,
            tempEigenvalueX,
            eigenvalueEnumerator
          );

          internal::computeMaxEigenvalue_LoopBody<Solver>(
            patchData.QIn + patchIndex * QInEnumerator.size(),
            QInEnumerator,
            patchData.cellCentre[patchIndex],
            patchData.cellSize[patchIndex],
            patchIndex,
            volumeIndex2d(y, x),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            1,
            tempEigenvalueY,
            eigenvalueEnumerator
          );

          i.barrier();
          x += solversHaloSize;
          if (x < numberOfVolumesPerAxisInPatch) {
            for (int unknown = 0; unknown < unknowns + auxiliaryVariables; unknown++) {
              internal::updateSolutionWithEigenvalueDamping_LoopBody(
                patchData.QIn + patchIndex * QInEnumerator.size(),
                QInEnumerator,
                tempEigenvalueX,
                tempEigenvalueY,
                tempEigenvalueZ,
                eigenvalueEnumerator,
                patchData.cellCentre[patchIndex],
                patchData.cellSize[patchIndex],
                patchIndex,
                volumeIndex2d(x, y),
                unknown,
                patchData.dt[patchIndex],
                patchData.QOut + patchIndex * QOutEnumerator.size(),
                QOutEnumerator
              );
            }
          }
        } else { // 3d of eigenvalue damping
          x = i.get_local_id(2) - solversHaloSize;

          internal::computeMaxEigenvalue_LoopBody<Solver>(
            patchData.QIn + patchIndex * QInEnumerator.size(),
            QInEnumerator,
            patchData.cellCentre[patchIndex],
            patchData.cellSize[patchIndex],
            patchIndex,
            volumeIndex3d(x, y, z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            0,
            tempEigenvalueX,
            eigenvalueEnumerator
          );


          internal::computeMaxEigenvalue_LoopBody<Solver>(
            patchData.QIn + patchIndex * QInEnumerator.size(),
            QInEnumerator,
            patchData.cellCentre[patchIndex],
            patchData.cellSize[patchIndex],
            patchIndex,
            volumeIndex3d(z, x, y),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            1,
            tempEigenvalueY,
            eigenvalueEnumerator
          );


          internal::computeMaxEigenvalue_LoopBody<Solver>(
            patchData.QIn + patchIndex * QInEnumerator.size(),
            QInEnumerator,
            patchData.cellCentre[patchIndex],
            patchData.cellSize[patchIndex],
            patchIndex,
            volumeIndex3d(y, z, x),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            2,
            tempEigenvalueZ,
            eigenvalueEnumerator
          );

          i.barrier();
          x += solversHaloSize;
          if (x < numberOfVolumesPerAxisInPatch) {
            for (int unknown = 0; unknown < unknowns + auxiliaryVariables; unknown++) {
              internal::updateSolutionWithEigenvalueDamping_LoopBody(
                patchData.QIn + patchIndex * QInEnumerator.size(),
                QInEnumerator,
                tempEigenvalueX,
                tempEigenvalueY,
                tempEigenvalueZ,
                eigenvalueEnumerator,
                patchData.cellCentre[patchIndex],
                patchData.cellSize[patchIndex],
                patchIndex,
                volumeIndex3d(x, y, z),
                unknown,
                patchData.dt[patchIndex],
                patchData.QOut + patchIndex * QOutEnumerator.size(),
                QOutEnumerator
              );
            }
          }
        }


        if (evaluateFlux and Dimensions == 2) {
          x = i.get_local_id(1) - solversHaloSize;

          internal::computeFlux_LoopBody<Solver, unknowns, auxiliaryVariables>(
            patchData.QIn + patchIndex * QInEnumerator.size(),
            QInEnumerator,
            patchData.cellCentre[patchIndex],
            patchData.cellSize[patchIndex],
            patchIndex,
            volumeIndex2d(x, y),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            0, // normal
            tempFluxX,
            fluxEnumerator
          );

          internal::computeFlux_LoopBody<Solver, unknowns, auxiliaryVariables>(
            patchData.QIn + patchIndex * QInEnumerator.size(),
            QInEnumerator,
            patchData.cellCentre[patchIndex],
            patchData.cellSize[patchIndex],
            patchIndex,
            volumeIndex2d(y, x),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            1, // normal
            tempFluxY,
            fluxEnumerator
          );

          i.barrier();
          x += solversHaloSize;

          if (x < numberOfVolumesPerAxisInPatch) {
            for (int unknown = 0; unknown < unknowns + auxiliaryVariables; unknown++) {
              internal::updateSolutionWithFlux_LoopBody(
                tempFluxX,
                tempFluxY,
                tempFluxZ,
                fluxEnumerator,
                patchData.cellCentre[patchIndex],
                patchData.cellSize[patchIndex],
                patchIndex,
                volumeIndex2d(x, y),
                unknown,
                patchData.dt[patchIndex],
                patchData.QOut + patchIndex * QOutEnumerator.size(),
                QOutEnumerator
              );
            }
          }
        } else if (evaluateFlux and Dimensions == 3) {
          x = i.get_local_id(2) - solversHaloSize;
          internal::computeFlux_LoopBody<Solver, unknowns, auxiliaryVariables>(
            patchData.QIn + patchIndex * QInEnumerator.size(),
            QInEnumerator,
            patchData.cellCentre[patchIndex],
            patchData.cellSize[patchIndex],
            patchIndex,
            volumeIndex3d(x, y, z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            0, // normal
            tempFluxX,
            fluxEnumerator
          );

          internal::computeFlux_LoopBody<Solver, unknowns, auxiliaryVariables>(
            patchData.QIn + patchIndex * QInEnumerator.size(),
            QInEnumerator,
            patchData.cellCentre[patchIndex],
            patchData.cellSize[patchIndex],
            patchIndex,
            volumeIndex3d(z, x, y),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            1, // normal
            tempFluxY,
            fluxEnumerator
          );

          internal::computeFlux_LoopBody<Solver, unknowns, auxiliaryVariables>(
            patchData.QIn + patchIndex * QInEnumerator.size(),
            QInEnumerator,
            patchData.cellCentre[patchIndex],
            patchData.cellSize[patchIndex],
            patchIndex,
            volumeIndex3d(y, z, x),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            2, // normal
            tempFluxZ,
            fluxEnumerator
          );

          i.barrier();
          x += solversHaloSize;

          if (x < numberOfVolumesPerAxisInPatch) {
            for (int unknown = 0; unknown < unknowns; unknown++) {
              internal::updateSolutionWithFlux_LoopBody(
                tempFluxX,
                tempFluxY,
                tempFluxZ,
                fluxEnumerator,
                patchData.cellCentre[patchIndex],
                patchData.cellSize[patchIndex],
                patchIndex,
                volumeIndex3d(x, y, z),
                unknown,
                patchData.dt[patchIndex],
                patchData.QOut + patchIndex * QOutEnumerator.size(),
                QOutEnumerator
              );
            }
          }
        }

        if (evaluateNonconservativeProduct and Dimensions == 2) {
          x = i.get_local_id(1) - solversHaloSize;
          internal::computeNonconservativeFlux_LoopBody<Solver, unknowns, auxiliaryVariables>(
            patchData.QIn + patchIndex * QInEnumerator.size(),
            QInEnumerator,
            patchData.cellCentre[patchIndex],
            patchData.cellSize[patchIndex],
            patchIndex,
            volumeIndex2d(x, y),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            0, // normal
            tempNonconservativeProductX,
            ncpEnumerator
          );

          internal::computeNonconservativeFlux_LoopBody<Solver, unknowns, auxiliaryVariables>(
            patchData.QIn + patchIndex * QInEnumerator.size(),
            QInEnumerator,
            patchData.cellCentre[patchIndex],
            patchData.cellSize[patchIndex],
            patchIndex,
            volumeIndex2d(y, x),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            1, // normal
            tempNonconservativeProductY,
            ncpEnumerator
          );

          i.barrier();
          x += solversHaloSize;

          if (x < numberOfVolumesPerAxisInPatch) {
            for (int unknown = 0; unknown < unknowns + auxiliaryVariables; unknown++) {
              internal::updateSolutionWithNonconservativeFlux_LoopBody(
                tempNonconservativeProductX,
                tempNonconservativeProductY,
                tempNonconservativeProductZ,
                ncpEnumerator,
                patchData.cellCentre[patchIndex],
                patchData.cellSize[patchIndex],
                patchIndex,
                volumeIndex2d(x, y),
                unknown,
                patchData.dt[patchIndex],
                patchData.QOut + patchIndex * QOutEnumerator.size(),
                QOutEnumerator
              );
            }
          }
        } else if (evaluateNonconservativeProduct and Dimensions == 3) {
          x = i.get_local_id(2) - solversHaloSize;
          internal::computeNonconservativeFlux_LoopBody<Solver, unknowns, auxiliaryVariables>(
            patchData.QIn + patchIndex * QInEnumerator.size(),
            QInEnumerator,
            patchData.cellCentre[patchIndex],
            patchData.cellSize[patchIndex],
            patchIndex,
            volumeIndex3d(x, y, z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            0, // normal
            tempNonconservativeProductX,
            ncpEnumerator
          );

          internal::computeNonconservativeFlux_LoopBody<Solver, unknowns, auxiliaryVariables>(
            patchData.QIn + patchIndex * QInEnumerator.size(),
            QInEnumerator,
            patchData.cellCentre[patchIndex],
            patchData.cellSize[patchIndex],
            patchIndex,
            volumeIndex3d(z, x, y),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            1, // normal
            tempNonconservativeProductY,
            ncpEnumerator
          );

          internal::computeNonconservativeFlux_LoopBody<Solver, unknowns, auxiliaryVariables>(
            patchData.QIn + patchIndex * QInEnumerator.size(),
            QInEnumerator,
            patchData.cellCentre[patchIndex],
            patchData.cellSize[patchIndex],
            patchIndex,
            volumeIndex3d(y, z, x),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            2, // normal
            tempNonconservativeProductZ,
            ncpEnumerator
          );

          i.barrier();
          x += solversHaloSize;

          if (x < numberOfVolumesPerAxisInPatch) {
            for (int unknown = 0; unknown < unknowns; unknown++) {
              internal::updateSolutionWithNonconservativeFlux_LoopBody(
                tempNonconservativeProductX,
                tempNonconservativeProductY,
                tempNonconservativeProductZ,
                ncpEnumerator,
                patchData.cellCentre[patchIndex],
                patchData.cellSize[patchIndex],
                patchIndex,
                volumeIndex3d(x, y, z),
                unknown,
                patchData.dt[patchIndex],
                patchData.QOut + patchIndex * QOutEnumerator.size(),
                QOutEnumerator
              );
            }
          }
        }

        i.barrier();
        if (evaluateMaximumEigenvalueAfterTimeStep and Dimensions == 2) {
          x = i.get_local_id(1);

          /* The slower (serial) version of the reduction
          if (x == 0 && y == 0) patchData.maxEigenvalue[patchIndex] = 0;
          if (x == 0 && y == 0) {
              double newMaxEigenvalue = 0.0;
                      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++) {
                        for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
                          newMaxEigenvalue = std::max(
                            newMaxEigenvalue,internal::reduceMaxEigenvalue_LoopBody<Solver>(
                            patchData.QOut + patchIndex * QOutEnumerator.size(),
                            QOutEnumerator,
                            patchData.cellCentre[patchIndex],
                            patchData.cellSize[patchIndex],
                            patchIndex,
                            volumeIndex2d(x,y),
                            patchData.t[patchIndex],
                            patchData.dt[patchIndex]
                            )
                          );
                        }
              }
                      patchData.maxEigenvalue[patchIndex] = newMaxEigenvalue;
            }
          */

          if (x < numberOfVolumesPerAxisInPatch) {
            tempEigenvalueX
              [patchIndex * numberOfVolumesPerAxisInPatch * (numberOfVolumesPerAxisInPatch + 2 * solversHaloSize)
               + (numberOfVolumesPerAxisInPatch + 2 * solversHaloSize) * y + x]
              = internal::reduceMaxEigenvalue_LoopBody<Solver>(
                patchData.QOut + patchIndex * QOutEnumerator.size(),
                QOutEnumerator,
                patchData.cellCentre[patchIndex],
                patchData.cellSize[patchIndex],
                patchIndex,
                volumeIndex2d(x, y),
                patchData.t[patchIndex],
                patchData.dt[patchIndex]
              );
          } else {
            tempEigenvalueX
              [patchIndex * numberOfVolumesPerAxisInPatch * (numberOfVolumesPerAxisInPatch + 2 * solversHaloSize)
               + (numberOfVolumesPerAxisInPatch + 2 * solversHaloSize) * y + x]
              = 0;
          }
          patchData.maxEigenvalue[patchIndex] = ::sycl::reduce_over_group(
            i.get_group(),
            tempEigenvalueX
              [patchIndex * numberOfVolumesPerAxisInPatch * (numberOfVolumesPerAxisInPatch + 2 * solversHaloSize)
               + (numberOfVolumesPerAxisInPatch + 2 * solversHaloSize) * y + x],
            ::sycl::maximum<>()
          );
        }

        else if (evaluateMaximumEigenvalueAfterTimeStep) {
          x = i.get_local_id(2);

          /*
          if (x == 0 && y == 0 && z == 0) {
            double newMaxEigenvalue = 0.0;
            for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
            for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
            for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
                      newMaxEigenvalue = std::max(
                        newMaxEigenvalue,
                        internal::reduceMaxEigenvalue_LoopBody<Solver>(
                          patchData.QOut + patchIndex * QOutEnumerator.size(),
                          QOutEnumerator,
                          patchData.cellCentre[patchIndex],
                          patchData.cellSize[patchIndex],
                          patchIndex,
                          volumeIndex3d(x,y,z),
                          patchData.t[patchIndex],
                          patchData.dt[patchIndex]
                        )
                      );
                    }
                    patchData.maxEigenvalue[patchIndex] = newMaxEigenvalue;
              }
          */

          if (x < numberOfVolumesPerAxisInPatch) {
            tempEigenvalueX
              [patchIndex * numberOfVolumesPerAxisInPatch * numberOfVolumesPerAxisInPatch
                 * (numberOfVolumesPerAxisInPatch + 2 * solversHaloSize)
               + numberOfVolumesPerAxisInPatch * (numberOfVolumesPerAxisInPatch + 2 * solversHaloSize) * z
               + (numberOfVolumesPerAxisInPatch + 2 * solversHaloSize) * y + x]
              = internal::reduceMaxEigenvalue_LoopBody<Solver>(
                patchData.QOut + patchIndex * QOutEnumerator.size(),
                QOutEnumerator,
                patchData.cellCentre[patchIndex],
                patchData.cellSize[patchIndex],
                patchIndex,
                volumeIndex3d(x, y, z),
                patchData.t[patchIndex],
                patchData.dt[patchIndex]
              );
          } else {
            tempEigenvalueX
              [patchIndex * numberOfVolumesPerAxisInPatch * numberOfVolumesPerAxisInPatch
                 * (numberOfVolumesPerAxisInPatch + 2 * solversHaloSize)
               + numberOfVolumesPerAxisInPatch * (numberOfVolumesPerAxisInPatch + 2 * solversHaloSize) * z
               + (numberOfVolumesPerAxisInPatch + 2 * solversHaloSize) * y + x]
              = 0;
          }

          patchData.maxEigenvalue[patchIndex] = ::sycl::reduce_over_group(
            i.get_group(),
            tempEigenvalueX
              [patchIndex * numberOfVolumesPerAxisInPatch * numberOfVolumesPerAxisInPatch
                 * (numberOfVolumesPerAxisInPatch + 2 * solversHaloSize)
               + numberOfVolumesPerAxisInPatch * (numberOfVolumesPerAxisInPatch + 2 * solversHaloSize) * z
               + (numberOfVolumesPerAxisInPatch + 2 * solversHaloSize) * y + x],
            ::sycl::maximum<>()
          );
        }
      }
    );
  });
  event.wait();

  /* Prints out kernel time without GPU-CPU data transfer
  auto start = event.get_profiling_info<::sycl::info::event_profiling::command_start>();
  auto stop = event.get_profiling_info<::sycl::info::event_profiling::command_end>();
  auto duration = static_cast<double>(stop - start) / NSEC_IN_SEC;
  if (evaluateMaximumEigenvalueAfterTimeStep == true) {
    ::std::cout << "Patchwise kernel execution time with reduction:" << duration << ::std::endl;
  }
  */

  patchData.destroy(hostPatchData, QOutEnumerator, evaluateMaximumEigenvalueAfterTimeStep, queue);

  if (tempFluxX != nullptr)
    ::sycl::free(tempFluxX, queue);
  if (tempFluxY != nullptr)
    ::sycl::free(tempFluxY, queue);
  if (tempFluxZ != nullptr)
    ::sycl::free(tempFluxZ, queue);
  if (tempNonconservativeProductX != nullptr)
    ::sycl::free(tempNonconservativeProductX, queue);
  if (tempNonconservativeProductY != nullptr)
    ::sycl::free(tempNonconservativeProductY, queue);
  if (tempNonconservativeProductZ != nullptr)
    ::sycl::free(tempNonconservativeProductZ, queue);
  if (tempEigenvalueX != nullptr)
    ::sycl::free(tempEigenvalueX, queue);
  if (tempEigenvalueY != nullptr)
    ::sycl::free(tempEigenvalueY, queue);
  if (tempEigenvalueZ != nullptr)
    ::sycl::free(tempEigenvalueZ, queue);
#else
  assertionMsg(
    false, "this routine should only be used in combination with SYCL offloading, as it has a device parameter"
  );
#endif
}
