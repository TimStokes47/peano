#include "Rusanov.h"
#include "GPUCellData.h"
#include "tarch/compiler/CompilerSpecificSettings.h"
#include "tarch/accelerator/accelerator.h"
#include "exahype2/fv/rusanov/LoopBody.h"
#include <chrono>
#include <cstdlib>
#define NSEC_IN_SEC 1000000000.0


template <
  typename Solver,
  std::size_t  numberOfVolumesPerAxisInPatch,
  std::size_t  haloSize,
  std::size_t  unknowns,
  std::size_t  auxiliaryVariables,
  typename TempDataEnumerator
>
void exahype2::fv::rusanov::sycl::timeStepWithRusanov_patchwise_static_calls(
  int                     targetDevice,
  ::exahype2::CellData&   hostPatchData,
  bool                    evaluateFlux,
  bool                    evaluateNonconservativeProduct,
  bool                    evaluateSource,
  bool                    evaluateMaximumEigenvalueAfterTimeStep
) {
  #if defined(GPUOffloadingSYCL)
  ::sycl::property_list prop_list{::sycl::property::queue::enable_profiling()};
  ::sycl::queue queue{::sycl::gpu_selector_v, prop_list};
  //::sycl::queue& queue = tarch::accelerator::getSYCLQueue(targetDevice);

  constexpr int solversHaloSize        = 1;

  exahype2::enumerator::AoSLexicographicEnumerator QInEnumerator       (                        1, numberOfVolumesPerAxisInPatch, haloSize, unknowns, auxiliaryVariables);
  exahype2::enumerator::AoSLexicographicEnumerator QOutEnumerator      (                        1, numberOfVolumesPerAxisInPatch,        0, unknowns, auxiliaryVariables);
  TempDataEnumerator fluxEnumerator      (hostPatchData.numberOfCells, numberOfVolumesPerAxisInPatch,   solversHaloSize, unknowns, 0);
  TempDataEnumerator ncpEnumerator       (hostPatchData.numberOfCells, numberOfVolumesPerAxisInPatch+1, solversHaloSize, unknowns, 0);
  TempDataEnumerator eigenvalueEnumerator(hostPatchData.numberOfCells, numberOfVolumesPerAxisInPatch,   solversHaloSize,        1, 0);

  auto before = ::std::chrono::system_clock::now();

  double* tempFluxX                   = evaluateFlux ?                                     ::sycl::malloc_device<double>(fluxEnumerator.size(), queue) : nullptr;
  double* tempFluxY                   = evaluateFlux ?                                     ::sycl::malloc_device<double>(fluxEnumerator.size(), queue) : nullptr;
  double* tempFluxZ                   = evaluateFlux and Dimensions==3 ?                   ::sycl::malloc_device<double>(fluxEnumerator.size(), queue) : nullptr;
  double* tempNonconservativeProductX = evaluateNonconservativeProduct ?                   ::sycl::malloc_device<double>(ncpEnumerator.size(), queue) : nullptr;
  double* tempNonconservativeProductY = evaluateNonconservativeProduct ?                   ::sycl::malloc_device<double>(ncpEnumerator.size(), queue) : nullptr;
  double* tempNonconservativeProductZ = evaluateNonconservativeProduct and Dimensions==3 ? ::sycl::malloc_device<double>(ncpEnumerator.size(), queue) : nullptr;
  double* tempEigenvalueX             = ::sycl::malloc_device<double>(eigenvalueEnumerator.size(), queue);
  double* tempEigenvalueY             = ::sycl::malloc_device<double>(eigenvalueEnumerator.size(), queue);
  double* tempEigenvalueZ             = ::sycl::malloc_device<double>(eigenvalueEnumerator.size(), queue);

  ::std::chrono::duration<double> end = ::std::chrono::system_clock::now() - before;
  //::std::cout << "Temp data malloc time:" << end.count() << ::std::endl;

  const std::size_t numberOfPatches = hostPatchData.numberOfCells;
  before = ::std::chrono::system_clock::now();
  GPUCellData  patchData( hostPatchData, QInEnumerator, QOutEnumerator, queue );
  end = ::std::chrono::system_clock::now() - before;
  //::std::cout << "GPU patch creation time:" << end.count() << ::std::endl;
  #if Dimensions == 2
  ::sycl::range<2> totalWorkItem{numberOfVolumesPerAxisInPatch, (numberOfVolumesPerAxisInPatch+2*solversHaloSize)*numberOfPatches};
  ::sycl::range<2> workgroupSize{numberOfVolumesPerAxisInPatch, numberOfVolumesPerAxisInPatch+2*solversHaloSize}; //only AoS benefit from this loop ordering
  #else
  ::sycl::range<3> totalWorkItem{numberOfVolumesPerAxisInPatch, numberOfVolumesPerAxisInPatch, (numberOfVolumesPerAxisInPatch+2*solversHaloSize)*numberOfPatches};
  ::sycl::range<3> workgroupSize{numberOfVolumesPerAxisInPatch, numberOfVolumesPerAxisInPatch, numberOfVolumesPerAxisInPatch+2*solversHaloSize};
  #endif

  ::sycl::event event = queue.submit(
    [&](::sycl::handler &handle) {
      handle.parallel_for(
      #if Dimensions == 2
      ::sycl::nd_range<2> {totalWorkItem, workgroupSize}, [=] (::sycl::nd_item<2> i) {
		int patchIndex    = i.get_group(1);
		int y             = i.get_local_id(0);
		int x             = i.get_local_id(1);
		int z;
		
      #else 
	  ::sycl::nd_range<3> {totalWorkItem, workgroupSize}, [=] (::sycl::nd_item<3> i) {
		int patchIndex  = i.get_group(2);
		int z = i.get_local_id(0);
		int y = i.get_local_id(1);
		int x = i.get_local_id(2);
      #endif
	  
      /*
        if (Dimensions==2 and evaluateSource) {
          handle.parallel_for( // -> should be parallel_for_work_items
                ::sycl::range<2>{numberOfVolumesPerAxisInPatch,numberOfVolumesPerAxisInPatch},
                [&] (::sycl::item<2> i) {
                  int x          = i[0];
                  int y          = i[1];
                  internal::copySolutionAndAddSourceTerm_LoopBody<Solver>(
                    patchData.QIn + patchIndex * QInEnumerator.size(),
                    QInEnumerator,
                    patchData.cellCentre[patchIndex],
                    patchData.cellSize[patchIndex],
                    patchIndex,
                    volumeIndex2d(x,y),
                    patchData.t[patchIndex],
                    patchData.dt[patchIndex],
                    patchData.QOut + patchIndex * QOutEnumerator.size(),
                    QOutEnumerator
                  );
                }
          );
        }
        else if (Dimensions==3 and evaluateSource) {
          handle.parallel_for(
                ::sycl::range<3>{numberOfVolumesPerAxisInPatch,numberOfVolumesPerAxisInPatch,numberOfVolumesPerAxisInPatch},
                [=] (::sycl::item<3> i) {
                  int x          = i[0];
                  int y          = i[1];
                  int z          = i[2];
                  internal::copySolutionAndAddSourceTerm_LoopBody<Solver>(
                      patchData.QIn + patchIndex * QInEnumerator.size(),
                      QInEnumerator,
                      patchData.cellCentre[patchIndex],
                      patchData.cellSize[patchIndex],
                      patchIndex,
                      volumeIndex3d(x,y,z),
                      patchData.t[patchIndex],
                      patchData.dt[patchIndex],
                      patchData.QOut + patchIndex * QOutEnumerator.size(),
                      QOutEnumerator
                   );
                }
          );
        }*/

        if (Dimensions==2) {
				  if (x < numberOfVolumesPerAxisInPatch) {
					for (int unknown = 0; unknown < unknowns+auxiliaryVariables; unknown++){
                    internal::copySolution_LoopBody(
                      patchData.QIn + patchIndex * QInEnumerator.size(),
                      QInEnumerator,
                      patchIndex,
                      volumeIndex2d(x,y),
                      unknown,
                      patchData.QOut + patchIndex * QOutEnumerator.size(),
                      QOutEnumerator
                    );
				    }
			      }
	    }
                
        else {
			    if (x < numberOfVolumesPerAxisInPatch) {
                  for (int unknown = 0; unknown < unknowns+auxiliaryVariables; unknown++) {
                    internal::copySolution_LoopBody(
                      patchData.QIn + patchIndex * QInEnumerator.size(),
                      QInEnumerator,
                      patchIndex,
                      volumeIndex3d(x,y,z),
                      unknown,
                      patchData.QOut + patchIndex * QOutEnumerator.size(),
                      QOutEnumerator
                    );
                  }
				}
        }

        if (Dimensions==2) {
                  x          = i.get_local_id(1)-solversHaloSize;
                    internal::computeMaxEigenvalue_LoopBody<Solver>(
                      patchData.QIn + patchIndex * QInEnumerator.size(),
                      QInEnumerator,
                      patchData.cellCentre[patchIndex],
                      patchData.cellSize[patchIndex],
                      patchIndex,
                      volumeIndex2d(x,y),
                      patchData.t[patchIndex], patchData.dt[patchIndex],
                      0,
                      tempEigenvalueX,
                      eigenvalueEnumerator
                    );
				  
                    internal::computeMaxEigenvalue_LoopBody<Solver>(
                      patchData.QIn + patchIndex * QInEnumerator.size(),
                      QInEnumerator,
                      patchData.cellCentre[patchIndex],
                      patchData.cellSize[patchIndex],
                      patchIndex,
                      volumeIndex2d(y,x),
                      patchData.t[patchIndex], patchData.dt[patchIndex],
                      1,
                      tempEigenvalueY,
                      eigenvalueEnumerator
                    );

				  i.barrier();
				  x += solversHaloSize;
                  if (x < numberOfVolumesPerAxisInPatch) {
                    for (int unknown = 0; unknown < unknowns+auxiliaryVariables; unknown++) {
					internal::updateSolutionWithEigenvalueDamping_LoopBody(
                      patchData.QIn + patchIndex * QInEnumerator.size(),
                      QInEnumerator,
                      tempEigenvalueX,
                      tempEigenvalueY,
                      tempEigenvalueZ,
                      eigenvalueEnumerator,
                      patchData.cellCentre[patchIndex],
                      patchData.cellSize[patchIndex],
                      patchIndex,
                      volumeIndex2d(x,y),
                      unknown,
                      patchData.dt[patchIndex],
                      patchData.QOut + patchIndex * QOutEnumerator.size(),
                      QOutEnumerator
                    );
					}
				  }
        }
        else {  // 3d of eigenvalue damping
                  x          = i.get_local_id(2)-solversHaloSize;

                  internal::computeMaxEigenvalue_LoopBody<Solver>(
                        patchData.QIn + patchIndex * QInEnumerator.size(),
                        QInEnumerator,
                        patchData.cellCentre[patchIndex],
                        patchData.cellSize[patchIndex],
                        patchIndex,
                        volumeIndex3d(x,y,z),
                        patchData.t[patchIndex], patchData.dt[patchIndex],
                        0,
                        tempEigenvalueX,
                        eigenvalueEnumerator
                  );


                  internal::computeMaxEigenvalue_LoopBody<Solver>(
                      patchData.QIn + patchIndex * QInEnumerator.size(),
                      QInEnumerator,
                      patchData.cellCentre[patchIndex],
                      patchData.cellSize[patchIndex],
                      patchIndex,
                      volumeIndex3d(z,x,y),
                      patchData.t[patchIndex], patchData.dt[patchIndex],
                      1,
                      tempEigenvalueY,
                      eigenvalueEnumerator
                  );


                  internal::computeMaxEigenvalue_LoopBody<Solver>(
                      patchData.QIn + patchIndex * QInEnumerator.size(),
                      QInEnumerator,
                      patchData.cellCentre[patchIndex],
                      patchData.cellSize[patchIndex],
                      patchIndex,
                      volumeIndex3d(y,z,x),
                      patchData.t[patchIndex], patchData.dt[patchIndex],
                      2,
                      tempEigenvalueZ,
                      eigenvalueEnumerator
                  );

				  i.barrier();
				  x += solversHaloSize;
                  if (x < numberOfVolumesPerAxisInPatch) {
                  for (int unknown = 0; unknown < unknowns+auxiliaryVariables; unknown++) {
                    internal::updateSolutionWithEigenvalueDamping_LoopBody(
                      patchData.QIn + patchIndex * QInEnumerator.size(),
                      QInEnumerator,
                      tempEigenvalueX,
                      tempEigenvalueY,
                      tempEigenvalueZ,
                      eigenvalueEnumerator,
                      patchData.cellCentre[patchIndex],
                      patchData.cellSize[patchIndex],
                      patchIndex,
                      volumeIndex3d(x,y,z),
                      unknown,
                      patchData.dt[patchIndex],
                      patchData.QOut + patchIndex * QOutEnumerator.size(),
                      QOutEnumerator
                    );
                  }
				  }
                
          
        }


        if (evaluateFlux and Dimensions==2) {
                  x          = i.get_local_id(1)-solversHaloSize;
				  
                    internal::computeFlux_LoopBody<Solver, unknowns, auxiliaryVariables>(
                      patchData.QIn + patchIndex * QInEnumerator.size(),
                      QInEnumerator,
                      patchData.cellCentre[patchIndex],
                      patchData.cellSize[patchIndex],
                      patchIndex,
                      volumeIndex2d(x,y),
                      patchData.t[patchIndex],
                      patchData.dt[patchIndex],
                      0, // normal
                      tempFluxX,
                      fluxEnumerator
                    );
                  
                    internal::computeFlux_LoopBody<Solver, unknowns, auxiliaryVariables>(
                      patchData.QIn + patchIndex * QInEnumerator.size(),
                      QInEnumerator,
                      patchData.cellCentre[patchIndex],
                      patchData.cellSize[patchIndex],
                      patchIndex,
                      volumeIndex2d(y,x),
                      patchData.t[patchIndex],
                      patchData.dt[patchIndex],
                      1, // normal
                      tempFluxY,
                      fluxEnumerator
                    );

				  i.barrier();
				  x += solversHaloSize;

                  if (x < numberOfVolumesPerAxisInPatch) {
					for (int unknown = 0; unknown < unknowns+auxiliaryVariables; unknown++) {
					internal::updateSolutionWithFlux_LoopBody(
                      tempFluxX, tempFluxY, tempFluxZ,
                      fluxEnumerator,
                      patchData.cellCentre[patchIndex],
                      patchData.cellSize[patchIndex],
                      patchIndex,
                      volumeIndex2d(x,y),
                      unknown,
                      patchData.dt[patchIndex],
                      patchData.QOut + patchIndex * QOutEnumerator.size(),
                      QOutEnumerator
                    );
					}
                  }
        }
        else if (evaluateFlux and Dimensions==3) {    
			      x = i.get_local_id(2) - solversHaloSize;
                  internal::computeFlux_LoopBody<Solver, unknowns, auxiliaryVariables>(
                      patchData.QIn + patchIndex * QInEnumerator.size(),
                      QInEnumerator,
                      patchData.cellCentre[patchIndex],
                      patchData.cellSize[patchIndex],
                      patchIndex,
                      volumeIndex3d(x,y,z),
                      patchData.t[patchIndex],
                      patchData.dt[patchIndex],
                      0, // normal
                      tempFluxX,
                      fluxEnumerator
                    );
               
          

                  internal::computeFlux_LoopBody<Solver, unknowns, auxiliaryVariables>(
                      patchData.QIn + patchIndex * QInEnumerator.size(),
                      QInEnumerator,
                      patchData.cellCentre[patchIndex],
                      patchData.cellSize[patchIndex],
                      patchIndex,
                      volumeIndex3d(z,x,y),
                      patchData.t[patchIndex],
                      patchData.dt[patchIndex],
                      1, // normal
                      tempFluxY,
                      fluxEnumerator
                  );
               
          

                  internal::computeFlux_LoopBody<Solver, unknowns, auxiliaryVariables>(
                      patchData.QIn + patchIndex * QInEnumerator.size(),
                      QInEnumerator,
                      patchData.cellCentre[patchIndex],
                      patchData.cellSize[patchIndex],
                      patchIndex,
                      volumeIndex3d(y,z,x),
                      patchData.t[patchIndex],
                      patchData.dt[patchIndex],
                      2, // normal
                      tempFluxZ,
                      fluxEnumerator
                  );
                  
				  i.barrier();
				  x += solversHaloSize;
         
                  if (x < numberOfVolumesPerAxisInPatch) {
                  for (int unknown=0; unknown<unknowns; unknown++) {
                    internal::updateSolutionWithFlux_LoopBody(
                      tempFluxX, tempFluxY, tempFluxZ,
                      fluxEnumerator,
                      patchData.cellCentre[patchIndex],
                      patchData.cellSize[patchIndex],
                      patchIndex,
                      volumeIndex3d(x,y,z),
                      unknown,
                      patchData.dt[patchIndex],
                      patchData.QOut + patchIndex * QOutEnumerator.size(),
                      QOutEnumerator
                    );
                  }
				  }
                
          
        }

/*
        if (evaluateNonconservativeProduct and Dimensions==2) {
          handle.parallel_for(
                ::sycl::range<2>{numberOfVolumesPerAxisInPatch+2*solversHaloSize,numberOfVolumesPerAxisInPatch},
                [=] (::sycl::item<2> i) {
                  int x = i[0]-solversHaloSize;
                  int y = i[1];

                  internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
                      patchData.QIn + patchIndex * QInEnumerator.size(),
                      QInEnumerator,
                      patchData.cellCentre[patchIndex],
                      patchData.cellSize[patchIndex],
                      patchIndex,
                      volumeIndex2d(x,y),
                      patchData.t[patchIndex],
                      patchData.dt[patchIndex],
                      0, // normal
                      tempNonconservativeProductX,
                      ncpEnumerator
                  );
                }
          );

          handle.parallel_for(
                ::sycl::range<2>{numberOfVolumesPerAxisInPatch,numberOfVolumesPerAxisInPatch+2*solversHaloSize},
                [=] (::sycl::item<2> i) {
                  int x          = i[0];
                  int y          = i[1]-solversHaloSize;

                  internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
                      patchData.QIn + patchIndex * QInEnumerator.size(),
                      QInEnumerator,
                      patchData.cellCentre[patchIndex],
                      patchData.cellSize[patchIndex],
                      patchIndex,
                      volumeIndex2d(x,y),
                      patchData.t[patchIndex],
                      patchData.dt[patchIndex],
                      1, // normal
                      tempNonconservativeProductY,
                      ncpEnumerator
                  );
                }
          );

          handle.parallel_for(
                ::sycl::range<3>{numberOfPatches,numberOfVolumesPerAxisInPatch,numberOfVolumesPerAxisInPatch},
                [=] (::sycl::item<3> i) {
                  int unknown    = i[0];
                  int x          = i[1];
                  int y          = i[2];

                  internal::updateSolutionWithNonconservativeFlux_LoopBody(
                      tempNonconservativeProductX, tempNonconservativeProductY, tempNonconservativeProductZ,
                      ncpEnumerator,
                      patchData.cellCentre[patchIndex],
                      patchData.cellSize[patchIndex],
                      patchIndex,
                      volumeIndex2d(x,y),
                      unknown,
                      patchData.dt[patchIndex],
                      patchData.QOut + patchIndex * QOutEnumerator.size(),
                      QOutEnumerator
                  );
                }
          );
        }
        else if (evaluateNonconservativeProduct and Dimensions==3) {
          handle.parallel_for(
                ::sycl::range<3>{numberOfVolumesPerAxisInPatch+2*solversHaloSize,numberOfVolumesPerAxisInPatch,numberOfVolumesPerAxisInPatch},
                [=] (::sycl::item<3> i) {
                  int x  = i[0]-solversHaloSize;
                  int z  = i[1];
                  int y  = i[2];

                  internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
                      patchData.QIn + patchIndex * QInEnumerator.size(),
                      QInEnumerator,
                      patchData.cellCentre[patchIndex],
                      patchData.cellSize[patchIndex],
                      patchIndex,
                      volumeIndex3d(x,y,z),
                      patchData.t[patchIndex],
                      patchData.dt[patchIndex],
                      0, // normal
                      tempNonconservativeProductX,
                      ncpEnumerator
                  );
                }
          );

          handle.parallel_for(
                ::sycl::range<3>{numberOfVolumesPerAxisInPatch,numberOfVolumesPerAxisInPatch+2*solversHaloSize,numberOfVolumesPerAxisInPatch},
                [=] (::sycl::item<3> i) {
                  int x  = i[0];
                  int y  = i[1]-solversHaloSize;
                  int z  = i[2];

                  internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
                      patchData.QIn + patchIndex * QInEnumerator.size(),
                      QInEnumerator,
                      patchData.cellCentre[patchIndex],
                      patchData.cellSize[patchIndex],
                      patchIndex,
                      volumeIndex3d(x,y,z),
                      patchData.t[patchIndex],
                      patchData.dt[patchIndex],
                      1, // normal
                      tempNonconservativeProductY,
                      ncpEnumerator
                  );
                }
          );

          handle.parallel_for(
                ::sycl::range<3>{numberOfVolumesPerAxisInPatch,numberOfVolumesPerAxisInPatch,numberOfVolumesPerAxisInPatch+2*solversHaloSize},
                [=] (::sycl::item<3> i) {
                  int x  = i[0];
                  int y  = i[1];
                  int z  = i[2]-solversHaloSize;

                  internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
                      patchData.QIn + patchIndex * QInEnumerator.size(),
                      QInEnumerator,
                      patchData.cellCentre[patchIndex],
                      patchData.cellSize[patchIndex],
                      patchIndex,
                      volumeIndex3d(x,y,z),
                      patchData.t[patchIndex],
                      patchData.dt[patchIndex],
                      2, // normal
                      tempNonconservativeProductZ,
                      ncpEnumerator
                  );
                }
          );

          handle.parallel_for(
                ::sycl::range<3>{numberOfVolumesPerAxisInPatch,numberOfVolumesPerAxisInPatch,numberOfVolumesPerAxisInPatch},
                [=] (::sycl::item<3> i) {
                  int x          = i[0];
                  int y          = i[1];
                  int z          = i[2];

                  for (int unknown=0; unknown<unknowns; unknown++) {
                    internal::updateSolutionWithNonconservativeFlux_LoopBody(
                      tempNonconservativeProductX, tempNonconservativeProductY, tempNonconservativeProductZ,
                      ncpEnumerator,
                      patchData.cellCentre[patchIndex],
                      patchData.cellSize[patchIndex],
                      patchIndex,
                      volumeIndex3d(x,y,z),
                      unknown,
                      patchData.dt[patchIndex],
                      patchData.QOut + patchIndex * QOutEnumerator.size(),
                      QOutEnumerator
                    );
                  }
                }
          );
        }*/

		i.barrier();
            if (evaluateMaximumEigenvalueAfterTimeStep and Dimensions==2) {
			    x = i.get_local_id(1);
				/*
				if (x == 0 && y == 0) patchData.maxEigenvalue[patchIndex] = 0;
				  if (x < numberOfVolumesPerAxisInPatch) {
					  auto atomicNewMaxEigenvalue = ::sycl::atomic_ref<double,
						::sycl::memory_order::relaxed,
						::sycl::memory_scope::device,
						::sycl::access::address_space::global_space>
						(patchData.maxEigenvalue[patchIndex]);

					  atomicNewMaxEigenvalue.fetch_max(internal::reduceMaxEigenvalue_LoopBody<Solver>( 
						patchData.QOut + patchIndex * QOutEnumerator.size(),
						QOutEnumerator,
