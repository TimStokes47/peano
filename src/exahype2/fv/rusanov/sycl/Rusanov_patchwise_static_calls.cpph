                  int x          = i[0];
                  int y          = i[1];
                  int z          = i[2];

                  for (int unknown = 0; unknown < unknowns; unknown++) {
                    internal::updateSolutionWithEigenvalueDamping_LoopBody(
                      patchData.QIn + patchIndex * QInEnumerator.size(),
                      QInEnumerator,
                      tempEigenvalueX,
                      tempEigenvalueY,
