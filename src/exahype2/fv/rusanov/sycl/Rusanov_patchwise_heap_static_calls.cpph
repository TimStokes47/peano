template <
  typename Solver,
  int      numberOfVolumesPerAxisInPatch,
  int      haloSize,
  int      unknowns,
  int      auxiliaryVariables,
  typename TempDataEnumerator
>
void exahype2::fv::rusanov::sycl::timeStepWithRusanov_patchwise_heap_static_calls(
  int                     targetDevice,
  ::exahype2::CellData&   hostPatchData,
  bool                    evaluateFlux,
  bool                    evaluateNonconservativeProduct,
  bool                    evaluateSource,
  bool                    evaluateMaximumEigenvalueAfterTimeStep
) {
  #if defined(GPUOffloadingSYCL)
  ::sycl::queue& queue = tarch::multicore::getSYCLQueue(targetDevice);

  constexpr int solversHaloSize        = 1;

  exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator QInHostEnumerator       (                        1, numberOfVolumesPerAxisInPatch, haloSize, unknowns, auxiliaryVariables);
  exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator QOutHostEnumerator      (                        1, numberOfVolumesPerAxisInPatch,        0, unknowns, auxiliaryVariables);
  TempDataEnumerator fluxHostEnumerator      (hostPatchData.numberOfCells, numberOfVolumesPerAxisInPatch,   solversHaloSize, unknowns, 0);
  TempDataEnumerator ncpHostEnumerator       (hostPatchData.numberOfCells, numberOfVolumesPerAxisInPatch+1, solversHaloSize, unknowns, 0);
  TempDataEnumerator eigenvalueHostEnumerator(hostPatchData.numberOfCells, numberOfVolumesPerAxisInPatch,   solversHaloSize,        1, 0);

  double* tempFluxX                   = evaluateFlux ?                                     ::sycl::malloc_device<double>(fluxHostEnumerator.size(), queue) : nullptr;
  double* tempFluxY                   = evaluateFlux ?                                     ::sycl::malloc_device<double>(fluxHostEnumerator.size(), queue) : nullptr;
  double* tempFluxZ                   = evaluateFlux and Dimensions==3 ?                   ::sycl::malloc_device<double>(fluxHostEnumerator.size(), queue) : nullptr;
  double* tempNonconservativeProductX = evaluateNonconservativeProduct ?                   ::sycl::malloc_device<double>(ncpHostEnumerator.size(), queue) : nullptr;
  double* tempNonconservativeProductY = evaluateNonconservativeProduct ?                   ::sycl::malloc_device<double>(ncpHostEnumerator.size(), queue) : nullptr;
  double* tempNonconservativeProductZ = evaluateNonconservativeProduct and Dimensions==3 ? ::sycl::malloc_device<double>(ncpHostEnumerator.size(), queue) : nullptr;
  double* tempEigenvalueX             = ::sycl::malloc_device<double>(eigenvalueHostEnumerator.size(), queue);
  double* tempEigenvalueY             = ::sycl::malloc_device<double>(eigenvalueHostEnumerator.size(), queue);
  double* tempEigenvalueZ             = ::sycl::malloc_device<double>(eigenvalueHostEnumerator.size(), queue);

  const int grainSizeVolumesX = 1;
  const int grainSizeVolumesY = 1;
  const int grainSizeVolumesZ = 1;
  const int grainSizeUnknowns = 1;

  queue.submit(
    [&](::sycl::handler &cgh) {
      exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator QInEnumerator       (                        1, numberOfVolumesPerAxisInPatch, haloSize, unknowns, auxiliaryVariables);
      exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator QOutEnumerator      (                        1, numberOfVolumesPerAxisInPatch,        0, unknowns, auxiliaryVariables);
      TempDataEnumerator fluxEnumerator      (hostPatchData.numberOfCells, numberOfVolumesPerAxisInPatch,   solversHaloSize, unknowns, 0);
      TempDataEnumerator ncpEnumerator       (hostPatchData.numberOfCells, numberOfVolumesPerAxisInPatch+1, solversHaloSize, unknowns, 0);
      TempDataEnumerator eigenvalueEnumerator(hostPatchData.numberOfCells, numberOfVolumesPerAxisInPatch,   solversHaloSize,        1, 0);

      const std::size_t iterationRange = hostPatchData.numberOfCells;
      cgh.parallel_for(
        ::sycl::nd_range<3>{
          {iterationRange, iterationRange, iterationRange},
          {grainSizeVolumesX, grainSizeVolumesY, grainSizeVolumesZ}
        },
        [=](::sycl::nd_item<3> workItem) {
//          auto [z,y] = glob2loc(item.get_global_id(2), numVPAIP);
 //         auto [x,i] = glob2loc(item.get_global_id(1), unknowns+aux);

        }
      );
    }
  );

  if (tempFluxX!=nullptr)                   ::sycl::free( tempFluxX, queue);
  if (tempFluxY!=nullptr)                   ::sycl::free( tempFluxY, queue);
  if (tempFluxZ!=nullptr)                   ::sycl::free( tempFluxZ, queue);
  if (tempNonconservativeProductX!=nullptr) ::sycl::free( tempNonconservativeProductX, queue);
  if (tempNonconservativeProductY!=nullptr) ::sycl::free( tempNonconservativeProductY, queue);
  if (tempNonconservativeProductZ!=nullptr) ::sycl::free( tempNonconservativeProductZ, queue);
  if (tempEigenvalueX!=nullptr)             ::sycl::free( tempEigenvalueX, queue);
  if (tempEigenvalueY!=nullptr)             ::sycl::free( tempEigenvalueY, queue);
  if (tempEigenvalueZ!=nullptr)             ::sycl::free( tempEigenvalueZ, queue);
  #else
  assertionMsg(false, "this routine should only be used in combination with OpenMP offloading, as it has a device parameter" );
  #endif
}

