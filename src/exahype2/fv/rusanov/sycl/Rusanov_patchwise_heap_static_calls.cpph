template <
  typename Solver,
  std::size_t  numberOfVolumesPerAxisInPatch,
  std::size_t  haloSize,
  std::size_t  unknowns,
  std::size_t  auxiliaryVariables,
  typename TempDataEnumerator
>
void exahype2::fv::rusanov::sycl::timeStepWithRusanov_patchwise_heap_static_calls(
  int                     targetDevice,
  ::exahype2::CellData&   hostPatchData,
  bool                    evaluateFlux,
  bool                    evaluateNonconservativeProduct,
  bool                    evaluateSource,
  bool                    evaluateMaximumEigenvalueAfterTimeStep
) {
  ::exahype2::fv::rusanov::sycl::timeStepWithRusanov_batched_heap_static_calls<
    Solver,
    numberOfVolumesPerAxisInPatch,
    haloSize,
    unknowns,
    auxiliaryVariables,
    TempDataEnumerator
  >(
    targetDevice,
    hostPatchData,
    evaluateFlux,
    evaluateNonconservativeProduct,
    evaluateSource,
    evaluateMaximumEigenvalueAfterTimeStep
  );
}
