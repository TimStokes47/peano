#include "../../../tarch/multicore/otter.h"
#include "Rusanov.h"
#include "tarch/compiler/CompilerSpecificSettings.h"


template <
  typename Solver,
  int      numberOfVolumesPerAxisInPatch,
  int      haloSize,
  int      unknowns,
  int      auxiliaryVariables,
  typename TempDataEnumerator
>
void exahype2::fv::rusanov::timeStepWithRusanov_patchwise_split_terms_call_stack_static_calls(
  ::exahype2::CellData&   patchData,
  bool                    evaluateFlux,
  bool                    evaluateNonconservativeProduct,
  bool                    evaluateSource,
  bool                    evaluateMaximumEigenvalueAfterTimeStep
) {
  static tarch::logging::Log _log( "exahype2::fv::rusanov" );

  /**
   * The halo size passed in by the user might differ from the one that we have to evaluate/
   * take into account from the solver's perspective.
   */
  constexpr int solversHaloSize        = 1;

  exahype2::enumerator::AoSLexicographicEnumerator QInEnumerator       (                        1, numberOfVolumesPerAxisInPatch,haloSize,unknowns,auxiliaryVariables);
  exahype2::enumerator::AoSLexicographicEnumerator QOutEnumerator      (                        1, numberOfVolumesPerAxisInPatch,       0,unknowns,auxiliaryVariables);
  TempDataEnumerator fluxEnumerator      (patchData.numberOfCells, numberOfVolumesPerAxisInPatch,    solversHaloSize,unknowns,0);
  TempDataEnumerator ncpEnumerator       (patchData.numberOfCells, numberOfVolumesPerAxisInPatch+1,  solversHaloSize,unknowns,0);
  TempDataEnumerator eigenvalueEnumerator(patchData.numberOfCells, numberOfVolumesPerAxisInPatch,    solversHaloSize,1,0);

  double tempFluxX[ fluxEnumerator.size() ] __attribute__((aligned (AlignmentOnHeap)));
  double tempFluxY[ fluxEnumerator.size() ] __attribute__((aligned (AlignmentOnHeap)));
  double tempFluxZ[ fluxEnumerator.size() ] __attribute__((aligned (AlignmentOnHeap)));
  double tempNonconservativeProductX[ ncpEnumerator.size() ] __attribute__((aligned (AlignmentOnHeap)));
  double tempNonconservativeProductY[ ncpEnumerator.size() ] __attribute__((aligned (AlignmentOnHeap)));
  double tempNonconservativeProductZ[ ncpEnumerator.size() ] __attribute__((aligned (AlignmentOnHeap)));
  double tempEigenvalueX[ eigenvalueEnumerator.size() ] __attribute__((aligned (AlignmentOnHeap)));
  double tempEigenvalueY[ eigenvalueEnumerator.size() ] __attribute__((aligned (AlignmentOnHeap)));
  double tempEigenvalueZ[ eigenvalueEnumerator.size() ] __attribute__((aligned (AlignmentOnHeap)));

  for (int patchIndex=0; patchIndex<patchData.numberOfCells; patchIndex++) {
    if (Dimensions==2 and evaluateSource) {
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      #if defined(SharedOMP)
      #pragma omp simd
      #endif
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        internal::copySolutionAndAddSourceTerm_LoopBody<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.cellCentre[patchIndex],
          patchData.cellSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          patchData.QOut[patchIndex],
          QOutEnumerator
        );
      }
    }
    else if (Dimensions==3 and evaluateSource) {
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      #if defined(SharedOMP)
      #pragma omp simd
      #endif
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        internal::copySolutionAndAddSourceTerm_LoopBody<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.cellCentre[patchIndex],
          patchData.cellSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          patchData.QOut[patchIndex],
          QOutEnumerator
        );
      }
    }
    else if (Dimensions==2) {
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      #if defined(SharedOMP)
      #pragma omp simd collapse(2)
      #endif
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int unknown=0; unknown<unknowns+auxiliaryVariables; unknown++) {
        internal::copySolution_LoopBody(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchIndex,
          volumeIndex2d(x,y),
          unknown,
          patchData.QOut[patchIndex],
          QOutEnumerator
        );
      }
    }
    else {
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      #if defined(SharedOMP)
      #pragma omp simd collapse(2)
      #endif
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int unknown=0; unknown<unknowns+auxiliaryVariables; unknown++) {
        internal::copySolution_LoopBody(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchIndex,
          volumeIndex3d(x,y,z),
          unknown,
          patchData.QOut[patchIndex],
          QOutEnumerator
        );
      }
    }


    if (Dimensions==2) {
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      #if defined(SharedOMP)
      #pragma omp simd
      #endif
      for (int x = -solversHaloSize; x < numberOfVolumesPerAxisInPatch+solversHaloSize; x++) {
        internal::computeMaxEigenvalue_LoopBody<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.cellCentre[patchIndex],
            patchData.cellSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            patchData.t[patchIndex], patchData.dt[patchIndex],
            0,
            tempEigenvalueX,
            eigenvalueEnumerator
        );
      }

      for (int y = -solversHaloSize; y < numberOfVolumesPerAxisInPatch+solversHaloSize; y++)
      #if defined(SharedOMP)
      #pragma omp simd
      #endif
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        internal::computeMaxEigenvalue_LoopBody<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.cellCentre[patchIndex],
            patchData.cellSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            patchData.t[patchIndex], patchData.dt[patchIndex],
            1,
            tempEigenvalueY,
            eigenvalueEnumerator
        );
      }
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int unknown = 0; unknown < unknowns; unknown++) {
        internal::updateSolutionWithEigenvalueDamping_LoopBody(
          patchData.QIn[patchIndex],
          QInEnumerator,
          tempEigenvalueX,
          tempEigenvalueY,
          tempEigenvalueZ,
          eigenvalueEnumerator,
          patchData.cellCentre[patchIndex],
          patchData.cellSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          unknown,
          patchData.dt[patchIndex],
          patchData.QOut[patchIndex],
          QOutEnumerator
        );
      }
    }
    else {
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      #if defined(SharedOMP)
      #pragma omp simd
      #endif
      for (int x = -solversHaloSize; x < numberOfVolumesPerAxisInPatch+solversHaloSize; x++) {
        internal::computeMaxEigenvalue_LoopBody<Solver>(
              patchData.QIn[patchIndex],
              QInEnumerator,
              patchData.cellCentre[patchIndex],
              patchData.cellSize[patchIndex],
              patchIndex,
              volumeIndex3d(x,y,z),
              patchData.t[patchIndex], patchData.dt[patchIndex],
              0,
              tempEigenvalueX,
              eigenvalueEnumerator
        );
      }
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int y = -solversHaloSize; y < numberOfVolumesPerAxisInPatch+solversHaloSize; y++)
      #if defined(SharedOMP)
      #pragma omp simd
      #endif
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        internal::computeMaxEigenvalue_LoopBody<Solver>(
              patchData.QIn[patchIndex],
              QInEnumerator,
              patchData.cellCentre[patchIndex],
              patchData.cellSize[patchIndex],
              patchIndex,
              volumeIndex3d(x,y,z),
              patchData.t[patchIndex], patchData.dt[patchIndex],
              1,
              tempEigenvalueY,
              eigenvalueEnumerator
        );
      }
      for (int z = -solversHaloSize; z < numberOfVolumesPerAxisInPatch+solversHaloSize; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      #if defined(SharedOMP)
      #pragma omp simd
      #endif
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        internal::computeMaxEigenvalue_LoopBody<Solver>(
              patchData.QIn[patchIndex],
              QInEnumerator,
              patchData.cellCentre[patchIndex],
              patchData.cellSize[patchIndex],
              patchIndex,
              volumeIndex3d(x,y,z),
              patchData.t[patchIndex], patchData.dt[patchIndex],
              2,
              tempEigenvalueZ,
              eigenvalueEnumerator
        );
      }
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int unknown = 0; unknown < unknowns; unknown++) {
        internal::updateSolutionWithEigenvalueDamping_LoopBody(
          patchData.QIn[patchIndex],
          QInEnumerator,
          tempEigenvalueX,
          tempEigenvalueY,
          tempEigenvalueZ,
          eigenvalueEnumerator,
          patchData.cellCentre[patchIndex],
          patchData.cellSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          unknown,
          patchData.dt[patchIndex],
          patchData.QOut[patchIndex],
          QOutEnumerator
        );
      }
    }

    if (evaluateFlux and Dimensions==2) {
      #pragma clang loop unroll(enable)
      for (int pick = 0; pick < unknowns;                      pick++)
      for (int y =    0; y    < numberOfVolumesPerAxisInPatch; y++)
      #if defined(SharedOMP)
      #pragma omp simd
      #endif
      for (int x = -solversHaloSize; x < numberOfVolumesPerAxisInPatch+solversHaloSize; x++) {
        internal::computeFlux_LoopBody<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.cellCentre[patchIndex],
          patchData.cellSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          0, // normal
          tempFluxX,
          fluxEnumerator,
          pick
        );
      }
      #pragma clang loop unroll(enable)
      for (int pick = 0; pick < unknowns;                      pick++)
      for (int y = -solversHaloSize; y < numberOfVolumesPerAxisInPatch+solversHaloSize;  y++)
      #if defined(SharedOMP)
      #pragma omp simd
      #endif
      for (int x =         0; x < numberOfVolumesPerAxisInPatch;           x++) {
        internal::computeFlux_LoopBody<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.cellCentre[patchIndex],
          patchData.cellSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          1, // normal
          tempFluxY,
          fluxEnumerator,
          pick
        );
      }
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int unknown=0; unknown<unknowns; unknown++) {
        internal::updateSolutionWithFlux_LoopBody(
          tempFluxX, tempFluxY, tempFluxZ,
          fluxEnumerator,
          patchData.cellCentre[patchIndex],
          patchData.cellSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          unknown,
          patchData.dt[patchIndex],
          *(patchData.QOut + patchIndex),
          QOutEnumerator
        );
      }
    }
    else if (evaluateFlux and Dimensions==3) {
      #pragma clang loop unroll(enable)
      for (int pick = 0; pick < unknowns;                      pick++)
      for (int z =         0; z < numberOfVolumesPerAxisInPatch;          z++)
      for (int y =         0; y < numberOfVolumesPerAxisInPatch;          y++)
      #if defined(SharedOMP)
      #pragma omp simd
      #endif
      for (int x = -solversHaloSize; x < numberOfVolumesPerAxisInPatch+solversHaloSize; x++) {
        internal::computeFlux_LoopBody<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.cellCentre[patchIndex],
          patchData.cellSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          0, // normal
          tempFluxX,
          fluxEnumerator,
          pick
        );
      }
      #pragma clang loop unroll(enable)
      for (int pick = 0; pick < unknowns;                      pick++)
      for (int z =         0; z < numberOfVolumesPerAxisInPatch;           z++)
      for (int y = -solversHaloSize; y < numberOfVolumesPerAxisInPatch+solversHaloSize;  y++)
      #if defined(SharedOMP)
      #pragma omp simd
      #endif
      for (int x =         0; x < numberOfVolumesPerAxisInPatch;           x++) {
        internal::computeFlux_LoopBody<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.cellCentre[patchIndex],
          patchData.cellSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          1, // normal
          tempFluxY,
          fluxEnumerator,
          pick
        );
      }
      #pragma clang loop unroll(enable)
      for (int pick = 0; pick < unknowns;                      pick++)
      for (int z = -solversHaloSize; z < numberOfVolumesPerAxisInPatch+solversHaloSize;  z++)
      for (int y =         0; y < numberOfVolumesPerAxisInPatch;           y++)
      #if defined(SharedOMP)
      #pragma omp simd
      #endif
      for (int x =         0; x < numberOfVolumesPerAxisInPatch;           x++) {
        internal::computeFlux_LoopBody<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.cellCentre[patchIndex],
          patchData.cellSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          2, // normal
          tempFluxZ,
          fluxEnumerator,
          pick
        );
      }
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int unknown=0; unknown<unknowns; unknown++) {
        internal::updateSolutionWithFlux_LoopBody(
          tempFluxX, tempFluxY, tempFluxZ,
          fluxEnumerator,
          patchData.cellCentre[patchIndex],
          patchData.cellSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          unknown,
          patchData.dt[patchIndex],
          *(patchData.QOut + patchIndex),
          QOutEnumerator
        );
      }
    }


    if (evaluateNonconservativeProduct and Dimensions==2) {
      #pragma clang loop unroll(enable)
      for (int pick = 0; pick < unknowns;                      pick++)
      for (int y =         0; y < numberOfVolumesPerAxisInPatch;            y++)
      #if defined(SharedOMP)
      #pragma omp simd
      #endif
      for (int x = -solversHaloSize; x < numberOfVolumesPerAxisInPatch+solversHaloSize-1; x++) {
        internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.cellCentre[patchIndex],
          patchData.cellSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          0, // normal
          tempNonconservativeProductX,
          ncpEnumerator,
          pick
        );
      }
      #pragma clang loop unroll(enable)
      for (int pick = 0; pick < unknowns;                      pick++)
      for (int y = -solversHaloSize; y < numberOfVolumesPerAxisInPatch+solversHaloSize-1; y++)
      #if defined(SharedOMP)
      #pragma omp simd
      #endif
      for (int x =         0; x < numberOfVolumesPerAxisInPatch;            x++) {
        internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.cellCentre[patchIndex],
          patchData.cellSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          1, // normal
          tempNonconservativeProductY,
          ncpEnumerator,
          pick
        );
      }
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int unknown=0; unknown<unknowns; unknown++) {
        internal::updateSolutionWithNonconservativeFlux_LoopBody(
          tempNonconservativeProductX, tempNonconservativeProductY, tempNonconservativeProductZ,
          ncpEnumerator,
          patchData.cellCentre[patchIndex],
          patchData.cellSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          unknown,
          patchData.dt[patchIndex],
          *(patchData.QOut + patchIndex),
          QOutEnumerator
        );
      }
    }
    else if (evaluateNonconservativeProduct and Dimensions==3) {
        #pragma clang loop unroll(enable)
        for (int pick = 0; pick < unknowns;                      pick++)
        for (int z =         0; z < numberOfVolumesPerAxisInPatch;            z++)
        for (int y =         0; y < numberOfVolumesPerAxisInPatch;            y++)
        #if defined(SharedOMP)
        #pragma omp simd
        #endif
        for (int x = -solversHaloSize; x < numberOfVolumesPerAxisInPatch+solversHaloSize-1; x++) {
          internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.cellCentre[patchIndex],
            patchData.cellSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            0, // normal
            tempNonconservativeProductX,
            ncpEnumerator,
            pick
          );
        }
        #pragma clang loop unroll(enable)
        for (int pick = 0; pick < unknowns;                      pick++)
        for (int z =         0; z < numberOfVolumesPerAxisInPatch;            z++)
        for (int y = -solversHaloSize; y < numberOfVolumesPerAxisInPatch+solversHaloSize-1; y++)
        #if defined(SharedOMP)
        #pragma omp simd
        #endif
        for (int x =         0; x < numberOfVolumesPerAxisInPatch;            x++) {
          internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.cellCentre[patchIndex],
            patchData.cellSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            1, // normal
            tempNonconservativeProductY,
            ncpEnumerator,
            pick
          );
        }
        #pragma clang loop unroll(enable)
        for (int pick = 0; pick < unknowns;                      pick++)
        for (int z = -solversHaloSize; z < numberOfVolumesPerAxisInPatch+solversHaloSize-1; z++)
        for (int y =         0; y < numberOfVolumesPerAxisInPatch;            y++)
        #if defined(SharedOMP)
        #pragma omp simd
        #endif
        for (int x =         0; x < numberOfVolumesPerAxisInPatch;            x++) {
          internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.cellCentre[patchIndex],
            patchData.cellSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            2, // normal
            tempNonconservativeProductZ,
            ncpEnumerator,
            pick
          );
        }
        for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
        for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
        for (int unknown=0; unknown<unknowns; unknown++) {
          internal::updateSolutionWithNonconservativeFlux_LoopBody(
            tempNonconservativeProductX, tempNonconservativeProductY, tempNonconservativeProductZ,
            ncpEnumerator,
            patchData.cellCentre[patchIndex],
            patchData.cellSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            unknown,
            patchData.dt[patchIndex],
            *(patchData.QOut + patchIndex),
            QOutEnumerator
          );
        }
    }

    if (evaluateMaximumEigenvalueAfterTimeStep and Dimensions==2) {
      logDebug( "timeStepWithRusanov_sequential(...)", "compute maximum eigenvalue for subsequent time step" );
      double newMaxEigenvalue = 0.0;
      #if defined(SharedOMP)
      #pragma omp simd collapse(2)
      #endif
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++) {
        newMaxEigenvalue = std::max(
          newMaxEigenvalue,
          internal::reduceMaxEigenvalue_LoopBody<Solver>(
            *(patchData.QOut + patchIndex),
            QOutEnumerator,
            patchData.cellCentre[patchIndex],
            patchData.cellSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            patchData.t[patchIndex],
            patchData.dt[patchIndex]
          )
        );
      }
      patchData.maxEigenvalue[patchIndex] = newMaxEigenvalue;
    }
    else if (evaluateMaximumEigenvalueAfterTimeStep) {
      logDebug( "timeStepWithRusanov_sequential(...)", "compute maximum eigenvalue for subsequent time step" );
      double newMaxEigenvalue = 0.0;
      #if defined(SharedOMP)
      #pragma omp simd collapse(3)
      #endif
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++) {
        newMaxEigenvalue = std::max(
          newMaxEigenvalue,
          internal::reduceMaxEigenvalue_LoopBody<Solver>(
            *(patchData.QOut + patchIndex),
            QOutEnumerator,
            patchData.cellCentre[patchIndex],
            patchData.cellSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex]
          )
        );
      }
      patchData.maxEigenvalue[patchIndex] = newMaxEigenvalue;
    }
  }
}

