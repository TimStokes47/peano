#include "Rusanov.h"
#include "tarch/compiler/CompilerSpecificSettings.h"
#include "exahype2/fv/rusanov/LoopBody.h"

template <
  typename Solver,
  int      numberOfVolumesPerAxisInPatch,
  int      haloSize,
  int      unknowns,
  int      auxiliaryVariables,
  typename TempDataEnumerator
>
void exahype2::fv::rusanov::cpp::timeStepWithRusanov_batched_heap_static_calls(
  int                     targetDevice,
  ::exahype2::CellData&   hostPatchData,
  bool                    evaluateFlux,
  bool                    evaluateNonconservativeProduct,
  bool                    evaluateSource,
  bool                    evaluateMaximumEigenvalueAfterTimeStep
) {
  #if defined(GPUOffloadingCPP)
  constexpr int solversHaloSize        = 1;

  exahype2::enumerator::AoSLexicographicEnumerator QInHostEnumerator(
    1, 
    numberOfVolumesPerAxisInPatch, 
    haloSize, 
    unknowns, 
    auxiliaryVariables
  );
  exahype2::enumerator::AoSLexicographicEnumerator QOutHostEnumerator(
    1, 
    numberOfVolumesPerAxisInPatch,
    0, 
    unknowns, 
    auxiliaryVariables
  );
  TempDataEnumerator fluxHostEnumerator(
    hostPatchData.numberOfCells, 
    numberOfVolumesPerAxisInPatch,   
    solversHaloSize, 
    unknowns, 
    0
  );
  TempDataEnumerator ncpHostEnumerator(
    hostPatchData.numberOfCells, 
    numberOfVolumesPerAxisInPatch+1, 
    solversHaloSize, 
    unknowns, 
  0);
  TempDataEnumerator eigenvalueHostEnumerator(
    hostPatchData.numberOfCells, 
    numberOfVolumesPerAxisInPatch,   
    solversHaloSize,        
    1, 
    0
  );

  // @todo change once sorted out by NVIDIA
  double* tempFluxX = new double[fluxHostEnumerator.size()];
  double* tempFluxY = new double[fluxHostEnumerator.size()];
  double* tempFluxZ = new double[fluxHostEnumerator.size()];
  double* tempNonconservativeProductX = new double[ncpHostEnumerator.size()];
  double* tempNonconservativeProductY = new double[ncpHostEnumerator.size()];
  double* tempNonconservativeProductZ = new double[ncpHostEnumerator.size()];
  double* tempEigenvalueX = new double[eigenvalueHostEnumerator.size()];
  double* tempEigenvalueY = new double[eigenvalueHostEnumerator.size()];
  double* tempEigenvalueZ = new double[eigenvalueHostEnumerator.size()];

  // The cartesian products have to be located on the heap so that they are accessible from the GPU.
  // Here we define types to able to allocated in heap.
  using cart_prod_2d = decltype(tl::views::cartesian_product(
    std::views::iota(0,1), 
    std::views::iota(0,1)
  ));
  using cart_prod_3d = decltype(tl::views::cartesian_product(
    std::views::iota(0,1), 
    std::views::iota(0,1), 
    std::views::iota(0,1)
  ));
  using cart_prod_4d = decltype(tl::views::cartesian_product(
    std::views::iota(0,1), 
    std::views::iota(0,1), 
    std::views::iota(0,1), 
    std::views::iota(0,1)
  ));
  using cart_prod_5d = decltype(tl::views::cartesian_product(
    std::views::iota(0,1), 
    std::views::iota(0,1), 
    std::views::iota(0,1), 
    std::views::iota(0,1), 
    std::views::iota(0,1)
  ));

  // Definition of the cartesian products.

  auto* range2d = new cart_prod_2d;
  *range2d = tl::views::cartesian_product(
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,numberOfVolumesPerAxisInPatch)
  );

  auto* range3d = new cart_prod_3d;
  *range3d = tl::views::cartesian_product(
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,numberOfVolumesPerAxisInPatch)
  );

  auto* range2d_cell = new cart_prod_3d;
  *range2d_cell = tl::views::cartesian_product(
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,hostPatchData.numberOfCells)
  );

  auto* range3d_cell = new cart_prod_4d;
  *range3d_cell = tl::views::cartesian_product(
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,hostPatchData.numberOfCells)
  );

  auto* range2d_cell_unknown_aux = new cart_prod_4d;
  *range2d_cell_unknown_aux = tl::views::cartesian_product(
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,hostPatchData.numberOfCells),
    std::views::iota(0,unknowns+auxiliaryVariables)
  );

  auto* range3d_cell_unknown_aux = new cart_prod_5d;
  *range3d_cell_unknown_aux = tl::views::cartesian_product(
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,hostPatchData.numberOfCells),
    std::views::iota(0,unknowns+auxiliaryVariables)
  );

  auto* range1d_cell_solvhalosize = new cart_prod_3d;
  *range1d_cell_solvhalosize = tl::views::cartesian_product(
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,hostPatchData.numberOfCells),
    std::views::iota(0,numberOfVolumesPerAxisInPatch+2*solversHaloSize)
  );

  auto* range2d_cell_solvhalosize = new cart_prod_4d;
  *range2d_cell_solvhalosize = tl::views::cartesian_product(
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,hostPatchData.numberOfCells),
    std::views::iota(0,numberOfVolumesPerAxisInPatch+2*solversHaloSize)
  );

  auto* range2d_cell_unknown = new cart_prod_4d;
  *range2d_cell_unknown = tl::views::cartesian_product(
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,hostPatchData.numberOfCells),
    std::views::iota(0,unknowns)
  );  

  auto* range3d_cell_unknown = new cart_prod_5d;
  *range3d_cell_unknown = tl::views::cartesian_product(
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,hostPatchData.numberOfCells),
    std::views::iota(0,unknowns)
  );  
    
  auto* range1d_cell_solvhalosize_m = new cart_prod_3d;
  *range1d_cell_solvhalosize_m = tl::views::cartesian_product(
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,hostPatchData.numberOfCells),
    std::views::iota(0,numberOfVolumesPerAxisInPatch+2*solversHaloSize-1)
  );

  auto* range2d_cell_solvhalosize_m = new cart_prod_4d;
  *range2d_cell_solvhalosize_m = tl::views::cartesian_product(
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,hostPatchData.numberOfCells),
    std::views::iota(0,numberOfVolumesPerAxisInPatch+2*solversHaloSize-1)
  );


  exahype2::enumerator::AoSLexicographicEnumerator QInEnumerator(
    1, 
    numberOfVolumesPerAxisInPatch,
    haloSize,
    unknowns,
    auxiliaryVariables
  );
  exahype2::enumerator::AoSLexicographicEnumerator QOutEnumerator(
    1, 
    numberOfVolumesPerAxisInPatch,
    0,
    unknowns,
    auxiliaryVariables
  );
  TempDataEnumerator fluxEnumerator(
    hostPatchData.numberOfCells, 
    numberOfVolumesPerAxisInPatch,
    haloSize,
    unknowns,
    0
  );
  TempDataEnumerator ncpEnumerator(
    hostPatchData.numberOfCells,
    numberOfVolumesPerAxisInPatch+1,
    haloSize,
    unknowns,
    0
  );
  TempDataEnumerator eigenvalueEnumerator(
    hostPatchData.numberOfCells, 
    numberOfVolumesPerAxisInPatch,
    haloSize,
    1,
    0
  );

  if (Dimensions==2 and evaluateSource) {
    
    std::for_each(
      std::execution::par_unseq,
      range2d_cell->begin(),
      range2d_cell->end(),
      [
        =,
        QIn=hostPatchData.QIn,
        cellCentre=hostPatchData.cellCentre,
        cellSize=hostPatchData.cellSize,
        t=hostPatchData.t,
        dt=hostPatchData.dt,
        QOut=hostPatchData.QOut
      ](auto ids){
        auto [x,y,patchIndex] = ids;

        internal::copySolutionAndAddSourceTerm_LoopBody<Solver>(
          QIn[patchIndex],
          QInEnumerator,
          cellCentre[patchIndex],
          cellSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          t[patchIndex],
          dt[patchIndex],
          QOut[patchIndex],
          QOutEnumerator
        );

      }
    );
  }
  else if (Dimensions==3 and evaluateSource) {
    std::for_each(
      std::execution::par_unseq,
      range3d_cell->begin(),
      range3d_cell->end(),
      [
        =,
        QIn=hostPatchData.QIn,
        cellCentre=hostPatchData.cellCentre,
        cellSize=hostPatchData.cellSize,
        t=hostPatchData.t,
        dt=hostPatchData.dt,
        QOut=hostPatchData.QOut
      ](auto ids){
        auto [x,y,z,patchIndex] = ids;

        internal::copySolutionAndAddSourceTerm_LoopBody<Solver>(
          QIn[patchIndex],
          QInEnumerator,
          cellCentre[patchIndex],
          cellSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          t[patchIndex],
          dt[patchIndex],
          QOut[patchIndex],
          QOutEnumerator
        );

      }
    );
  }
  else if (Dimensions==2) {
    std::for_each(
      std::execution::par_unseq,
      range2d_cell_unknown_aux->begin(),
      range2d_cell_unknown_aux->end(),
      [
        =,
        QIn=hostPatchData.QIn,
        QOut=hostPatchData.QOut
      ](auto ids){
        auto [x,y,patchIndex,unknown] = ids;

        internal::copySolution_LoopBody(
          QIn[patchIndex],
          QInEnumerator,
          patchIndex,
          volumeIndex2d(x,y),
          unknown,
          QOut[patchIndex],
          QOutEnumerator
        );

      }
    );
  }
  else {  
    std::for_each(
      std::execution::par_unseq,
      range3d_cell_unknown_aux->begin(),
      range3d_cell_unknown_aux->end(),
      [
        =,
        QIn=hostPatchData.QIn,
        QOut=hostPatchData.QOut
      ](auto ids){
        auto [x,y,z,patchIndex,unknown] = ids;

        internal::copySolution_LoopBody(
          QIn[patchIndex],
          QInEnumerator,
          patchIndex,
          volumeIndex3d(x,y,z),
          unknown,
          QOut[patchIndex],
          QOutEnumerator
        );

      }
    );
  }

  if (Dimensions==2) {
    
    std::for_each(
      std::execution::par_unseq,
      range1d_cell_solvhalosize->begin(),
      range1d_cell_solvhalosize->end(),
      [
        =,
        QIn=hostPatchData.QIn,
        cellCentre=hostPatchData.cellCentre,
        cellSize=hostPatchData.cellSize,
        t=hostPatchData.t,
        dt=hostPatchData.dt
      ](auto ids){
        auto [y,patchIndex,x] = ids;

        internal::computeMaxEigenvalue_LoopBody<Solver>(
          QIn[patchIndex],
          QInEnumerator,
          cellCentre[patchIndex],
          cellSize[patchIndex],
          patchIndex,
          volumeIndex2d(x-solversHaloSize,y),
          t[patchIndex], 
          dt[patchIndex],
          0,
          tempEigenvalueX,
          eigenvalueEnumerator
        );

      }
    );

    std::for_each(
      std::execution::par_unseq,
      range1d_cell_solvhalosize->begin(),
      range1d_cell_solvhalosize->end(),
      [
        =,
        QIn=hostPatchData.QIn,
        cellCentre=hostPatchData.cellCentre,
        cellSize=hostPatchData.cellSize,
        t=hostPatchData.t,
        dt=hostPatchData.dt
      ](auto ids){
        auto [x,patchIndex,y] = ids;

        internal::computeMaxEigenvalue_LoopBody<Solver>(
          QIn[patchIndex],
          QInEnumerator,
          cellCentre[patchIndex],
          cellSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y-solversHaloSize),
          t[patchIndex], 
          dt[patchIndex],
          1,
          tempEigenvalueY,
          eigenvalueEnumerator
        );

      }
    );

    std::for_each(
      std::execution::par_unseq,
      range2d_cell_unknown->begin(),
      range2d_cell_unknown->end(),
      [
        =,
        QIn=hostPatchData.QIn,
        cellCentre=hostPatchData.cellCentre,
        cellSize=hostPatchData.cellSize,
        dt=hostPatchData.dt,
        QOut=hostPatchData.QOut
      ](auto ids){
        auto [x,y,patchIndex,unknown] = ids;

        internal::updateSolutionWithEigenvalueDamping_LoopBody(
          QIn[patchIndex],
          QInEnumerator,
          tempEigenvalueX,
          tempEigenvalueY,
          tempEigenvalueZ,
          eigenvalueEnumerator,
          cellCentre[patchIndex],
          cellSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          unknown,
          dt[patchIndex],
          QOut[patchIndex],
          QOutEnumerator
        );

      }
    );
  }
  else {

    std::for_each(
      std::execution::par_unseq,
      range2d_cell_solvhalosize->begin(),
      range2d_cell_solvhalosize->end(),
      [
        =,
        QIn=hostPatchData.QIn,
        cellCentre=hostPatchData.cellCentre,
        cellSize=hostPatchData.cellSize,
        t=hostPatchData.t,
        dt=hostPatchData.dt
      ](auto ids){
        auto [z,y,patchIndex,x] = ids;

        internal::computeMaxEigenvalue_LoopBody<Solver>(
          QIn[patchIndex],
          QInEnumerator,
          cellCentre[patchIndex],
          cellSize[patchIndex],
          patchIndex,
          volumeIndex3d(x-solversHaloSize,y,z),
          t[patchIndex], 
          dt[patchIndex],
          0,
          tempEigenvalueX,
          eigenvalueEnumerator
        );

      }
    );

    std::for_each(
      std::execution::par_unseq,
      range2d_cell_solvhalosize->begin(),
      range2d_cell_solvhalosize->end(),
      [
        =,
        QIn=hostPatchData.QIn,
        cellCentre=hostPatchData.cellCentre,
        cellSize=hostPatchData.cellSize,
        t=hostPatchData.t,
        dt=hostPatchData.dt
      ](auto ids){
        auto [z,x,patchIndex,y] = ids;

        internal::computeMaxEigenvalue_LoopBody<Solver>(
          QIn[patchIndex],
          QInEnumerator,
          cellCentre[patchIndex],
          cellSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y-solversHaloSize,z),
          t[patchIndex], 
          dt[patchIndex],
          1,
          tempEigenvalueY,
          eigenvalueEnumerator
        );

      }
    );

    std::for_each(
      std::execution::par_unseq,
      range2d_cell_solvhalosize->begin(),
      range2d_cell_solvhalosize->end(),
      [
        =,
        QIn=hostPatchData.QIn,
        cellCentre=hostPatchData.cellCentre,
        cellSize=hostPatchData.cellSize,
        t=hostPatchData.t,
        dt=hostPatchData.dt
      ](auto ids){
        auto [y,x,patchIndex,z] = ids;
    
        internal::computeMaxEigenvalue_LoopBody<Solver>(
          QIn[patchIndex],
          QInEnumerator,
          cellCentre[patchIndex],
          cellSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z-solversHaloSize),
          t[patchIndex], 
          dt[patchIndex],
          2,
          tempEigenvalueZ,
          eigenvalueEnumerator
        );

      }
    );

    std::for_each(
      std::execution::par_unseq,
      range3d_cell_unknown->begin(),
      range3d_cell_unknown->end(),
      [
        =,
        QIn=hostPatchData.QIn,
        cellCentre=hostPatchData.cellCentre,
        cellSize=hostPatchData.cellSize,
        dt=hostPatchData.dt,
        QOut=hostPatchData.QOut
      ](auto ids){
        auto [x,y,z,patchIndex,unknown] = ids;
        
        internal::updateSolutionWithEigenvalueDamping_LoopBody(
          QIn[patchIndex],
          QInEnumerator,
          tempEigenvalueX,
          tempEigenvalueY,
          tempEigenvalueZ,
          eigenvalueEnumerator,
          cellCentre[patchIndex],
          cellSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          unknown,
          dt[patchIndex],
          QOut[patchIndex],
          QOutEnumerator
        );

      }
    );

  }

  if (evaluateFlux and Dimensions==2) {

    std::for_each(
      std::execution::par_unseq,
      range1d_cell_solvhalosize->begin(),
      range1d_cell_solvhalosize->end(),
      [
        =,
        QIn=hostPatchData.QIn,
        cellCentre=hostPatchData.cellCentre,
        cellSize=hostPatchData.cellSize,
        t=hostPatchData.t,
        dt=hostPatchData.dt
      ](auto ids){
        auto [y,patchIndex,x] = ids;
        
        internal::computeFlux_LoopBody<Solver, unknowns, auxiliaryVariables>(
          QIn[patchIndex],
          QInEnumerator,
          cellCentre[patchIndex],
          cellSize[patchIndex],
          patchIndex,
          volumeIndex2d(x-solversHaloSize,y),
          t[patchIndex],
          dt[patchIndex],
          0, // normal
          tempFluxX,
          fluxEnumerator
        );

      }
    );

    std::for_each(
      std::execution::par_unseq,
      range1d_cell_solvhalosize->begin(),
      range1d_cell_solvhalosize->end(),
      [
        =,
        QIn=hostPatchData.QIn,
        cellCentre=hostPatchData.cellCentre,
        cellSize=hostPatchData.cellSize,
        t=hostPatchData.t,
        dt=hostPatchData.dt
      ](auto ids){
        auto [x,patchIndex,y] = ids;
        
        internal::computeFlux_LoopBody<Solver, unknowns, auxiliaryVariables>(
          QIn[patchIndex],
          QInEnumerator,
          cellCentre[patchIndex],
          cellSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y-solversHaloSize),
          t[patchIndex],
          dt[patchIndex],
          1, // normal
          tempFluxY,
          fluxEnumerator
        );

      }
    );

    std::for_each(
      std::execution::par_unseq,
      range2d_cell_unknown->begin(),
      range2d_cell_unknown->end(),
      [
        =,
        cellCentre=hostPatchData.cellCentre,
        cellSize=hostPatchData.cellSize,
        dt=hostPatchData.dt,
        QOut=hostPatchData.QOut
      ](auto ids){
        auto [x,y,patchIndex,unknown] = ids;

        internal::updateSolutionWithFlux_LoopBody(
          tempFluxX, tempFluxY, tempFluxZ,
          fluxEnumerator,
          cellCentre[patchIndex],
          cellSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          unknown,
          dt[patchIndex],
          *(QOut + patchIndex),
          QOutEnumerator
        );
      }
    );
  }

  else if (evaluateFlux and Dimensions==3) {

    std::for_each(
      std::execution::par_unseq,
      range2d_cell_solvhalosize->begin(),
      range2d_cell_solvhalosize->end(),
      [
        =,
        QIn=hostPatchData.QIn,
        cellCentre=hostPatchData.cellCentre,
        cellSize=hostPatchData.cellSize,
        t=hostPatchData.t,
        dt=hostPatchData.dt
      ](auto ids){
        auto [z,y,patchIndex,x] = ids;
        
        internal::computeFlux_LoopBody<Solver, unknowns, auxiliaryVariables>(
          QIn[patchIndex],
          QInEnumerator,
          cellCentre[patchIndex],
          cellSize[patchIndex],
          patchIndex,
          volumeIndex3d(x-solversHaloSize,y,z),
          t[patchIndex],
          dt[patchIndex],
          0, // normal
          tempFluxX,
          fluxEnumerator
        );

      }
    );

    std::for_each(
      std::execution::par_unseq,
      range2d_cell_solvhalosize->begin(),
      range2d_cell_solvhalosize->end(),
      [
        =,
        QIn=hostPatchData.QIn,
        cellCentre=hostPatchData.cellCentre,
        cellSize=hostPatchData.cellSize,
        t=hostPatchData.t,
        dt=hostPatchData.dt
      ](auto ids){
        auto [z,x,patchIndex,y] = ids;
        
        internal::computeFlux_LoopBody<Solver, unknowns, auxiliaryVariables>(
          QIn[patchIndex],
          QInEnumerator,
          cellCentre[patchIndex],
          cellSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y-solversHaloSize,z),
          t[patchIndex],
          dt[patchIndex],
          1, // normal
          tempFluxY,
          fluxEnumerator
        );

      }
    );

    std::for_each(
      std::execution::par_unseq,
      range2d_cell_solvhalosize->begin(),
      range2d_cell_solvhalosize->end(),
      [
        =,
        QIn=hostPatchData.QIn,
        cellCentre=hostPatchData.cellCentre,
        cellSize=hostPatchData.cellSize,
        t=hostPatchData.t,
        dt=hostPatchData.dt
      ](auto ids){
        auto [x,y,patchIndex,z] = ids;

        internal::computeFlux_LoopBody<Solver, unknowns, auxiliaryVariables>(
          QIn[patchIndex],
          QInEnumerator,
          cellCentre[patchIndex],
          cellSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z-solversHaloSize),
          t[patchIndex],
          dt[patchIndex],
          2, // normal
          tempFluxZ,
          fluxEnumerator
        );

      }
    );

    std::for_each(
      std::execution::par_unseq,
      range3d_cell_unknown->begin(),
      range3d_cell_unknown->end(),
      [
        =,
        cellCentre=hostPatchData.cellCentre,
        cellSize=hostPatchData.cellSize,
        dt=hostPatchData.dt,
        QOut=hostPatchData.QOut
      ](auto ids){
        auto [x,y,z,patchIndex,unknown] = ids;

        internal::updateSolutionWithFlux_LoopBody(
          tempFluxX, tempFluxY, tempFluxZ,
          fluxEnumerator,
          cellCentre[patchIndex],
          cellSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          unknown,
          dt[patchIndex],
          *(QOut + patchIndex),
          QOutEnumerator
        );

      }
    );
  }

  if (evaluateNonconservativeProduct and Dimensions==2) {
    
    std::for_each(
      std::execution::par_unseq,
      range1d_cell_solvhalosize_m->begin(),
      range1d_cell_solvhalosize_m->end(),
      [
        =,
        QIn=hostPatchData.QIn,
        cellCentre=hostPatchData.cellCentre,
        cellSize=hostPatchData.cellSize,
        t=hostPatchData.t,
        dt=hostPatchData.dt
      ](auto ids){
        auto [y,patchIndex,x] = ids;

        internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
          QIn[patchIndex],
          QInEnumerator,
          cellCentre[patchIndex],
          cellSize[patchIndex],
          patchIndex,
          volumeIndex2d(x-solversHaloSize,y),
          t[patchIndex],
          dt[patchIndex],
          0, // normal
          tempNonconservativeProductX,
          ncpEnumerator
        );

      }
    );

    std::for_each(
      std::execution::par_unseq,
      range1d_cell_solvhalosize_m->begin(),
      range1d_cell_solvhalosize_m->end(),
      [
        =,
        QIn=hostPatchData.QIn,
        cellCentre=hostPatchData.cellCentre,
        cellSize=hostPatchData.cellSize,
        t=hostPatchData.t,
        dt=hostPatchData.dt
      ](auto ids){
        auto [x,patchIndex,y] = ids;

        internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
          QIn[patchIndex],
          QInEnumerator,
          cellCentre[patchIndex],
          cellSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y-solversHaloSize),
          t[patchIndex],
          dt[patchIndex],
          1, // normal
          tempNonconservativeProductY,
          ncpEnumerator
        );

      }
    );

    std::for_each(
      std::execution::par_unseq,
      range2d_cell_unknown->begin(),
      range2d_cell_unknown->end(),
      [
        =,
        cellCentre=hostPatchData.cellCentre,
        cellSize=hostPatchData.cellSize,
        dt=hostPatchData.dt,
        QOut=hostPatchData.QOut
      ](auto ids){
        auto [x,y,patchIndex,unknown] = ids;

        internal::updateSolutionWithNonconservativeFlux_LoopBody(
          tempNonconservativeProductX, tempNonconservativeProductY, tempNonconservativeProductZ,
          ncpEnumerator,
          cellCentre[patchIndex],
          cellSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          unknown,
          dt[patchIndex],
          *(QOut + patchIndex),
          QOutEnumerator
        );

      }
    );
  }
  else if (evaluateNonconservativeProduct and Dimensions==3) {

    std::for_each(
      std::execution::par_unseq,
      range2d_cell_solvhalosize_m->begin(),
      range2d_cell_solvhalosize_m->end(),
      [
        =,
        QIn=hostPatchData.QIn,
        cellCentre=hostPatchData.cellCentre,
        cellSize=hostPatchData.cellSize,
        t=hostPatchData.t,
        dt=hostPatchData.dt
      ](auto ids){
        auto [z,y,patchIndex,x] = ids;

        internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
          QIn[patchIndex],
          QInEnumerator,
          cellCentre[patchIndex],
          cellSize[patchIndex],
          patchIndex,
          volumeIndex3d(x-solversHaloSize,y,z),
          t[patchIndex],
          dt[patchIndex],
          0, // normal
          tempNonconservativeProductX,
          ncpEnumerator
        );

      }
    );

    std::for_each(
      std::execution::par_unseq,
      range2d_cell_solvhalosize_m->begin(),
      range2d_cell_solvhalosize_m->end(),
      [
        =,
        QIn=hostPatchData.QIn,
        cellCentre=hostPatchData.cellCentre,
        cellSize=hostPatchData.cellSize,
        t=hostPatchData.t,
        dt=hostPatchData.dt
      ](auto ids){
        auto [z,x,patchIndex,y] = ids;

        internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
          QIn[patchIndex],
          QInEnumerator,
          cellCentre[patchIndex],
          cellSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y-solversHaloSize,z),
          t[patchIndex],
          dt[patchIndex],
          1, // normal
          tempNonconservativeProductY,
          ncpEnumerator
        );

      }
    );

    std::for_each(
      std::execution::par_unseq,
      range2d_cell_solvhalosize_m->begin(),
      range2d_cell_solvhalosize_m->end(),
      [
        =,
        QIn=hostPatchData.QIn,
        cellCentre=hostPatchData.cellCentre,
        cellSize=hostPatchData.cellSize,
        t=hostPatchData.t,
        dt=hostPatchData.dt
      ](auto ids){
        auto [y,x,patchIndex,z] = ids;

        internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
          QIn[patchIndex],
          QInEnumerator,
          cellCentre[patchIndex],
          cellSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z-solversHaloSize),
          t[patchIndex],
          dt[patchIndex],
          2, // normal
          tempNonconservativeProductY,
          ncpEnumerator
        );

      }
    );

    std::for_each(
      std::execution::par_unseq,
      range3d_cell_unknown->begin(),
      range3d_cell_unknown->end(),
      [
        =,
        cellCentre=hostPatchData.cellCentre,
        cellSize=hostPatchData.cellSize,
        dt=hostPatchData.dt,
        QOut=hostPatchData.QOut
      ](auto ids){
        auto [x,y,z,patchIndex,unknown] = ids;

        internal::updateSolutionWithNonconservativeFlux_LoopBody(
          tempNonconservativeProductX, tempNonconservativeProductY, tempNonconservativeProductZ,
          ncpEnumerator,
          cellCentre[patchIndex],
          cellSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          unknown,
          dt[patchIndex],
          *(QOut + patchIndex),
          QOutEnumerator
        );

      }
    );
  }


  if (evaluateMaximumEigenvalueAfterTimeStep and Dimensions==2) {
    for (int patchIndex=0; patchIndex<hostPatchData.numberOfCells; patchIndex++) {

      double newMaxEigenvalue = 0.0;

      std::for_each(
        std::execution::seq,
        range2d->begin(),
        range2d->end(),
        [
          =,
          &newMaxEigenvalue,
          QOut=hostPatchData.QOut,
          cellCentre=hostPatchData.cellCentre,
          cellSize=hostPatchData.cellSize,
          t=hostPatchData.t,
          dt=hostPatchData.dt
        ](auto ids){
          auto [x,y] = ids;
          newMaxEigenvalue = std::max(
            newMaxEigenvalue,
            internal::reduceMaxEigenvalue_LoopBody<Solver>(
              *(QOut + patchIndex),
              QOutEnumerator,
              cellCentre[patchIndex],
              cellSize[patchIndex],
              patchIndex,
              volumeIndex2d(x,y),
              t[patchIndex],
              dt[patchIndex]
            )
          );
        }
      );


      hostPatchData.maxEigenvalue[patchIndex] = newMaxEigenvalue;
    }
  }
  else if (evaluateMaximumEigenvalueAfterTimeStep) {
    for (int patchIndex=0; patchIndex<hostPatchData.numberOfCells; patchIndex++) {

      double newMaxEigenvalue = 0.0;
      std::for_each(
        std::execution::seq,
        range3d->begin(),
        range3d->end(),
        [
          =,
          &newMaxEigenvalue,
          QOut=hostPatchData.QOut,
          cellCentre=hostPatchData.cellCentre,
          cellSize=hostPatchData.cellSize,
          t=hostPatchData.t,
          dt=hostPatchData.dt
        ](auto ids){
          auto [x,y,z] = ids;
          newMaxEigenvalue = std::max(
            newMaxEigenvalue,
            internal::reduceMaxEigenvalue_LoopBody<Solver>(
              *(QOut + patchIndex),
              QOutEnumerator,
              cellCentre[patchIndex],
              cellSize[patchIndex],
              patchIndex,
              volumeIndex3d(x,y,z),
              t[patchIndex],
              dt[patchIndex]
            )
          );
        }
      );


      hostPatchData.maxEigenvalue[patchIndex] = newMaxEigenvalue;
    }
  }

  delete[] tempFluxX;
  delete[] tempFluxY;
  delete[] tempFluxZ;
  delete[] tempNonconservativeProductX;
  delete[] tempNonconservativeProductY;
  delete[] tempNonconservativeProductZ;
  delete[] tempEigenvalueX;
  delete[] tempEigenvalueY;
  delete[] tempEigenvalueZ;
  delete[] range2d;
  delete[] range3d;
  delete[] range2d_cell;
  delete[] range3d_cell;
  delete[] range2d_cell_unknown_aux;
  delete[] range3d_cell_unknown_aux;
  delete[] range1d_cell_solvhalosize;
  delete[] range2d_cell_solvhalosize;
  delete[] range2d_cell_unknown;
  delete[] range3d_cell_unknown;
  delete[] range1d_cell_solvhalosize_m;
  delete[] range2d_cell_solvhalosize_m;

  #else
  assertionMsg(false, "this routine should only be used in combination with CPP offloading, as it has a device parameter" );
  #endif
}
