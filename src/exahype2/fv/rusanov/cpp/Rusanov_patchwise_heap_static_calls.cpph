#include "Rusanov.h"
#include "tarch/compiler/CompilerSpecificSettings.h"
#include "exahype2/fv/rusanov/LoopBody.h"

template <
  typename Solver,
  int      numberOfVolumesPerAxisInPatch,
  int      haloSize,
  int      unknowns,
  int      auxiliaryVariables,
  typename TempDataEnumerator
>
void exahype2::fv::rusanov::cpp::timeStepWithRusanov_patchwise_heap_static_calls(
  int                     targetDevice,
  ::exahype2::CellData&   hostPatchData,
  bool                    evaluateFlux,
  bool                    evaluateNonconservativeProduct,
  bool                    evaluateSource,
  bool                    evaluateMaximumEigenvalueAfterTimeStep
) {
  #if defined(GPUOffloadingCPP)
  /**
   * The halo size passed in by the user might differ from the one that we have to evaluate/
   * take into account from the solver's perspective.
   */
  constexpr int solversHaloSize        = 1;

  exahype2::enumerator::AoSLexicographicEnumerator QInHostEnumerator(
    1, 
    numberOfVolumesPerAxisInPatch, 
    haloSize, 
    unknowns, 
    auxiliaryVariables
  );
  exahype2::enumerator::AoSLexicographicEnumerator QOutHostEnumerator(
    1, 
    numberOfVolumesPerAxisInPatch,
    0, 
    unknowns, 
    auxiliaryVariables
  );
  TempDataEnumerator fluxHostEnumerator(
    hostPatchData.numberOfCells, 
    numberOfVolumesPerAxisInPatch,   
    solversHaloSize, 
    unknowns, 
    0
  );
  TempDataEnumerator ncpHostEnumerator(
    hostPatchData.numberOfCells, 
    numberOfVolumesPerAxisInPatch+1,
    solversHaloSize, 
    unknowns, 
    0
  );
  TempDataEnumerator eigenvalueHostEnumerator(
    hostPatchData.numberOfCells, 
    numberOfVolumesPerAxisInPatch,   
    solversHaloSize,        
    1, 
    0
  );
  
  double* tempFluxX = new double[fluxHostEnumerator.size()];
  double* tempFluxY = new double[fluxHostEnumerator.size()];
  double* tempFluxZ = new double[fluxHostEnumerator.size()];
  double* tempNonconservativeProductX = new double[ncpHostEnumerator.size()];
  double* tempNonconservativeProductY = new double[ncpHostEnumerator.size()];
  double* tempNonconservativeProductZ = new double[ncpHostEnumerator.size()];
  double* tempEigenvalueX = new double[eigenvalueHostEnumerator.size()];
  double* tempEigenvalueY = new double[eigenvalueHostEnumerator.size()];
  double* tempEigenvalueZ = new double[eigenvalueHostEnumerator.size()];

  // The cartesian products have to be located on the heap so that they are accessible from the GPU.
  // Here we define types to be able to allocate in heap.
  using cart_prod_2d = decltype(tl::views::cartesian_product(
    std::views::iota(0,1), 
    std::views::iota(0,1)
  ));
  using cart_prod_3d = decltype(tl::views::cartesian_product(
    std::views::iota(0,1), 
    std::views::iota(0,1), 
    std::views::iota(0,1)
  ));
  using cart_prod_4d = decltype(tl::views::cartesian_product(
    std::views::iota(0,1), 
    std::views::iota(0,1), 
    std::views::iota(0,1), 
    std::views::iota(0,1)
  ));

  // Cartesian products definition.
  auto* range2d = new cart_prod_2d;
  *range2d = tl::views::cartesian_product(
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,numberOfVolumesPerAxisInPatch)
  );

  auto* range3d = new cart_prod_3d;
  *range3d = tl::views::cartesian_product(
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,numberOfVolumesPerAxisInPatch)
  );

  auto* range2d_unknown = new cart_prod_3d;
  *range2d_unknown = tl::views::cartesian_product(
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,unknowns)
  );

  auto* range3d_unknown = new cart_prod_4d;
  *range3d_unknown = tl::views::cartesian_product(
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,unknowns)
  );

  auto* range1d_solvhalosize = new cart_prod_2d;
  *range1d_solvhalosize = tl::views::cartesian_product(
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,numberOfVolumesPerAxisInPatch+2*solversHaloSize)
  );

  auto* range2d_solvhalosize = new cart_prod_3d;
  *range2d_solvhalosize = tl::views::cartesian_product(
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,numberOfVolumesPerAxisInPatch+2*solversHaloSize)
  );

  auto* range2d_unknown_aux = new cart_prod_3d;
  *range2d_unknown_aux = tl::views::cartesian_product(
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,unknowns+auxiliaryVariables)
  );

  auto* range3d_unknown_aux = new cart_prod_4d;
  *range3d_unknown_aux = tl::views::cartesian_product(
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,unknowns+auxiliaryVariables)
  );

  auto* range1d_solvhalosize_m = new cart_prod_2d;
  *range1d_solvhalosize_m = tl::views::cartesian_product(
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,numberOfVolumesPerAxisInPatch+2*solversHaloSize-1)
  );

  auto* range2d_solvhalosize_m = new cart_prod_3d;
  *range2d_solvhalosize_m = tl::views::cartesian_product(
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,numberOfVolumesPerAxisInPatch),  
    std::views::iota(0,numberOfVolumesPerAxisInPatch+2*solversHaloSize-1)
  );

  exahype2::enumerator::AoSLexicographicEnumerator QInEnumerator(
    1, 
    numberOfVolumesPerAxisInPatch,
    haloSize,
    unknowns,
    auxiliaryVariables
  );
  exahype2::enumerator::AoSLexicographicEnumerator QOutEnumerator(
    1, 
    numberOfVolumesPerAxisInPatch,
    0,
    unknowns,
    auxiliaryVariables
  );
  
  TempDataEnumerator fluxEnumerator(
    hostPatchData.numberOfCells, 
    numberOfVolumesPerAxisInPatch,
    haloSize,
    unknowns,
    0
  );
  TempDataEnumerator ncpEnumerator(
    hostPatchData.numberOfCells, 
    numberOfVolumesPerAxisInPatch+1,
    haloSize,
    unknowns,
    0
  );
  TempDataEnumerator eigenvalueEnumerator(
    hostPatchData.numberOfCells, 
    numberOfVolumesPerAxisInPatch,
    haloSize,
    1,
    0
  );

  for (int patchIndex=0; patchIndex<hostPatchData.numberOfCells; patchIndex++) {

    if (Dimensions==2) {
      std::for_each(
        std::execution::par_unseq,
        range2d_unknown_aux->begin(),
        range2d_unknown_aux->end(),
        [
          =,
          QIn=hostPatchData.QIn,
          cellCentre=hostPatchData.cellCentre,
          cellSize=hostPatchData.cellSize,
          t=hostPatchData.t,
          dt=hostPatchData.dt,
          QOut=hostPatchData.QOut
        ](auto ids){

          auto [x,y,unknown] = ids;

          if (evaluateSource == true) {
            internal::copySolutionAndAddSourceTerm_LoopBody<Solver>(
              QIn[patchIndex],
              QInEnumerator,
              cellCentre[patchIndex],
              cellSize[patchIndex],
              patchIndex,
              volumeIndex2d(x,y),
              t[patchIndex],
              dt[patchIndex],
              QOut[patchIndex],
              QOutEnumerator
            );
          }
          else if (evaluateSource == false) {
            internal::copySolution_LoopBody(
              QIn[patchIndex],
              QInEnumerator,
              patchIndex,
              volumeIndex2d(x,y),
              unknown,
              QOut[patchIndex],
              QOutEnumerator
            );
          }
    
        }
      );
    }
    else if (Dimensions==3) {
      std::for_each(
        std::execution::par_unseq,
        range3d_unknown_aux->begin(),
        range3d_unknown_aux->end(),
        [
          =,
          QIn=hostPatchData.QIn,
          cellCentre=hostPatchData.cellCentre,
          cellSize=hostPatchData.cellSize,
          t=hostPatchData.t,
          dt=hostPatchData.dt,
          QOut=hostPatchData.QOut
        ](auto ids){
          auto [x,y,z,unknown] = ids;

          if (evaluateSource == true) {
            internal::copySolutionAndAddSourceTerm_LoopBody<Solver>(
              QIn[patchIndex],
              QInEnumerator,
              cellCentre[patchIndex],
              cellSize[patchIndex],
              patchIndex,
              volumeIndex3d(x,y,z),
              t[patchIndex],
              dt[patchIndex],
              QOut[patchIndex],
              QOutEnumerator
            );
          }

          else if (evaluateSource == false) {
            internal::copySolution_LoopBody(
              QIn[patchIndex],
              QInEnumerator,
              patchIndex,
              volumeIndex3d(x,y,z),
              unknown,
              QOut[patchIndex],
              QOutEnumerator
            );
          }

        }
      );
    }

    if (Dimensions==2) {
      
      std::for_each(
        std::execution::par_unseq,
        range1d_solvhalosize->begin(),
        range1d_solvhalosize->end(),
        [
          =,
          QIn=hostPatchData.QIn,
          cellCentre=hostPatchData.cellCentre,
          cellSize=hostPatchData.cellSize,
          t=hostPatchData.t,
          dt=hostPatchData.dt
        ](auto ids){
          auto [y,x] = ids;
          
          internal::computeMaxEigenvalue_LoopBody<Solver>(
            QIn[patchIndex],
            QInEnumerator,
            cellCentre[patchIndex],
            cellSize[patchIndex],
            patchIndex,
            volumeIndex2d(x-solversHaloSize,y),
            t[patchIndex], 
            dt[patchIndex],
            0,
            tempEigenvalueX,
            eigenvalueEnumerator
          );

          internal::computeMaxEigenvalue_LoopBody<Solver>(
            QIn[patchIndex],
            QInEnumerator,
            cellCentre[patchIndex],
            cellSize[patchIndex],
            patchIndex,
            volumeIndex2d(y,x-solversHaloSize),
            t[patchIndex], 
            dt[patchIndex],
            1,
            tempEigenvalueY,
            eigenvalueEnumerator
          );
        }
      );

      std::for_each(
        std::execution::par_unseq,
        range2d_unknown->begin(),
        range2d_unknown->end(),
        [
          =,
          QIn=hostPatchData.QIn,
          cellCentre=hostPatchData.cellCentre,
          cellSize=hostPatchData.cellSize,
          dt=hostPatchData.dt,
          QOut=hostPatchData.QOut
        ](auto ids){
          auto [y,x,unknown] = ids;
          internal::updateSolutionWithEigenvalueDamping_LoopBody(
            QIn[patchIndex],
            QInEnumerator,
            tempEigenvalueX,
            tempEigenvalueY,
            tempEigenvalueZ,
            eigenvalueEnumerator,
            cellCentre[patchIndex],
            cellSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            unknown,
            dt[patchIndex],
            QOut[patchIndex],
            QOutEnumerator
          );
        }
      );
    }
    else if (Dimensions==3) {

      std::for_each(
        std::execution::par_unseq,
        range2d_solvhalosize->begin(),
        range2d_solvhalosize->end(),
        [
          =,
          QIn=hostPatchData.QIn,
          cellCentre=hostPatchData.cellCentre,
          cellSize=hostPatchData.cellSize,
          t=hostPatchData.t,
          dt=hostPatchData.dt
        ](auto ids){
          auto [v,w,u] = ids;

          internal::computeMaxEigenvalue_LoopBody<Solver>(
            QIn[patchIndex],
            QInEnumerator,
            cellCentre[patchIndex],
            cellSize[patchIndex],
            patchIndex,
            volumeIndex3d(u-solversHaloSize,v,w),
            t[patchIndex], 
            dt[patchIndex],
            0,
            tempEigenvalueX,
            eigenvalueEnumerator
          );

          internal::computeMaxEigenvalue_LoopBody<Solver>(
            QIn[patchIndex],
            QInEnumerator,
            cellCentre[patchIndex],
            cellSize[patchIndex],
            patchIndex,
            volumeIndex3d(w,u-solversHaloSize,v),
            t[patchIndex], 
            dt[patchIndex],
            1,
            tempEigenvalueY,
            eigenvalueEnumerator
          );

          internal::computeMaxEigenvalue_LoopBody<Solver>(
            QIn[patchIndex],
            QInEnumerator,
            cellCentre[patchIndex],
            cellSize[patchIndex],
            patchIndex,
            volumeIndex3d(v,w,u-solversHaloSize),
            t[patchIndex],
            dt[patchIndex],
            2,
            tempEigenvalueZ,
            eigenvalueEnumerator
          );
          
        }
      );

      std::for_each(
        std::execution::par_unseq,
        range3d_unknown->begin(),
        range3d_unknown->end(),
        [
          =,
          QIn=hostPatchData.QIn,
          cellCentre=hostPatchData.cellCentre,
          cellSize=hostPatchData.cellSize,
          dt=hostPatchData.dt,
          QOut=hostPatchData.QOut          
        ](auto ids){
          auto [x,y,z,unknown] = ids;
          internal::updateSolutionWithEigenvalueDamping_LoopBody(
            QIn[patchIndex],
            QInEnumerator,
            tempEigenvalueX,
            tempEigenvalueY,
            tempEigenvalueZ,
            eigenvalueEnumerator,
            cellCentre[patchIndex],
            cellSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            unknown,
            dt[patchIndex],
            QOut[patchIndex],
            QOutEnumerator
          );
        }
      );

    }

    if (evaluateFlux and Dimensions==2) {

      std::for_each(
        std::execution::par_unseq,
        range1d_solvhalosize->begin(),
        range1d_solvhalosize->end(),
        [
          =,
          QIn=hostPatchData.QIn,
          cellCentre=hostPatchData.cellCentre,
          cellSize=hostPatchData.cellSize,
          t=hostPatchData.t,
          dt=hostPatchData.dt
        ](auto ids){
          auto [y,x] = ids;

          internal::computeFlux_LoopBody<Solver, unknowns, auxiliaryVariables>(
            QIn[patchIndex],
            QInEnumerator,
            cellCentre[patchIndex],
            cellSize[patchIndex],
            patchIndex,
            volumeIndex2d(x-solversHaloSize,y),
            t[patchIndex],
            dt[patchIndex],
            0, // normal
            tempFluxX,
            fluxEnumerator
          );

          internal::computeFlux_LoopBody<Solver, unknowns, auxiliaryVariables>(
            QIn[patchIndex],
            QInEnumerator,
            cellCentre[patchIndex],
            cellSize[patchIndex],
            patchIndex,
            volumeIndex2d(y,x-solversHaloSize),
            t[patchIndex],
            dt[patchIndex],
            1, // normal
            tempFluxY,
            fluxEnumerator
          );

        }
      );

      std::for_each(
        std::execution::par_unseq,
        range2d_unknown->begin(),
        range2d_unknown->end(),
        [
          =,
          cellCentre=hostPatchData.cellCentre,
          cellSize=hostPatchData.cellSize,
          dt=hostPatchData.dt,
          QOut=hostPatchData.QOut
        ](auto ids){
          auto [x,y,unknown] = ids;
          internal::updateSolutionWithFlux_LoopBody(
            tempFluxX, tempFluxY, tempFluxZ,
            fluxEnumerator,
            cellCentre[patchIndex],
            cellSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            unknown,
            dt[patchIndex],
            *(QOut + patchIndex),
            QOutEnumerator
          );
        }
      );

    }

    else if (evaluateFlux and Dimensions==3) {

      std::for_each(
        std::execution::par_unseq,
        range2d_solvhalosize->begin(),
        range2d_solvhalosize->end(),
        [
          =,
          QIn=hostPatchData.QIn,
          cellCentre=hostPatchData.cellCentre,
          cellSize=hostPatchData.cellSize,
          t=hostPatchData.t,
          dt=hostPatchData.dt
        ](auto ids){
          auto [v,w,u] = ids;
          internal::computeFlux_LoopBody<Solver, unknowns, auxiliaryVariables>(
            QIn[patchIndex],
            QInEnumerator,
            cellCentre[patchIndex],
            cellSize[patchIndex],
            patchIndex,
            volumeIndex3d(u-solversHaloSize,v,w),
            t[patchIndex],
            dt[patchIndex],
            0, // normal
            tempFluxX,
            fluxEnumerator
          );

          internal::computeFlux_LoopBody<Solver, unknowns, auxiliaryVariables>(
            QIn[patchIndex],
            QInEnumerator,
            cellCentre[patchIndex],
            cellSize[patchIndex],
            patchIndex,
            volumeIndex3d(w,u-solversHaloSize,v),
            t[patchIndex],
            dt[patchIndex],
            1, // normal
            tempFluxY,
            fluxEnumerator
          );

          internal::computeFlux_LoopBody<Solver, unknowns, auxiliaryVariables>(
            QIn[patchIndex],
            QInEnumerator,
            cellCentre[patchIndex],
            cellSize[patchIndex],
            patchIndex,
            volumeIndex3d(v,w,u-solversHaloSize),
            t[patchIndex],
            dt[patchIndex],
            2, // normal
            tempFluxZ,
            fluxEnumerator
          );

        }
      );

      std::for_each(
        std::execution::par_unseq,
        range3d_unknown->begin(),
        range3d_unknown->end(),
        [
          =,
          cellCentre=hostPatchData.cellCentre,
          cellSize=hostPatchData.cellSize,
          dt=hostPatchData.dt,
          QOut=hostPatchData.QOut
        ](auto ids){
          auto [x,y,z,unknown] = ids;
          internal::updateSolutionWithFlux_LoopBody(
            tempFluxX, tempFluxY, tempFluxZ,
            fluxEnumerator,
            cellCentre[patchIndex],
            cellSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            unknown,
            dt[patchIndex],
            *(QOut + patchIndex),
            QOutEnumerator
          );
        }
      );
    }


    if (evaluateNonconservativeProduct and Dimensions==2) {
      
      std::for_each(
        std::execution::par_unseq,
        range1d_solvhalosize_m->begin(),
        range1d_solvhalosize_m->end(),
        [
          =,
          QIn=hostPatchData.QIn,
          cellCentre=hostPatchData.cellCentre,
          cellSize=hostPatchData.cellSize,
          t=hostPatchData.t,
          dt=hostPatchData.dt
        ](auto ids){
          auto [y,x] = ids;
          internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
            QIn[patchIndex],
            QInEnumerator,
            cellCentre[patchIndex],
            cellSize[patchIndex],
            patchIndex,
            volumeIndex2d(x-solversHaloSize,y),
            t[patchIndex],
            dt[patchIndex],
            0, // normal
            tempNonconservativeProductX,
            ncpEnumerator
          );

          internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
            QIn[patchIndex],
            QInEnumerator,
            cellCentre[patchIndex],
            cellSize[patchIndex],
            patchIndex,
            volumeIndex2d(y,x-solversHaloSize),
            t[patchIndex],
            dt[patchIndex],
            1, // normal
            tempNonconservativeProductY,
            ncpEnumerator
          );
        }
      );

      std::for_each(
        std::execution::par_unseq,
        range2d_unknown->begin(),
        range2d_unknown->end(),
        [
          =,
          cellCentre=hostPatchData.cellCentre,
          cellSize=hostPatchData.cellSize,
          dt=hostPatchData.dt,
          QOut=hostPatchData.QOut
        ](auto ids){
          auto [x,y,unknown] = ids;
          internal::updateSolutionWithNonconservativeFlux_LoopBody(
            tempNonconservativeProductX, tempNonconservativeProductY, tempNonconservativeProductZ,
            ncpEnumerator,
            cellCentre[patchIndex],
            cellSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            unknown,
            dt[patchIndex],
            *(QOut + patchIndex),
            QOutEnumerator
          );
        }
      );

    }
    else if (evaluateNonconservativeProduct and Dimensions==3) { 

      std::for_each(
        std::execution::par_unseq,
        range2d_solvhalosize_m->begin(),
        range2d_solvhalosize_m->end(),
        [
          =,
          QIn=hostPatchData.QIn,
          cellCentre=hostPatchData.cellCentre,
          cellSize=hostPatchData.cellSize,
          t=hostPatchData.t,
          dt=hostPatchData.dt
        ](auto ids){
          auto [v,w,u] = ids;

          internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
            QIn[patchIndex],
            QInEnumerator,
            cellCentre[patchIndex],
            cellSize[patchIndex],
            patchIndex,
            volumeIndex3d(u-solversHaloSize,v,w),
            t[patchIndex],
            dt[patchIndex],
            0, // normal
            tempNonconservativeProductX,
            ncpEnumerator
          );

          internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
            QIn[patchIndex],
            QInEnumerator,
            cellCentre[patchIndex],
            cellSize[patchIndex],
            patchIndex,
            volumeIndex3d(w,u-solversHaloSize,v),
            t[patchIndex],
            dt[patchIndex],
            1, // normal
            tempNonconservativeProductY,
            ncpEnumerator
          );

          internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
            QIn[patchIndex],
            QInEnumerator,
            cellCentre[patchIndex],
            cellSize[patchIndex],
            patchIndex,
            volumeIndex3d(v,w,u-solversHaloSize),
            t[patchIndex],
            dt[patchIndex],
            2, // normal
            tempNonconservativeProductZ,
            ncpEnumerator
          );

        }
      );

      std::for_each(
        std::execution::par_unseq,
        range3d_unknown->begin(),
        range3d_unknown->end(),
        [
          =,
          cellCentre=hostPatchData.cellCentre,
          cellSize=hostPatchData.cellSize,
          dt=hostPatchData.dt,
          QOut=hostPatchData.QOut
        ](auto ids){
          auto [x,y,z,unknown] = ids;
          internal::updateSolutionWithNonconservativeFlux_LoopBody(
            tempNonconservativeProductX, tempNonconservativeProductY, tempNonconservativeProductZ,
            ncpEnumerator,
            cellCentre[patchIndex],
            cellSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            unknown,
            dt[patchIndex],
            *(QOut + patchIndex),
            QOutEnumerator
          );
        }
      );
    }

    if (evaluateMaximumEigenvalueAfterTimeStep and Dimensions==2) {
      logDebug( "timeStepWithRusanov_overlap1_sequential(...)", "compute maximum eigenvalue for subsequent time step" );
      double newMaxEigenvalue = 0.0;

      std::for_each(
        std::execution::seq,
        range2d->begin(),
        range2d->end(),
        [
          =,
          &newMaxEigenvalue,
          QOut=hostPatchData.QOut,
          cellCentre=hostPatchData.cellCentre,
          cellSize=hostPatchData.cellSize,
          t=hostPatchData.t,
          dt=hostPatchData.dt
        ](auto ids){
          auto [x,y] = ids;
          newMaxEigenvalue = std::max(
            newMaxEigenvalue,
            internal::reduceMaxEigenvalue_LoopBody<Solver>(
              *(QOut + patchIndex),
              QOutEnumerator,
              cellCentre[patchIndex],
              cellSize[patchIndex],
              patchIndex,
              volumeIndex2d(x,y),
              t[patchIndex],
              dt[patchIndex]
            )
          );
        }
      );

      hostPatchData.maxEigenvalue[patchIndex] = newMaxEigenvalue;
    }
    
    else if (evaluateMaximumEigenvalueAfterTimeStep and Dimensions==3) {
      double newMaxEigenvalue = 0.0;

      std::for_each(
        std::execution::seq,
        range3d->begin(),
        range3d->end(),
        [
          =,
          &newMaxEigenvalue,
          QOut=hostPatchData.QOut,
          cellCentre=hostPatchData.cellCentre,
          cellSize=hostPatchData.cellSize,
          t=hostPatchData.t,
          dt=hostPatchData.dt
        ](auto ids){
          auto [x,y,z] = ids;
          newMaxEigenvalue = std::max(
            newMaxEigenvalue,
            internal::reduceMaxEigenvalue_LoopBody<Solver>(
              *(QOut + patchIndex),
              QOutEnumerator,
              cellCentre[patchIndex],
              cellSize[patchIndex],
              patchIndex,
              volumeIndex3d(x,y,z),
              t[patchIndex],
              dt[patchIndex]
            )
          );
        }
      );

      hostPatchData.maxEigenvalue[patchIndex] = newMaxEigenvalue;
    }
  } // This is the end of the target offloading block

  delete[] tempFluxX;
  delete[] tempFluxY;
  delete[] tempFluxZ;
  delete[] tempNonconservativeProductX;
  delete[] tempNonconservativeProductY;
  delete[] tempNonconservativeProductZ;
  delete[] tempEigenvalueX;
  delete[] tempEigenvalueY;
  delete[] tempEigenvalueZ;
  delete[] range2d;
  delete[] range3d;
  delete[] range2d_unknown;
  delete[] range3d_unknown;
  delete[] range1d_solvhalosize;
  delete[] range2d_solvhalosize;
  delete[] range2d_unknown_aux;
  delete[] range3d_unknown_aux;
  delete[] range1d_solvhalosize_m;
  delete[] range2d_solvhalosize_m;


  #else
  assertionMsg(false, "this routine should only be used in combination with CPP offloading, as it has a device parameter" );
  #endif
}
