#include "Rusanov.h"
#include "tarch/compiler/CompilerSpecificSettings.h"
#include "exahype2/fv/rusanov/LoopBody.h"

// ***************************************************************************************
// @todo Include this in a separate file
#include <vector>
#include <iterator>
#include <execution>
#include <algorithm>

template<typename Collection1, typename Collection2, typename Collection3, typename Collection4, typename Collection5>
void cartesian_product(Collection1&& collection1, Collection2&& collection2, Collection3&& collection3, Collection4&& collection4, Collection5&& collection5, auto func)
{
    std::for_each(
        std::execution::par_unseq,
        collection1.begin(), 
        collection1.end(), 
        [&collection2,&collection3,&collection4,&collection5,&func](auto i){
            std::for_each(
                std::execution::par_unseq,
                collection2.begin(),
                collection2.end(),
                [&collection3,&collection4,&collection5,&i,&func](auto j){
                    std::for_each(
                        std::execution::par_unseq,
                        collection3.begin(),
                        collection3.end(),
                        [&collection4,&collection5,&i,&j,&func](auto k){
                            std::for_each(
                                std::execution::par_unseq,
                                collection4.begin(),
                                collection4.end(),
                                [&collection5,&i,&j,&k,&func](auto m){
                                    std::for_each(
                                        std::execution::par_unseq,
                                        collection5.begin(),
                                        collection5.end(),
                                        [&i,&j,&k,&m,&func](auto n){
                                            func(i,j,k,m,n);
                                        }
                                    );
                                }
                            );
                        }
                    );
                }
            );
        }
    );
}

template<typename Collection1, typename Collection2, typename Collection3, typename Collection4>
void cartesian_product(Collection1&& collection1, Collection2&& collection2, Collection3&& collection3, Collection4&& collection4, auto func)
{
    std::for_each(
        std::execution::par_unseq,
        collection1.begin(), 
        collection1.end(), 
        [&collection2,&collection3,&collection4,&func](auto i){
            std::for_each(
                std::execution::par_unseq,
                collection2.begin(),
                collection2.end(),
                [&collection3,&collection4,&i,&func](auto j){
                    std::for_each(
                        std::execution::par_unseq,
                        collection3.begin(),
                        collection3.end(),
                        [&collection4,&i,&j,&func](auto k){
                            std::for_each(
                                std::execution::par_unseq,
                                collection4.begin(),
                                collection4.end(),
                                [&i,&j,&k,&func](auto m){
                                    func(i,j,k,m);
                                }
                            );
                        }
                    );
                }
            );
        }
    );
}

template<typename Collection1, typename Collection2, typename Collection3>
void cartesian_product(Collection1&& collection1, Collection2&& collection2, Collection3&& collection3, auto func)
{
    std::for_each(
        std::execution::par_unseq,
        collection1.begin(), 
        collection1.end(), 
        [&collection2,&collection3,&func](auto i){
            std::for_each(
                std::execution::par_unseq,
                collection2.begin(),
                collection2.end(),
                [&collection3,&i,&func](auto j){
                      std::for_each(
                        std::execution::par_unseq,
                        collection3.begin(),
                        collection3.end(),
                        [&i,&j,&func](auto k){
                            func(i,j,k);
                        }
                    );
                }
            );
        }
    );
}

template<typename Collection1, typename Collection2>
void cartesian_product(Collection1&& collection1, Collection2&& collection2, auto func)
{
    std::for_each(
        std::execution::par_unseq,
        collection1.begin(), 
        collection1.end(), 
        [&collection2,&func](auto i){
            std::for_each(
                std::execution::par_unseq,
                collection2.begin(),
                collection2.end(),
                [&i,&func](auto j){
                    func(i,j);
                }
            );
        }
    );
}

// ***************************************************************************************


template <
  typename Solver,
  int      numberOfVolumesPerAxisInPatch,
  int      haloSize,
  int      unknowns,
  int      auxiliaryVariables,
  typename TempDataEnumerator
>
void exahype2::fv::rusanov::cpp::timeStepWithRusanov_patchwise_heap_static_calls(
  int                     targetDevice,
  ::exahype2::CellData&   hostPatchData,
  bool                    evaluateFlux,
  bool                    evaluateNonconservativeProduct,
  bool                    evaluateSource,
  bool                    evaluateMaximumEigenvalueAfterTimeStep
) {
  #if defined(GPUOffloadingCPP)
  /**
   * The halo size passed in by the user might differ from the one that we have to evaluate/
   * take into account from the solver's perspective.
   */
  constexpr int solversHaloSize        = 1;

  exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator QInHostEnumerator       (                        1, numberOfVolumesPerAxisInPatch, haloSize, unknowns, auxiliaryVariables);
  exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator QOutHostEnumerator      (                        1, numberOfVolumesPerAxisInPatch,        0, unknowns, auxiliaryVariables);
  TempDataEnumerator fluxHostEnumerator      (hostPatchData.numberOfCells, numberOfVolumesPerAxisInPatch,   solversHaloSize, unknowns, 0);
  TempDataEnumerator ncpHostEnumerator       (hostPatchData.numberOfCells, numberOfVolumesPerAxisInPatch+1, solversHaloSize, unknowns, 0);
  TempDataEnumerator eigenvalueHostEnumerator(hostPatchData.numberOfCells, numberOfVolumesPerAxisInPatch,   solversHaloSize,        1, 0);


  double* tempFluxX = new double[fluxHostEnumerator.size()];
  double* tempFluxY = new double[fluxHostEnumerator.size()];
  double* tempFluxZ = new double[fluxHostEnumerator.size()];
  double* tempNonconservativeProductX = new double[ncpHostEnumerator.size()];
  double* tempNonconservativeProductY = new double[ncpHostEnumerator.size()];
  double* tempNonconservativeProductZ = new double[ncpHostEnumerator.size()];
  double* tempEigenvalueX = new double[eigenvalueHostEnumerator.size()];
  double* tempEigenvalueY = new double[eigenvalueHostEnumerator.size()];
  double* tempEigenvalueZ = new double[eigenvalueHostEnumerator.size()];


  double**  mappedPointersToQIn          = new double*[ hostPatchData.numberOfCells ];
  double**  mappedPointersToQOut         = new double*[ hostPatchData.numberOfCells ];


  std::vector<int> dim_range(numberOfVolumesPerAxisInPatch);
  std::vector<int> unknown_range(unknowns);
  std::vector<int> aux_range1(unknowns+auxiliaryVariables);
  std::vector<int> aux_range2(numberOfVolumesPerAxisInPatch);
  std::vector<int> aux_range3(numberOfVolumesPerAxisInPatch-1);

  std::iota(std::begin(dim_range), std::end(dim_range), 0);
  std::iota(std::begin(unknown_range), std::end(unknown_range), 0);
  std::iota(std::begin(aux_range1), std::end(aux_range1), 0);
  std::iota(std::begin(aux_range2), std::end(aux_range2), -solversHaloSize);
  std::iota(std::begin(aux_range3), std::end(aux_range3), -solversHaloSize);


  for (int patchIndex=0; patchIndex<hostPatchData.numberOfCells; patchIndex++) {
    double* currentQIn  = hostPatchData.QIn[patchIndex];
    double* currentQOut = hostPatchData.QOut[patchIndex];

    mappedPointersToQIn[patchIndex]  = currentQIn;
    mappedPointersToQOut[patchIndex] = currentQOut;
  }

  const int numberOfCells            = hostPatchData.numberOfCells;
  double*   rawPointerToPatchCentres = hostPatchData.patchCentre[0].data();
  double*   rawPointerToPatchSizes   = hostPatchData.patchSize[0].data();
  double*   t                        = hostPatchData.t;
  double*   dt                       = hostPatchData.dt;
  double*   maxEigenvalue            = hostPatchData.maxEigenvalue;

  for (int patchIndex=0; patchIndex<numberOfCells; patchIndex++) {

    // @todo docu manual assembly of patch data meta object on GPU
    helper::CPPGPUCellData patchData;
    patchData.numberOfCells = numberOfCells;
    patchData.patchCentre   = (tarch::la::Vector<Dimensions,double>*)(rawPointerToPatchCentres);
    patchData.patchSize     = (tarch::la::Vector<Dimensions,double>*)(rawPointerToPatchSizes);
    patchData.QIn           = mappedPointersToQIn;
    patchData.QOut          = mappedPointersToQOut;
    patchData.t             = t;
    patchData.dt            = dt;
    patchData.maxEigenvalue = maxEigenvalue;

    exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator QInEnumerator       (                        1, numberOfVolumesPerAxisInPatch,haloSize,unknowns,auxiliaryVariables);
    exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator QOutEnumerator      (                        1, numberOfVolumesPerAxisInPatch,       0,unknowns,auxiliaryVariables);
    TempDataEnumerator fluxEnumerator      (patchData.numberOfCells, numberOfVolumesPerAxisInPatch,haloSize,unknowns,0);
    TempDataEnumerator ncpEnumerator       (patchData.numberOfCells, numberOfVolumesPerAxisInPatch+1,haloSize,unknowns,0);
    TempDataEnumerator eigenvalueEnumerator(patchData.numberOfCells, numberOfVolumesPerAxisInPatch,haloSize,1,0);

    if (Dimensions==2 and evaluateSource) {
      cartesian_product(dim_range, dim_range, [&](int x, int y) {
        internal::copySolutionAndAddSourceTerm_LoopBody<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          patchData.QOut[patchIndex],
          QOutEnumerator
        );
      });
    }
    
    else if (Dimensions==3 and evaluateSource) {
      cartesian_product(dim_range, dim_range, dim_range, [&](int x, int y, int z) {
        internal::copySolutionAndAddSourceTerm_LoopBody<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          patchData.QOut[patchIndex],
          QOutEnumerator
        );
      });
    }

    else if (Dimensions==2) {
      cartesian_product(dim_range, dim_range, aux_range1, [&](int x, int y, int unknown) {
        internal::copySolution_LoopBody(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchIndex,
          volumeIndex2d(x,y),
          unknown,
          patchData.QOut[patchIndex],
          QOutEnumerator
        );
      });
    }

    else {
      cartesian_product(dim_range, dim_range, dim_range, aux_range1, [&](int x, int y, int z, int unknown) {
        internal::copySolution_LoopBody(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchIndex,
          volumeIndex3d(x,y,z),
          unknown,
          patchData.QOut[patchIndex],
          QOutEnumerator
        );
      });
    }

    if (Dimensions==2) {

      cartesian_product(dim_range, aux_range2, [&](int y, int x) {
        internal::computeMaxEigenvalue_LoopBody<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            patchData.t[patchIndex], patchData.dt[patchIndex],
            0,
            tempEigenvalueX,
            eigenvalueEnumerator
        );
      });

      cartesian_product(aux_range2, dim_range, [&](int y, int x) {
        internal::computeMaxEigenvalue_LoopBody<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            patchData.t[patchIndex], patchData.dt[patchIndex],
            1,
            tempEigenvalueY,
            eigenvalueEnumerator
        );
      });

      cartesian_product(dim_range, dim_range, unknown_range, [&](int y, int x, int unknown) {
        internal::updateSolutionWithEigenvalueDamping_LoopBody(
          patchData.QIn[patchIndex],
          QInEnumerator,
          tempEigenvalueX,
          tempEigenvalueY,
          tempEigenvalueZ,
          eigenvalueEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          unknown,
          patchData.dt[patchIndex],
          patchData.QOut[patchIndex],
          QOutEnumerator
        );
      });
    }
    else {
      cartesian_product(dim_range, dim_range, aux_range2, [&](int z, int y, int x) {
        internal::computeMaxEigenvalue_LoopBody<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          patchData.t[patchIndex], patchData.dt[patchIndex],
          0,
          tempEigenvalueX,
          eigenvalueEnumerator
        );
      });

      cartesian_product(dim_range, aux_range2, dim_range, [&](int z, int y, int x) {
        internal::computeMaxEigenvalue_LoopBody<Solver>(
              patchData.QIn[patchIndex],
              QInEnumerator,
              patchData.patchCentre[patchIndex],
              patchData.patchSize[patchIndex],
              patchIndex,
              volumeIndex3d(x,y,z),
              patchData.t[patchIndex], patchData.dt[patchIndex],
              1,
              tempEigenvalueY,
              eigenvalueEnumerator
        );
      });

      cartesian_product(aux_range2, dim_range, dim_range, [&](int z, int y, int x) {
        internal::computeMaxEigenvalue_LoopBody<Solver>(
              patchData.QIn[patchIndex],
              QInEnumerator,
              patchData.patchCentre[patchIndex],
              patchData.patchSize[patchIndex],
              patchIndex,
              volumeIndex3d(x,y,z),
              patchData.t[patchIndex], patchData.dt[patchIndex],
              2,
              tempEigenvalueZ,
              eigenvalueEnumerator
        );
      });

      cartesian_product(dim_range, dim_range, dim_range, unknown_range, [&](int z, int y, int x, int unknown) {
        internal::updateSolutionWithEigenvalueDamping_LoopBody(
          patchData.QIn[patchIndex],
          QInEnumerator,
          tempEigenvalueX,
          tempEigenvalueY,
          tempEigenvalueZ,
          eigenvalueEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          unknown,
          patchData.dt[patchIndex],
          patchData.QOut[patchIndex],
          QOutEnumerator
        );
      });
    }


    if (evaluateFlux and Dimensions==2) {
      cartesian_product(dim_range, aux_range2, [&](int y, int x) {
        internal::computeFlux_LoopBody<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          0, // normal
          tempFluxX,
          fluxEnumerator
        );
      });

      cartesian_product(aux_range2, dim_range, [&](int y, int x) {
        internal::computeFlux_LoopBody<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          1, // normal
          tempFluxY,
          fluxEnumerator
        );
      });

      cartesian_product(dim_range, dim_range, unknown_range, [&](int y, int x, int unknown) {
        internal::updateSolutionWithFlux_LoopBody(
          tempFluxX, tempFluxY, tempFluxZ,
          fluxEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          unknown,
          patchData.dt[patchIndex],
          *(patchData.QOut + patchIndex),
          QOutEnumerator
        );
      });
    }

    else if (evaluateFlux and Dimensions==3) {
      cartesian_product(dim_range, dim_range, aux_range2, [&](int z, int y, int x) {
        internal::computeFlux_LoopBody<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          0, // normal
          tempFluxX,
          fluxEnumerator
        );
      });

      cartesian_product(dim_range, aux_range2, dim_range, [&](int z, int y, int x) {
        internal::computeFlux_LoopBody<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          1, // normal
          tempFluxY,
          fluxEnumerator
        );
      });

      cartesian_product(aux_range2, dim_range, dim_range, [&](int z, int y, int x) {
        internal::computeFlux_LoopBody<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          2, // normal
          tempFluxZ,
          fluxEnumerator
        );
      });

      cartesian_product(dim_range, dim_range, dim_range, unknown_range, [&](int z, int y, int x, int unknown) {
        internal::updateSolutionWithFlux_LoopBody(
          tempFluxX, tempFluxY, tempFluxZ,
          fluxEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          unknown,
          patchData.dt[patchIndex],
          *(patchData.QOut + patchIndex),
          QOutEnumerator
        );
      });
    }


    if (evaluateNonconservativeProduct and Dimensions==2) {
      cartesian_product(dim_range, aux_range3, [&](int y, int x) {
        internal::computeNonconservativeFlux_LoopBody<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          0, // normal
          tempNonconservativeProductX,
          ncpEnumerator
        );
      });

      cartesian_product(aux_range3, dim_range, [&](int y, int x) {
        internal::computeNonconservativeFlux_LoopBody<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          1, // normal
          tempNonconservativeProductY,
          ncpEnumerator
        );
      });

      cartesian_product(dim_range, dim_range, unknown_range, [&](int y, int x, int unknown) {
        internal::updateSolutionWithNonconservativeFlux_LoopBody(
          tempNonconservativeProductX, tempNonconservativeProductY, tempNonconservativeProductZ,
          ncpEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          unknown,
          patchData.dt[patchIndex],
          *(patchData.QOut + patchIndex),
          QOutEnumerator
        );
      });
    }
    else if (evaluateNonconservativeProduct and Dimensions==3) {
        cartesian_product(dim_range, dim_range, aux_range3, [&](int z, int y, int x) {
          internal::computeNonconservativeFlux_LoopBody<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            0, // normal
            tempNonconservativeProductX,
            ncpEnumerator
          );
        });

        cartesian_product(dim_range, aux_range3, dim_range, [&](int z, int y, int x) {
          internal::computeNonconservativeFlux_LoopBody<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            1, // normal
            tempNonconservativeProductY,
            ncpEnumerator
          );
        });

        cartesian_product(aux_range3, dim_range, dim_range, [&](int z, int y, int x) {
          internal::computeNonconservativeFlux_LoopBody<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            2, // normal
            tempNonconservativeProductZ,
            ncpEnumerator
          );
        });

        cartesian_product(dim_range, dim_range, dim_range, unknown_range, [&](int z, int y, int x, int unknown) {
          internal::updateSolutionWithNonconservativeFlux_LoopBody(
            tempNonconservativeProductX, tempNonconservativeProductY, tempNonconservativeProductZ,
            ncpEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            unknown,
            patchData.dt[patchIndex],
            *(patchData.QOut + patchIndex),
            QOutEnumerator
          );
        });
    }
    if (evaluateMaximumEigenvalueAfterTimeStep and Dimensions==2) {
      logDebug( "timeStepWithRusanov_overlap1_sequential(...)", "compute maximum eigenvalue for subsequent time step" );
      double newMaxEigenvalue = 0.0;
      cartesian_product(dim_range, dim_range, [&](int y, int x) {
        newMaxEigenvalue = std::max(
          newMaxEigenvalue,
          internal::reduceMaxEigenvalue_LoopBody<Solver>(
            *(patchData.QOut + patchIndex),
            QOutEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            patchData.t[patchIndex],
            patchData.dt[patchIndex]
          )
        );
      });
      patchData.maxEigenvalue[patchIndex] = newMaxEigenvalue;
    }
    else if (evaluateMaximumEigenvalueAfterTimeStep) {
      double newMaxEigenvalue = 0.0;
      cartesian_product(dim_range, dim_range, dim_range, [&](int z, int y, int x) {
        newMaxEigenvalue = std::max(
          newMaxEigenvalue,
          internal::reduceMaxEigenvalue_LoopBody<Solver>(
            *(patchData.QOut + patchIndex),
            QOutEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex]
          )
        );
      });
    }
  } // This is the end of the target offloading block

  for (int patchIndex=0; patchIndex<hostPatchData.numberOfCells; patchIndex++) {
    const double* currentQIn  = hostPatchData.QIn[patchIndex];
    double*       currentQOut = hostPatchData.QOut[patchIndex];
  }

  delete[] tempFluxX;
  delete[] tempFluxY;
  delete[] tempFluxZ;
  delete[] tempNonconservativeProductX;
  delete[] tempNonconservativeProductY;
  delete[] tempNonconservativeProductZ;
  delete[] tempEigenvalueX;
  delete[] tempEigenvalueY;
  delete[] tempEigenvalueZ;
  delete[] mappedPointersToQIn;
  delete[] mappedPointersToQOut;


  #else
  assertionMsg(false, "this routine should only be used in combination with OpenMP offloading, as it has a device parameter" );
  #endif
}

