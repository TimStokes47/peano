#include "Rusanov.h"
#include "tarch/compiler/CompilerSpecificSettings.h"
#include "exahype2/fv/rusanov/LoopBody.h"
#include "extra/cartesian_product.h"

#include <vector>
#include <iterator>
#include <execution>
#include <algorithm>
#include <numeric>

template <
  typename Solver,
  int      numberOfVolumesPerAxisInPatch,
  int      haloSize,
  int      unknowns,
  int      auxiliaryVariables,
  typename TempDataEnumerator
>
void exahype2::fv::rusanov::cpp::timeStepWithRusanov_patchwise_heap_static_calls(
  int                     targetDevice,
  ::exahype2::CellData&   hostPatchData,
  bool                    evaluateFlux,
  bool                    evaluateNonconservativeProduct,
  bool                    evaluateSource,
  bool                    evaluateMaximumEigenvalueAfterTimeStep
) {
  #if defined(GPUOffloadingCPP)
  /**
   * The halo size passed in by the user might differ from the one that we have to evaluate/
   * take into account from the solver's perspective.
   */
  constexpr int solversHaloSize        = 1;

  exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator QInHostEnumerator       (                        1, numberOfVolumesPerAxisInPatch, haloSize, unknowns, auxiliaryVariables);
  exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator QOutHostEnumerator      (                        1, numberOfVolumesPerAxisInPatch,        0, unknowns, auxiliaryVariables);
  TempDataEnumerator fluxHostEnumerator      (hostPatchData.numberOfCells, numberOfVolumesPerAxisInPatch,   solversHaloSize, unknowns, 0);
  TempDataEnumerator ncpHostEnumerator       (hostPatchData.numberOfCells, numberOfVolumesPerAxisInPatch+1, solversHaloSize, unknowns, 0);
  TempDataEnumerator eigenvalueHostEnumerator(hostPatchData.numberOfCells, numberOfVolumesPerAxisInPatch,   solversHaloSize,        1, 0);


  double* tempFluxX = new double[fluxHostEnumerator.size()];
  double* tempFluxY = new double[fluxHostEnumerator.size()];
  double* tempFluxZ = new double[fluxHostEnumerator.size()];
  double* tempNonconservativeProductX = new double[ncpHostEnumerator.size()];
  double* tempNonconservativeProductY = new double[ncpHostEnumerator.size()];
  double* tempNonconservativeProductZ = new double[ncpHostEnumerator.size()];
  double* tempEigenvalueX = new double[eigenvalueHostEnumerator.size()];
  double* tempEigenvalueY = new double[eigenvalueHostEnumerator.size()];
  double* tempEigenvalueZ = new double[eigenvalueHostEnumerator.size()];


  double**  mappedPointersToQIn          = new double*[ hostPatchData.numberOfCells ];
  double**  mappedPointersToQOut         = new double*[ hostPatchData.numberOfCells ];

  // The cartesian products have to be located on the heap so that they are accessible from the GPU.
  // Here we define types to able to allocated in heap.
  using cart_prod_2d = decltype(tl::views::cartesian_product(
    std::views::iota(0,1), 
    std::views::iota(0,1)
  ));
  using cart_prod_3d = decltype(tl::views::cartesian_product(
    std::views::iota(0,1), 
    std::views::iota(0,1), 
    std::views::iota(0,1)
  ));
  using cart_prod_4d = decltype(tl::views::cartesian_product(
    std::views::iota(0,1), 
    std::views::iota(0,1), 
    std::views::iota(0,1), 
    std::views::iota(0,1)
  ));

  // Definition of the cartesian products.
  auto* range2d = new cart_prod_2d;
  *range2d = tl::views::cartesian_product(
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,numberOfVolumesPerAxisInPatch)
  );

  auto* range3d = new cart_prod_3d;
  *range3d = tl::views::cartesian_product(
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,numberOfVolumesPerAxisInPatch)
  );

  auto* range2d_unknown = new cart_prod_3d;
  *range2d_unknown = tl::views::cartesian_product(
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,unknowns)
  );

  auto* range3d_unknown = new cart_prod_4d;
  *range3d_unknown = tl::views::cartesian_product(
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,unknowns)
  );

  auto* range1d_solvhalosize = new cart_prod_2d;
  *range1d_solvhalosize = tl::views::cartesian_product(
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(-solversHaloSize,numberOfVolumesPerAxisInPatch+solversHaloSize)
  );

  auto* range2d_solvhalosize = new cart_prod_3d;
  *range2d_solvhalosize = tl::views::cartesian_product(
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(-solversHaloSize,numberOfVolumesPerAxisInPatch+solversHaloSize)
  );

  auto* range2d_unknown_aux = new cart_prod_3d;
  *range2d_unknown_aux = tl::views::cartesian_product(
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,unknowns+auxiliaryVariables)
  );

  auto* range3d_unknown_aux = new cart_prod_4d;
  *range3d_unknown_aux = tl::views::cartesian_product(
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,unknowns+auxiliaryVariables)
  );

  auto* range1d_solvhalosize_m = new cart_prod_2d;
  *range1d_solvhalosize_m = tl::views::cartesian_product(
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(-solversHaloSize,numberOfVolumesPerAxisInPatch+solversHaloSize-1)
  );

  auto* range2d_solvhalosize_m = new cart_prod_3d;
  *range2d_solvhalosize_m = tl::views::cartesian_product(
    std::views::iota(0,numberOfVolumesPerAxisInPatch),
    std::views::iota(0,numberOfVolumesPerAxisInPatch),  
    std::views::iota(-solversHaloSize,numberOfVolumesPerAxisInPatch+solversHaloSize-1)
  );


  for (int patchIndex=0; patchIndex<hostPatchData.numberOfCells; patchIndex++) {
    double* currentQIn  = hostPatchData.QIn[patchIndex];
    double* currentQOut = hostPatchData.QOut[patchIndex];

    mappedPointersToQIn[patchIndex]  = currentQIn;
    mappedPointersToQOut[patchIndex] = currentQOut;
  }

  const int numberOfCells            = hostPatchData.numberOfCells;
  double*   rawPointerToPatchCentres = hostPatchData.patchCentre[0].data();
  double*   rawPointerToPatchSizes   = hostPatchData.patchSize[0].data();
  double*   t                        = hostPatchData.t;
  double*   dt                       = hostPatchData.dt;
  double*   maxEigenvalue            = hostPatchData.maxEigenvalue;

  for (int patchIndex=0; patchIndex<numberOfCells; patchIndex++) {

    // @todo docu manual assembly of patch data meta object on GPU
    helper::CPPGPUCellData patchData;
    patchData.numberOfCells = numberOfCells;
    patchData.patchCentre   = (tarch::la::Vector<Dimensions,double>*)(rawPointerToPatchCentres);
    patchData.patchSize     = (tarch::la::Vector<Dimensions,double>*)(rawPointerToPatchSizes);
    patchData.QIn           = mappedPointersToQIn;
    patchData.QOut          = mappedPointersToQOut;
    patchData.t             = t;
    patchData.dt            = dt;
    patchData.maxEigenvalue = maxEigenvalue;

    exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator QInEnumerator       (                        1, numberOfVolumesPerAxisInPatch,haloSize,unknowns,auxiliaryVariables);
    exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator QOutEnumerator      (                        1, numberOfVolumesPerAxisInPatch,       0,unknowns,auxiliaryVariables);
    TempDataEnumerator fluxEnumerator      (patchData.numberOfCells, numberOfVolumesPerAxisInPatch,haloSize,unknowns,0);
    TempDataEnumerator ncpEnumerator       (patchData.numberOfCells, numberOfVolumesPerAxisInPatch+1,haloSize,unknowns,0);
    TempDataEnumerator eigenvalueEnumerator(patchData.numberOfCells, numberOfVolumesPerAxisInPatch,haloSize,1,0);

    if (Dimensions==2 and evaluateSource) {
      std::for_each(
        std::execution::par_unseq,
        range2d->begin(),
        range2d->end(),
        [&](auto ids){
          auto [x,y] = ids;
          internal::copySolutionAndAddSourceTerm_LoopBody<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            patchData.QOut[patchIndex],
            QOutEnumerator
          );
        }
      );
    }
    
    else if (Dimensions==3 and evaluateSource) {
      std::for_each(
        std::execution::par_unseq,
        range3d->begin(),
        range3d->end(),
        [&](auto ids){
          auto [x,y,z] = ids;
          internal::copySolutionAndAddSourceTerm_LoopBody<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            patchData.QOut[patchIndex],
            QOutEnumerator
          );
        }
      );
    }

    else if (Dimensions==2) {
      std::for_each(
        std::execution::par_unseq,
        range2d_unknown_aux->begin(),
        range2d_unknown_aux->end(),
        [&](auto ids){
          auto [x,y,unknown] = ids;
          internal::copySolution_LoopBody(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchIndex,
            volumeIndex2d(x,y),
            unknown,
            patchData.QOut[patchIndex],
            QOutEnumerator
          );
        }
      );
    }

    else {
      std::for_each(
        std::execution::par_unseq,
        range3d_unknown_aux->begin(),
        range3d_unknown_aux->end(),
        [&](auto ids){
          auto [x,y,z,unknown] = ids;
          internal::copySolution_LoopBody(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchIndex,
            volumeIndex3d(x,y,z),
            unknown,
            patchData.QOut[patchIndex],
            QOutEnumerator
          );
        }
      );
    }

    if (Dimensions==2) {
      
      std::for_each(
        std::execution::par_unseq,
        range1d_solvhalosize->begin(),
        range1d_solvhalosize->end(),
        [&](auto ids){
          auto [y,x] = ids;
          internal::computeMaxEigenvalue_LoopBody<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            patchData.t[patchIndex], patchData.dt[patchIndex],
            0,
            tempEigenvalueX,
            eigenvalueEnumerator
          );
        }
      );

      std::for_each(
        std::execution::par_unseq,
        range1d_solvhalosize->begin(),
        range1d_solvhalosize->end(),
        [&](auto ids){
          auto [x,y] = ids;
          internal::computeMaxEigenvalue_LoopBody<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            patchData.t[patchIndex], patchData.dt[patchIndex],
            1,
            tempEigenvalueY,
            eigenvalueEnumerator
          );
        }
      );

      std::for_each(
        std::execution::par_unseq,
        range2d_unknown->begin(),
        range2d_unknown->end(),
        [&](auto ids){
          auto [y,x,unknown] = ids;
          internal::updateSolutionWithEigenvalueDamping_LoopBody(
            patchData.QIn[patchIndex],
            QInEnumerator,
            tempEigenvalueX,
            tempEigenvalueY,
            tempEigenvalueZ,
            eigenvalueEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            unknown,
            patchData.dt[patchIndex],
            patchData.QOut[patchIndex],
            QOutEnumerator
          );
        }
      );
    }
    else {

      std::for_each(
        std::execution::par_unseq,
        range2d_solvhalosize->begin(),
        range2d_solvhalosize->end(),
        [&](auto ids){
          auto [z,y,x] = ids;
          internal::computeMaxEigenvalue_LoopBody<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex], patchData.dt[patchIndex],
            0,
            tempEigenvalueX,
            eigenvalueEnumerator
          );
        }
      );

      std::for_each(
        std::execution::par_unseq,
        range2d_solvhalosize->begin(),
        range2d_solvhalosize->end(),
        [&](auto ids){
          auto [z,x,y] = ids;
          internal::computeMaxEigenvalue_LoopBody<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex], patchData.dt[patchIndex],
            1,
            tempEigenvalueY,
            eigenvalueEnumerator
          );
        }
      );

      std::for_each(
        std::execution::par_unseq,
        range2d_solvhalosize->begin(),
        range2d_solvhalosize->end(),
        [&](auto ids){
          auto [x,y,z] = ids;
          internal::computeMaxEigenvalue_LoopBody<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex], patchData.dt[patchIndex],
            2,
            tempEigenvalueZ,
            eigenvalueEnumerator
          );
        }
      );

      std::for_each(
        std::execution::par_unseq,
        range3d_unknown->begin(),
        range3d_unknown->end(),
        [&](auto ids){
          auto [x,y,z,unknown] = ids;
          internal::updateSolutionWithEigenvalueDamping_LoopBody(
            patchData.QIn[patchIndex],
            QInEnumerator,
            tempEigenvalueX,
            tempEigenvalueY,
            tempEigenvalueZ,
            eigenvalueEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            unknown,
            patchData.dt[patchIndex],
            patchData.QOut[patchIndex],
            QOutEnumerator
          );
        }
      );

    }

    if (evaluateFlux and Dimensions==2) {

      std::for_each(
        std::execution::par_unseq,
        range1d_solvhalosize->begin(),
        range1d_solvhalosize->end(),
        [&](auto ids){
          auto [y,x] = ids;
          internal::computeFlux_LoopBody<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            0, // normal
            tempFluxX,
            fluxEnumerator
          );
        }
      );

      std::for_each(
        std::execution::par_unseq,
        range1d_solvhalosize->begin(),
        range1d_solvhalosize->end(),
        [&](auto ids){
          auto [x,y] = ids;
          internal::computeFlux_LoopBody<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            1, // normal
            tempFluxY,
            fluxEnumerator
          );
        }
      );

      std::for_each(
        std::execution::par_unseq,
        range2d_unknown->begin(),
        range2d_unknown->end(),
        [&](auto ids){
          auto [x,y,unknown] = ids;
          internal::updateSolutionWithFlux_LoopBody(
            tempFluxX, tempFluxY, tempFluxZ,
            fluxEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            unknown,
            patchData.dt[patchIndex],
            *(patchData.QOut + patchIndex),
            QOutEnumerator
          );
        }
      );

    }

    else if (evaluateFlux and Dimensions==3) {

      std::for_each(
        std::execution::par_unseq,
        range2d_solvhalosize->begin(),
        range2d_solvhalosize->end(),
        [&](auto ids){
          auto [z,y,x] = ids;
          internal::computeFlux_LoopBody<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            0, // normal
            tempFluxX,
            fluxEnumerator
          );
        }
      );

      std::for_each(
        std::execution::par_unseq,
        range2d_solvhalosize->begin(),
        range2d_solvhalosize->end(),
        [&](auto ids){
          auto [z,x,y] = ids;
          internal::computeFlux_LoopBody<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            1, // normal
            tempFluxY,
            fluxEnumerator
          );
        }
      );

      std::for_each(
        std::execution::par_unseq,
        range2d_solvhalosize->begin(),
        range2d_solvhalosize->end(),
        [&](auto ids){
          auto [x,y,z] = ids;
          internal::computeFlux_LoopBody<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            2, // normal
            tempFluxZ,
            fluxEnumerator
          );
        }
      );

      std::for_each(
        std::execution::par_unseq,
        range3d_unknown->begin(),
        range3d_unknown->end(),
        [&](auto ids){
          auto [x,y,z,unknown] = ids;
          internal::updateSolutionWithFlux_LoopBody(
            tempFluxX, tempFluxY, tempFluxZ,
            fluxEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            unknown,
            patchData.dt[patchIndex],
            *(patchData.QOut + patchIndex),
            QOutEnumerator
          );
        }
      );
    }


    if (evaluateNonconservativeProduct and Dimensions==2) {
      
      std::for_each(
        std::execution::par_unseq,
        range1d_solvhalosize_m->begin(),
        range1d_solvhalosize_m->end(),
        [&](auto ids){
          auto [y,x] = ids;
          internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            0, // normal
            tempNonconservativeProductX,
            ncpEnumerator
          );
        }
      );

      std::for_each(
        std::execution::par_unseq,
        range1d_solvhalosize_m->begin(),
        range1d_solvhalosize_m->end(),
        [&](auto ids){
          auto [x,y] = ids;
          internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            1, // normal
            tempNonconservativeProductY,
            ncpEnumerator
          );
        }
      );

      std::for_each(
        std::execution::par_unseq,
        range2d_unknown->begin(),
        range2d_unknown->end(),
        [&](auto ids){
          auto [x,y,unknown] = ids;
          internal::updateSolutionWithNonconservativeFlux_LoopBody(
            tempNonconservativeProductX, tempNonconservativeProductY, tempNonconservativeProductZ,
            ncpEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            unknown,
            patchData.dt[patchIndex],
            *(patchData.QOut + patchIndex),
            QOutEnumerator
          );
        }
      );
    }
    else if (evaluateNonconservativeProduct and Dimensions==3) { 

      std::for_each(
        std::execution::par_unseq,
        range2d_solvhalosize_m->begin(),
        range2d_solvhalosize_m->end(),
        [&](auto ids){
          auto [z,y,x] = ids;
          internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            0, // normal
            tempNonconservativeProductX,
            ncpEnumerator
          );
        }
      );

      std::for_each(
        std::execution::par_unseq,
        range2d_solvhalosize_m->begin(),
        range2d_solvhalosize_m->end(),
        [&](auto ids){
          auto [z,x,y] = ids;
          internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            1, // normal
            tempNonconservativeProductY,
            ncpEnumerator
          );
        }
      );

      std::for_each(
        std::execution::par_unseq,
        range2d_solvhalosize_m->begin(),
        range2d_solvhalosize_m->end(),
        [&](auto ids){
          auto [x,y,z] = ids;
          internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            2, // normal
            tempNonconservativeProductZ,
            ncpEnumerator
          );
        }
      );

      std::for_each(
        std::execution::par_unseq,
        range3d_unknown->begin(),
        range3d_unknown->end(),
        [&](auto ids){
          auto [x,y,z,unknown] = ids;
          internal::updateSolutionWithNonconservativeFlux_LoopBody(
            tempNonconservativeProductX, tempNonconservativeProductY, tempNonconservativeProductZ,
            ncpEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            unknown,
            patchData.dt[patchIndex],
            *(patchData.QOut + patchIndex),
            QOutEnumerator
          );
        }
      );
    }

    if (evaluateMaximumEigenvalueAfterTimeStep and Dimensions==2) {
      logDebug( "timeStepWithRusanov_overlap1_sequential(...)", "compute maximum eigenvalue for subsequent time step" );
      double newMaxEigenvalue = 0.0;

      std::for_each(
        std::execution::par_unseq,
        range2d->begin(),
        range2d->end(),
        [&](auto ids){
          auto [x,y] = ids;
          newMaxEigenvalue = std::max(
            newMaxEigenvalue,
            internal::reduceMaxEigenvalue_LoopBody<Solver>(
              *(patchData.QOut + patchIndex),
              QOutEnumerator,
              patchData.patchCentre[patchIndex],
              patchData.patchSize[patchIndex],
              patchIndex,
              volumeIndex2d(x,y),
              patchData.t[patchIndex],
              patchData.dt[patchIndex]
            )
          );
        }
      );
      patchData.maxEigenvalue[patchIndex] = newMaxEigenvalue;
    }
    else if (evaluateMaximumEigenvalueAfterTimeStep) {
      double newMaxEigenvalue = 0.0;

      std::for_each(
        std::execution::par_unseq,
        range3d->begin(),
        range3d->end(),
        [&](auto ids){
          auto [x,y,z] = ids;
          newMaxEigenvalue = std::max(
            newMaxEigenvalue,
            internal::reduceMaxEigenvalue_LoopBody<Solver>(
              *(patchData.QOut + patchIndex),
              QOutEnumerator,
              patchData.patchCentre[patchIndex],
              patchData.patchSize[patchIndex],
              patchIndex,
              volumeIndex3d(x,y,z),
              patchData.t[patchIndex],
              patchData.dt[patchIndex]
            )
          );
        }
      );
    }
  } // This is the end of the target offloading block

  for (int patchIndex=0; patchIndex<hostPatchData.numberOfCells; patchIndex++) {
    const double* currentQIn  = hostPatchData.QIn[patchIndex];
    double*       currentQOut = hostPatchData.QOut[patchIndex];
  }

  delete[] tempFluxX;
  delete[] tempFluxY;
  delete[] tempFluxZ;
  delete[] tempNonconservativeProductX;
  delete[] tempNonconservativeProductY;
  delete[] tempNonconservativeProductZ;
  delete[] tempEigenvalueX;
  delete[] tempEigenvalueY;
  delete[] tempEigenvalueZ;
  delete[] mappedPointersToQIn;
  delete[] mappedPointersToQOut;
  delete[] range2d;
  delete[] range3d;
  delete[] range2d_unknown;
  delete[] range3d_unknown;
  delete[] range1d_solvhalosize;
  delete[] range2d_solvhalosize;
  delete[] range2d_unknown_aux;
  delete[] range3d_unknown_aux;
  delete[] range1d_solvhalosize_m;
  delete[] range2d_solvhalosize_m;


  #else
  assertionMsg(false, "this routine should only be used in combination with CPP offloading, as it has a device parameter" );
  #endif
}