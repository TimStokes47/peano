#include "Rusanov.h"
#include "otter/otter.h"
#include "tarch/compiler/CompilerSpecificSettings.h"


namespace exahype2 { namespace fv{ namespace rusanov{ namespace internal{
  template <
    typename Solver,
    int                     numberOfVolumesPerAxisInPatch,
    int                     unknowns,
    int                     auxiliaryVariables,
    typename TempDataEnumerator
  >
  void timeStepWithRusanov_overlap1_patchwise_static_calls(
    ::exahype2::CellData&              patchData,
    bool                    evaluateFlux,
    bool                    evaluateNonconservativeProduct,
    bool                    evaluateSource,
    bool                    evaluateMaximumEigenvalueAfterTimeStep,
    const exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator& QInEnumerator,
    const exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator& QOutEnumerator,
    const TempDataEnumerator& fluxEnumerator,
    const TempDataEnumerator& ncpEnumerator,
    const TempDataEnumerator& eigenvalueEnumerator,
    double* tempFluxX,
    double* tempFluxY,
    double* tempFluxZ,
    double* tempNonconservativeProductX,
    double* tempNonconservativeProductY,
    double* tempNonconservativeProductZ,
    double* tempEigenvalueX,
    double* tempEigenvalueY,
    double* tempEigenvalueZ
  ) {
    constexpr int haloSize        = 1;
    for (int patchIndex=0; patchIndex<patchData.numberOfCells; patchIndex++) {
      if (Dimensions==2 and evaluateSource) {
        otterLoopBegin();
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
        #if defined(SharedOMP)
        #pragma omp simd
        #endif
        for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
          otterLoopIterationBegin();
          internal::copySolutionAndAddSourceTerm_LoopBody<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            patchData.QOut[patchIndex],
            QOutEnumerator
          );
          otterLoopIterationEnd();
        }
        otterLoopEnd();
      }
      else if (Dimensions==3 and evaluateSource) {
        otterLoopBegin();
        for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
        #if defined(SharedOMP)
        #pragma omp simd
        #endif
        for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
          otterLoopIterationBegin();
          internal::copySolutionAndAddSourceTerm_LoopBody<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            patchData.QOut[patchIndex],
            QOutEnumerator
          );
          otterLoopIterationEnd();
        }
        otterLoopEnd();
      }
      else if (Dimensions==2) {
        otterLoopBegin();
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
        #if defined(SharedOMP)
        #pragma omp simd collapse(2)
        #endif
        for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int unknown=0; unknown<unknowns+auxiliaryVariables; unknown++) {
          otterLoopIterationBegin();
          internal::copySolution_LoopBody(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchIndex,
            volumeIndex2d(x,y),
            unknown,
            patchData.QOut[patchIndex],
            QOutEnumerator
          );
          otterLoopIterationEnd();
        }
        otterLoopEnd();
      }
      else {
        otterLoopBegin();
        for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
        #if defined(SharedOMP)
        #pragma omp simd collapse(2)
        #endif
        for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int unknown=0; unknown<unknowns+auxiliaryVariables; unknown++) {
          otterLoopIterationBegin();
          internal::copySolution_LoopBody(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchIndex,
            volumeIndex3d(x,y,z),
            unknown,
            patchData.QOut[patchIndex],
            QOutEnumerator
          );
          otterLoopIterationEnd();
        }
        otterLoopEnd();
      }


      if (Dimensions==2) {
        otterLoopBegin();
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
        #if defined(SharedOMP)
        #pragma omp simd
        #endif
        for (int x = -haloSize; x < numberOfVolumesPerAxisInPatch+haloSize; x++) {
          otterLoopIterationBegin();
          internal::computeMaxEigenvalue_LoopBody<Solver>(
              patchData.QIn[patchIndex],
              QInEnumerator,
              patchData.patchCentre[patchIndex],
              patchData.patchSize[patchIndex],
              patchIndex,
              volumeIndex2d(x,y),
              patchData.t[patchIndex], patchData.dt[patchIndex],
              0,
              tempEigenvalueX,
              eigenvalueEnumerator
          );
        }

        for (int y = -haloSize; y < numberOfVolumesPerAxisInPatch+haloSize; y++)
        #if defined(SharedOMP)
        #pragma omp simd
        #endif
        for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
          otterLoopIterationBegin();
          internal::computeMaxEigenvalue_LoopBody<Solver>(
              patchData.QIn[patchIndex],
              QInEnumerator,
              patchData.patchCentre[patchIndex],
              patchData.patchSize[patchIndex],
              patchIndex,
              volumeIndex2d(x,y),
              patchData.t[patchIndex], patchData.dt[patchIndex],
              1,
              tempEigenvalueY,
              eigenvalueEnumerator
          );
          otterLoopIterationEnd();
        }
        otterLoopEnd();


        otterLoopBegin();
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
        #if defined(SharedOMP)
        #pragma omp simd collapse(2)
        #endif
        for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int unknown = 0; unknown < unknowns; unknown++) {
          otterLoopIterationBegin();
          internal::updateSolutionWithEigenvalueDamping_LoopBody(
            patchData.QIn[patchIndex],
            QInEnumerator,
            tempEigenvalueX,
            tempEigenvalueY,
            tempEigenvalueZ,
            eigenvalueEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            unknown,
            patchData.dt[patchIndex],
            patchData.QOut[patchIndex],
            QOutEnumerator
          );
          otterLoopIterationEnd();
        }
        otterLoopEnd();
      }
      else {
        otterLoopBegin();
        for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
        #if defined(SharedOMP)
        #pragma omp simd
        #endif
        for (int x = -haloSize; x < numberOfVolumesPerAxisInPatch+haloSize; x++) {
          otterLoopIterationBegin();
          internal::computeMaxEigenvalue_LoopBody<Solver>(
                patchData.QIn[patchIndex],
                QInEnumerator,
                patchData.patchCentre[patchIndex],
                patchData.patchSize[patchIndex],
                patchIndex,
                volumeIndex3d(x,y,z),
                patchData.t[patchIndex], patchData.dt[patchIndex],
                0,
                tempEigenvalueX,
                eigenvalueEnumerator
          );
          otterLoopIterationEnd();
        }
        otterLoopEnd();

        otterLoopBegin();
        for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
        for (int y = -haloSize; y < numberOfVolumesPerAxisInPatch+haloSize; y++)
        #if defined(SharedOMP)
        #pragma omp simd
        #endif
        for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
          otterLoopIterationBegin();
          internal::computeMaxEigenvalue_LoopBody<Solver>(
                patchData.QIn[patchIndex],
                QInEnumerator,
                patchData.patchCentre[patchIndex],
                patchData.patchSize[patchIndex],
                patchIndex,
                volumeIndex3d(x,y,z),
                patchData.t[patchIndex], patchData.dt[patchIndex],
                1,
                tempEigenvalueY,
                eigenvalueEnumerator
          );
          otterLoopIterationEnd();
        }
        otterLoopEnd();

        otterLoopBegin();
        for (int z = -haloSize; z < numberOfVolumesPerAxisInPatch+haloSize; z++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
        #if defined(SharedOMP)
        #pragma omp simd
        #endif
        for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
          otterLoopIterationBegin();
          internal::computeMaxEigenvalue_LoopBody<Solver>(
                patchData.QIn[patchIndex],
                QInEnumerator,
                patchData.patchCentre[patchIndex],
                patchData.patchSize[patchIndex],
                patchIndex,
                volumeIndex3d(x,y,z),
                patchData.t[patchIndex], patchData.dt[patchIndex],
                2,
                tempEigenvalueZ,
                eigenvalueEnumerator
          );
          otterLoopIterationEnd();
        }
        otterLoopEnd();


        otterLoopBegin();
        for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
        #if defined(SharedOMP)
        #pragma omp simd collapse(2)
        #endif
        for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int unknown = 0; unknown < unknowns; unknown++) {
          otterLoopIterationBegin();
          internal::updateSolutionWithEigenvalueDamping_LoopBody(
            patchData.QIn[patchIndex],
            QInEnumerator,
            tempEigenvalueX,
            tempEigenvalueY,
            tempEigenvalueZ,
            eigenvalueEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            unknown,
            patchData.dt[patchIndex],
            patchData.QOut[patchIndex],
            QOutEnumerator
          );
          otterLoopIterationEnd();
        }
        otterLoopEnd();
      }

      if (evaluateFlux and Dimensions==2) {
        otterLoopBegin();
        for (int y =         0; y < numberOfVolumesPerAxisInPatch;          y++)
        #if defined(SharedOMP)
        #pragma omp simd
        #endif
        for (int x = -haloSize; x < numberOfVolumesPerAxisInPatch+haloSize; x++) {
          otterLoopIterationBegin();
          internal::computeFlux_LoopBody<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            0, // normal
            tempFluxX,
            fluxEnumerator
          );
          otterLoopIterationEnd();
        }
        otterLoopEnd();

        otterLoopBegin();
        for (int y = -haloSize; y < numberOfVolumesPerAxisInPatch+haloSize;  y++)
        #if defined(SharedOMP)
        #pragma omp simd
        #endif
        for (int x =         0; x < numberOfVolumesPerAxisInPatch;           x++) {
          otterLoopIterationBegin();
          internal::computeFlux_LoopBody<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            1, // normal
            tempFluxY,
            fluxEnumerator
          );
          otterLoopIterationEnd();
        }
        otterLoopEnd();

        otterLoopBegin();
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
        #if defined(SharedOMP)
        #pragma omp simd collapse(2)
        #endif
        for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int unknown=0; unknown<unknowns; unknown++) {
          otterLoopIterationBegin();
          internal::updateSolutionWithFlux_LoopBody(
            tempFluxX, tempFluxY, tempFluxZ,
            fluxEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            unknown,
            patchData.dt[patchIndex],
            *(patchData.QOut + patchIndex),
            QOutEnumerator
          );
          otterLoopIterationEnd();
        }
        otterLoopEnd();
      }
      else if (evaluateFlux and Dimensions==3) {
        otterLoopBegin();
        for (int z =         0; z < numberOfVolumesPerAxisInPatch;          z++)
        for (int y =         0; y < numberOfVolumesPerAxisInPatch;          y++)
        #if defined(SharedOMP)
        #pragma omp simd
        #endif
        for (int x = -haloSize; x < numberOfVolumesPerAxisInPatch+haloSize; x++) {
          otterLoopIterationBegin();
          internal::computeFlux_LoopBody<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            0, // normal
            tempFluxX,
            fluxEnumerator
          );
          otterLoopIterationEnd();
        }
        otterLoopEnd();

        otterLoopBegin();
        for (int z =         0; z < numberOfVolumesPerAxisInPatch;           z++)
        for (int y = -haloSize; y < numberOfVolumesPerAxisInPatch+haloSize;  y++)
        #if defined(SharedOMP)
        #pragma omp simd
        #endif
        for (int x =         0; x < numberOfVolumesPerAxisInPatch;           x++) {
          otterLoopIterationBegin();
          internal::computeFlux_LoopBody<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            1, // normal
            tempFluxY,
            fluxEnumerator
          );
          otterLoopIterationEnd();
        }
        otterLoopEnd();

        otterLoopBegin();
        for (int z = -haloSize; z < numberOfVolumesPerAxisInPatch+haloSize;  z++)
        for (int y =         0; y < numberOfVolumesPerAxisInPatch;           y++)
        #if defined(SharedOMP)
        #pragma omp simd
        #endif
        for (int x =         0; x < numberOfVolumesPerAxisInPatch;           x++) {
          otterLoopIterationBegin();
          internal::computeFlux_LoopBody<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            2, // normal
            tempFluxZ,
            fluxEnumerator
          );
          otterLoopIterationEnd();
        }
        otterLoopEnd();

        otterLoopBegin();
        for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
        #if defined(SharedOMP)
        #pragma omp simd
        #endif
        for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int unknown=0; unknown<unknowns; unknown++) {
          otterLoopIterationBegin();
          internal::updateSolutionWithFlux_LoopBody(
            tempFluxX, tempFluxY, tempFluxZ,
            fluxEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            unknown,
            patchData.dt[patchIndex],
            *(patchData.QOut + patchIndex),
            QOutEnumerator
          );
          otterLoopIterationEnd();
        }
        otterLoopEnd();
      }


      if (evaluateNonconservativeProduct and Dimensions==2) {
        otterLoopBegin();
        for (int y =         0; y < numberOfVolumesPerAxisInPatch;            y++)
        #if defined(SharedOMP)
        #pragma omp simd
        #endif
        for (int x = -haloSize; x < numberOfVolumesPerAxisInPatch+haloSize-1; x++) {
          otterLoopIterationBegin();
          internal::computeNonconservativeFlux_LoopBody<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            0, // normal
            tempNonconservativeProductX,
            ncpEnumerator
          );
          otterLoopIterationEnd();
        }
        otterLoopEnd();

        otterLoopBegin();
        for (int y = -haloSize; y < numberOfVolumesPerAxisInPatch+haloSize-1; y++)
        #if defined(SharedOMP)
        #pragma omp simd
        #endif
        for (int x =         0; x < numberOfVolumesPerAxisInPatch;            x++) {
          otterLoopIterationBegin();
          internal::computeNonconservativeFlux_LoopBody<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            1, // normal
            tempNonconservativeProductY,
            ncpEnumerator
          );
          otterLoopIterationEnd();
        }
        otterLoopEnd();

        otterLoopBegin();
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
        #if defined(SharedOMP)
        #pragma omp simd collapse(2)
        #endif
        for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int unknown=0; unknown<unknowns; unknown++) {
          otterLoopIterationBegin();
          internal::updateSolutionWithNonconservativeFlux_LoopBody(
            tempNonconservativeProductX, tempNonconservativeProductY, tempNonconservativeProductZ,
            ncpEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            unknown,
            patchData.dt[patchIndex],
            *(patchData.QOut + patchIndex),
            QOutEnumerator
          );
          otterLoopIterationEnd();
        }
        otterLoopEnd();
      }
      else if (evaluateNonconservativeProduct and Dimensions==3) {
          otterLoopBegin();
          for (int z =         0; z < numberOfVolumesPerAxisInPatch;            z++)
          for (int y =         0; y < numberOfVolumesPerAxisInPatch;            y++)
          #if defined(SharedOMP)
          #pragma omp simd
          #endif
          for (int x = -haloSize; x < numberOfVolumesPerAxisInPatch+haloSize-1; x++) {
            otterLoopIterationBegin();
            internal::computeNonconservativeFlux_LoopBody<Solver>(
              patchData.QIn[patchIndex],
              QInEnumerator,
              patchData.patchCentre[patchIndex],
              patchData.patchSize[patchIndex],
              patchIndex,
              volumeIndex3d(x,y,z),
              patchData.t[patchIndex],
              patchData.dt[patchIndex],
              0, // normal
              tempNonconservativeProductX,
              ncpEnumerator
            );
            otterLoopIterationEnd();
          }
          otterLoopEnd();

          otterLoopBegin();
          for (int z =         0; z < numberOfVolumesPerAxisInPatch;            z++)
          for (int y = -haloSize; y < numberOfVolumesPerAxisInPatch+haloSize-1; y++)
          #if defined(SharedOMP)
          #pragma omp simd
          #endif
          for (int x =         0; x < numberOfVolumesPerAxisInPatch;            x++) {
            otterLoopIterationBegin();
            internal::computeNonconservativeFlux_LoopBody<Solver>(
              patchData.QIn[patchIndex],
              QInEnumerator,
              patchData.patchCentre[patchIndex],
              patchData.patchSize[patchIndex],
              patchIndex,
              volumeIndex3d(x,y,z),
              patchData.t[patchIndex],
              patchData.dt[patchIndex],
              1, // normal
              tempNonconservativeProductY,
              ncpEnumerator
            );
            otterLoopIterationEnd();
          }
          otterLoopEnd();

          otterLoopBegin();
          for (int z = -haloSize; z < numberOfVolumesPerAxisInPatch+haloSize-1; z++)
          for (int y =         0; y < numberOfVolumesPerAxisInPatch;            y++)
          #if defined(SharedOMP)
          #pragma omp simd
          #endif
          for (int x =         0; x < numberOfVolumesPerAxisInPatch;            x++) {
            otterLoopIterationBegin();
            internal::computeNonconservativeFlux_LoopBody<Solver>(
              patchData.QIn[patchIndex],
              QInEnumerator,
              patchData.patchCentre[patchIndex],
              patchData.patchSize[patchIndex],
              patchIndex,
              volumeIndex3d(x,y,z),
              patchData.t[patchIndex],
              patchData.dt[patchIndex],
              2, // normal
              tempNonconservativeProductZ,
              ncpEnumerator
            );
            otterLoopIterationEnd();
          }
          otterLoopEnd();

          otterLoopBegin();
          for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
          for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
          #if defined(SharedOMP)
          #pragma omp simd collapse(2)
          #endif
          for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
          for (int unknown=0; unknown<unknowns; unknown++) {
            otterLoopIterationBegin();
            internal::updateSolutionWithNonconservativeFlux_LoopBody(
              tempNonconservativeProductX, tempNonconservativeProductY, tempNonconservativeProductZ,
              ncpEnumerator,
              patchData.patchCentre[patchIndex],
              patchData.patchSize[patchIndex],
              patchIndex,
              volumeIndex3d(x,y,z),
              unknown,
              patchData.dt[patchIndex],
              *(patchData.QOut + patchIndex),
              QOutEnumerator
            );
            otterLoopIterationEnd();
          }
          otterLoopEnd();
      }

      if (evaluateMaximumEigenvalueAfterTimeStep and Dimensions==2) {
        logDebug( "timeStepWithRusanov_overlap1_sequential(...)", "compute maximum eigenvalue for subsequent time step" );
        double newMaxEigenvalue = 0.0;
        otterLoopBegin(); // @todo how do I clarify that this is a reduction? Do we need this info here?
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
        #if defined(SharedOMP)
        #pragma omp simd reduction(max:newMaxEigenvalue)
        #endif
        for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
          otterLoopIterationBegin();
          newMaxEigenvalue = std::max(
            newMaxEigenvalue,
            internal::reduceMaxEigenvalue_LoopBody<Solver>(
              *(patchData.QOut + patchIndex),
              QOutEnumerator,
              patchData.patchCentre[patchIndex],
              patchData.patchSize[patchIndex],
              patchIndex,
              volumeIndex2d(x,y),
              patchData.t[patchIndex],
              patchData.dt[patchIndex]
            )
          );
          otterLoopIterationEnd();
        }
        otterLoopEnd();
        patchData.maxEigenvalue[patchIndex] = newMaxEigenvalue;
      }
      else if (evaluateMaximumEigenvalueAfterTimeStep) {
        double newMaxEigenvalue = 0.0;
        otterLoopBegin(); // @todo how do I clarify that this is a reduction? Do we need this info here?
        for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
        #if defined(SharedOMP)
        #pragma omp simd reduction(max:newMaxEigenvalue)
        #endif
        for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
          otterLoopIterationBegin();
          newMaxEigenvalue = std::max(
            newMaxEigenvalue,
            internal::reduceMaxEigenvalue_LoopBody<Solver>(
              *(patchData.QOut + patchIndex),
              QOutEnumerator,
              patchData.patchCentre[patchIndex],
              patchData.patchSize[patchIndex],
              patchIndex,
              volumeIndex3d(x,y,z),
              patchData.t[patchIndex],
              patchData.dt[patchIndex]
            )
          );
          otterLoopIterationEnd();
        }
        otterLoopEnd();
        patchData.maxEigenvalue[patchIndex] = newMaxEigenvalue;
      }
    }
  }
}}}}


template <
  typename Solver,
  int                     numberOfVolumesPerAxisInPatch,
  int                     unknowns,
  int                     auxiliaryVariables,
  typename TempDataEnumerator
>
void exahype2::fv::rusanov::timeStepWithRusanov_overlap1_patchwise_call_stack_static_calls(
  ::exahype2::CellData&   patchData,
  bool                    evaluateFlux,
  bool                    evaluateNonconservativeProduct,
  bool                    evaluateSource,
  bool                    evaluateMaximumEigenvalueAfterTimeStep
) {
  static tarch::logging::Log _log( "exahype2::fv::rusanov" );
  constexpr int haloSize        = 1;

  exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator QInEnumerator       (                        1, numberOfVolumesPerAxisInPatch,haloSize,unknowns,auxiliaryVariables);
  exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator QOutEnumerator      (                        1, numberOfVolumesPerAxisInPatch,       0,unknowns,auxiliaryVariables);
  TempDataEnumerator fluxEnumerator      (patchData.numberOfCells, numberOfVolumesPerAxisInPatch,haloSize,unknowns,0);
  TempDataEnumerator ncpEnumerator       (patchData.numberOfCells, numberOfVolumesPerAxisInPatch+1,haloSize,unknowns,0);
  TempDataEnumerator eigenvalueEnumerator(patchData.numberOfCells, numberOfVolumesPerAxisInPatch,haloSize,1,0);

  double tempFluxX[ fluxEnumerator.size() ] __attribute__((aligned (Alignment)));
  double tempFluxY[ fluxEnumerator.size() ] __attribute__((aligned (Alignment)));
  double tempFluxZ[ fluxEnumerator.size() ] __attribute__((aligned (Alignment)));
  double tempNonconservativeProductX[ ncpEnumerator.size() ] __attribute__((aligned (Alignment)));
  double tempNonconservativeProductY[ ncpEnumerator.size() ] __attribute__((aligned (Alignment)));
  double tempNonconservativeProductZ[ ncpEnumerator.size() ] __attribute__((aligned (Alignment)));
  double tempEigenvalueX[ eigenvalueEnumerator.size() ] __attribute__((aligned (Alignment)));
  double tempEigenvalueY[ eigenvalueEnumerator.size() ] __attribute__((aligned (Alignment)));
  double tempEigenvalueZ[ eigenvalueEnumerator.size() ] __attribute__((aligned (Alignment)));

  internal::timeStepWithRusanov_overlap1_patchwise_static_calls<Solver, numberOfVolumesPerAxisInPatch, unknowns, auxiliaryVariables, TempDataEnumerator>(
    patchData,
    evaluateFlux,
    evaluateNonconservativeProduct,
    evaluateSource,
    evaluateMaximumEigenvalueAfterTimeStep,
    QInEnumerator,
    QOutEnumerator,
    fluxEnumerator,
    ncpEnumerator,
    eigenvalueEnumerator,
    tempFluxX,
    tempFluxY,
    tempFluxZ,
    tempNonconservativeProductX,
    tempNonconservativeProductY,
    tempNonconservativeProductZ,
    tempEigenvalueX,
    tempEigenvalueY,
    tempEigenvalueZ
  );
}




template <
  typename Solver,
  int      numberOfVolumesPerAxisInPatch,
  int      unknowns,
  int      auxiliaryVariables,
  typename TempDataEnumerator
>
void exahype2::fv::rusanov::timeStepWithRusanov_overlap1_patchwise_heap_static_calls(
  ::exahype2::CellData&   patchData,
  bool                    evaluateFlux,
  bool                    evaluateNonconservativeProduct,
  bool                    evaluateSource,
  bool                    evaluateMaximumEigenvalueAfterTimeStep
) {
  static tarch::logging::Log _log( "exahype2::fv::rusanov" );
  constexpr int haloSize        = 1;

  exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator QInEnumerator       (                        1, numberOfVolumesPerAxisInPatch,haloSize,unknowns,auxiliaryVariables);
  exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator QOutEnumerator      (                        1, numberOfVolumesPerAxisInPatch,       0,unknowns,auxiliaryVariables);
  TempDataEnumerator fluxEnumerator      (patchData.numberOfCells, numberOfVolumesPerAxisInPatch,haloSize,unknowns,0);
  TempDataEnumerator ncpEnumerator       (patchData.numberOfCells, numberOfVolumesPerAxisInPatch+1,haloSize,unknowns,0);
  TempDataEnumerator eigenvalueEnumerator(patchData.numberOfCells, numberOfVolumesPerAxisInPatch,haloSize,1,0);

  double* tempFluxX                  = evaluateFlux                     ? tarch::allocateMemory( fluxEnumerator.size(),      tarch::MemoryLocation::Heap ) : nullptr;
  double* tempFluxY                  = evaluateFlux                     ? tarch::allocateMemory( fluxEnumerator.size(),      tarch::MemoryLocation::Heap ) : nullptr;
  double* tempFluxZ                  = (evaluateFlux and Dimensions==3) ? tarch::allocateMemory( fluxEnumerator.size(),      tarch::MemoryLocation::Heap ) : nullptr;
  double* tempNonconservativeProductX = evaluateNonconservativeProduct                     ? tarch::allocateMemory( ncpEnumerator.size(),        tarch::MemoryLocation::Heap ) : nullptr;
  double* tempNonconservativeProductY = evaluateNonconservativeProduct                     ? tarch::allocateMemory( ncpEnumerator.size(),        tarch::MemoryLocation::Heap ) : nullptr;
  double* tempNonconservativeProductZ = (evaluateNonconservativeProduct and Dimensions==3) ? tarch::allocateMemory( ncpEnumerator.size(),        tarch::MemoryLocation::Heap ) : nullptr;
  double* tempEigenvalueX            =                                    tarch::allocateMemory( eigenvalueEnumerator.size(),      tarch::MemoryLocation::Heap );
  double* tempEigenvalueY            =                                    tarch::allocateMemory( eigenvalueEnumerator.size(),      tarch::MemoryLocation::Heap );
  double* tempEigenvalueZ            = (Dimensions==3)                  ? tarch::allocateMemory( eigenvalueEnumerator.size(),      tarch::MemoryLocation::Heap ) : nullptr;

  internal::timeStepWithRusanov_overlap1_patchwise_static_calls<Solver, numberOfVolumesPerAxisInPatch, unknowns, auxiliaryVariables, TempDataEnumerator>(
    patchData,
    evaluateFlux,
    evaluateNonconservativeProduct,
    evaluateSource,
    evaluateMaximumEigenvalueAfterTimeStep,
    QInEnumerator,
    QOutEnumerator,
    fluxEnumerator,
    ncpEnumerator,
    eigenvalueEnumerator,
    tempFluxX,
    tempFluxY,
    tempFluxZ,
    tempNonconservativeProductX,
    tempNonconservativeProductY,
    tempNonconservativeProductZ,
    tempEigenvalueX,
    tempEigenvalueY,
    tempEigenvalueZ
  );

  if (tempFluxX!=nullptr)               tarch::freeMemory(tempFluxX, tarch::MemoryLocation::Heap);
  if (tempFluxY!=nullptr)               tarch::freeMemory(tempFluxY, tarch::MemoryLocation::Heap);
  if (tempFluxZ!=nullptr)               tarch::freeMemory(tempFluxZ, tarch::MemoryLocation::Heap);
  if (tempNonconservativeProductX!=nullptr) tarch::freeMemory(tempNonconservativeProductX, tarch::MemoryLocation::Heap);
  if (tempNonconservativeProductY!=nullptr) tarch::freeMemory(tempNonconservativeProductY, tarch::MemoryLocation::Heap);
  if (tempNonconservativeProductZ!=nullptr) tarch::freeMemory(tempNonconservativeProductZ, tarch::MemoryLocation::Heap);
  if (tempEigenvalueX!=nullptr)         tarch::freeMemory(tempEigenvalueX, tarch::MemoryLocation::Heap);
  if (tempEigenvalueY!=nullptr)         tarch::freeMemory(tempEigenvalueY, tarch::MemoryLocation::Heap);
  if (tempEigenvalueZ!=nullptr)         tarch::freeMemory(tempEigenvalueZ, tarch::MemoryLocation::Heap);
}

