#include "tarch/compiler/CompilerSpecificSettings.h"

#include "exahype2/Solver.h"
#include "exahype2/fv/PatchUtils.h"

#if defined(GPUOffloadingOMP)
#pragma omp declare target
#endif
template <class QInEnumeratorType, class QOutEnumeratorType>
void exahype2::fv::rusanov::internal::copySolution_LoopBody(
  const double* __restrict__                QIn,
  const QInEnumeratorType&                  QInEnumerator,
  int                                       patchIndex,
  const tarch::la::Vector<Dimensions,int>&  volumeIndex,
  int                                       unknown,
  double* __restrict__                      QOut,
  const QOutEnumeratorType&                 QOutEnumerator
) {
  QOut[ QOutEnumerator(patchIndex,volumeIndex,unknown) ] = QIn[QInEnumerator(patchIndex,volumeIndex,unknown)];
}
#if defined(GPUOffloadingOMP)
#pragma omp end declare target
#endif

template <class QInEnumeratorType, class QOutEnumeratorType>
void exahype2::fv::rusanov::internal::copySolutionAndAddSourceTerm_LoopBody(
  const double* __restrict__                   QIn,
  const QInEnumeratorType&                     QInEnumerator,
  exahype2::fv::rusanov::Source                source,
  const tarch::la::Vector<Dimensions,double>&  patchCentre,
  const tarch::la::Vector<Dimensions,double>&  patchSize,
  int                                          patchIndex,
  const tarch::la::Vector<Dimensions,int>&     volumeIndex,
  double                                       t,
  double                                       dt,
  double* __restrict__                         QOut,
  const QOutEnumeratorType&                    QOutEnumerator
) {
  double QInGathered[QInEnumerator._unknowns+QInEnumerator._numberOfAuxiliaryVariables];
  double QSourceGathered[QInEnumerator._unknowns];

  // gather
  for (int unknown=0; unknown<QInEnumerator._unknowns+QInEnumerator._numberOfAuxiliaryVariables; unknown++) {
    QInGathered[unknown] = QIn[ QInEnumerator(patchIndex,volumeIndex,unknown) ];
  }

  source(
      QInGathered,
      ::exahype2::fv::getVolumeCentre( patchCentre, patchSize, QInEnumerator._numberOfDoFsPerAxisInCell, volumeIndex ),
      ::exahype2::fv::getVolumeSize( patchSize, QInEnumerator._numberOfDoFsPerAxisInCell ),
      t,
      dt,
      QSourceGathered
  );

  for (int unknown=0; unknown<QInEnumerator._unknowns; unknown++) {
    QOut[ QOutEnumerator(patchIndex,volumeIndex,unknown) ] = QIn[QInEnumerator(patchIndex,volumeIndex,unknown)]
                                                             + dt * QSourceGathered[unknown];
    assertion4(
      QOut[ QOutEnumerator(patchIndex, volumeIndex,unknown) ]==QOut[ QOutEnumerator(patchIndex, volumeIndex,unknown) ],
      dt, unknown, volumeIndex,
      QOutEnumerator(patchIndex, volumeIndex,unknown)
    );
  }
  for (int unknown=QInEnumerator._unknowns; unknown<QInEnumerator._unknowns+QInEnumerator._numberOfAuxiliaryVariables; unknown++) {
    QOut[ QOutEnumerator(patchIndex,volumeIndex,unknown) ] = QIn[QInEnumerator(patchIndex,volumeIndex,unknown)];
    assertion4(
      QOut[ QOutEnumerator(patchIndex, volumeIndex,unknown) ]==QOut[ QOutEnumerator(patchIndex, volumeIndex,unknown) ],
      dt, unknown, volumeIndex,
      QOutEnumerator(patchIndex, volumeIndex,unknown)
    );
  }
}

template <>
void exahype2::fv::rusanov::internal::copySolutionAndAddSourceTerm_LoopBody(
  const double* __restrict__                              QIn,
  const exahype2::enumerator::AoSLexicographicEnumerator& QInEnumerator,
  exahype2::fv::rusanov::Source                           source,
  const tarch::la::Vector<Dimensions,double>&             patchCentre,
  const tarch::la::Vector<Dimensions,double>&             patchSize,
  int                                                     patchIndex,
  const tarch::la::Vector<Dimensions,int>&                volumeIndex,
  double                                                  t,
  double                                                  dt,
  double* __restrict__                                    QOut,
  const exahype2::enumerator::AoSLexicographicEnumerator& QOutEnumerator
) {
  source(
    QIn + QInEnumerator(patchIndex,volumeIndex,0),
    ::exahype2::fv::getVolumeCentre( patchCentre, patchSize, QInEnumerator._numberOfDoFsPerAxisInCell, volumeIndex ),
    ::exahype2::fv::getVolumeSize( patchSize, QInEnumerator._numberOfDoFsPerAxisInCell ),
    t,
    dt,
    QOut + QOutEnumerator(patchIndex,volumeIndex,0)
  );

  for (int unknown=0; unknown<QInEnumerator._unknowns; unknown++) {
    QOut[ QOutEnumerator(patchIndex,volumeIndex,unknown) ] =
         dt * QOut[ QOutEnumerator(patchIndex,volumeIndex,unknown) ]
      + QIn[QInEnumerator(patchIndex,volumeIndex,unknown)];
    assertion4(
      QOut[ QOutEnumerator(patchIndex, volumeIndex,unknown) ]==QOut[ QOutEnumerator(patchIndex, volumeIndex,unknown) ],
      dt, unknown, volumeIndex,
      QOutEnumerator(patchIndex, volumeIndex,unknown)
    );
  }
  for (int unknown=QInEnumerator._unknowns; unknown<QInEnumerator._unknowns+QInEnumerator._numberOfAuxiliaryVariables; unknown++) {
    QOut[ QOutEnumerator(patchIndex,volumeIndex,unknown) ] = QIn[QInEnumerator(patchIndex,volumeIndex,unknown)];
    assertion4(
      QOut[ QOutEnumerator(patchIndex, volumeIndex,unknown) ]==QOut[ QOutEnumerator(patchIndex, volumeIndex,unknown) ],
      dt, unknown, volumeIndex,
      QOutEnumerator(patchIndex, volumeIndex,unknown)
    );
  }
}

#if defined(GPUOffloadingOMP)
#pragma omp declare target
#endif
template <class Solver, class QInEnumeratorType, class QOutEnumeratorType>
void exahype2::fv::rusanov::internal::copySolutionAndAddSourceTerm_LoopBody(
    const double* __restrict__                        QIn,
    const QInEnumeratorType&                          QInEnumerator,
    const tarch::la::Vector<Dimensions,double>&       patchCentre,
    const tarch::la::Vector<Dimensions,double>&       patchSize,
    int                                               patchIndex,
    const tarch::la::Vector<Dimensions,int>&          volumeIndex,
    double                                            t,
    double                                            dt,
    double* __restrict__                              QOut,
    const QOutEnumeratorType&                         QOutEnumerator
) {
  double QInGathered[QInEnumerator._unknowns+QInEnumerator._numberOfAuxiliaryVariables];
  double QSourceGathered[QInEnumerator._unknowns];

  // gather
  #if defined(SharedOMP)
    #pragma omp simd
  #endif
  for (int unknown=0; unknown<QInEnumerator._unknowns+QInEnumerator._numberOfAuxiliaryVariables; unknown++) {
    QInGathered[unknown] = QIn[ QInEnumerator(patchIndex,volumeIndex,unknown) ];
  }

  Solver::sourceTerm(
      QInGathered,
      ::exahype2::fv::getVolumeCentre( patchCentre, patchSize, QInEnumerator._numberOfDoFsPerAxisInCell, volumeIndex ),
      ::exahype2::fv::getVolumeSize( patchSize, QInEnumerator._numberOfDoFsPerAxisInCell ),
      t,
      dt,
      QSourceGathered,
      ::exahype2::Solver::Offloadable::Yes
  );

  // scatter
  #if defined(SharedOMP)
    #pragma omp simd
  #endif
  for (int unknown=0; unknown<QInEnumerator._unknowns; unknown++) {
    QOut[ QOutEnumerator(patchIndex,volumeIndex,unknown) ] = QIn[QInEnumerator(patchIndex,volumeIndex,unknown)]
                                                           + dt * QSourceGathered[unknown];

    #if !defined(GPUOffloadingOMP) and  !defined(GPUOffloadingSYCL)
      assertion4(
          QOut[ QOutEnumerator(patchIndex, volumeIndex,unknown) ]==QOut[ QOutEnumerator(patchIndex, volumeIndex,unknown) ],
          dt, unknown, volumeIndex,
          QOutEnumerator(patchIndex, volumeIndex,unknown)
      );
    #endif
  }

  #if defined(SharedOMP)
    #pragma omp simd
  #endif
  for (int unknown=QInEnumerator._unknowns; unknown<QInEnumerator._unknowns+QInEnumerator._numberOfAuxiliaryVariables; unknown++) {
    QOut[ QOutEnumerator(patchIndex,volumeIndex,unknown) ] = QIn[QInEnumerator(patchIndex,volumeIndex,unknown)];
    #if !defined(GPUOffloadingOMP) and  !defined(GPUOffloadingSYCL)
      assertion4(
          QOut[ QOutEnumerator(patchIndex, volumeIndex,unknown) ]==QOut[ QOutEnumerator(patchIndex, volumeIndex,unknown) ],
          dt, unknown, volumeIndex,
          QOutEnumerator(patchIndex, volumeIndex,unknown)
      );
    #endif
  }
}
#if defined(GPUOffloadingOMP)
#pragma omp end declare target
#endif

#if defined(GPUOffloadingOMP)
#pragma omp declare target
#endif
template <class Solver>
void exahype2::fv::rusanov::internal::copySolutionAndAddSourceTerm_LoopBody(
    const double* __restrict__                              QIn,
    const exahype2::enumerator::AoSLexicographicEnumerator& QInEnumerator,
    const tarch::la::Vector<Dimensions,double>&             patchCentre,
    const tarch::la::Vector<Dimensions,double>&             patchSize,
    int                                                     patchIndex,
    const tarch::la::Vector<Dimensions,int>&                volumeIndex,
    double                                                  t,
    double                                                  dt,
    double* __restrict__                                    QOut,
    const exahype2::enumerator::AoSLexicographicEnumerator& QOutEnumerator
) {
  Solver::sourceTerm(
    QIn + QInEnumerator(patchIndex,volumeIndex,0),
    ::exahype2::fv::getVolumeCentre( patchCentre, patchSize, QInEnumerator._numberOfDoFsPerAxisInCell, volumeIndex ),
    ::exahype2::fv::getVolumeSize( patchSize, QInEnumerator._numberOfDoFsPerAxisInCell ),
    t,
    dt,
    QOut + QOutEnumerator(patchIndex,volumeIndex,0),
    ::exahype2::Solver::Offloadable::Yes
  );

  // scatter
  for (int unknown=0; unknown<QInEnumerator._unknowns; unknown++) {
    QOut[ QOutEnumerator(patchIndex,volumeIndex,unknown) ] =
        dt * QOut[ QOutEnumerator(patchIndex,volumeIndex,unknown) ]
      + QIn[QInEnumerator(patchIndex,volumeIndex,unknown)];

    #if !defined(GPUOffloadingOMP) and  !defined(GPUOffloadingSYCL)
      assertion4(
        QOut[ QOutEnumerator(patchIndex, volumeIndex,unknown) ]==QOut[ QOutEnumerator(patchIndex, volumeIndex,unknown) ],
        dt, unknown, volumeIndex,
        QOutEnumerator(patchIndex, volumeIndex,unknown)
      );
    #endif
  }

  for (int unknown=QInEnumerator._unknowns; unknown<QInEnumerator._unknowns+QInEnumerator._numberOfAuxiliaryVariables; unknown++) {
    QOut[ QOutEnumerator(patchIndex,volumeIndex,unknown) ] = QIn[QInEnumerator(patchIndex,volumeIndex,unknown)];

    #if !defined(GPUOffloadingOMP) and  !defined(GPUOffloadingSYCL)
      assertion4(
        QOut[ QOutEnumerator(patchIndex, volumeIndex,unknown) ]==QOut[ QOutEnumerator(patchIndex, volumeIndex,unknown) ],
        dt, unknown, volumeIndex,
        QOutEnumerator(patchIndex, volumeIndex,unknown)
      );
    #endif
  }
}
