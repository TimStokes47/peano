    QMaxEigenvalueEnumeratorType                 QMaxEigenvalueEnumerator
) {
    QMaxEigenvalue[ QMaxEigenvalueEnumerator(patchIndex,volumeIndex,0) ] =
      maxEigenvalue(
        QIn + QInEnumerator(patchIndex,volumeIndex,0),
        ::exahype2::fv::getVolumeCentre( patchCentre, patchSize, QInEnumerator._numberOfVolumesPerAxisInPatch, volumeIndex ),
        ::exahype2::fv::getVolumeSize( patchSize, QInEnumerator._numberOfVolumesPerAxisInPatch ),
        t,
        dt,
        normal
      );
}


