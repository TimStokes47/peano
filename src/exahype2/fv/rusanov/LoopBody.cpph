#include "tarch/compiler/CompilerSpecificSettings.h"



template <class QInEnumeratorType, class QOutEnumeratorType>
void exahype2::fv::rusanov::internal::copy_solution_loop_body(
    const double* __restrict__                QIn,
    QInEnumeratorType                         QInEnumerator,
    int                                       patchIndex,
    const tarch::la::Vector<Dimensions,int>&  volumeIndex,
    int                                       unknown,
    double* __restrict__                      QOut,
    QOutEnumeratorType                        QOutEnumerator
  ) {
    QOut[ QOutEnumerator(patchIndex,volumeIndex,unknown) ] = QIn[QInEnumerator(patchIndex,volumeIndex,unknown)];
  }


template <class QInEnumeratorType, class QOutEnumeratorType>
void exahype2::fv::rusanov::internal::copy_solution_and_add_source_term_loop_body(
    const double* __restrict__                QIn,
    QInEnumeratorType                         QInEnumerator,
    exahype2::fv::rusanov::Source             source,
    const tarch::la::Vector<Dimensions,double>&  patchCentre,
    const tarch::la::Vector<Dimensions,double>&  patchSize,
    int                                       patchIndex,
    const tarch::la::Vector<Dimensions,int>&  volumeIndex,
    double                                    t,
    double                                    dt,
    double* __restrict__                      QOut,
    QOutEnumeratorType                        QOutEnumerator
  ) {
    double QInGathered[QInEnumerator._unknowns+QInEnumerator._numberOfAuxiliaryVariables];
    double QSourceGathered[QInEnumerator._unknowns];

    // gather
    #if defined(SharedOMP)
    #pragma omp simd
    #endif
    for (int unknown=0; unknown<QInEnumerator._unknowns+QInEnumerator._numberOfAuxiliaryVariables; unknown++) {
      QInGathered[unknown] = QIn[ QInEnumerator(patchIndex,volumeIndex,unknown) ];
    }

    source(
      QInGathered,
      ::exahype2::fv::getVolumeCentre( patchCentre, patchSize, QInEnumerator._numberOfVolumesPerAxisInPatch, volumeIndex ),
      ::exahype2::fv::getVolumeSize( patchSize, QInEnumerator._numberOfVolumesPerAxisInPatch ),
      t,
      dt,
      QSourceGathered
    );

    // scatter
    #if defined(SharedOMP)
    #pragma omp simd
    #endif
    for (int unknown=0; unknown<QInEnumerator._unknowns; unknown++) {
      QOut[ QOutEnumerator(patchIndex,volumeIndex,unknown) ] = QIn[QInEnumerator(patchIndex,volumeIndex,unknown)]
                                                             + dt * QSourceGathered[unknown];
    }
    #if defined(SharedOMP)
    #pragma omp simd
    #endif
    for (int unknown=QInEnumerator._unknowns; unknown<QInEnumerator._unknowns+QInEnumerator._numberOfAuxiliaryVariables; unknown++) {
      QOut[ QOutEnumerator(patchIndex,volumeIndex,unknown) ] = QIn[QInEnumerator(patchIndex,volumeIndex,unknown)];
    }
  }


template <>
void exahype2::fv::rusanov::internal::copy_solution_and_add_source_term_loop_body(
    const double* __restrict__                QIn,
    exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator QInEnumerator,
    exahype2::fv::rusanov::Source             source,
    const tarch::la::Vector<Dimensions,double>&  patchCentre,
    const tarch::la::Vector<Dimensions,double>&  patchSize,
    int                                       patchIndex,
    const tarch::la::Vector<Dimensions,int>&  volumeIndex,
    double                                    t,
    double                                    dt,
    double* __restrict__                      QOut,
    exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator QOutEnumerator
  ) {
    double QSourceGathered[QInEnumerator._unknowns];

    source(
      QIn + QInEnumerator(patchIndex,volumeIndex,0),
      ::exahype2::fv::getVolumeCentre( patchCentre, patchSize, QInEnumerator._numberOfVolumesPerAxisInPatch, volumeIndex ),
      ::exahype2::fv::getVolumeSize( patchSize, QInEnumerator._numberOfVolumesPerAxisInPatch ),
      t,
      dt,
      QSourceGathered
    );

    // scatter
#if defined(SharedOMP)
#pragma omp simd
#endif
    for (int unknown=0; unknown<QInEnumerator._unknowns; unknown++) {
      QOut[ QOutEnumerator(patchIndex,volumeIndex,unknown) ] = QIn[QInEnumerator(patchIndex,volumeIndex,unknown)]
                                                             + dt * QSourceGathered[unknown];
    }
#if defined(SharedOMP)
#pragma omp simd
#endif
    for (int unknown=QInEnumerator._unknowns; unknown<QInEnumerator._unknowns+QInEnumerator._numberOfAuxiliaryVariables; unknown++) {
      QOut[ QOutEnumerator(patchIndex,volumeIndex,unknown) ] = QIn[QInEnumerator(patchIndex,volumeIndex,unknown)];
    }
}


template <typename Solver, class QInEnumeratorType, class QOutEnumeratorType>
