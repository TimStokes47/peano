#include "Rusanov.h"
#include "otter/otter.h"


namespace {
  /**
   * A lot of the loop routines expect a voxel (or face) index which is
   * a vector over integers. Syntactically, I can just hand over
   *
   * <pre>
     volumeIndex2d(x,y)
     </pre>
   *
   * Peano's vector class then provides the right constructor to convert
   * this into a vector object. However, this constructor has to rely on
   * a while loop that iterates over the arguments. A while loop in return
   * cannot vectorise or be inlined/unrolled. So I need this helper routine
   * which is way less elegant, yet knows how often the underlying while
   * loop is to be unrolled.
   */
  tarch::la::Vector<Dimensions,int> volumeIndex2d( int x, int y ) {
    tarch::la::Vector<Dimensions,int> result;
    result(0) = x;
    result(1) = y;
    return result;
  }

  tarch::la::Vector<Dimensions,int> volumeIndex3d( int x, int y, int z ) {
    tarch::la::Vector<Dimensions,int> result;
    result(0) = x;
    result(1) = y;
    result(2) = z;
    return result;
  }
}


void exahype2::fv::rusanov::timeStepWithRusanov_overlap1_sequential_AoS(
  PatchData&              patchData,
  int                     numberOfVolumesPerAxisInPatch,
  int                     unknowns,
  int                     auxiliaryVariables,
  bool                    evaluateFlux,
  bool                    evaluateNonconservativeProduct,
  bool                    evaluateSource,
  bool                    evaluateMaximumEigenvalueAfterTimeStep,
  Flux                    flux,
  NonconservativeProduct  nonconservativeProduct,
  Source                  source,
  MaxEigenvalue           maxEigenvalue
) {
  static tarch::logging::Log _log( "exahype2::fv::rusanov" );
  constexpr int haloSize        = 1;

  const int faceDoFs        = exahype2::fv::getTotalNumberOfFaceDoFs(        patchData.numberOfPatches, numberOfVolumesPerAxisInPatch, haloSize );
  const int volumeDoFs      = exahype2::fv::getTotalNumberOfVolumeDoFs(      patchData.numberOfPatches, numberOfVolumesPerAxisInPatch, haloSize );
  const int innerVolumeDoFs = exahype2::fv::getTotalNumberOfInnerVolumeDoFs( patchData.numberOfPatches, numberOfVolumesPerAxisInPatch, haloSize );

  double* tempFluxX                  = evaluateFlux                     ? tarch::allocateMemory( volumeDoFs * unknowns,      tarch::MemoryLocation::Heap ) : nullptr;
  double* tempFluxY                  = evaluateFlux                     ? tarch::allocateMemory( volumeDoFs * unknowns,      tarch::MemoryLocation::Heap ) : nullptr;
  double* tempFluxZ                  = (evaluateFlux and Dimensions==3) ? tarch::allocateMemory( volumeDoFs * unknowns,      tarch::MemoryLocation::Heap ) : nullptr;
  double* tempNonconservativeProductX = evaluateNonconservativeProduct                     ? tarch::allocateMemory( faceDoFs,        tarch::MemoryLocation::Heap ) : nullptr;
  double* tempNonconservativeProductY = evaluateNonconservativeProduct                     ? tarch::allocateMemory( faceDoFs,        tarch::MemoryLocation::Heap ) : nullptr;
  double* tempNonconservativeProductZ = (evaluateNonconservativeProduct and Dimensions==3) ? tarch::allocateMemory( faceDoFs,        tarch::MemoryLocation::Heap ) : nullptr;
  double* tempEigenvalueX            =                                    tarch::allocateMemory( volumeDoFs,      tarch::MemoryLocation::Heap );
  double* tempEigenvalueY            =                                    tarch::allocateMemory( volumeDoFs,      tarch::MemoryLocation::Heap );
  double* tempEigenvalueZ            = (Dimensions==3)                  ? tarch::allocateMemory( volumeDoFs,      tarch::MemoryLocation::Heap ) : nullptr;

  exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator QInEnumerator       (                        1, numberOfVolumesPerAxisInPatch,haloSize,unknowns,auxiliaryVariables);
  exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator QOutEnumerator      (                        1, numberOfVolumesPerAxisInPatch,       0,unknowns,auxiliaryVariables);
  exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator fluxEnumerator      (patchData.numberOfPatches, numberOfVolumesPerAxisInPatch,haloSize,unknowns,0);
  exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator ncpEnumerator       (patchData.numberOfPatches, numberOfVolumesPerAxisInPatch,haloSize,unknowns,0);
  exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator eigenvalueEnumerator(patchData.numberOfPatches, numberOfVolumesPerAxisInPatch,haloSize,1,0);

  for (int patchIndex=0; patchIndex<patchData.numberOfPatches; patchIndex++) {
    logDebug( "timeStepWithRusanov_overlap1_sequential_AoS(...)", "evaluate source terms and/or copy solution over" );
    if (Dimensions==2 and evaluateSource) {
      otterLoopBegin();
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++) {
        otterLoopIterationBegin();
        internal::copy_solution_and_add_source_term_loop_body(
          patchData.QIn[patchIndex],
          QInEnumerator,
          source,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          patchData.QOut[patchIndex],
          QOutEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();
    }
    else if (Dimensions==3 and evaluateSource) {
      otterLoopBegin();
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++) {
        otterLoopIterationBegin();
        internal::copy_solution_and_add_source_term_loop_body(
          patchData.QIn[patchIndex],
          QInEnumerator,
          source,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          patchData.QOut[patchIndex],
          QOutEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();
    }
    else if (Dimensions==2) {
      otterLoopBegin();
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int unknown=0; unknown<unknowns+auxiliaryVariables; unknown++) {
        otterLoopIterationBegin();
        internal::copy_solution_loop_body(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchIndex,
          volumeIndex2d(x,y),
          unknown,
          patchData.QOut[patchIndex],
          QOutEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();
    }
    else {
      otterLoopBegin();
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int unknown=0; unknown<unknowns+auxiliaryVariables; unknown++) {
        otterLoopIterationBegin();
        internal::copy_solution_loop_body(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchIndex,
          volumeIndex3d(x,y,z),
          unknown,
          patchData.QOut[patchIndex],
          QOutEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();
    }


    logDebug( "timeStepWithRusanov_overlap1_sequential_AoS(...)", "evaluate directional eigenvalues per volume" );
    if (Dimensions==2) {
      otterLoopBegin();
      for (int x = -haloSize; x < numberOfVolumesPerAxisInPatch+haloSize; x++)
      for (int y = -haloSize; y < numberOfVolumesPerAxisInPatch+haloSize; y++) {
        otterLoopIterationBegin();
        bool isDiagonalCell = false;
        isDiagonalCell |= (x==-haloSize and y==-haloSize);
        isDiagonalCell |= (x==-haloSize and y==numberOfVolumesPerAxisInPatch+haloSize-1);
        isDiagonalCell |= (x==numberOfVolumesPerAxisInPatch+haloSize-1 and y==-haloSize);
        isDiagonalCell |= (x==numberOfVolumesPerAxisInPatch+haloSize-1 and y==numberOfVolumesPerAxisInPatch+haloSize-1);
        if ( not isDiagonalCell ) {
          internal::compute_max_eigenvalue_loop_body(
            patchData.QIn[patchIndex],
            QInEnumerator,
            maxEigenvalue,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            patchData.t[patchIndex], patchData.dt[patchIndex],
            0,
            tempEigenvalueX,
            eigenvalueEnumerator
          );

          internal::compute_max_eigenvalue_loop_body(
            patchData.QIn[patchIndex],
            QInEnumerator,
            maxEigenvalue,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            patchData.t[patchIndex], patchData.dt[patchIndex],
            1,
            tempEigenvalueY,
            eigenvalueEnumerator
          );
        }
        otterLoopIterationEnd();
      }
      otterLoopEnd();


      otterLoopBegin();
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int unknown = 0; unknown < unknowns; unknown++)
      for (int d = 0; d < 2; d++) {
        otterLoopIterationBegin();
        internal::update_solution_with_eigenvalue_damping(
          patchData.QIn[patchIndex],
          QInEnumerator,
          tempEigenvalueX,
          tempEigenvalueY,
          tempEigenvalueZ,
          eigenvalueEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          unknown, d,
          patchData.dt[patchIndex],
          patchData.QOut[patchIndex],
          QOutEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();
    }
    else {
      otterLoopBegin();
      for (int x = -haloSize; x < numberOfVolumesPerAxisInPatch+haloSize; x++)
      for (int y = -haloSize; y < numberOfVolumesPerAxisInPatch+haloSize; y++)
      for (int z = -haloSize; z < numberOfVolumesPerAxisInPatch+haloSize; z++) {
        otterLoopIterationBegin();
        bool isDiagonalCell = false;
        isDiagonalCell |= (x==-haloSize and y==-haloSize);
        isDiagonalCell |= (x==-haloSize and z==-haloSize);
        isDiagonalCell |= (y==-haloSize and z==-haloSize);
        isDiagonalCell |= (x==-haloSize and y==numberOfVolumesPerAxisInPatch+haloSize-1);
        isDiagonalCell |= (x==-haloSize and z==numberOfVolumesPerAxisInPatch+haloSize-1);
        isDiagonalCell |= (y==-haloSize and z==numberOfVolumesPerAxisInPatch+haloSize-1);
        isDiagonalCell |= (x==numberOfVolumesPerAxisInPatch+haloSize-1 and y==-haloSize);
        isDiagonalCell |= (x==numberOfVolumesPerAxisInPatch+haloSize-1 and z==-haloSize);
        isDiagonalCell |= (y==numberOfVolumesPerAxisInPatch+haloSize-1 and z==-haloSize);
        isDiagonalCell |= (x==numberOfVolumesPerAxisInPatch+haloSize-1 and y==numberOfVolumesPerAxisInPatch+haloSize-1);
        isDiagonalCell |= (x==numberOfVolumesPerAxisInPatch+haloSize-1 and z==numberOfVolumesPerAxisInPatch+haloSize-1);
        isDiagonalCell |= (y==numberOfVolumesPerAxisInPatch+haloSize-1 and z==numberOfVolumesPerAxisInPatch+haloSize-1);
        if ( not isDiagonalCell ) {
            internal::compute_max_eigenvalue_loop_body(
              patchData.QIn[patchIndex],
              QInEnumerator,
              maxEigenvalue,
              patchData.patchCentre[patchIndex],
              patchData.patchSize[patchIndex],
              patchIndex,
              volumeIndex3d(x,y,z),
              patchData.t[patchIndex], patchData.dt[patchIndex],
              0,
              tempEigenvalueX,
              eigenvalueEnumerator
            );

            internal::compute_max_eigenvalue_loop_body(
              patchData.QIn[patchIndex],
              QInEnumerator,
              maxEigenvalue,
              patchData.patchCentre[patchIndex],
              patchData.patchSize[patchIndex],
              patchIndex,
              volumeIndex3d(x,y,z),
              patchData.t[patchIndex], patchData.dt[patchIndex],
              1,
              tempEigenvalueY,
              eigenvalueEnumerator
            );

            internal::compute_max_eigenvalue_loop_body(
              patchData.QIn[patchIndex],
              QInEnumerator,
              maxEigenvalue,
              patchData.patchCentre[patchIndex],
              patchData.patchSize[patchIndex],
              patchIndex,
              volumeIndex3d(x,y,z),
              patchData.t[patchIndex], patchData.dt[patchIndex],
              2,
              tempEigenvalueY,
              eigenvalueEnumerator
            );
        }
        otterLoopIterationEnd();
      }
      otterLoopEnd();


      otterLoopBegin();
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int unknown = 0; unknown < unknowns; unknown++)
      for (int d = 0; d < 3; d++) {
        otterLoopIterationBegin();
        internal::update_solution_with_eigenvalue_damping(
          patchData.QIn[patchIndex],
          QInEnumerator,
          tempEigenvalueX,
          tempEigenvalueY,
          tempEigenvalueZ,
          eigenvalueEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          unknown, d,
          patchData.dt[patchIndex],
          patchData.QOut[patchIndex],
          QOutEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();
    }

    if (evaluateFlux and Dimensions==2) {
      logDebug( "timeStepWithRusanov_overlap1_sequential_AoS(...)", "evaluate flux in x-direction" );
      otterLoopBegin();
      for (int x = -haloSize; x < numberOfVolumesPerAxisInPatch+haloSize; x++)
      for (int y =         0; y < numberOfVolumesPerAxisInPatch;          y++) {
        otterLoopIterationBegin();
        internal::compute_flux_loop_body(
          patchData.QIn[patchIndex],
          QInEnumerator,
          flux,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          0, // normal
          tempFluxX,
          fluxEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();

      otterLoopBegin();
      for (int x =         0; x < numberOfVolumesPerAxisInPatch;           x++)
      for (int y = -haloSize; y < numberOfVolumesPerAxisInPatch+haloSize;  y++) {
        otterLoopIterationBegin();
        internal::compute_flux_loop_body(
          patchData.QIn[patchIndex],
          QInEnumerator,
          flux,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          1, // normal
          tempFluxY,
          fluxEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();

      otterLoopBegin();
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int unknown=0; unknown<unknowns+auxiliaryVariables; unknown++)
      for (int d=0; d<2; d++) {
        otterLoopIterationBegin();
        internal::update_solution_with_flux_loop_body(
          tempFluxX, tempFluxY, tempFluxZ,
          fluxEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          unknown, d,
          patchData.dt[patchIndex],
          *(patchData.QOut + patchIndex),
          QOutEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();
    }
    else if (evaluateFlux and Dimensions==3) {
      otterLoopBegin();
      for (int x = -haloSize; x < numberOfVolumesPerAxisInPatch+haloSize; x++)
      for (int y =         0; y < numberOfVolumesPerAxisInPatch;          y++)
      for (int z =         0; z < numberOfVolumesPerAxisInPatch;          z++) {
        otterLoopIterationBegin();
        internal::compute_flux_loop_body(
          patchData.QIn[patchIndex],
          QInEnumerator,
          flux,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          0, // normal
          tempFluxX,
          fluxEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();

      otterLoopBegin();
      for (int x =         0; x < numberOfVolumesPerAxisInPatch;           x++)
      for (int y = -haloSize; y < numberOfVolumesPerAxisInPatch+haloSize;  y++)
      for (int z =         0; z < numberOfVolumesPerAxisInPatch;           z++) {
        otterLoopIterationBegin();
        internal::compute_flux_loop_body(
          patchData.QIn[patchIndex],
          QInEnumerator,
          flux,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          1, // normal
          tempFluxY,
          fluxEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();

      otterLoopBegin();
      for (int x =         0; x < numberOfVolumesPerAxisInPatch;           x++)
      for (int y =         0; y < numberOfVolumesPerAxisInPatch;           y++)
      for (int z = -haloSize; z < numberOfVolumesPerAxisInPatch+haloSize;  z++) {
        otterLoopIterationBegin();
        internal::compute_flux_loop_body(
          patchData.QIn[patchIndex],
          QInEnumerator,
          flux,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          2, // normal
          tempFluxZ,
          fluxEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();

      otterLoopBegin();
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int unknown=0; unknown<unknowns+auxiliaryVariables; unknown++)
      for (int d=0; d<3; d++) {
        otterLoopIterationBegin();
        internal::update_solution_with_flux_loop_body(
          tempFluxX, tempFluxY, tempFluxZ,
          fluxEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          unknown, d,
          patchData.dt[patchIndex],
          *(patchData.QOut + patchIndex),
          QOutEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();
    }


    if (evaluateNonconservativeProduct and Dimensions==2) {
      otterLoopBegin();
      for (int x = -haloSize; x < numberOfVolumesPerAxisInPatch+haloSize-1; x++)
      for (int y =         0; y < numberOfVolumesPerAxisInPatch;            y++) {
        otterLoopIterationBegin();
        internal::compute_nonconservative_flux_loop_body(
          patchData.QIn[patchIndex],
          QInEnumerator,
          nonconservativeProduct,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          0, // normal
          tempNonconservativeProductX,
          ncpEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();

      otterLoopBegin();
      for (int x =         0; x < numberOfVolumesPerAxisInPatch;            x++)
      for (int y = -haloSize; y < numberOfVolumesPerAxisInPatch+haloSize-1; y++) {
        otterLoopIterationBegin();
        internal::compute_nonconservative_flux_loop_body(
          patchData.QIn[patchIndex],
          QInEnumerator,
          nonconservativeProduct,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          1, // normal
          tempNonconservativeProductY,
          ncpEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();

      otterLoopBegin();
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int unknown=0; unknown<unknowns+auxiliaryVariables; unknown++)
      for (int d=0; d<2; d++) {
        otterLoopIterationBegin();
        internal::update_solution_with_nonconservative_flux_loop_body(
          tempNonconservativeProductX, tempNonconservativeProductY, tempNonconservativeProductZ,
          ncpEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          unknown, d,
          patchData.dt[patchIndex],
          *(patchData.QOut + patchIndex),
          QOutEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();
    }
    else if (evaluateNonconservativeProduct and Dimensions==3) {
        otterLoopBegin();
        for (int x = -haloSize; x < numberOfVolumesPerAxisInPatch+haloSize-1; x++)
        for (int y =         0; y < numberOfVolumesPerAxisInPatch;            y++)
        for (int z =         0; z < numberOfVolumesPerAxisInPatch;            z++) {
          otterLoopIterationBegin();
          internal::compute_nonconservative_flux_loop_body(
            patchData.QIn[patchIndex],
            QInEnumerator,
            nonconservativeProduct,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            0, // normal
            tempNonconservativeProductX,
            ncpEnumerator
          );
          otterLoopIterationEnd();
        }
        otterLoopEnd();

        otterLoopBegin();
        for (int x =         0; x < numberOfVolumesPerAxisInPatch;            x++)
        for (int y = -haloSize; y < numberOfVolumesPerAxisInPatch+haloSize-1; y++)
        for (int z =         0; z < numberOfVolumesPerAxisInPatch;            z++) {
          otterLoopIterationBegin();
          internal::compute_nonconservative_flux_loop_body(
            patchData.QIn[patchIndex],
            QInEnumerator,
            nonconservativeProduct,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            1, // normal
            tempNonconservativeProductY,
            ncpEnumerator
          );
          otterLoopIterationEnd();
        }
        otterLoopEnd();

        otterLoopBegin();
        for (int x =         0; x < numberOfVolumesPerAxisInPatch;            x++)
        for (int y =         0; y < numberOfVolumesPerAxisInPatch;            y++)
        for (int z = -haloSize; z < numberOfVolumesPerAxisInPatch+haloSize-1; z++) {
          otterLoopIterationBegin();
          internal::compute_nonconservative_flux_loop_body(
            patchData.QIn[patchIndex],
            QInEnumerator,
            nonconservativeProduct,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            2, // normal
            tempNonconservativeProductY,
            ncpEnumerator
          );
          otterLoopIterationEnd();
        }
        otterLoopEnd();

        otterLoopBegin();
        for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
        for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
        for (int unknown=0; unknown<unknowns+auxiliaryVariables; unknown++)
        for (int d=0; d<3; d++) {
          otterLoopIterationBegin();
          internal::update_solution_with_nonconservative_flux_loop_body(
            tempNonconservativeProductX, tempNonconservativeProductY, tempNonconservativeProductZ,
            ncpEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            unknown, d,
            patchData.dt[patchIndex],
            *(patchData.QOut + patchIndex),
            QOutEnumerator
          );
          otterLoopIterationEnd();
        }
        otterLoopEnd();
    }

    if (evaluateMaximumEigenvalueAfterTimeStep and Dimensions==2) {
      logDebug( "timeStepWithRusanov_overlap1_sequential_AoS(...)", "compute maximum eigenvalue for subsequent time step" );
      double newMaxEigenvalue = 0.0;
      otterLoopBegin(); // @todo how do I clarify that this is a reduction? Do we need this info here?
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++) {
        otterLoopIterationBegin();
        newMaxEigenvalue = std::max(
          patchData.maxEigenvalue[patchIndex],
          internal::reduce_max_eigenvalue_loop_body(
            *(patchData.QOut + patchIndex),
            QOutEnumerator,
            maxEigenvalue,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            patchData.t[patchIndex],
            patchData.dt[patchIndex]
          )
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();
      patchData.maxEigenvalue[patchIndex] = newMaxEigenvalue;
    }
    else if (evaluateMaximumEigenvalueAfterTimeStep) {
      logDebug( "timeStepWithRusanov_overlap1_sequential_AoS(...)", "compute maximum eigenvalue for subsequent time step" );
      double newMaxEigenvalue = 0.0;
      otterLoopBegin(); // @todo how do I clarify that this is a reduction? Do we need this info here?
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++) {
        otterLoopIterationBegin();
        newMaxEigenvalue = std::max(
          patchData.maxEigenvalue[patchIndex],
          internal::reduce_max_eigenvalue_loop_body(
            *(patchData.QOut + patchIndex),
            QOutEnumerator,
            maxEigenvalue,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex]
          )
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();
      patchData.maxEigenvalue[patchIndex] = newMaxEigenvalue;
    }
  }

  if (tempFluxX!=nullptr)               tarch::freeMemory(tempFluxX, tarch::MemoryLocation::Heap);
  if (tempFluxY!=nullptr)               tarch::freeMemory(tempFluxY, tarch::MemoryLocation::Heap);
  if (tempFluxZ!=nullptr)               tarch::freeMemory(tempFluxZ, tarch::MemoryLocation::Heap);
  if (tempNonconservativeProductX!=nullptr) tarch::freeMemory(tempNonconservativeProductX, tarch::MemoryLocation::Heap);
  if (tempNonconservativeProductY!=nullptr) tarch::freeMemory(tempNonconservativeProductY, tarch::MemoryLocation::Heap);
  if (tempNonconservativeProductZ!=nullptr) tarch::freeMemory(tempNonconservativeProductZ, tarch::MemoryLocation::Heap);
  if (tempEigenvalueX!=nullptr)         tarch::freeMemory(tempEigenvalueX, tarch::MemoryLocation::Heap);
  if (tempEigenvalueY!=nullptr)         tarch::freeMemory(tempEigenvalueY, tarch::MemoryLocation::Heap);
  if (tempEigenvalueZ!=nullptr)         tarch::freeMemory(tempEigenvalueZ, tarch::MemoryLocation::Heap);
}


void exahype2::fv::rusanov::timeStepWithRusanov_overlap1_batched_AoS(
  PatchData&              patchData,
  int                     numberOfVolumesPerAxisInPatch,
  int                     unknowns,
  int                     auxiliaryVariables,
  bool                    evaluateFlux,
  bool                    evaluateNonconservativeProduct,
  bool                    evaluateSource,
  bool                    evaluateMaximumEigenvalueAfterTimeStep,
  Flux                    flux,
  NonconservativeProduct  nonconservativeProduct,
  Source                  source,
  MaxEigenvalue           maxEigenvalue
) {
  static tarch::logging::Log _log( "exahype2::fv::rusanov" );
  constexpr int haloSize        = 1;

  const int faceDoFs        = exahype2::fv::getTotalNumberOfFaceDoFs(        patchData.numberOfPatches, numberOfVolumesPerAxisInPatch, haloSize );
  const int volumeDoFs      = exahype2::fv::getTotalNumberOfVolumeDoFs(      patchData.numberOfPatches, numberOfVolumesPerAxisInPatch, haloSize );
  const int innerVolumeDoFs = exahype2::fv::getTotalNumberOfInnerVolumeDoFs( patchData.numberOfPatches, numberOfVolumesPerAxisInPatch, haloSize );

  double* tempFluxX                  = evaluateFlux                     ? tarch::allocateMemory( volumeDoFs * unknowns,      tarch::MemoryLocation::Heap ) : nullptr;
  double* tempFluxY                  = evaluateFlux                     ? tarch::allocateMemory( volumeDoFs * unknowns,      tarch::MemoryLocation::Heap ) : nullptr;
  double* tempFluxZ                  = (evaluateFlux and Dimensions==3) ? tarch::allocateMemory( volumeDoFs * unknowns,      tarch::MemoryLocation::Heap ) : nullptr;
  double* tempNonconservativeProductX = evaluateNonconservativeProduct                     ? tarch::allocateMemory( faceDoFs,        tarch::MemoryLocation::Heap ) : nullptr;
  double* tempNonconservativeProductY = evaluateNonconservativeProduct                     ? tarch::allocateMemory( faceDoFs,        tarch::MemoryLocation::Heap ) : nullptr;
  double* tempNonconservativeProductZ = (evaluateNonconservativeProduct and Dimensions==3) ? tarch::allocateMemory( faceDoFs,        tarch::MemoryLocation::Heap ) : nullptr;
  double* tempEigenvalueX            =                                    tarch::allocateMemory( volumeDoFs,      tarch::MemoryLocation::Heap );
  double* tempEigenvalueY            =                                    tarch::allocateMemory( volumeDoFs,      tarch::MemoryLocation::Heap );
  double* tempEigenvalueZ            = (Dimensions==3)                  ? tarch::allocateMemory( volumeDoFs,      tarch::MemoryLocation::Heap ) : nullptr;

  exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator QInEnumerator       (                        1, numberOfVolumesPerAxisInPatch,haloSize,unknowns,auxiliaryVariables);
  exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator QOutEnumerator      (                        1, numberOfVolumesPerAxisInPatch,       0,unknowns,auxiliaryVariables);
  exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator fluxEnumerator      (patchData.numberOfPatches, numberOfVolumesPerAxisInPatch,haloSize,unknowns,0);
  exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator ncpEnumerator       (patchData.numberOfPatches, numberOfVolumesPerAxisInPatch,haloSize,unknowns,0);
  exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator eigenvalueEnumerator(patchData.numberOfPatches, numberOfVolumesPerAxisInPatch,haloSize,1,0);

  logDebug( "timeStepWithRusanov_overlap1_sequential_AoS(...)", "evaluate source terms and/or copy solution over" );
  if (Dimensions==2 and evaluateSource) {
    otterLoopBegin();
    for (int patchIndex=0; patchIndex<patchData.numberOfPatches; patchIndex++)
    for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
    for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++) {
      otterLoopIterationBegin();
      internal::copy_solution_and_add_source_term_loop_body(
        patchData.QIn[patchIndex],
        QInEnumerator,
        source,
        patchData.patchCentre[patchIndex],
        patchData.patchSize[patchIndex],
        patchIndex,
        volumeIndex2d(x,y),
        patchData.t[patchIndex],
        patchData.dt[patchIndex],
        patchData.QOut[patchIndex],
        QOutEnumerator
      );
      otterLoopIterationEnd();
    }
    otterLoopEnd();
  }
  else if (Dimensions==3 and evaluateSource) {
    otterLoopBegin();
    for (int patchIndex=0; patchIndex<patchData.numberOfPatches; patchIndex++)
    for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
    for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
    for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++) {
      otterLoopIterationBegin();
      internal::copy_solution_and_add_source_term_loop_body(
        patchData.QIn[patchIndex],
        QInEnumerator,
        source,
        patchData.patchCentre[patchIndex],
        patchData.patchSize[patchIndex],
        patchIndex,
        volumeIndex3d(x,y,z),
        patchData.t[patchIndex],
        patchData.dt[patchIndex],
        patchData.QOut[patchIndex],
        QOutEnumerator
      );
      otterLoopIterationEnd();
    }
    otterLoopEnd();
  }
  else if (Dimensions==2) {
    otterLoopBegin();
    for (int patchIndex=0; patchIndex<patchData.numberOfPatches; patchIndex++)
    for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
    for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
    for (int unknown=0; unknown<unknowns+auxiliaryVariables; unknown++) {
      otterLoopIterationBegin();
      internal::copy_solution_loop_body(
        patchData.QIn[patchIndex],
        QInEnumerator,
        patchIndex,
        volumeIndex2d(x,y),
        unknown,
        patchData.QOut[patchIndex],
        QOutEnumerator
      );
      otterLoopIterationEnd();
    }
    otterLoopEnd();
  }
  else {
    otterLoopBegin();
    for (int patchIndex=0; patchIndex<patchData.numberOfPatches; patchIndex++)
    for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
    for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
    for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
    for (int unknown=0; unknown<unknowns+auxiliaryVariables; unknown++) {
      otterLoopIterationBegin();
      internal::copy_solution_loop_body(
        patchData.QIn[patchIndex],
        QInEnumerator,
        patchIndex,
        volumeIndex3d(x,y,z),
        unknown,
        patchData.QOut[patchIndex],
        QOutEnumerator
      );
      otterLoopIterationEnd();
    }
    otterLoopEnd();
  }


  logDebug( "timeStepWithRusanov_overlap1_sequential_AoS(...)", "evaluate directional eigenvalues per volume" );
  if (Dimensions==2) {
    otterLoopBegin();
    for (int patchIndex=0; patchIndex<patchData.numberOfPatches; patchIndex++)
    for (int x = -haloSize; x < numberOfVolumesPerAxisInPatch+haloSize; x++)
    for (int y = -haloSize; y < numberOfVolumesPerAxisInPatch+haloSize; y++) {
      otterLoopIterationBegin();
      bool isDiagonalCell = false;
      isDiagonalCell |= (x==-haloSize and y==-haloSize);
      isDiagonalCell |= (x==-haloSize and y==numberOfVolumesPerAxisInPatch+haloSize-1);
      isDiagonalCell |= (x==numberOfVolumesPerAxisInPatch+haloSize-1 and y==-haloSize);
      isDiagonalCell |= (x==numberOfVolumesPerAxisInPatch+haloSize-1 and y==numberOfVolumesPerAxisInPatch+haloSize-1);
      if ( not isDiagonalCell ) {
        internal::compute_max_eigenvalue_loop_body(
          patchData.QIn[patchIndex],
          QInEnumerator,
          maxEigenvalue,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          patchData.t[patchIndex], patchData.dt[patchIndex],
          0,
          tempEigenvalueX,
          eigenvalueEnumerator
        );

        internal::compute_max_eigenvalue_loop_body(
          patchData.QIn[patchIndex],
          QInEnumerator,
          maxEigenvalue,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          patchData.t[patchIndex], patchData.dt[patchIndex],
          1,
          tempEigenvalueY,
          eigenvalueEnumerator
        );
      }
      otterLoopIterationEnd();
    }
    otterLoopEnd();


    otterLoopBegin();
    for (int patchIndex=0; patchIndex<patchData.numberOfPatches; patchIndex++)
    for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
    for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
    for (int unknown = 0; unknown < unknowns; unknown++)
    for (int d=0; d<2; d++) {
      otterLoopIterationBegin();
      internal::update_solution_with_eigenvalue_damping(
        patchData.QIn[patchIndex],
        QInEnumerator,
        tempEigenvalueX,
        tempEigenvalueY,
        tempEigenvalueZ,
        eigenvalueEnumerator,
        patchData.patchCentre[patchIndex],
        patchData.patchSize[patchIndex],
        patchIndex,
        volumeIndex2d(x,y),
        unknown, d,
        patchData.dt[patchIndex],
        patchData.QOut[patchIndex],
        QOutEnumerator
      );
      otterLoopIterationEnd();
    }
    otterLoopEnd();
  }
  else {
    otterLoopBegin();
    for (int patchIndex=0; patchIndex<patchData.numberOfPatches; patchIndex++)
    for (int x = -haloSize; x < numberOfVolumesPerAxisInPatch+haloSize; x++)
    for (int y = -haloSize; y < numberOfVolumesPerAxisInPatch+haloSize; y++)
    for (int z = -haloSize; z < numberOfVolumesPerAxisInPatch+haloSize; z++) {
      otterLoopIterationBegin();
      bool isDiagonalCell = false;
      isDiagonalCell |= (x==-haloSize and y==-haloSize);
      isDiagonalCell |= (x==-haloSize and z==-haloSize);
      isDiagonalCell |= (y==-haloSize and z==-haloSize);
      isDiagonalCell |= (x==-haloSize and y==numberOfVolumesPerAxisInPatch+haloSize-1);
      isDiagonalCell |= (x==-haloSize and z==numberOfVolumesPerAxisInPatch+haloSize-1);
      isDiagonalCell |= (y==-haloSize and z==numberOfVolumesPerAxisInPatch+haloSize-1);
      isDiagonalCell |= (x==numberOfVolumesPerAxisInPatch+haloSize-1 and y==-haloSize);
      isDiagonalCell |= (x==numberOfVolumesPerAxisInPatch+haloSize-1 and z==-haloSize);
      isDiagonalCell |= (y==numberOfVolumesPerAxisInPatch+haloSize-1 and z==-haloSize);
      isDiagonalCell |= (x==numberOfVolumesPerAxisInPatch+haloSize-1 and y==numberOfVolumesPerAxisInPatch+haloSize-1);
      isDiagonalCell |= (x==numberOfVolumesPerAxisInPatch+haloSize-1 and z==numberOfVolumesPerAxisInPatch+haloSize-1);
      isDiagonalCell |= (y==numberOfVolumesPerAxisInPatch+haloSize-1 and z==numberOfVolumesPerAxisInPatch+haloSize-1);
      if ( not isDiagonalCell ) {
          internal::compute_max_eigenvalue_loop_body(
            patchData.QIn[patchIndex],
            QInEnumerator,
            maxEigenvalue,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex], patchData.dt[patchIndex],
            0,
            tempEigenvalueX,
            eigenvalueEnumerator
          );

          internal::compute_max_eigenvalue_loop_body(
            patchData.QIn[patchIndex],
            QInEnumerator,
            maxEigenvalue,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex], patchData.dt[patchIndex],
            1,
            tempEigenvalueY,
            eigenvalueEnumerator
          );

          internal::compute_max_eigenvalue_loop_body(
            patchData.QIn[patchIndex],
            QInEnumerator,
            maxEigenvalue,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex], patchData.dt[patchIndex],
            2,
            tempEigenvalueY,
            eigenvalueEnumerator
          );
      }
      otterLoopIterationEnd();
    }
    otterLoopEnd();

    otterLoopBegin();
    for (int patchIndex=0; patchIndex<patchData.numberOfPatches; patchIndex++)
    for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
    for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
    for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
    for (int unknown = 0; unknown < unknowns; unknown++)
    for (int d=0; d<3; d++) {
      otterLoopIterationBegin();
      internal::update_solution_with_eigenvalue_damping(
        patchData.QIn[patchIndex],
        QInEnumerator,
        tempEigenvalueX,
        tempEigenvalueY,
        tempEigenvalueZ,
        eigenvalueEnumerator,
        patchData.patchCentre[patchIndex],
        patchData.patchSize[patchIndex],
        patchIndex,
        volumeIndex3d(x,y,z),
        unknown, d,
        patchData.dt[patchIndex],
        patchData.QOut[patchIndex],
        QOutEnumerator
      );
      otterLoopIterationEnd();
    }
    otterLoopEnd();
  }

  if (evaluateFlux and Dimensions==2) {
    logDebug( "timeStepWithRusanov_overlap1_sequential_AoS(...)", "evaluate flux in x-direction" );
    otterLoopBegin();
    for (int patchIndex=0; patchIndex<patchData.numberOfPatches; patchIndex++)
    for (int x = -haloSize; x < numberOfVolumesPerAxisInPatch+haloSize; x++)
    for (int y =         0; y < numberOfVolumesPerAxisInPatch;          y++) {
      otterLoopIterationBegin();
      internal::compute_flux_loop_body(
        patchData.QIn[patchIndex],
        QInEnumerator,
        flux,
        patchData.patchCentre[patchIndex],
        patchData.patchSize[patchIndex],
        patchIndex,
        volumeIndex2d(x,y),
        patchData.t[patchIndex],
        patchData.dt[patchIndex],
        0, // normal
        tempFluxX,
        fluxEnumerator
      );
      otterLoopIterationEnd();
    }
    otterLoopEnd();

    otterLoopBegin();
    for (int patchIndex=0; patchIndex<patchData.numberOfPatches; patchIndex++)
    for (int x =         0; x < numberOfVolumesPerAxisInPatch;           x++)
    for (int y = -haloSize; y < numberOfVolumesPerAxisInPatch+haloSize;  y++) {
      otterLoopIterationBegin();
      internal::compute_flux_loop_body(
        patchData.QIn[patchIndex],
        QInEnumerator,
        flux,
        patchData.patchCentre[patchIndex],
        patchData.patchSize[patchIndex],
        patchIndex,
        volumeIndex2d(x,y),
        patchData.t[patchIndex],
        patchData.dt[patchIndex],
        1, // normal
        tempFluxY,
        fluxEnumerator
      );
      otterLoopIterationEnd();
    }
    otterLoopEnd();

    otterLoopBegin();
    for (int patchIndex=0; patchIndex<patchData.numberOfPatches; patchIndex++)
    for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
    for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
    for (int unknown=0; unknown<unknowns+auxiliaryVariables; unknown++)
    for (int d=0; d<2; d++){
      otterLoopIterationBegin();
      internal::update_solution_with_flux_loop_body(
        tempFluxX, tempFluxY, tempFluxZ,
        fluxEnumerator,
        patchData.patchCentre[patchIndex],
        patchData.patchSize[patchIndex],
        patchIndex,
        volumeIndex2d(x,y),
        unknown, d,
        patchData.dt[patchIndex],
        *(patchData.QOut + patchIndex),
        QOutEnumerator
      );
      otterLoopIterationEnd();
    }
    otterLoopEnd();
  }
  else if (evaluateFlux and Dimensions==3) {
    logDebug( "timeStepWithRusanov_overlap1_sequential_AoS(...)", "evaluate flux in x-direction" );
    otterLoopBegin();
    for (int patchIndex=0; patchIndex<patchData.numberOfPatches; patchIndex++)
    for (int x = -haloSize; x < numberOfVolumesPerAxisInPatch+haloSize; x++)
    for (int y =         0; y < numberOfVolumesPerAxisInPatch;          y++)
    for (int z =         0; z < numberOfVolumesPerAxisInPatch;          z++) {
      otterLoopIterationBegin();
      internal::compute_flux_loop_body(
        patchData.QIn[patchIndex],
        QInEnumerator,
        flux,
        patchData.patchCentre[patchIndex],
        patchData.patchSize[patchIndex],
        patchIndex,
        volumeIndex3d(x,y,z),
        patchData.t[patchIndex],
        patchData.dt[patchIndex],
        0, // normal
        tempFluxX,
        fluxEnumerator
      );
      otterLoopIterationEnd();
    }
    otterLoopEnd();

    otterLoopBegin();
    for (int patchIndex=0; patchIndex<patchData.numberOfPatches; patchIndex++)
    for (int x =         0; x < numberOfVolumesPerAxisInPatch;           x++)
    for (int y = -haloSize; y < numberOfVolumesPerAxisInPatch+haloSize;  y++)
    for (int z =         0; z < numberOfVolumesPerAxisInPatch;           z++) {
      otterLoopIterationBegin();
      internal::compute_flux_loop_body(
        patchData.QIn[patchIndex],
        QInEnumerator,
        flux,
        patchData.patchCentre[patchIndex],
        patchData.patchSize[patchIndex],
        patchIndex,
        volumeIndex3d(x,y,z),
        patchData.t[patchIndex],
        patchData.dt[patchIndex],
        1, // normal
        tempFluxY,
        fluxEnumerator
      );
      otterLoopIterationEnd();
    }
    otterLoopEnd();

    otterLoopBegin();
    for (int patchIndex=0; patchIndex<patchData.numberOfPatches; patchIndex++)
    for (int x =         0; x < numberOfVolumesPerAxisInPatch;           x++)
    for (int y =         0; y < numberOfVolumesPerAxisInPatch;           y++)
    for (int z = -haloSize; z < numberOfVolumesPerAxisInPatch+haloSize;  z++) {
      otterLoopIterationBegin();
      internal::compute_flux_loop_body(
        patchData.QIn[patchIndex],
        QInEnumerator,
        flux,
        patchData.patchCentre[patchIndex],
        patchData.patchSize[patchIndex],
        patchIndex,
        volumeIndex3d(x,y,z),
        patchData.t[patchIndex],
        patchData.dt[patchIndex],
        2, // normal
        tempFluxZ,
        fluxEnumerator
      );
      otterLoopIterationEnd();
    }
    otterLoopEnd();

    otterLoopBegin();
    for (int patchIndex=0; patchIndex<patchData.numberOfPatches; patchIndex++)
    for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
    for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
    for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
    for (int unknown=0; unknown<unknowns+auxiliaryVariables; unknown++)
    for (int d=0; d<3; d++) {
      otterLoopIterationBegin();
      internal::update_solution_with_flux_loop_body(
        tempFluxX, tempFluxY, tempFluxZ,
        fluxEnumerator,
        patchData.patchCentre[patchIndex],
        patchData.patchSize[patchIndex],
        patchIndex,
        volumeIndex3d(x,y,z),
        unknown, d,
        patchData.dt[patchIndex],
        *(patchData.QOut + patchIndex),
        QOutEnumerator
      );
      otterLoopIterationEnd();
    }
    otterLoopEnd();
  }

  if (evaluateNonconservativeProduct and Dimensions==2) {
    otterLoopBegin();
    for (int patchIndex=0; patchIndex<patchData.numberOfPatches; patchIndex++)
    for (int x = -haloSize; x < numberOfVolumesPerAxisInPatch+haloSize-1; x++)
    for (int y =         0; y < numberOfVolumesPerAxisInPatch;            y++) {
      otterLoopIterationBegin();
      internal::compute_nonconservative_flux_loop_body(
        patchData.QIn[patchIndex],
        QInEnumerator,
        nonconservativeProduct,
        patchData.patchCentre[patchIndex],
        patchData.patchSize[patchIndex],
        patchIndex,
        volumeIndex2d(x,y),
        patchData.t[patchIndex],
        patchData.dt[patchIndex],
        0, // normal
        tempNonconservativeProductX,
        ncpEnumerator
      );
      otterLoopIterationEnd();
    }
    otterLoopEnd();

    otterLoopBegin();
    for (int patchIndex=0; patchIndex<patchData.numberOfPatches; patchIndex++)
    for (int x =         0; x < numberOfVolumesPerAxisInPatch;            x++)
    for (int y = -haloSize; y < numberOfVolumesPerAxisInPatch+haloSize-1; y++) {
      otterLoopIterationBegin();
      internal::compute_nonconservative_flux_loop_body(
        patchData.QIn[patchIndex],
        QInEnumerator,
        nonconservativeProduct,
        patchData.patchCentre[patchIndex],
        patchData.patchSize[patchIndex],
        patchIndex,
        volumeIndex2d(x,y),
        patchData.t[patchIndex],
        patchData.dt[patchIndex],
        1, // normal
        tempNonconservativeProductY,
        ncpEnumerator
      );
      otterLoopIterationEnd();
    }
    otterLoopEnd();

    otterLoopBegin();
    for (int patchIndex=0; patchIndex<patchData.numberOfPatches; patchIndex++)
    for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
    for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
    for (int unknown=0; unknown<unknowns+auxiliaryVariables; unknown++)
    for (int d=0; d<2; d++)  {
      otterLoopIterationBegin();
      internal::update_solution_with_nonconservative_flux_loop_body(
        tempNonconservativeProductX, tempNonconservativeProductY, tempNonconservativeProductZ,
        ncpEnumerator,
        patchData.patchCentre[patchIndex],
        patchData.patchSize[patchIndex],
        patchIndex,
        volumeIndex2d(x,y),
        unknown, d,
        patchData.dt[patchIndex],
        *(patchData.QOut + patchIndex),
        QOutEnumerator
      );
      otterLoopIterationEnd();
    }
    otterLoopEnd();
  }
  else if (evaluateNonconservativeProduct and Dimensions==3) {
      otterLoopBegin();
      for (int patchIndex=0; patchIndex<patchData.numberOfPatches; patchIndex++)
      for (int x = -haloSize; x < numberOfVolumesPerAxisInPatch+haloSize-1; x++)
      for (int y =         0; y < numberOfVolumesPerAxisInPatch;            y++)
      for (int z =         0; z < numberOfVolumesPerAxisInPatch;            z++) {
        otterLoopIterationBegin();
        internal::compute_nonconservative_flux_loop_body(
          patchData.QIn[patchIndex],
          QInEnumerator,
          nonconservativeProduct,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          0, // normal
          tempNonconservativeProductX,
          ncpEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();

      otterLoopBegin();
      for (int patchIndex=0; patchIndex<patchData.numberOfPatches; patchIndex++)
      for (int x =         0; x < numberOfVolumesPerAxisInPatch;            x++)
      for (int y = -haloSize; y < numberOfVolumesPerAxisInPatch+haloSize-1; y++)
      for (int z =         0; z < numberOfVolumesPerAxisInPatch;            z++) {
        otterLoopIterationBegin();
        internal::compute_nonconservative_flux_loop_body(
          patchData.QIn[patchIndex],
          QInEnumerator,
          nonconservativeProduct,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          1, // normal
          tempNonconservativeProductY,
          ncpEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();

      otterLoopBegin();
      for (int patchIndex=0; patchIndex<patchData.numberOfPatches; patchIndex++)
      for (int x =         0; x < numberOfVolumesPerAxisInPatch;            x++)
      for (int y =         0; y < numberOfVolumesPerAxisInPatch;            y++)
      for (int z = -haloSize; z < numberOfVolumesPerAxisInPatch+haloSize-1; z++) {
        otterLoopIterationBegin();
        internal::compute_nonconservative_flux_loop_body(
          patchData.QIn[patchIndex],
          QInEnumerator,
          nonconservativeProduct,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          2, // normal
          tempNonconservativeProductY,
          ncpEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();

      otterLoopBegin();
      for (int patchIndex=0; patchIndex<patchData.numberOfPatches; patchIndex++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int unknown=0; unknown<unknowns+auxiliaryVariables; unknown++)
      for (int d = 0; d < 3; d++){
        otterLoopIterationBegin();
        internal::update_solution_with_nonconservative_flux_loop_body(
          tempNonconservativeProductX, tempNonconservativeProductY, tempNonconservativeProductZ,
          ncpEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          unknown, d,
          patchData.dt[patchIndex],
          *(patchData.QOut + patchIndex),
          QOutEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();
  }


  if (evaluateMaximumEigenvalueAfterTimeStep and Dimensions==2) {
    logDebug( "timeStepWithRusanov_overlap1_sequential_AoS(...)", "compute maximum eigenvalue for subsequent time step" );
    for (int patchIndex=0; patchIndex<patchData.numberOfPatches; patchIndex++) {
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++) {
        patchData.maxEigenvalue[patchIndex] = std::max(
          patchData.maxEigenvalue[patchIndex],
          internal::reduce_max_eigenvalue_loop_body(
            *(patchData.QOut + patchIndex),
            QOutEnumerator,
            maxEigenvalue,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            patchData.t[patchIndex],
            patchData.dt[patchIndex]
          )
        );
      }
      patchData.maxEigenvalue[patchIndex] = 0.0;
    }
  }
  else if (evaluateMaximumEigenvalueAfterTimeStep) {
    logDebug( "timeStepWithRusanov_overlap1_sequential_AoS(...)", "compute maximum eigenvalue for subsequent time step" );
    double newMaxEigenvalue = 0.0;
    otterLoopBegin(); // @todo mark that this is a reduction
    for (int patchIndex=0; patchIndex<patchData.numberOfPatches; patchIndex++) {
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++) {
        newMaxEigenvalue = std::max(
          patchData.maxEigenvalue[patchIndex],
          internal::reduce_max_eigenvalue_loop_body(
            *(patchData.QOut + patchIndex),
            QOutEnumerator,
            maxEigenvalue,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex]
          )
        );
      }
      patchData.maxEigenvalue[patchIndex] = newMaxEigenvalue;
    }
  }

  if (tempFluxX!=nullptr)               tarch::freeMemory(tempFluxX, tarch::MemoryLocation::Heap);
  if (tempFluxY!=nullptr)               tarch::freeMemory(tempFluxY, tarch::MemoryLocation::Heap);
  if (tempFluxZ!=nullptr)               tarch::freeMemory(tempFluxZ, tarch::MemoryLocation::Heap);
  if (tempNonconservativeProductX!=nullptr) tarch::freeMemory(tempNonconservativeProductX, tarch::MemoryLocation::Heap);
  if (tempNonconservativeProductY!=nullptr) tarch::freeMemory(tempNonconservativeProductY, tarch::MemoryLocation::Heap);
  if (tempNonconservativeProductZ!=nullptr) tarch::freeMemory(tempNonconservativeProductZ, tarch::MemoryLocation::Heap);
  if (tempEigenvalueX!=nullptr)         tarch::freeMemory(tempEigenvalueX, tarch::MemoryLocation::Heap);
  if (tempEigenvalueY!=nullptr)         tarch::freeMemory(tempEigenvalueY, tarch::MemoryLocation::Heap);
  if (tempEigenvalueZ!=nullptr)         tarch::freeMemory(tempEigenvalueZ, tarch::MemoryLocation::Heap);
}


template <typename Solver>
void exahype2::fv::rusanov::timeStepWithRusanov_overlap1_sequential_AoS(
  PatchData&              patchData,
  int                     numberOfVolumesPerAxisInPatch,
  int                     unknowns,
  int                     auxiliaryVariables,
  bool                    evaluateFlux,
  bool                    evaluateNonconservativeProduct,
  bool                    evaluateSource,
  bool                    evaluateMaximumEigenvalueAfterTimeStep
) {
  static tarch::logging::Log _log( "exahype2::fv::rusanov" );
  constexpr int haloSize        = 1;

  const int faceDoFs        = exahype2::fv::getTotalNumberOfFaceDoFs(        patchData.numberOfPatches, numberOfVolumesPerAxisInPatch, haloSize );
  const int volumeDoFs      = exahype2::fv::getTotalNumberOfVolumeDoFs(      patchData.numberOfPatches, numberOfVolumesPerAxisInPatch, haloSize );
  const int innerVolumeDoFs = exahype2::fv::getTotalNumberOfInnerVolumeDoFs( patchData.numberOfPatches, numberOfVolumesPerAxisInPatch, haloSize );

  double* tempFluxX                  = evaluateFlux                     ? tarch::allocateMemory( volumeDoFs * unknowns,      tarch::MemoryLocation::Heap ) : nullptr;
  double* tempFluxY                  = evaluateFlux                     ? tarch::allocateMemory( volumeDoFs * unknowns,      tarch::MemoryLocation::Heap ) : nullptr;
  double* tempFluxZ                  = (evaluateFlux and Dimensions==3) ? tarch::allocateMemory( volumeDoFs * unknowns,      tarch::MemoryLocation::Heap ) : nullptr;
  double* tempNonconservativeProductX = evaluateNonconservativeProduct                     ? tarch::allocateMemory( faceDoFs,        tarch::MemoryLocation::Heap ) : nullptr;
  double* tempNonconservativeProductY = evaluateNonconservativeProduct                     ? tarch::allocateMemory( faceDoFs,        tarch::MemoryLocation::Heap ) : nullptr;
  double* tempNonconservativeProductZ = (evaluateNonconservativeProduct and Dimensions==3) ? tarch::allocateMemory( faceDoFs,        tarch::MemoryLocation::Heap ) : nullptr;
  double* tempEigenvalueX            =                                    tarch::allocateMemory( volumeDoFs,      tarch::MemoryLocation::Heap );
  double* tempEigenvalueY            =                                    tarch::allocateMemory( volumeDoFs,      tarch::MemoryLocation::Heap );
  double* tempEigenvalueZ            = (Dimensions==3)                  ? tarch::allocateMemory( volumeDoFs,      tarch::MemoryLocation::Heap ) : nullptr;

  exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator QInEnumerator       (                        1, numberOfVolumesPerAxisInPatch,haloSize,unknowns,auxiliaryVariables);
  exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator QOutEnumerator      (                        1, numberOfVolumesPerAxisInPatch,       0,unknowns,auxiliaryVariables);
  exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator fluxEnumerator      (patchData.numberOfPatches, numberOfVolumesPerAxisInPatch,haloSize,unknowns,0);
  exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator ncpEnumerator       (patchData.numberOfPatches, numberOfVolumesPerAxisInPatch,haloSize,unknowns,0);
  exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator eigenvalueEnumerator(patchData.numberOfPatches, numberOfVolumesPerAxisInPatch,haloSize,1,0);

  for (int patchIndex=0; patchIndex<patchData.numberOfPatches; patchIndex++) {
    logDebug( "timeStepWithRusanov_overlap1_sequential_AoS(...)", "evaluate source terms and/or copy solution over" );
    if (Dimensions==2 and evaluateSource) {
      otterLoopBegin();
      #if defined(SharedOMP)
      #pragma omp simd collapse(2) aligned(tempFluxX,tempFluxY,tempFluxZ,tempEigenvalueX,tempEigenvalueY,tempEigenvalueZ,tempNonconservativeProductX,tempNonconservativeProductY,tempNonconservativeProductZ:Alignment)
      #endif
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++) {
        otterLoopIterationBegin();
        internal::copy_solution_and_add_source_term_loop_body<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          patchData.QOut[patchIndex],
          QOutEnumerator
        );
        otterLoopIterationEnd();
      }
    }
    else if (Dimensions==3 and evaluateSource) {
      otterLoopBegin();
      #if defined(SharedOMP)
      #pragma omp simd collapse(3) aligned(tempFluxX,tempFluxY,tempFluxZ,tempEigenvalueX,tempEigenvalueY,tempEigenvalueZ,tempNonconservativeProductX,tempNonconservativeProductY,tempNonconservativeProductZ:Alignment)
      #endif
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++) {
        otterLoopIterationBegin();
        internal::copy_solution_and_add_source_term_loop_body<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          patchData.QOut[patchIndex],
          QOutEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();
    }
    else if (Dimensions==2) {
      otterLoopBegin();
      #if defined(SharedOMP)
      #pragma omp simd collapse(3) aligned(tempFluxX,tempFluxY,tempFluxZ,tempEigenvalueX,tempEigenvalueY,tempEigenvalueZ,tempNonconservativeProductX,tempNonconservativeProductY,tempNonconservativeProductZ:Alignment)
      #endif
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int unknown=0; unknown<unknowns+auxiliaryVariables; unknown++) {
        otterLoopIterationBegin();
        internal::copy_solution_loop_body(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchIndex,
          volumeIndex2d(x,y),
          unknown,
          patchData.QOut[patchIndex],
          QOutEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();
    }
    else {
      otterLoopBegin();
      #if defined(SharedOMP)
      #pragma omp simd collapse(4) aligned(tempFluxX,tempFluxY,tempFluxZ,tempEigenvalueX,tempEigenvalueY,tempEigenvalueZ,tempNonconservativeProductX,tempNonconservativeProductY,tempNonconservativeProductZ:Alignment)
      #endif
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int unknown=0; unknown<unknowns+auxiliaryVariables; unknown++) {
        otterLoopIterationBegin();
        internal::copy_solution_loop_body(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchIndex,
          volumeIndex3d(x,y,z),
          unknown,
          patchData.QOut[patchIndex],
          QOutEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();
    }


    logDebug( "timeStepWithRusanov_overlap1_sequential_AoS(...)", "evaluate directional eigenvalues per volume" );
    if (Dimensions==2) {
      otterLoopBegin();
      #if defined(SharedOMP)
      #pragma omp simd collapse(2) aligned(tempFluxX,tempFluxY,tempFluxZ,tempEigenvalueX,tempEigenvalueY,tempEigenvalueZ,tempNonconservativeProductX,tempNonconservativeProductY,tempNonconservativeProductZ:Alignment)
      #endif
      for (int x = -haloSize; x < numberOfVolumesPerAxisInPatch+haloSize; x++)
      for (int y = -haloSize; y < numberOfVolumesPerAxisInPatch+haloSize; y++) {
        otterLoopIterationBegin();

        bool isDiagonalCell = false;
        #if PeanoDebug>0
        isDiagonalCell |= (x==-haloSize and y==-haloSize);
        isDiagonalCell |= (x==-haloSize and y==numberOfVolumesPerAxisInPatch+haloSize-1);
        isDiagonalCell |= (x==numberOfVolumesPerAxisInPatch+haloSize-1 and y==-haloSize);
        isDiagonalCell |= (x==numberOfVolumesPerAxisInPatch+haloSize-1 and y==numberOfVolumesPerAxisInPatch+haloSize-1);
        #endif

        if ( not isDiagonalCell ) {
          internal::compute_max_eigenvalue_loop_body<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            patchData.t[patchIndex], patchData.dt[patchIndex],
            0,
            tempEigenvalueX,
            eigenvalueEnumerator
          );
        }
        otterLoopIterationBegin();
      }
      otterLoopEnd();


      otterLoopBegin();
      #if defined(SharedOMP)
      #pragma omp simd collapse(2) aligned(tempFluxX,tempFluxY,tempFluxZ,tempEigenvalueX,tempEigenvalueY,tempEigenvalueZ,tempNonconservativeProductX,tempNonconservativeProductY,tempNonconservativeProductZ:Alignment)
      #endif
      for (int x = -haloSize; x < numberOfVolumesPerAxisInPatch+haloSize; x++)
      for (int y = -haloSize; y < numberOfVolumesPerAxisInPatch+haloSize; y++) {
        otterLoopIterationBegin();

        bool isDiagonalCell = false;
        #if PeanoDebug>0
        isDiagonalCell |= (x==-haloSize and y==-haloSize);
        isDiagonalCell |= (x==-haloSize and y==numberOfVolumesPerAxisInPatch+haloSize-1);
        isDiagonalCell |= (x==numberOfVolumesPerAxisInPatch+haloSize-1 and y==-haloSize);
        isDiagonalCell |= (x==numberOfVolumesPerAxisInPatch+haloSize-1 and y==numberOfVolumesPerAxisInPatch+haloSize-1);
        #endif

        if ( not isDiagonalCell ) {
          internal::compute_max_eigenvalue_loop_body<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            patchData.t[patchIndex], patchData.dt[patchIndex],
            1,
            tempEigenvalueY,
            eigenvalueEnumerator
          );
        }
        otterLoopIterationEnd();
      }
      otterLoopEnd();

      otterLoopBegin();
      for (int d = 0; d < 2; d++) {
        otterLoopIterationBegin();
        otterLoopBegin();
        #if defined(SharedOMP)
        #pragma omp simd collapse(3) aligned(tempFluxX,tempFluxY,tempFluxZ,tempEigenvalueX,tempEigenvalueY,tempEigenvalueZ,tempNonconservativeProductX,tempNonconservativeProductY,tempNonconservativeProductZ:Alignment)
        #endif
        for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
        for (int unknown = 0; unknown < unknowns; unknown++) {
          otterLoopIterationBegin();
          internal::update_solution_with_eigenvalue_damping(
            patchData.QIn[patchIndex],
            QInEnumerator,
            tempEigenvalueX,
            tempEigenvalueY,
            tempEigenvalueZ,
            eigenvalueEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            unknown,
            d,
            patchData.dt[patchIndex], // thisDt,
            patchData.QOut[patchIndex], // thisQOut,
            QOutEnumerator
          );
          otterLoopIterationEnd();
        }
        otterLoopEnd();
        otterLoopIterationEnd();
      }
      otterLoopEnd();
    }
    else {
      otterLoopBegin();
      #if defined(SharedOMP)
      #pragma omp simd collapse(3) aligned(tempFluxX,tempFluxY,tempFluxZ,tempEigenvalueX,tempEigenvalueY,tempEigenvalueZ,tempNonconservativeProductX,tempNonconservativeProductY,tempNonconservativeProductZ:Alignment)
      #endif
      for (int x = -haloSize; x < numberOfVolumesPerAxisInPatch+haloSize; x++)
      for (int y = -haloSize; y < numberOfVolumesPerAxisInPatch+haloSize; y++)
      for (int z = -haloSize; z < numberOfVolumesPerAxisInPatch+haloSize; z++) {
        otterLoopIterationBegin();

        #if PeanoDebug>0
        bool isDiagonalCell = false;
        isDiagonalCell |= (x==-haloSize and y==-haloSize);
        isDiagonalCell |= (x==-haloSize and z==-haloSize);
        isDiagonalCell |= (y==-haloSize and z==-haloSize);
        isDiagonalCell |= (x==-haloSize and y==numberOfVolumesPerAxisInPatch+haloSize-1);
        isDiagonalCell |= (x==-haloSize and z==numberOfVolumesPerAxisInPatch+haloSize-1);
        isDiagonalCell |= (y==-haloSize and z==numberOfVolumesPerAxisInPatch+haloSize-1);
        isDiagonalCell |= (x==numberOfVolumesPerAxisInPatch+haloSize-1 and y==-haloSize);
        isDiagonalCell |= (x==numberOfVolumesPerAxisInPatch+haloSize-1 and z==-haloSize);
        isDiagonalCell |= (y==numberOfVolumesPerAxisInPatch+haloSize-1 and z==-haloSize);
        isDiagonalCell |= (x==numberOfVolumesPerAxisInPatch+haloSize-1 and y==numberOfVolumesPerAxisInPatch+haloSize-1);
        isDiagonalCell |= (x==numberOfVolumesPerAxisInPatch+haloSize-1 and z==numberOfVolumesPerAxisInPatch+haloSize-1);
        isDiagonalCell |= (y==numberOfVolumesPerAxisInPatch+haloSize-1 and z==numberOfVolumesPerAxisInPatch+haloSize-1);
        #else
        bool isDiagonalCell = false;
        #endif
        if ( not isDiagonalCell ) {
            internal::compute_max_eigenvalue_loop_body<Solver>(
              patchData.QIn[patchIndex],
              QInEnumerator,
              patchData.patchCentre[patchIndex],
              patchData.patchSize[patchIndex],
              patchIndex,
              volumeIndex3d(x,y,z),
              patchData.t[patchIndex], patchData.dt[patchIndex],
              0,
              tempEigenvalueX,
              eigenvalueEnumerator
            );
        }
        otterLoopIterationEnd();
      }

      otterLoopBegin();
      #if defined(SharedOMP)
      #pragma omp simd collapse(3) aligned(tempFluxX,tempFluxY,tempFluxZ,tempEigenvalueX,tempEigenvalueY,tempEigenvalueZ,tempNonconservativeProductX,tempNonconservativeProductY,tempNonconservativeProductZ:Alignment)
      #endif
      for (int x = -haloSize; x < numberOfVolumesPerAxisInPatch+haloSize; x++)
      for (int y = -haloSize; y < numberOfVolumesPerAxisInPatch+haloSize; y++)
      for (int z = -haloSize; z < numberOfVolumesPerAxisInPatch+haloSize; z++) {
        otterLoopIterationBegin();

        #if PeanoDebug>0
          bool isDiagonalCell = false;
          isDiagonalCell |= (x==-haloSize and y==-haloSize);
          isDiagonalCell |= (x==-haloSize and z==-haloSize);
          isDiagonalCell |= (y==-haloSize and z==-haloSize);
          isDiagonalCell |= (x==-haloSize and y==numberOfVolumesPerAxisInPatch+haloSize-1);
          isDiagonalCell |= (x==-haloSize and z==numberOfVolumesPerAxisInPatch+haloSize-1);
          isDiagonalCell |= (y==-haloSize and z==numberOfVolumesPerAxisInPatch+haloSize-1);
          isDiagonalCell |= (x==numberOfVolumesPerAxisInPatch+haloSize-1 and y==-haloSize);
          isDiagonalCell |= (x==numberOfVolumesPerAxisInPatch+haloSize-1 and z==-haloSize);
          isDiagonalCell |= (y==numberOfVolumesPerAxisInPatch+haloSize-1 and z==-haloSize);
          isDiagonalCell |= (x==numberOfVolumesPerAxisInPatch+haloSize-1 and y==numberOfVolumesPerAxisInPatch+haloSize-1);
          isDiagonalCell |= (x==numberOfVolumesPerAxisInPatch+haloSize-1 and z==numberOfVolumesPerAxisInPatch+haloSize-1);
          isDiagonalCell |= (y==numberOfVolumesPerAxisInPatch+haloSize-1 and z==numberOfVolumesPerAxisInPatch+haloSize-1);
        #else
        bool isDiagonalCell = false;
        #endif
        if ( not isDiagonalCell ) {
          internal::compute_max_eigenvalue_loop_body<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex], patchData.dt[patchIndex],
            1,
            tempEigenvalueY,
            eigenvalueEnumerator
          );
        }
        otterLoopIterationEnd();
      }

      otterLoopBegin();
      #if defined(SharedOMP)
      #pragma omp simd collapse(3) aligned(tempFluxX,tempFluxY,tempFluxZ,tempEigenvalueX,tempEigenvalueY,tempEigenvalueZ,tempNonconservativeProductX,tempNonconservativeProductY,tempNonconservativeProductZ:Alignment)
      #endif
      for (int x = -haloSize; x < numberOfVolumesPerAxisInPatch+haloSize; x++)
      for (int y = -haloSize; y < numberOfVolumesPerAxisInPatch+haloSize; y++)
      for (int z = -haloSize; z < numberOfVolumesPerAxisInPatch+haloSize; z++) {
        otterLoopIterationBegin();

        #if PeanoDebug>0
          bool isDiagonalCell = false;
          isDiagonalCell |= (x==-haloSize and y==-haloSize);
          isDiagonalCell |= (x==-haloSize and z==-haloSize);
          isDiagonalCell |= (y==-haloSize and z==-haloSize);
          isDiagonalCell |= (x==-haloSize and y==numberOfVolumesPerAxisInPatch+haloSize-1);
          isDiagonalCell |= (x==-haloSize and z==numberOfVolumesPerAxisInPatch+haloSize-1);
          isDiagonalCell |= (y==-haloSize and z==numberOfVolumesPerAxisInPatch+haloSize-1);
          isDiagonalCell |= (x==numberOfVolumesPerAxisInPatch+haloSize-1 and y==-haloSize);
          isDiagonalCell |= (x==numberOfVolumesPerAxisInPatch+haloSize-1 and z==-haloSize);
          isDiagonalCell |= (y==numberOfVolumesPerAxisInPatch+haloSize-1 and z==-haloSize);
          isDiagonalCell |= (x==numberOfVolumesPerAxisInPatch+haloSize-1 and y==numberOfVolumesPerAxisInPatch+haloSize-1);
          isDiagonalCell |= (x==numberOfVolumesPerAxisInPatch+haloSize-1 and z==numberOfVolumesPerAxisInPatch+haloSize-1);
          isDiagonalCell |= (y==numberOfVolumesPerAxisInPatch+haloSize-1 and z==numberOfVolumesPerAxisInPatch+haloSize-1);
        #else
        bool isDiagonalCell = false;
        #endif
        if ( not isDiagonalCell ) {
            internal::compute_max_eigenvalue_loop_body<Solver>(
              patchData.QIn[patchIndex],
              QInEnumerator,
              patchData.patchCentre[patchIndex],
              patchData.patchSize[patchIndex],
              patchIndex,
              volumeIndex3d(x,y,z),
              patchData.t[patchIndex], patchData.dt[patchIndex],
              2,
              tempEigenvalueY,
              eigenvalueEnumerator
            );
        }
        otterLoopIterationEnd();
      }
      otterLoopEnd();


      for (int d = 0; d < 2; d++) {
        otterLoopBegin();
        #if defined(SharedOMP)
        #pragma omp simd collapse(4) aligned(tempFluxX,tempFluxY,tempFluxZ,tempEigenvalueX,tempEigenvalueY,tempEigenvalueZ,tempNonconservativeProductX,tempNonconservativeProductY,tempNonconservativeProductZ:Alignment)
        #endif
        for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
        for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
        for (int unknown = 0; unknown < unknowns; unknown++) {
          otterLoopIterationBegin();
          internal::update_solution_with_eigenvalue_damping(
            patchData.QIn[patchIndex],
            QInEnumerator,
            tempEigenvalueX,
            tempEigenvalueY,
            tempEigenvalueZ,
            eigenvalueEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            unknown, d,
            patchData.dt[patchIndex],
            patchData.QOut[patchIndex],
            QOutEnumerator
          );
          otterLoopIterationEnd();
        }
        otterLoopEnd();
      }
    }

    if (evaluateFlux and Dimensions==2) {
      logDebug( "timeStepWithRusanov_overlap1_sequential_AoS(...)", "evaluate flux in x-direction" );
      otterLoopBegin();
      #if defined(SharedOMP)
      #pragma omp simd collapse(2) aligned(tempFluxX,tempFluxY,tempFluxZ,tempEigenvalueX,tempEigenvalueY,tempEigenvalueZ,tempNonconservativeProductX,tempNonconservativeProductY,tempNonconservativeProductZ:Alignment)
      #endif
      for (int x = -haloSize; x < numberOfVolumesPerAxisInPatch+haloSize; x++)
      for (int y =         0; y < numberOfVolumesPerAxisInPatch;          y++) {
        otterLoopIterationBegin();
        internal::compute_flux_loop_body<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          0, // normal
          tempFluxX,
          fluxEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();

      otterLoopBegin();
      #if defined(SharedOMP)
      #pragma omp simd collapse(2) aligned(tempFluxX,tempFluxY,tempFluxZ,tempEigenvalueX,tempEigenvalueY,tempEigenvalueZ,tempNonconservativeProductX,tempNonconservativeProductY,tempNonconservativeProductZ:Alignment)
      #endif
      for (int x =         0; x < numberOfVolumesPerAxisInPatch;           x++)
      for (int y = -haloSize; y < numberOfVolumesPerAxisInPatch+haloSize;  y++) {
        otterLoopIterationBegin();
        internal::compute_flux_loop_body<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          1, // normal
          tempFluxY,
          fluxEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();

      for (int d=0; d<2; d++) {
        otterLoopBegin();
        #if defined(SharedOMP)
        #pragma omp simd collapse(3) aligned(tempFluxX,tempFluxY,tempFluxZ,tempEigenvalueX,tempEigenvalueY,tempEigenvalueZ,tempNonconservativeProductX,tempNonconservativeProductY,tempNonconservativeProductZ:Alignment)
        #endif
        for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
        for (int unknown=0; unknown<unknowns+auxiliaryVariables; unknown++) {
          otterLoopIterationBegin();
          internal::update_solution_with_flux_loop_body(
            tempFluxX, tempFluxY, tempFluxZ,
            fluxEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            unknown, d,
            patchData.dt[patchIndex],
            *(patchData.QOut + patchIndex),
            QOutEnumerator
          );
          otterLoopIterationEnd();
        }
        otterLoopEnd();
      }
    }
    else if (evaluateFlux and Dimensions==3) {
      logDebug( "timeStepWithRusanov_overlap1_sequential_AoS(...)", "evaluate flux in x-direction" );
      otterLoopBegin();
      #if defined(SharedOMP)
      #pragma omp simd collapse(3) aligned(tempFluxX,tempFluxY,tempFluxZ,tempEigenvalueX,tempEigenvalueY,tempEigenvalueZ,tempNonconservativeProductX,tempNonconservativeProductY,tempNonconservativeProductZ:Alignment)
      #endif
      for (int x = -haloSize; x < numberOfVolumesPerAxisInPatch+haloSize; x++)
      for (int y =         0; y < numberOfVolumesPerAxisInPatch;          y++)
      for (int z =         0; z < numberOfVolumesPerAxisInPatch;          z++) {
        otterLoopIterationBegin();
        internal::compute_flux_loop_body<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          0, // normal
          tempFluxX,
          fluxEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();

      otterLoopBegin();
      #if defined(SharedOMP)
      #pragma omp simd collapse(3) aligned(tempFluxX,tempFluxY,tempFluxZ,tempEigenvalueX,tempEigenvalueY,tempEigenvalueZ,tempNonconservativeProductX,tempNonconservativeProductY,tempNonconservativeProductZ:Alignment)
      #endif
      for (int x =         0; x < numberOfVolumesPerAxisInPatch;           x++)
      for (int y = -haloSize; y < numberOfVolumesPerAxisInPatch+haloSize;  y++)
      for (int z =         0; z < numberOfVolumesPerAxisInPatch;           z++) {
        otterLoopIterationBegin();
        internal::compute_flux_loop_body<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          1, // normal
          tempFluxY,
          fluxEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();

      otterLoopBegin();
      #if defined(SharedOMP)
      #pragma omp simd collapse(3) aligned(tempFluxX,tempFluxY,tempFluxZ,tempEigenvalueX,tempEigenvalueY,tempEigenvalueZ,tempNonconservativeProductX,tempNonconservativeProductY,tempNonconservativeProductZ:Alignment)
      #endif
      for (int x =         0; x < numberOfVolumesPerAxisInPatch;           x++)
      for (int y =         0; y < numberOfVolumesPerAxisInPatch;           y++)
      for (int z = -haloSize; z < numberOfVolumesPerAxisInPatch+haloSize;  z++) {
        otterLoopIterationBegin();
        internal::compute_flux_loop_body<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          2, // normal
          tempFluxZ,
          fluxEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();

      for (int d=0; d<3; d++) {
        otterLoopBegin();
        #if defined(SharedOMP)
        #pragma omp simd collapse(4) aligned(tempFluxX,tempFluxY,tempFluxZ,tempEigenvalueX,tempEigenvalueY,tempEigenvalueZ,tempNonconservativeProductX,tempNonconservativeProductY,tempNonconservativeProductZ:Alignment)
        #endif
        for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
        for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
        for (int unknown=0; unknown<unknowns+auxiliaryVariables; unknown++) {
          otterLoopIterationBegin();
          internal::update_solution_with_flux_loop_body(
            tempFluxX, tempFluxY, tempFluxZ,
            fluxEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            unknown, d,
            patchData.dt[patchIndex],
            *(patchData.QOut + patchIndex),
            QOutEnumerator
          );
          otterLoopIterationEnd();
        }
        otterLoopEnd();
      }
    }

    if (evaluateNonconservativeProduct and Dimensions==2) {
      otterLoopBegin();
#if defined(SharedOMP)
#pragma omp simd collapse(2) aligned(tempFluxX,tempFluxY,tempFluxZ,tempEigenvalueX,tempEigenvalueY,tempEigenvalueZ,tempNonconservativeProductX,tempNonconservativeProductY,tempNonconservativeProductZ:Alignment)
#endif
      for (int x = -haloSize; x < numberOfVolumesPerAxisInPatch+haloSize-1; x++)
      for (int y =         0; y < numberOfVolumesPerAxisInPatch;            y++) {
        otterLoopIterationBegin();
        internal::compute_nonconservative_flux_loop_body<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          0, // normal
          tempNonconservativeProductX,
          ncpEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();

      otterLoopBegin();
#if defined(SharedOMP)
#pragma omp simd collapse(2) aligned(tempFluxX,tempFluxY,tempFluxZ,tempEigenvalueX,tempEigenvalueY,tempEigenvalueZ,tempNonconservativeProductX,tempNonconservativeProductY,tempNonconservativeProductZ:Alignment)
#endif
      for (int x =         0; x < numberOfVolumesPerAxisInPatch;            x++)
      for (int y = -haloSize; y < numberOfVolumesPerAxisInPatch+haloSize-1; y++) {
        otterLoopIterationBegin();
        internal::compute_nonconservative_flux_loop_body<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          1, // normal
          tempNonconservativeProductY,
          ncpEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();

      for (int d=0; d<2; d++) {
        otterLoopBegin();
        #if defined(SharedOMP)
        #pragma omp simd collapse(3) aligned(tempFluxX,tempFluxY,tempFluxZ,tempEigenvalueX,tempEigenvalueY,tempEigenvalueZ,tempNonconservativeProductX,tempNonconservativeProductY,tempNonconservativeProductZ:Alignment)
        #endif
        for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
        for (int unknown=0; unknown<unknowns+auxiliaryVariables; unknown++) {
          otterLoopIterationBegin();
          internal::update_solution_with_nonconservative_flux_loop_body(
            tempNonconservativeProductX, tempNonconservativeProductY, tempNonconservativeProductZ,
            ncpEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            unknown, d,
            patchData.dt[patchIndex],
            *(patchData.QOut + patchIndex),
            QOutEnumerator
          );
          otterLoopIterationEnd();
        }
        otterLoopEnd();
      }
    }
    else if (evaluateNonconservativeProduct and Dimensions==3) {
      otterLoopBegin();
      #if defined(SharedOMP)
      #pragma omp simd collapse(3) aligned(tempFluxX,tempFluxY,tempFluxZ,tempEigenvalueX,tempEigenvalueY,tempEigenvalueZ,tempNonconservativeProductX,tempNonconservativeProductY,tempNonconservativeProductZ:Alignment)
      #endif
      for (int x = -haloSize; x < numberOfVolumesPerAxisInPatch+haloSize-1; x++)
      for (int y =         0; y < numberOfVolumesPerAxisInPatch;            y++)
      for (int z =         0; z < numberOfVolumesPerAxisInPatch;            z++) {
          otterLoopIterationBegin();
          internal::compute_nonconservative_flux_loop_body<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            0, // normal
            tempNonconservativeProductX,
            ncpEnumerator
          );
          otterLoopIterationEnd();
      }
      otterLoopEnd();

      otterLoopBegin();
      #if defined(SharedOMP)
      #pragma omp simd collapse(3) aligned(tempFluxX,tempFluxY,tempFluxZ,tempEigenvalueX,tempEigenvalueY,tempEigenvalueZ,tempNonconservativeProductX,tempNonconservativeProductY,tempNonconservativeProductZ:Alignment)
      #endif
      for (int x =         0; x < numberOfVolumesPerAxisInPatch;            x++)
      for (int y = -haloSize; y < numberOfVolumesPerAxisInPatch+haloSize-1; y++)
      for (int z =         0; z < numberOfVolumesPerAxisInPatch;            z++) {
        otterLoopIterationBegin();
        internal::compute_nonconservative_flux_loop_body<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            1, // normal
            tempNonconservativeProductY,
            ncpEnumerator
          );
          otterLoopIterationEnd();
        }
        otterLoopEnd();

        otterLoopBegin();
        #if defined(SharedOMP)
        #pragma omp simd collapse(3) aligned(tempFluxX,tempFluxY,tempFluxZ,tempEigenvalueX,tempEigenvalueY,tempEigenvalueZ,tempNonconservativeProductX,tempNonconservativeProductY,tempNonconservativeProductZ:Alignment)
        #endif
        for (int x =         0; x < numberOfVolumesPerAxisInPatch;            x++)
        for (int y =         0; y < numberOfVolumesPerAxisInPatch;            y++)
        for (int z = -haloSize; z < numberOfVolumesPerAxisInPatch+haloSize-1; z++) {
          otterLoopIterationBegin();
          internal::compute_nonconservative_flux_loop_body<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            2, // normal
            tempNonconservativeProductY,
            ncpEnumerator
          );
          otterLoopIterationEnd();
        }
        otterLoopEnd();

        for (int d=0; d<3; d++) {
          otterLoopBegin();
          #if defined(SharedOMP)
          #pragma omp simd collapse(4) aligned(tempFluxX,tempFluxY,tempFluxZ,tempEigenvalueX,tempEigenvalueY,tempEigenvalueZ,tempNonconservativeProductX,tempNonconservativeProductY,tempNonconservativeProductZ:Alignment)
          #endif
          for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
          for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
          for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
          for (int unknown=0; unknown<unknowns+auxiliaryVariables; unknown++) {
            otterLoopIterationBegin();
            internal::update_solution_with_nonconservative_flux_loop_body(
              tempNonconservativeProductX, tempNonconservativeProductY, tempNonconservativeProductZ,
              ncpEnumerator,
              patchData.patchCentre[patchIndex],
              patchData.patchSize[patchIndex],
              patchIndex,
              volumeIndex3d(x,y,z),
              unknown, d,
              patchData.dt[patchIndex],
              *(patchData.QOut + patchIndex),
              QOutEnumerator
            );
            otterLoopIterationEnd();
          }
          otterLoopEnd();
        }
    }


    if (evaluateMaximumEigenvalueAfterTimeStep and Dimensions==2) {
      logDebug( "timeStepWithRusanov_overlap1_sequential_AoS(...)", "compute maximum eigenvalue for subsequent time step" );
      patchData.maxEigenvalue[patchIndex] = 0.0;
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++) {
        patchData.maxEigenvalue[patchIndex] = std::max(
          patchData.maxEigenvalue[patchIndex],
          internal::reduce_max_eigenvalue_loop_body<Solver>(
            *(patchData.QOut + patchIndex),
            QOutEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            patchData.t[patchIndex],
            patchData.dt[patchIndex]
          )
        );
      }
    }
    else if (evaluateMaximumEigenvalueAfterTimeStep) {
      logDebug( "timeStepWithRusanov_overlap1_sequential_AoS(...)", "compute maximum eigenvalue for subsequent time step" );
      patchData.maxEigenvalue[patchIndex] = 0.0;
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++) {
        patchData.maxEigenvalue[patchIndex] = std::max(
          patchData.maxEigenvalue[patchIndex],
          internal::reduce_max_eigenvalue_loop_body<Solver>(
            *(patchData.QOut + patchIndex),
            QOutEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex]
          )
        );
      }
    }
  }

  if (tempFluxX!=nullptr)               tarch::freeMemory(tempFluxX, tarch::MemoryLocation::Heap);
  if (tempFluxY!=nullptr)               tarch::freeMemory(tempFluxY, tarch::MemoryLocation::Heap);
  if (tempFluxZ!=nullptr)               tarch::freeMemory(tempFluxZ, tarch::MemoryLocation::Heap);
  if (tempNonconservativeProductX!=nullptr) tarch::freeMemory(tempNonconservativeProductX, tarch::MemoryLocation::Heap);
  if (tempNonconservativeProductY!=nullptr) tarch::freeMemory(tempNonconservativeProductY, tarch::MemoryLocation::Heap);
  if (tempNonconservativeProductZ!=nullptr) tarch::freeMemory(tempNonconservativeProductZ, tarch::MemoryLocation::Heap);
  if (tempEigenvalueX!=nullptr)         tarch::freeMemory(tempEigenvalueX, tarch::MemoryLocation::Heap);
  if (tempEigenvalueY!=nullptr)         tarch::freeMemory(tempEigenvalueY, tarch::MemoryLocation::Heap);
  if (tempEigenvalueZ!=nullptr)         tarch::freeMemory(tempEigenvalueZ, tarch::MemoryLocation::Heap);
}


template <typename Solver>
void exahype2::fv::rusanov::timeStepWithRusanov_overlap1_batched_AoS(
  PatchData&              patchData,
  int                     numberOfVolumesPerAxisInPatch,
  int                     unknowns,
  int                     auxiliaryVariables,
  bool                    evaluateFlux,
  bool                    evaluateNonconservativeProduct,
  bool                    evaluateSource,
  bool                    evaluateMaximumEigenvalueAfterTimeStep
) {
  static tarch::logging::Log _log( "exahype2::fv::rusanov" );
  constexpr int haloSize        = 1;

  const int faceDoFs        = exahype2::fv::getTotalNumberOfFaceDoFs(        patchData.numberOfPatches, numberOfVolumesPerAxisInPatch, haloSize );
  const int volumeDoFs      = exahype2::fv::getTotalNumberOfVolumeDoFs(      patchData.numberOfPatches, numberOfVolumesPerAxisInPatch, haloSize );
  const int innerVolumeDoFs = exahype2::fv::getTotalNumberOfInnerVolumeDoFs( patchData.numberOfPatches, numberOfVolumesPerAxisInPatch, haloSize );

  double* tempFluxX                  = evaluateFlux                     ? tarch::allocateMemory( volumeDoFs * unknowns,      tarch::MemoryLocation::Heap ) : nullptr;
  double* tempFluxY                  = evaluateFlux                     ? tarch::allocateMemory( volumeDoFs * unknowns,      tarch::MemoryLocation::Heap ) : nullptr;
  double* tempFluxZ                  = (evaluateFlux and Dimensions==3) ? tarch::allocateMemory( volumeDoFs * unknowns,      tarch::MemoryLocation::Heap ) : nullptr;
  double* tempNonconservativeProductX = evaluateNonconservativeProduct                     ? tarch::allocateMemory( faceDoFs,        tarch::MemoryLocation::Heap ) : nullptr;
  double* tempNonconservativeProductY = evaluateNonconservativeProduct                     ? tarch::allocateMemory( faceDoFs,        tarch::MemoryLocation::Heap ) : nullptr;
  double* tempNonconservativeProductZ = (evaluateNonconservativeProduct and Dimensions==3) ? tarch::allocateMemory( faceDoFs,        tarch::MemoryLocation::Heap ) : nullptr;
  double* tempEigenvalueX            =                                    tarch::allocateMemory( volumeDoFs,      tarch::MemoryLocation::Heap );
  double* tempEigenvalueY            =                                    tarch::allocateMemory( volumeDoFs,      tarch::MemoryLocation::Heap );
  double* tempEigenvalueZ            = (Dimensions==3)                  ? tarch::allocateMemory( volumeDoFs,      tarch::MemoryLocation::Heap ) : nullptr;

  exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator QInEnumerator       (                        1, numberOfVolumesPerAxisInPatch,haloSize,unknowns,auxiliaryVariables);
  exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator QOutEnumerator      (                        1, numberOfVolumesPerAxisInPatch,       0,unknowns,auxiliaryVariables);
  exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator fluxEnumerator      (patchData.numberOfPatches, numberOfVolumesPerAxisInPatch,haloSize,unknowns,0);
  exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator ncpEnumerator       (patchData.numberOfPatches, numberOfVolumesPerAxisInPatch,haloSize,unknowns,0);
  exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator eigenvalueEnumerator(patchData.numberOfPatches, numberOfVolumesPerAxisInPatch,haloSize,1,0);

  logDebug( "timeStepWithRusanov_overlap1_sequential_AoS(...)", "evaluate source terms and/or copy solution over" );
  if (Dimensions==2 and evaluateSource) {
    otterLoopBegin();
    #if defined(SharedOMP)
    #pragma omp simd collapse(3) aligned(tempFluxX,tempFluxY,tempFluxZ,tempEigenvalueX,tempEigenvalueY,tempEigenvalueZ,tempNonconservativeProductX,tempNonconservativeProductY,tempNonconservativeProductZ:Alignment)
    #endif
    for (int patchIndex=0; patchIndex<patchData.numberOfPatches; patchIndex++)
    for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
    for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++) {
      otterLoopIterationBegin();
      internal::copy_solution_and_add_source_term_loop_body<Solver>(
        patchData.QIn[patchIndex],
        QInEnumerator,
        patchData.patchCentre[patchIndex],
        patchData.patchSize[patchIndex],
        patchIndex,
        volumeIndex2d(x,y),
        patchData.t[patchIndex],
        patchData.dt[patchIndex],
        patchData.QOut[patchIndex],
        QOutEnumerator
      );
      otterLoopIterationEnd();
    }
    otterLoopEnd();
  }
  else if (Dimensions==3 and evaluateSource) {
    otterLoopBegin();
    #if defined(SharedOMP)
    #pragma omp simd collapse(4) aligned(tempFluxX,tempFluxY,tempFluxZ,tempEigenvalueX,tempEigenvalueY,tempEigenvalueZ,tempNonconservativeProductX,tempNonconservativeProductY,tempNonconservativeProductZ:Alignment)
    #endif
    for (int patchIndex=0; patchIndex<patchData.numberOfPatches; patchIndex++)
    for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
    for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
    for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++) {
      otterLoopIterationBegin();
      internal::copy_solution_and_add_source_term_loop_body<Solver>(
        patchData.QIn[patchIndex],
        QInEnumerator,
        patchData.patchCentre[patchIndex],
        patchData.patchSize[patchIndex],
        patchIndex,
        volumeIndex3d(x,y,z),
        patchData.t[patchIndex],
        patchData.dt[patchIndex],
        patchData.QOut[patchIndex],
        QOutEnumerator
      );
      otterLoopIterationEnd();
