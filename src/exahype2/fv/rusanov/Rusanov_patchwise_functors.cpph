#include "../../../tarch/multicore/otter.h"
#include "Rusanov.h"

void exahype2::fv::rusanov::timeStepWithRusanov_patchwise_heap_functors(
    ::exahype2::CellData &patchData,
    int numberOfVolumesPerAxisInPatch,
    int haloSize,
    int unknowns,
    int auxiliaryVariables,
    bool evaluateFlux,
    bool evaluateNonconservativeProduct,
    bool evaluateSource,
    bool evaluateMaximumEigenvalueAfterTimeStep,
    Flux flux,
    NonconservativeProduct nonconservativeProduct,
    Source source,
    MaxEigenvalue maxEigenvalue)
{
  static tarch::logging::Log _log("exahype2::fv::rusanov");

  /**
   * The halo size passed in by the user might differ from the one that we have to evaluate/
   * take into account from the solver's perspective.
   */
  constexpr int solversHaloSize = 1;

  assertionEquals(haloSize, 1);

  exahype2::enumerator::AoSLexicographicEnumerator QInEnumerator(1, numberOfVolumesPerAxisInPatch, haloSize, unknowns, auxiliaryVariables);
  exahype2::enumerator::AoSLexicographicEnumerator QOutEnumerator(1, numberOfVolumesPerAxisInPatch, 0, unknowns, auxiliaryVariables);
  exahype2::enumerator::AoSLexicographicEnumerator fluxEnumerator(patchData.numberOfCells, numberOfVolumesPerAxisInPatch, solversHaloSize, unknowns, 0);
  exahype2::enumerator::AoSLexicographicEnumerator ncpEnumerator(patchData.numberOfCells, numberOfVolumesPerAxisInPatch + 1, solversHaloSize, unknowns, 0);
  exahype2::enumerator::AoSLexicographicEnumerator eigenvalueEnumerator(patchData.numberOfCells, numberOfVolumesPerAxisInPatch, solversHaloSize, 1, 0);

  double *tempFluxX = evaluateFlux ? tarch::allocateMemory(fluxEnumerator.size(), tarch::MemoryLocation::Heap) : nullptr;
  double *tempFluxY = evaluateFlux ? tarch::allocateMemory(fluxEnumerator.size(), tarch::MemoryLocation::Heap) : nullptr;
  double *tempFluxZ = (evaluateFlux and Dimensions == 3) ? tarch::allocateMemory(fluxEnumerator.size(), tarch::MemoryLocation::Heap) : nullptr;
  double *tempNonconservativeProductX = evaluateNonconservativeProduct ? tarch::allocateMemory(ncpEnumerator.size(), tarch::MemoryLocation::Heap) : nullptr;
  double *tempNonconservativeProductY = evaluateNonconservativeProduct ? tarch::allocateMemory(ncpEnumerator.size(), tarch::MemoryLocation::Heap) : nullptr;
  double *tempNonconservativeProductZ = (evaluateNonconservativeProduct and Dimensions == 3) ? tarch::allocateMemory(ncpEnumerator.size(), tarch::MemoryLocation::Heap) : nullptr;
  double *tempEigenvalueX = tarch::allocateMemory(eigenvalueEnumerator.size(), tarch::MemoryLocation::Heap);
  double *tempEigenvalueY = tarch::allocateMemory(eigenvalueEnumerator.size(), tarch::MemoryLocation::Heap);
  double *tempEigenvalueZ = (Dimensions == 3) ? tarch::allocateMemory(eigenvalueEnumerator.size(), tarch::MemoryLocation::Heap) : nullptr;

  for (int patchIndex = 0; patchIndex < patchData.numberOfCells; patchIndex++)
  {
    logDebug("timeStepWithRusanov_sequential(...)", "evaluate source terms and/or copy solution over");

    // Assigning corner values properly
    for (int unknown = 0; unknown < unknowns; unknown++)
    {
      patchData.QIn[patchIndex][QInEnumerator(patchIndex, volumeIndex2d(-1, -1), unknown)] = 0.5 * (patchData.QIn[patchIndex][QInEnumerator(patchIndex, volumeIndex2d(-1, 0), unknown)] + patchData.QIn[patchIndex][QInEnumerator(patchIndex, volumeIndex2d(0, -1), unknown)]);
      patchData.QIn[patchIndex][QInEnumerator(patchIndex, volumeIndex2d(-1, numberOfVolumesPerAxisInPatch), unknown)] = 0.5 * (patchData.QIn[patchIndex][QInEnumerator(patchIndex, volumeIndex2d(0, numberOfVolumesPerAxisInPatch), unknown)] + patchData.QIn[patchIndex][QInEnumerator(patchIndex, volumeIndex2d(-1, numberOfVolumesPerAxisInPatch - 1), unknown)]);
      patchData.QIn[patchIndex][QInEnumerator(patchIndex, volumeIndex2d(numberOfVolumesPerAxisInPatch, -1), unknown)] = 0.5 * (patchData.QIn[patchIndex][QInEnumerator(patchIndex, volumeIndex2d(numberOfVolumesPerAxisInPatch - 1, -1), unknown)] + patchData.QIn[patchIndex][QInEnumerator(patchIndex, volumeIndex2d(numberOfVolumesPerAxisInPatch, 0), unknown)]);
      patchData.QIn[patchIndex][QInEnumerator(patchIndex, volumeIndex2d(numberOfVolumesPerAxisInPatch, numberOfVolumesPerAxisInPatch), unknown)] = 0.5 * (patchData.QIn[patchIndex][QInEnumerator(patchIndex, volumeIndex2d(numberOfVolumesPerAxisInPatch - 1, numberOfVolumesPerAxisInPatch), unknown)] + patchData.QIn[patchIndex][QInEnumerator(patchIndex, volumeIndex2d(numberOfVolumesPerAxisInPatch, numberOfVolumesPerAxisInPatch - 1), unknown)]);
    }

    for (int i = -1; i < numberOfVolumesPerAxisInPatch + 1; i++)
    {
      // Setting Q[4]
      patchData.QIn[patchIndex][QInEnumerator(patchIndex, volumeIndex2d(-1, i), 4)] = 0.1;
      patchData.QIn[patchIndex][QInEnumerator(patchIndex, volumeIndex2d(numberOfVolumesPerAxisInPatch, i), 4)] = 0.1;
      patchData.QIn[patchIndex][QInEnumerator(patchIndex, volumeIndex2d(i, -1), 4)] = 0.1;
      patchData.QIn[patchIndex][QInEnumerator(patchIndex, volumeIndex2d(i, numberOfVolumesPerAxisInPatch), 4)] = 0.1;

      // Setting Q[5]
      patchData.QIn[patchIndex][QInEnumerator(patchIndex, volumeIndex2d(-1, i), 5)] = 0.7;
      patchData.QIn[patchIndex][QInEnumerator(patchIndex, volumeIndex2d(numberOfVolumesPerAxisInPatch, i), 5)] = 0.7;
      patchData.QIn[patchIndex][QInEnumerator(patchIndex, volumeIndex2d(i, -1), 5)] = 0.7;
      patchData.QIn[patchIndex][QInEnumerator(patchIndex, volumeIndex2d(i, numberOfVolumesPerAxisInPatch), 5)] = 0.7;
    }
    
    if (Dimensions == 2 and evaluateSource)
    {
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
        {
          internal::copySolutionAndAddSourceTerm_LoopBody(
              patchData.QIn[patchIndex],
              QInEnumerator,
              source,
              patchData.cellCentre[patchIndex],
              patchData.cellSize[patchIndex],
              patchIndex,
              volumeIndex2d(x, y),
              patchData.t[patchIndex],
              patchData.dt[patchIndex],
              patchData.QOut[patchIndex],
              QOutEnumerator);
        }
    }
    else if (Dimensions == 3 and evaluateSource)
    {
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
          for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
          {
            internal::copySolutionAndAddSourceTerm_LoopBody(
                patchData.QIn[patchIndex],
                QInEnumerator,
                source,
                patchData.cellCentre[patchIndex],
                patchData.cellSize[patchIndex],
                patchIndex,
                volumeIndex3d(x, y, z),
                patchData.t[patchIndex],
                patchData.dt[patchIndex],
                patchData.QOut[patchIndex],
                QOutEnumerator);
          }
    }
    else if (Dimensions == 2)
    {
      std::cout << "Copying Solution\n";
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
          for (int unknown = 0; unknown < unknowns + auxiliaryVariables; unknown++)
          {
            internal::copySolution_LoopBody(
                patchData.QIn[patchIndex],
                QInEnumerator,
                patchIndex,
                volumeIndex2d(x, y),
                unknown,
                patchData.QOut[patchIndex],
                QOutEnumerator);
          }
    }
    else
    {
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
          for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
            for (int unknown = 0; unknown < unknowns + auxiliaryVariables; unknown++)
            {
              internal::copySolution_LoopBody(
                  patchData.QIn[patchIndex],
                  QInEnumerator,
                  patchIndex,
                  volumeIndex3d(x, y, z),
                  unknown,
                  patchData.QOut[patchIndex],
                  QOutEnumerator);
            }
    }

    if (Dimensions == 2)
    {
      std::cout << "Computing MaxEigenValue in x\n";
      for (int x = -solversHaloSize; x < numberOfVolumesPerAxisInPatch + solversHaloSize; x++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
        {
          internal::computeMaxEigenvalue_LoopBody(
              patchData.QIn[patchIndex],
              QInEnumerator,
              maxEigenvalue,
              patchData.cellCentre[patchIndex],
              patchData.cellSize[patchIndex],
              patchIndex,
              volumeIndex2d(x, y),
              patchData.t[patchIndex], patchData.dt[patchIndex],
              0,
              tempEigenvalueX,
              eigenvalueEnumerator);
        }

      std::cout << "Computing MaxEigenValue in y\n";
      for (int y = -solversHaloSize; y < numberOfVolumesPerAxisInPatch + solversHaloSize; y++)
        for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        {
          internal::computeMaxEigenvalue_LoopBody(
              patchData.QIn[patchIndex],
              QInEnumerator,
              maxEigenvalue,
              patchData.cellCentre[patchIndex],
              patchData.cellSize[patchIndex],
              patchIndex,
              volumeIndex2d(x, y),
              patchData.t[patchIndex], patchData.dt[patchIndex],
              1,
              tempEigenvalueY,
              eigenvalueEnumerator);
        }

      std::cout << "Updating solution with EigenValue\n";
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
          for (int unknown = 0; unknown < unknowns; unknown++)
          {
            internal::updateSolutionWithEigenvalueDamping_LoopBody(
                patchData.QIn[patchIndex],
                QInEnumerator,
                tempEigenvalueX,
                tempEigenvalueY,
                tempEigenvalueZ,
                eigenvalueEnumerator,
                patchData.cellCentre[patchIndex],
                patchData.cellSize[patchIndex],
                patchIndex,
                volumeIndex2d(x, y),
                unknown,
                patchData.dt[patchIndex],
                patchData.QOut[patchIndex],
                QOutEnumerator);
          }
    }
    else
    {
      for (int x = -solversHaloSize; x < numberOfVolumesPerAxisInPatch + solversHaloSize; x++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
          for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
          {
            internal::computeMaxEigenvalue_LoopBody(
                patchData.QIn[patchIndex],
                QInEnumerator,
                maxEigenvalue,
                patchData.cellCentre[patchIndex],
                patchData.cellSize[patchIndex],
                patchIndex,
                volumeIndex3d(x, y, z),
                patchData.t[patchIndex], patchData.dt[patchIndex],
                0,
                tempEigenvalueX,
                eigenvalueEnumerator);
          }

      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int y = -solversHaloSize; y < numberOfVolumesPerAxisInPatch + solversHaloSize; y++)
          for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
          {
            internal::computeMaxEigenvalue_LoopBody(
                patchData.QIn[patchIndex],
                QInEnumerator,
                maxEigenvalue,
                patchData.cellCentre[patchIndex],
                patchData.cellSize[patchIndex],
                patchIndex,
                volumeIndex3d(x, y, z),
                patchData.t[patchIndex], patchData.dt[patchIndex],
                1,
                tempEigenvalueY,
                eigenvalueEnumerator);
          }

      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
          for (int z = -solversHaloSize; z < numberOfVolumesPerAxisInPatch + solversHaloSize; z++)
          {
            internal::computeMaxEigenvalue_LoopBody(
                patchData.QIn[patchIndex],
                QInEnumerator,
                maxEigenvalue,
                patchData.cellCentre[patchIndex],
                patchData.cellSize[patchIndex],
                patchIndex,
                volumeIndex3d(x, y, z),
                patchData.t[patchIndex], patchData.dt[patchIndex],
                2,
                tempEigenvalueZ,
                eigenvalueEnumerator);
          }

      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
          for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
            for (int unknown = 0; unknown < unknowns; unknown++)
            {
              internal::updateSolutionWithEigenvalueDamping_LoopBody(
                  patchData.QIn[patchIndex],
                  QInEnumerator,
                  tempEigenvalueX,
                  tempEigenvalueY,
                  tempEigenvalueZ,
                  eigenvalueEnumerator,
                  patchData.cellCentre[patchIndex],
                  patchData.cellSize[patchIndex],
                  patchIndex,
                  volumeIndex3d(x, y, z),
                  unknown,
                  patchData.dt[patchIndex],
                  patchData.QOut[patchIndex],
                  QOutEnumerator);
            }
    }

    if (evaluateFlux and Dimensions == 2)
    {
      std::cout << "Evaluating xFlux\n";
      for (int x = -solversHaloSize; x < numberOfVolumesPerAxisInPatch + solversHaloSize; x++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
        {
          internal::computeFlux_LoopBody(
              patchData.QIn[patchIndex],
              QInEnumerator,
              flux,
              patchData.cellCentre[patchIndex],
              patchData.cellSize[patchIndex],
              patchIndex,
              volumeIndex2d(x, y),
              patchData.t[patchIndex],
              patchData.dt[patchIndex],
              0, // normal
              tempFluxX,
              fluxEnumerator);
        }

      std::cout << "Evaluating yFlux\n";

      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int y = -solversHaloSize; y < numberOfVolumesPerAxisInPatch + solversHaloSize; y++)
        {
          internal::computeFlux_LoopBody(
              patchData.QIn[patchIndex],
              QInEnumerator,
              flux,
              patchData.cellCentre[patchIndex],
              patchData.cellSize[patchIndex],
              patchIndex,
              volumeIndex2d(x, y),
              patchData.t[patchIndex],
              patchData.dt[patchIndex],
              1, // normal
              tempFluxY,
              fluxEnumerator);
        }

      std::cout << "Updating solution with Flux\n";
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
          for (int unknown = 0; unknown < unknowns; unknown++)
          {
            internal::updateSolutionWithFlux_LoopBody(
                tempFluxX, tempFluxY, tempFluxZ,
                fluxEnumerator,
                patchData.cellCentre[patchIndex],
                patchData.cellSize[patchIndex],
                patchIndex,
                volumeIndex2d(x, y),
                unknown,
                patchData.dt[patchIndex],
                *(patchData.QOut + patchIndex),
                QOutEnumerator);
          }
    }
    else if (evaluateFlux and Dimensions == 3)
    {
      for (int x = -solversHaloSize; x < numberOfVolumesPerAxisInPatch + solversHaloSize; x++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
          for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
          {
            internal::computeFlux_LoopBody(
                patchData.QIn[patchIndex],
                QInEnumerator,
                flux,
                patchData.cellCentre[patchIndex],
                patchData.cellSize[patchIndex],
                patchIndex,
                volumeIndex3d(x, y, z),
                patchData.t[patchIndex],
                patchData.dt[patchIndex],
                0, // normal
                tempFluxX,
                fluxEnumerator);
          }

      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int y = -solversHaloSize; y < numberOfVolumesPerAxisInPatch + solversHaloSize; y++)
          for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
          {
            internal::computeFlux_LoopBody(
                patchData.QIn[patchIndex],
                QInEnumerator,
                flux,
                patchData.cellCentre[patchIndex],
                patchData.cellSize[patchIndex],
                patchIndex,
                volumeIndex3d(x, y, z),
                patchData.t[patchIndex],
                patchData.dt[patchIndex],
                1, // normal
                tempFluxY,
                fluxEnumerator);
          }

      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
          for (int z = -solversHaloSize; z < numberOfVolumesPerAxisInPatch + solversHaloSize; z++)
          {

            internal::computeFlux_LoopBody(
                patchData.QIn[patchIndex],
                QInEnumerator,
                flux,
                patchData.cellCentre[patchIndex],
                patchData.cellSize[patchIndex],
                patchIndex,
                volumeIndex3d(x, y, z),
                patchData.t[patchIndex],
                patchData.dt[patchIndex],
                2, // normal
                tempFluxZ,
                fluxEnumerator);
          }

      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
          for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
            for (int unknown = 0; unknown < unknowns; unknown++)
            {

              internal::updateSolutionWithFlux_LoopBody(
                  tempFluxX, tempFluxY, tempFluxZ,
                  fluxEnumerator,
                  patchData.cellCentre[patchIndex],
                  patchData.cellSize[patchIndex],
                  patchIndex,
                  volumeIndex3d(x, y, z),
                  unknown,
                  patchData.dt[patchIndex],
                  *(patchData.QOut + patchIndex),
                  QOutEnumerator);
            }
    }

    if (evaluateNonconservativeProduct and Dimensions == 2)
    {
      std::cout << "Evaluating ncpxFlux\n";
      for (int x = -solversHaloSize; x < numberOfVolumesPerAxisInPatch + solversHaloSize - 1; x++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
        {
          internal::computeNonconservativeFlux_LoopBody(
              patchData.QIn[patchIndex],
              QInEnumerator,
              nonconservativeProduct,
              patchData.cellCentre[patchIndex],
              patchData.cellSize[patchIndex],
              patchIndex,
              volumeIndex2d(x, y),
              patchData.t[patchIndex],
              patchData.dt[patchIndex],
              0, // normal
              tempNonconservativeProductX,
              ncpEnumerator);
        }

      std::cout << "Evaluating ncpyFlux\n";
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int y = -solversHaloSize; y < numberOfVolumesPerAxisInPatch + solversHaloSize - 1; y++)
        {
          internal::computeNonconservativeFlux_LoopBody(
              patchData.QIn[patchIndex],
              QInEnumerator,
              nonconservativeProduct,
              patchData.cellCentre[patchIndex],
              patchData.cellSize[patchIndex],
              patchIndex,
              volumeIndex2d(x, y),
              patchData.t[patchIndex],
              patchData.dt[patchIndex],
              1, // normal
              tempNonconservativeProductY,
              ncpEnumerator);
        }

      // std::cout << "Updating solution with ncpFlux\n";
      // for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      //   for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      //     for (int unknown = 0; unknown < unknowns; unknown++)
      //     {
      //       internal::updateSolutionWithNonconservativeFlux_LoopBody(
      //           tempNonconservativeProductX, tempNonconservativeProductY, tempNonconservativeProductZ,
      //           ncpEnumerator,
      //           patchData.cellCentre[patchIndex],
      //           patchData.cellSize[patchIndex],
      //           patchIndex,
      //           volumeIndex2d(x, y),
      //           unknown,
      //           patchData.dt[patchIndex],
      //           *(patchData.QOut + patchIndex),
      //           QOutEnumerator);
      //     }
    }
    else if (evaluateNonconservativeProduct and Dimensions == 3)
    {
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
          for (int x = -solversHaloSize; x < numberOfVolumesPerAxisInPatch + solversHaloSize - 1; x++)
          {
            internal::computeNonconservativeFlux_LoopBody(
                patchData.QIn[patchIndex],
                QInEnumerator,
                nonconservativeProduct,
                patchData.cellCentre[patchIndex],
                patchData.cellSize[patchIndex],
                patchIndex,
                volumeIndex3d(x, y, z),
                patchData.t[patchIndex],
                patchData.dt[patchIndex],
                0, // normal
                tempNonconservativeProductX,
                ncpEnumerator);
          }

      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int y = -solversHaloSize; y < numberOfVolumesPerAxisInPatch + solversHaloSize - 1; y++)
          for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
          {
            internal::computeNonconservativeFlux_LoopBody(
                patchData.QIn[patchIndex],
                QInEnumerator,
                nonconservativeProduct,
                patchData.cellCentre[patchIndex],
                patchData.cellSize[patchIndex],
                patchIndex,
                volumeIndex3d(x, y, z),
                patchData.t[patchIndex],
                patchData.dt[patchIndex],
                1, // normal
                tempNonconservativeProductY,
                ncpEnumerator);
          }

      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
          for (int z = -solversHaloSize; z < numberOfVolumesPerAxisInPatch + solversHaloSize - 1; z++)
          {
            internal::computeNonconservativeFlux_LoopBody(
                patchData.QIn[patchIndex],
                QInEnumerator,
                nonconservativeProduct,
                patchData.cellCentre[patchIndex],
                patchData.cellSize[patchIndex],
                patchIndex,
                volumeIndex3d(x, y, z),
                patchData.t[patchIndex],
                patchData.dt[patchIndex],
                2, // normal
                tempNonconservativeProductZ,
                ncpEnumerator);
          }

      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
          for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
            for (int unknown = 0; unknown < unknowns; unknown++)
            {
              internal::updateSolutionWithNonconservativeFlux_LoopBody(
                  tempNonconservativeProductX, tempNonconservativeProductY, tempNonconservativeProductZ,
                  ncpEnumerator,
                  patchData.cellCentre[patchIndex],
                  patchData.cellSize[patchIndex],
                  patchIndex,
                  volumeIndex3d(x, y, z),
                  unknown,
                  patchData.dt[patchIndex],
                  *(patchData.QOut + patchIndex),
                  QOutEnumerator);
            }
    }

    if (evaluateMaximumEigenvalueAfterTimeStep and Dimensions == 2)
    {
      logDebug("timeStepWithRusanov_sequential(...)", "compute maximum eigenvalue for subsequent time step");
      double newMaxEigenvalue = 0.0;

      std::cout << "Reducing max eigenvalue\n";

      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
        {
          newMaxEigenvalue = std::max(
              newMaxEigenvalue,
              internal::reduceMaxEigenvalue_LoopBody(
                  *(patchData.QOut + patchIndex),
                  QOutEnumerator,
                  maxEigenvalue,
                  patchData.cellCentre[patchIndex],
                  patchData.cellSize[patchIndex],
                  patchIndex,
                  volumeIndex2d(x, y),
                  patchData.t[patchIndex],
                  patchData.dt[patchIndex]));
        }

      patchData.maxEigenvalue[patchIndex] = newMaxEigenvalue;
      patchData.maxEigenvalue[patchIndex] = 15;
    }
    else if (evaluateMaximumEigenvalueAfterTimeStep)
    {
      double newMaxEigenvalue = 0.0;

      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
          for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
          {
            newMaxEigenvalue = std::max(
                newMaxEigenvalue,
                internal::reduceMaxEigenvalue_LoopBody(
                    *(patchData.QOut + patchIndex),
                    QOutEnumerator,
                    maxEigenvalue,
                    patchData.cellCentre[patchIndex],
                    patchData.cellSize[patchIndex],
                    patchIndex,
                    volumeIndex3d(x, y, z),
                    patchData.t[patchIndex],
                    patchData.dt[patchIndex]));
          }
      patchData.maxEigenvalue[patchIndex] = newMaxEigenvalue;
    }

    // for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
    // {
    //   for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
    //   {
    //     std::cout << "x=" << x << ", y=" << y << ", Qout[0]=" << patchData.QOut[patchIndex][QOutEnumerator(patchIndex, volumeIndex2d(x, y), 0)]
