#include "Rusanov.h"
#include "tarch/compiler/CompilerSpecificSettings.h"
#include "exahype2/fv/rusanov/LoopBody.h"
#include "exahype2/fv/rusanov/Rusanov_Helper.cpph"

#include <cstring>

template <
  typename Solver,
  int      numberOfVolumesPerAxisInPatch,
  int      haloSize,
  int      unknowns,
  int      auxiliaryVariables,
  typename TempDataEnumerator
>
void exahype2::fv::rusanov::omp::opt::timeStepWithRusanov_patchwise_heap_static_calls(
  int                     targetDevice,
  ::exahype2::CellData&   hostPatchData,
  GPUCellData&            devicePatchData,
  GPUScratchpadData&      deviceScratchpadData,
  bool                    evaluateFlux,
  bool                    evaluateNonconservativeProduct,
  bool                    evaluateSource,
  bool                    evaluateMaximumEigenvalueAfterTimeStep
) {
  #if defined(GPUOffloadingOMP)
  while (not canOffloadIntoPreallocatedMemory(hostPatchData.numberOfCells)) {
    printf("Cannot offload to GPU -> suspending for now\n");
  }

  constexpr int solversHaloSize = 1;

  exahype2::enumerator::AoSLexicographicEnumerator QInHostEnumerator       (                        1, numberOfVolumesPerAxisInPatch, haloSize, unknowns, auxiliaryVariables);
  exahype2::enumerator::AoSLexicographicEnumerator QOutHostEnumerator      (                        1, numberOfVolumesPerAxisInPatch,        0, unknowns, auxiliaryVariables);
  TempDataEnumerator fluxHostEnumerator      (hostPatchData.numberOfCells, numberOfVolumesPerAxisInPatch,   solversHaloSize, unknowns, 0);
  TempDataEnumerator ncpHostEnumerator       (hostPatchData.numberOfCells, numberOfVolumesPerAxisInPatch+1, solversHaloSize, unknowns, 0);
  TempDataEnumerator eigenvalueHostEnumerator(hostPatchData.numberOfCells, numberOfVolumesPerAxisInPatch,   solversHaloSize,        1, 0);

  static TempDataEnumerator fluxHostEnumeratorMax      (MaxNumberOfPossiblePatchEntries, numberOfVolumesPerAxisInPatch,   solversHaloSize, unknowns, 0);
  static TempDataEnumerator ncpHostEnumeratorMax       (MaxNumberOfPossiblePatchEntries, numberOfVolumesPerAxisInPatch+1, solversHaloSize, unknowns, 0);
  static TempDataEnumerator eigenvalueHostEnumeratorMax(MaxNumberOfPossiblePatchEntries, numberOfVolumesPerAxisInPatch,   solversHaloSize,        1, 0);

  deviceScratchpadData.allocate(targetDevice, fluxHostEnumeratorMax.size(), ncpHostEnumeratorMax.size(), eigenvalueHostEnumeratorMax.size());
  double* tempFluxX                   = deviceScratchpadData.tempFluxX;
  double* tempFluxY                   = deviceScratchpadData.tempFluxY;
  double* tempFluxZ                   = deviceScratchpadData.tempFluxZ;
  double* tempNonconservativeProductX = deviceScratchpadData.tempNonconservativeProductX;
  double* tempNonconservativeProductY = deviceScratchpadData.tempNonconservativeProductY;
  double* tempNonconservativeProductZ = deviceScratchpadData.tempNonconservativeProductZ;
  double* tempEigenvalueX             = deviceScratchpadData.tempEigenvalueX;
  double* tempEigenvalueY             = deviceScratchpadData.tempEigenvalueY;
  double* tempEigenvalueZ             = deviceScratchpadData.tempEigenvalueZ;

  devicePatchData.allocate(targetDevice, QInHostEnumerator.size(), QOutHostEnumerator.size());
  double* mappedPointersToQIns        = devicePatchData.QIn;
  double* mappedPointersToQOuts       = devicePatchData.QOut;
  double* rawPointerToCellCentres     = devicePatchData.cellCentre;
  double* rawPointerToCellSizes       = devicePatchData.cellSize;
  double* ts                          = devicePatchData.t;
  double* dts                         = devicePatchData.dt;
  double* maxEigenvalues              = devicePatchData.maxEigenvalue;

  std::vector<double> tmpQIn(hostPatchData.numberOfCells * QInHostEnumerator.size());
  for (int patchIndex=0; patchIndex<hostPatchData.numberOfCells; patchIndex++) {
    std::memcpy(&tmpQIn[patchIndex * QInHostEnumerator.size()], hostPatchData.QIn[patchIndex], QInHostEnumerator.size() * sizeof(double));
  }

  auto hostId = omp_get_initial_device();

  omp_target_memcpy(mappedPointersToQIns, &tmpQIn[0], hostPatchData.numberOfCells * QInHostEnumerator.size() * sizeof(double), 0, 0, targetDevice, hostId);
  omp_target_memcpy(rawPointerToCellCentres, &hostPatchData.cellCentre[0], hostPatchData.numberOfCells * Dimensions * sizeof(double), 0, 0, targetDevice, hostId);
  omp_target_memcpy(rawPointerToCellSizes, &hostPatchData.cellSize[0], hostPatchData.numberOfCells * Dimensions * sizeof(double), 0, 0, targetDevice, hostId);
  omp_target_memcpy(ts, hostPatchData.t, hostPatchData.numberOfCells * sizeof(double), 0, 0, targetDevice, hostId);
  omp_target_memcpy(dts, hostPatchData.dt, hostPatchData.numberOfCells * sizeof(double), 0, 0, targetDevice, hostId);

  const int numberOfCells = hostPatchData.numberOfCells;

  #pragma omp target teams distribute device(targetDevice) \
    is_device_ptr(tempFluxX, tempFluxY, tempFluxZ, \
                  tempNonconservativeProductX, tempNonconservativeProductY, tempNonconservativeProductZ, \
                  tempEigenvalueX, tempEigenvalueY, tempEigenvalueZ, \
                  mappedPointersToQIns, mappedPointersToQOuts, \
                  rawPointerToCellCentres, rawPointerToCellSizes, \
                  ts, dts, maxEigenvalues)
  for (int patchIndex=0; patchIndex<numberOfCells; patchIndex++) {
    exahype2::enumerator::AoSLexicographicEnumerator QInEnumerator       (                        1, numberOfVolumesPerAxisInPatch,haloSize,unknowns,auxiliaryVariables);
    exahype2::enumerator::AoSLexicographicEnumerator QOutEnumerator      (                        1, numberOfVolumesPerAxisInPatch,       0,unknowns,auxiliaryVariables);
    TempDataEnumerator fluxEnumerator      (numberOfCells, numberOfVolumesPerAxisInPatch,haloSize,unknowns,0);
    TempDataEnumerator ncpEnumerator       (numberOfCells, numberOfVolumesPerAxisInPatch+1,haloSize,unknowns,0);
    TempDataEnumerator eigenvalueEnumerator(numberOfCells, numberOfVolumesPerAxisInPatch,haloSize,1,0);

    double* QIn = &mappedPointersToQIns[patchIndex * QInEnumerator.size()];
    double* QOut = &mappedPointersToQOuts[patchIndex * QOutEnumerator.size()];
    const tarch::la::Vector<Dimensions,double> patchCentre = rawPointerToCellCentres[patchIndex];
    const tarch::la::Vector<Dimensions,double> patchSize = rawPointerToCellSizes[patchIndex];
    const double t = ts[patchIndex];
    const double dt = dts[patchIndex];

    if (Dimensions==2 and evaluateSource) {
      #pragma omp parallel for simd collapse(2)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        internal::copySolutionAndAddSourceTerm_LoopBody<Solver>(
          QIn,
          QInEnumerator,
          patchCentre,
          patchSize,
          patchIndex,
          volumeIndex2d(x,y),
          t,
          dt,
          QOut,
          QOutEnumerator
        );
      }
    }
    else if (Dimensions==3 and evaluateSource) {
      #pragma omp parallel for simd collapse(3)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        internal::copySolutionAndAddSourceTerm_LoopBody<Solver>(
          QIn,
          QInEnumerator,
          patchCentre,
          patchSize,
          patchIndex,
          volumeIndex3d(x,y,z),
          t,
          dt,
          QOut,
          QOutEnumerator
        );
      }
    }
    else if (Dimensions==2) {
      #pragma omp parallel for simd collapse(3)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int unknown=0; unknown<unknowns+auxiliaryVariables; unknown++) {
        internal::copySolution_LoopBody(
          QIn,
          QInEnumerator,
          patchIndex,
          volumeIndex2d(x,y),
          unknown,
          QOut,
          QOutEnumerator
        );
      }
    }
    else {
      #pragma omp parallel for simd collapse(4)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int unknown=0; unknown<unknowns+auxiliaryVariables; unknown++) {
        internal::copySolution_LoopBody(
          QIn,
          QInEnumerator,
          patchIndex,
          volumeIndex3d(x,y,z),
          unknown,
          QOut,
          QOutEnumerator
        );
      }
    }

    if (Dimensions==2) {
      #pragma omp parallel for collapse(2)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch+2*solversHaloSize; x++) {
        internal::computeMaxEigenvalue_LoopBody<Solver>(
            QIn,
            QInEnumerator,
            patchCentre,
            patchSize,
            patchIndex,
            volumeIndex2d(x-solversHaloSize,y),
            t,
            dt,
            0,
            tempEigenvalueX,
            eigenvalueEnumerator
        );
      }

      #pragma omp parallel for collapse(2)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch+2*solversHaloSize; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        internal::computeMaxEigenvalue_LoopBody<Solver>(
            QIn,
            QInEnumerator,
            patchCentre,
            patchSize,
            patchIndex,
            volumeIndex2d(x,y-solversHaloSize),
            t,
            dt,
            1,
            tempEigenvalueY,
            eigenvalueEnumerator
        );
      }

      #pragma omp parallel for collapse(3)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int unknown = 0; unknown < unknowns; unknown++) {
        internal::updateSolutionWithEigenvalueDamping_LoopBody(
          QIn,
          QInEnumerator,
          tempEigenvalueX,
          tempEigenvalueY,
          tempEigenvalueZ,
          eigenvalueEnumerator,
          patchCentre,
          patchSize,
          patchIndex,
          volumeIndex2d(x,y),
          unknown,
          dt,
          QOut,
          QOutEnumerator
        );
      }
    }
    else {
      #pragma omp parallel for collapse(3)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch+2*solversHaloSize; x++) {
        internal::computeMaxEigenvalue_LoopBody<Solver>(
          QIn,
          QInEnumerator,
          patchCentre,
          patchSize,
          patchIndex,
          volumeIndex3d(x-solversHaloSize,y,z),
          t,
          dt,
          0,
          tempEigenvalueX,
          eigenvalueEnumerator
        );
      }

      #pragma omp parallel for collapse(3)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch+2*solversHaloSize; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        internal::computeMaxEigenvalue_LoopBody<Solver>(
              QIn,
              QInEnumerator,
              patchCentre,
              patchSize,
              patchIndex,
              volumeIndex3d(x,y-solversHaloSize,z),
              t,
              dt,
              1,
              tempEigenvalueY,
              eigenvalueEnumerator
        );
      }

      #pragma omp parallel for collapse(3)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch+2*solversHaloSize; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        internal::computeMaxEigenvalue_LoopBody<Solver>(
              QIn,
              QInEnumerator,
              patchCentre,
              patchSize,
              patchIndex,
              volumeIndex3d(x,y,z-solversHaloSize),
              t,
              dt,
              2,
              tempEigenvalueZ,
              eigenvalueEnumerator
        );
      }

      #pragma omp parallel for collapse(4)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int unknown = 0; unknown < unknowns; unknown++) {
        internal::updateSolutionWithEigenvalueDamping_LoopBody(
          QIn,
          QInEnumerator,
          tempEigenvalueX,
          tempEigenvalueY,
          tempEigenvalueZ,
          eigenvalueEnumerator,
          patchCentre,
          patchSize,
          patchIndex,
          volumeIndex3d(x,y,z),
          unknown,
          dt,
          QOut,
          QOutEnumerator
        );
      }
    }

    if (evaluateFlux and Dimensions==2) {
      #pragma omp parallel for collapse(2)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch+2*solversHaloSize; x++) {
        internal::computeFlux_LoopBody<Solver, unknowns, auxiliaryVariables>(
          QIn,
          QInEnumerator,
          patchCentre,
          patchSize,
          patchIndex,
          volumeIndex2d(x-solversHaloSize,y),
          t,
          dt,
          0, // normal
          tempFluxX,
          fluxEnumerator
        );
      }

      #pragma omp parallel for collapse(2)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch+2*solversHaloSize;  y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        internal::computeFlux_LoopBody<Solver, unknowns, auxiliaryVariables>(
          QIn,
          QInEnumerator,
          patchCentre,
          patchSize,
          patchIndex,
          volumeIndex2d(x,y-solversHaloSize),
          t,
          dt,
          1, // normal
          tempFluxY,
          fluxEnumerator
        );
      }

      #pragma omp parallel for collapse(3)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int unknown=0; unknown<unknowns; unknown++) {
        internal::updateSolutionWithFlux_LoopBody(
          tempFluxX, tempFluxY, tempFluxZ,
          fluxEnumerator,
          patchCentre,
          patchSize,
          patchIndex,
          volumeIndex2d(x,y),
          unknown,
          dt,
          QOut,
          QOutEnumerator
        );
      }
    }
    else if (evaluateFlux and Dimensions==3) {
      #pragma omp parallel for collapse(3)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch+2*solversHaloSize; x++) {
        internal::computeFlux_LoopBody<Solver, unknowns, auxiliaryVariables>(
          QIn,
          QInEnumerator,
          patchCentre,
          patchSize,
          patchIndex,
          volumeIndex3d(x-solversHaloSize,y,z),
          t,
          dt,
          0, // normal
          tempFluxX,
          fluxEnumerator
        );
      }

      #pragma omp parallel for collapse(3)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch+2*solversHaloSize;  y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        internal::computeFlux_LoopBody<Solver, unknowns, auxiliaryVariables>(
          QIn,
          QInEnumerator,
          patchCentre,
          patchSize,
          patchIndex,
          volumeIndex3d(x,y-solversHaloSize,z),
          t,
          dt,
          1, // normal
          tempFluxY,
          fluxEnumerator
        );
      }

      #pragma omp parallel for collapse(3)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch+2*solversHaloSize; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        internal::computeFlux_LoopBody<Solver, unknowns, auxiliaryVariables>(
          QIn,
          QInEnumerator,
          patchCentre,
          patchSize,
          patchIndex,
          volumeIndex3d(x,y,z-solversHaloSize),
          t,
          dt,
          2, // normal
          tempFluxZ,
          fluxEnumerator
        );
      }

      #pragma omp parallel for collapse(4)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int unknown=0; unknown<unknowns; unknown++) {
        internal::updateSolutionWithFlux_LoopBody(
          tempFluxX, tempFluxY, tempFluxZ,
          fluxEnumerator,
          patchCentre,
          patchSize,
          patchIndex,
          volumeIndex3d(x,y,z),
          unknown,
          dt,
          QOut,
          QOutEnumerator
        );
      }
    }

    if (evaluateNonconservativeProduct and Dimensions==2) {
      #pragma omp parallel for collapse(2)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch+2*solversHaloSize-1; x++) {
        internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
          QIn,
          QInEnumerator,
          patchCentre,
          patchSize,
          patchIndex,
          volumeIndex2d(x-solversHaloSize,y),
          t,
          dt,
          0, // normal
          tempNonconservativeProductX,
          ncpEnumerator
        );
      }

      #pragma omp parallel for collapse(2)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch+2*solversHaloSize-1; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
          QIn,
          QInEnumerator,
          patchCentre,
          patchSize,
          patchIndex,
          volumeIndex2d(x,y-solversHaloSize),
          t,
          dt,
          1, // normal
          tempNonconservativeProductY,
          ncpEnumerator
        );
      }

      #pragma omp parallel for collapse(3)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int unknown=0; unknown<unknowns; unknown++) {
        internal::updateSolutionWithNonconservativeFlux_LoopBody(
          tempNonconservativeProductX, tempNonconservativeProductY, tempNonconservativeProductZ,
          ncpEnumerator,
          patchCentre,
          patchSize,
          patchIndex,
          volumeIndex2d(x,y),
          unknown,
          dt,
          QOut,
          QOutEnumerator
        );
      }
    }
    else if (evaluateNonconservativeProduct and Dimensions==3) {
        #pragma omp parallel for collapse(3)
        for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
        for (int x = 0; x < numberOfVolumesPerAxisInPatch+2*solversHaloSize-1; x++) {
          internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
            QIn,
            QInEnumerator,
            patchCentre,
            patchSize,
            patchIndex,
            volumeIndex3d(x-solversHaloSize,y,z),
            t,
            dt,
            0, // normal
            tempNonconservativeProductX,
            ncpEnumerator
          );
        }

        #pragma omp parallel for collapse(3)
        for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch+2*solversHaloSize-1; y++)
        for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
          internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
            QIn,
            QInEnumerator,
            patchCentre,
            patchSize,
            patchIndex,
            volumeIndex3d(x,y-solversHaloSize,z),
            t,
            dt,
            1, // normal
            tempNonconservativeProductY,
            ncpEnumerator
          );
        }

        #pragma omp parallel for collapse(3)
        for (int z = 0; z < numberOfVolumesPerAxisInPatch+2*solversHaloSize-1; z++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
        for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
          internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
            QIn,
            QInEnumerator,
            patchCentre,
            patchSize,
            patchIndex,
            volumeIndex3d(x,y,z-solversHaloSize),
            t,
            dt,
            2, // normal
            tempNonconservativeProductZ,
            ncpEnumerator
          );
        }

        #pragma omp parallel for collapse(4)
        for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
        for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int unknown=0; unknown<unknowns; unknown++) {
          internal::updateSolutionWithNonconservativeFlux_LoopBody(
            tempNonconservativeProductX, tempNonconservativeProductY, tempNonconservativeProductZ,
            ncpEnumerator,
            patchCentre,
            patchSize,
            patchIndex,
            volumeIndex3d(x,y,z),
            unknown,
            dt,
            QOut,
            QOutEnumerator
          );
        }
    }
    if (evaluateMaximumEigenvalueAfterTimeStep and Dimensions==2) {
      double newMaxEigenvalue = 0.0;
      #pragma omp parallel for collapse(2) reduction(max:newMaxEigenvalue)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        newMaxEigenvalue = std::max(
          newMaxEigenvalue,
          internal::reduceMaxEigenvalue_LoopBody<Solver>(
            QOut,
            QOutEnumerator,
            patchCentre,
            patchSize,
            patchIndex,
            volumeIndex2d(x,y),
            t,
            dt
          )
        );
      }
      maxEigenvalues[patchIndex] = newMaxEigenvalue;
    }
    else if (evaluateMaximumEigenvalueAfterTimeStep) {
      double newMaxEigenvalue = 0.0;
      #pragma omp parallel for collapse(3) reduction(max:newMaxEigenvalue)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        newMaxEigenvalue = std::max(
          newMaxEigenvalue,
          internal::reduceMaxEigenvalue_LoopBody<Solver>(
            QOut,
            QOutEnumerator,
            patchCentre,
            patchSize,
            patchIndex,
            volumeIndex3d(x,y,z),
            t,
            dt
          )
        );
      }
      maxEigenvalues[patchIndex] = newMaxEigenvalue;
    }
  } // This is the end of the target offloading block

  std::vector<double> tmpQOut(hostPatchData.numberOfCells * QOutHostEnumerator.size());
  omp_target_memcpy(&tmpQOut[0], mappedPointersToQOuts, hostPatchData.numberOfCells * QOutHostEnumerator.size() * sizeof(double), 0, 0, hostId, targetDevice);
  for (int patchIndex=0; patchIndex<hostPatchData.numberOfCells; patchIndex++) {
    std::memcpy(hostPatchData.QOut[patchIndex], &tmpQOut[patchIndex * QOutHostEnumerator.size()], QOutHostEnumerator.size() * sizeof(double));
  }
  omp_target_memcpy(hostPatchData.maxEigenvalue, maxEigenvalues, hostPatchData.numberOfCells * sizeof(double), 0, 0, hostId, targetDevice);

  leavePreallocatedMemoryFromOffloading(hostPatchData.numberOfCells);

  #else
  assertionMsg(false, "this routine should only be used in combination with OpenMP offloading, as it has a device parameter" );
  #endif
}
