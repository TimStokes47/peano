#include "Rusanov.h"
#include "tarch/compiler/CompilerSpecificSettings.h"
#include "tarch/accelerator/omp/GPUMemoryManager.h"
#include "exahype2/fv/rusanov/LoopBody.h"

#include <cstring>

template <
  typename Solver,
  int      numberOfVolumesPerAxisInPatch,
  int      haloSize,
  int      unknowns,
  int      auxiliaryVariables,
  typename TempDataEnumerator
>
void exahype2::fv::rusanov::omp::timeStepWithRusanov_patchwise_managed_static_calls(
  int                     targetDevice,
  ::exahype2::CellData&   hostPatchData,
  bool                    evaluateFlux,
  bool                    evaluateNonconservativeProduct,
  bool                    evaluateSource,
  bool                    evaluateMaximumEigenvalueAfterTimeStep
) {
#if defined(GPUOffloadingOMP) and defined(_OPENMP) and not defined(__HIP_DEVICE_COMPILE__)
  constexpr int solversHaloSize = 1;

  const auto hostId = omp_get_initial_device();

  const TempDataEnumerator fluxHostEnumerator      (hostPatchData.numberOfCells, numberOfVolumesPerAxisInPatch,   solversHaloSize, unknowns, 0);
  const TempDataEnumerator ncpHostEnumerator       (hostPatchData.numberOfCells, numberOfVolumesPerAxisInPatch+1, solversHaloSize, unknowns, 0);
  const TempDataEnumerator eigenvalueHostEnumerator(hostPatchData.numberOfCells, numberOfVolumesPerAxisInPatch,   solversHaloSize,        1, 0);

  double* tempFluxX = tarch::accelerator::omp::GPUMemoryManager::getInstance().allocate<double>( fluxHostEnumerator.size(), targetDevice );
  double* tempFluxY = tarch::accelerator::omp::GPUMemoryManager::getInstance().allocate<double>( fluxHostEnumerator.size(), targetDevice );
  double* tempFluxZ = tarch::accelerator::omp::GPUMemoryManager::getInstance().allocate<double>( Dimensions==3 ? fluxHostEnumerator.size() : 1, targetDevice );
  double* tempNonconservativeProductX = tarch::accelerator::omp::GPUMemoryManager::getInstance().allocate<double>( ncpHostEnumerator.size(), targetDevice );
  double* tempNonconservativeProductY = tarch::accelerator::omp::GPUMemoryManager::getInstance().allocate<double>( ncpHostEnumerator.size(), targetDevice );
  double* tempNonconservativeProductZ = tarch::accelerator::omp::GPUMemoryManager::getInstance().allocate<double>( Dimensions==3 ? ncpHostEnumerator.size() : 1, targetDevice );
  double* tempEigenvalueX = tarch::accelerator::omp::GPUMemoryManager::getInstance().allocate<double>( eigenvalueHostEnumerator.size(), targetDevice );
  double* tempEigenvalueY = tarch::accelerator::omp::GPUMemoryManager::getInstance().allocate<double>( eigenvalueHostEnumerator.size(), targetDevice );
  double* tempEigenvalueZ = tarch::accelerator::omp::GPUMemoryManager::getInstance().allocate<double>( Dimensions==3 ? eigenvalueHostEnumerator.size() : 1, targetDevice );

  exahype2::enumerator::AoSLexicographicEnumerator QInHostEnumerator       (                        1, numberOfVolumesPerAxisInPatch, haloSize, unknowns, auxiliaryVariables);
  exahype2::enumerator::AoSLexicographicEnumerator QOutHostEnumerator      (                        1, numberOfVolumesPerAxisInPatch,        0, unknowns, auxiliaryVariables);

  // We do not assume the memory is in the unified memory already -> need to do it manually.
  #if defined(__AMDGPU__) or defined(__clang__)
  const int QInCount = hostPatchData.numberOfCells * QInHostEnumerator.size();
  double* mappedPointersToQIns = tarch::accelerator::omp::GPUMemoryManager::getInstance().allocate<double>(QInCount, targetDevice );
  std::vector<double> tmpQIn(QInCount);
   for (int patchIndex=0; patchIndex<hostPatchData.numberOfCells; patchIndex++) {
    std::memcpy(&tmpQIn[patchIndex * QInHostEnumerator.size()], hostPatchData.QIn[patchIndex], QInHostEnumerator.size() * sizeof(double));
  }
  omp_target_memcpy(mappedPointersToQIns, &tmpQIn[0], QInCount * sizeof(double), 0, 0, targetDevice, hostId);
  #else // Memory is already in the unified memory -> we don't need to do anything.
  double** mappedPointersToQIns = hostPatchData.QIn;
  #endif

  const int QOutCount = hostPatchData.numberOfCells * QOutHostEnumerator.size();
  double* mappedPointersToQOuts = tarch::accelerator::omp::GPUMemoryManager::getInstance().allocate<double>(QOutCount, targetDevice );

  double* rawPointerToCellCentres = tarch::accelerator::omp::GPUMemoryManager::getInstance().allocate<double>(hostPatchData.numberOfCells * Dimensions, targetDevice );
  double* rawPointerToCellSizes = tarch::accelerator::omp::GPUMemoryManager::getInstance().allocate<double>(hostPatchData.numberOfCells * Dimensions, targetDevice );
  double* ts = tarch::accelerator::omp::GPUMemoryManager::getInstance().allocate<double>(hostPatchData.numberOfCells, targetDevice );
  double* dts = tarch::accelerator::omp::GPUMemoryManager::getInstance().allocate<double>(hostPatchData.numberOfCells, targetDevice );
  double* maxEigenvalues = tarch::accelerator::omp::GPUMemoryManager::getInstance().allocate<double>(hostPatchData.numberOfCells, targetDevice );

  omp_target_memcpy(rawPointerToCellCentres, &hostPatchData.cellCentre[0], hostPatchData.numberOfCells * Dimensions * sizeof(double), 0, 0, targetDevice, hostId);
  omp_target_memcpy(rawPointerToCellSizes, &hostPatchData.cellSize[0], hostPatchData.numberOfCells * Dimensions * sizeof(double), 0, 0, targetDevice, hostId);
  omp_target_memcpy(ts, hostPatchData.t, hostPatchData.numberOfCells * sizeof(double), 0, 0, targetDevice, hostId);
  omp_target_memcpy(dts, hostPatchData.dt, hostPatchData.numberOfCells * sizeof(double), 0, 0, targetDevice, hostId);

  const int numberOfCells = hostPatchData.numberOfCells;
  #pragma omp target teams distribute device(targetDevice) \
    is_device_ptr(tempFluxX, tempFluxY, tempFluxZ, \
                  tempNonconservativeProductX, tempNonconservativeProductY, tempNonconservativeProductZ, \
                  tempEigenvalueX, tempEigenvalueY, tempEigenvalueZ, \
                  mappedPointersToQIns, mappedPointersToQOuts, \
                  rawPointerToCellCentres, rawPointerToCellSizes, \
                  ts, dts, maxEigenvalues)
  for (int patchIndex=0; patchIndex<numberOfCells; patchIndex++) {
    exahype2::enumerator::AoSLexicographicEnumerator QInEnumerator       (                        1, numberOfVolumesPerAxisInPatch,haloSize,unknowns,auxiliaryVariables);
    exahype2::enumerator::AoSLexicographicEnumerator QOutEnumerator      (                        1, numberOfVolumesPerAxisInPatch,       0,unknowns,auxiliaryVariables);
    TempDataEnumerator fluxEnumerator      (numberOfCells, numberOfVolumesPerAxisInPatch,haloSize,unknowns,0);
    TempDataEnumerator ncpEnumerator       (numberOfCells, numberOfVolumesPerAxisInPatch+1,haloSize,unknowns,0);
    TempDataEnumerator eigenvalueEnumerator(numberOfCells, numberOfVolumesPerAxisInPatch,haloSize,1,0);

    #if defined(__AMDGPU__) or defined(__clang__)
    double* QIn = &mappedPointersToQIns[patchIndex * QInEnumerator.size()];
    #else
    double* QIn = mappedPointersToQIns[patchIndex];
    #endif
    double* QOut = &mappedPointersToQOuts[patchIndex * QOutEnumerator.size()];
    const tarch::la::Vector<Dimensions,double> patchCentre = rawPointerToCellCentres[patchIndex];
    const tarch::la::Vector<Dimensions,double> patchSize = rawPointerToCellSizes[patchIndex];
    const double t = ts[patchIndex];
    const double dt = dts[patchIndex];

    if (Dimensions==2 and evaluateSource) {
      #pragma omp parallel for simd collapse(2)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        internal::copySolutionAndAddSourceTerm_LoopBody<Solver>(
          QIn,
          QInEnumerator,
          patchCentre,
          patchSize,
          patchIndex,
          volumeIndex2d(x,y),
          t,
          dt,
          QOut,
          QOutEnumerator
        );
      }
    }
    else if (Dimensions==3 and evaluateSource) {
      #pragma omp parallel for simd collapse(3)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        internal::copySolutionAndAddSourceTerm_LoopBody<Solver>(
          QIn,
          QInEnumerator,
          patchCentre,
          patchSize,
          patchIndex,
          volumeIndex3d(x,y,z),
          t,
          dt,
          QOut,
          QOutEnumerator
        );
      }
    }
    else if (Dimensions==2) {
      #pragma omp parallel for simd collapse(3)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int unknown=0; unknown<unknowns+auxiliaryVariables; unknown++) {
        internal::copySolution_LoopBody(
          QIn,
          QInEnumerator,
          patchIndex,
          volumeIndex2d(x,y),
          unknown,
          QOut,
          QOutEnumerator
        );
      }
    }
    else {
      #pragma omp parallel for simd collapse(4)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int unknown=0; unknown<unknowns+auxiliaryVariables; unknown++) {
        internal::copySolution_LoopBody(
          QIn,
          QInEnumerator,
          patchIndex,
          volumeIndex3d(x,y,z),
          unknown,
          QOut,
          QOutEnumerator
        );
      }
    }

    if (Dimensions==2) {
      #pragma omp parallel for simd collapse(2)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch+2*solversHaloSize; x++) {
        internal::computeMaxEigenvalue_LoopBody<Solver>(
            QIn,
            QInEnumerator,
            patchCentre,
            patchSize,
            patchIndex,
            volumeIndex2d(x-solversHaloSize,y),
            t,
            dt,
            0,
            tempEigenvalueX,
            eigenvalueEnumerator
        );
      }

      #pragma omp parallel for simd collapse(2)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch+2*solversHaloSize; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        internal::computeMaxEigenvalue_LoopBody<Solver>(
            QIn,
            QInEnumerator,
            patchCentre,
            patchSize,
            patchIndex,
            volumeIndex2d(x,y-solversHaloSize),
            t,
            dt,
            1,
            tempEigenvalueY,
            eigenvalueEnumerator
        );
      }

      #pragma omp parallel for simd collapse(3)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int unknown = 0; unknown < unknowns; unknown++) {
        internal::updateSolutionWithEigenvalueDamping_LoopBody(
          QIn,
          QInEnumerator,
          tempEigenvalueX,
          tempEigenvalueY,
          tempEigenvalueZ,
          eigenvalueEnumerator,
          patchCentre,
          patchSize,
          patchIndex,
          volumeIndex2d(x,y),
          unknown,
          dt,
          QOut,
          QOutEnumerator
        );
      }
    }
    else {
      #pragma omp parallel for simd collapse(3)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch+2*solversHaloSize; x++) {
        internal::computeMaxEigenvalue_LoopBody<Solver>(
          QIn,
          QInEnumerator,
          patchCentre,
          patchSize,
          patchIndex,
          volumeIndex3d(x-solversHaloSize,y,z),
          t,
          dt,
          0,
          tempEigenvalueX,
          eigenvalueEnumerator
        );
      }

      #pragma omp parallel for simd collapse(3)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch+2*solversHaloSize; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        internal::computeMaxEigenvalue_LoopBody<Solver>(
              QIn,
              QInEnumerator,
              patchCentre,
              patchSize,
              patchIndex,
              volumeIndex3d(x,y-solversHaloSize,z),
              t,
              dt,
              1,
              tempEigenvalueY,
              eigenvalueEnumerator
        );
      }

      #pragma omp parallel for simd collapse(3)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch+2*solversHaloSize; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        internal::computeMaxEigenvalue_LoopBody<Solver>(
              QIn,
              QInEnumerator,
              patchCentre,
              patchSize,
              patchIndex,
              volumeIndex3d(x,y,z-solversHaloSize),
              t,
              dt,
              2,
              tempEigenvalueZ,
              eigenvalueEnumerator
        );
      }

      #pragma omp parallel for simd collapse(4)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int unknown = 0; unknown < unknowns; unknown++) {
        internal::updateSolutionWithEigenvalueDamping_LoopBody(
          QIn,
          QInEnumerator,
          tempEigenvalueX,
          tempEigenvalueY,
          tempEigenvalueZ,
          eigenvalueEnumerator,
          patchCentre,
          patchSize,
          patchIndex,
          volumeIndex3d(x,y,z),
          unknown,
          dt,
          QOut,
          QOutEnumerator
        );
      }
    }

    if (evaluateFlux and Dimensions==2) {
      #pragma omp parallel for simd collapse(2)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch+2*solversHaloSize; x++) {
        internal::computeFlux_LoopBody<Solver, unknowns, auxiliaryVariables>(
          QIn,
          QInEnumerator,
          patchCentre,
          patchSize,
          patchIndex,
          volumeIndex2d(x-solversHaloSize,y),
          t,
          dt,
          0, // normal
          tempFluxX,
          fluxEnumerator
        );
      }

      #pragma omp parallel for simd collapse(2)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch+2*solversHaloSize; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        internal::computeFlux_LoopBody<Solver, unknowns, auxiliaryVariables>(
          QIn,
          QInEnumerator,
          patchCentre,
          patchSize,
          patchIndex,
          volumeIndex2d(x,y-solversHaloSize),
          t,
          dt,
          1, // normal
          tempFluxY,
          fluxEnumerator
        );
      }

      #pragma omp parallel for simd collapse(3)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int unknown=0; unknown<unknowns; unknown++) {
        internal::updateSolutionWithFlux_LoopBody(
          tempFluxX, tempFluxY, tempFluxZ,
          fluxEnumerator,
          patchCentre,
          patchSize,
          patchIndex,
          volumeIndex2d(x,y),
          unknown,
          dt,
          QOut,
          QOutEnumerator
        );
      }
    }
    else if (evaluateFlux and Dimensions==3) {
      #pragma omp parallel for simd collapse(3)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch+2*solversHaloSize; x++) {
        internal::computeFlux_LoopBody<Solver, unknowns, auxiliaryVariables>(
          QIn,
          QInEnumerator,
          patchCentre,
          patchSize,
          patchIndex,
          volumeIndex3d(x-solversHaloSize,y,z),
          t,
          dt,
          0, // normal
          tempFluxX,
          fluxEnumerator
        );
      }

      #pragma omp parallel for simd collapse(3)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch+2*solversHaloSize; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        internal::computeFlux_LoopBody<Solver, unknowns, auxiliaryVariables>(
          QIn,
          QInEnumerator,
          patchCentre,
          patchSize,
          patchIndex,
          volumeIndex3d(x,y-solversHaloSize,z),
          t,
          dt,
          1, // normal
          tempFluxY,
          fluxEnumerator
        );
      }

      #pragma omp parallel for simd collapse(3)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch+2*solversHaloSize; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        internal::computeFlux_LoopBody<Solver, unknowns, auxiliaryVariables>(
          QIn,
          QInEnumerator,
          patchCentre,
          patchSize,
          patchIndex,
          volumeIndex3d(x,y,z-solversHaloSize),
          t,
          dt,
          2, // normal
          tempFluxZ,
          fluxEnumerator
        );
      }

      #pragma omp parallel for simd collapse(4)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int unknown=0; unknown<unknowns; unknown++) {
        internal::updateSolutionWithFlux_LoopBody(
          tempFluxX, tempFluxY, tempFluxZ,
          fluxEnumerator,
          patchCentre,
          patchSize,
          patchIndex,
          volumeIndex3d(x,y,z),
          unknown,
          dt,
          QOut,
          QOutEnumerator
        );
      }
    }

    if (evaluateNonconservativeProduct and Dimensions==2) {
      #pragma omp parallel for simd collapse(2)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch+2*solversHaloSize-1; x++) {
        internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
          QIn,
          QInEnumerator,
          patchCentre,
          patchSize,
          patchIndex,
          volumeIndex2d(x-solversHaloSize,y),
          t,
          dt,
          0, // normal
          tempNonconservativeProductX,
          ncpEnumerator
        );
      }

      #pragma omp parallel for simd collapse(2)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch+2*solversHaloSize-1; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
          QIn,
          QInEnumerator,
          patchCentre,
          patchSize,
          patchIndex,
          volumeIndex2d(x,y-solversHaloSize),
          t,
          dt,
          1, // normal
          tempNonconservativeProductY,
          ncpEnumerator
        );
      }

      #pragma omp parallel for simd collapse(3)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int unknown=0; unknown<unknowns; unknown++) {
        internal::updateSolutionWithNonconservativeFlux_LoopBody(
          tempNonconservativeProductX, tempNonconservativeProductY, tempNonconservativeProductZ,
          ncpEnumerator,
          patchCentre,
          patchSize,
          patchIndex,
          volumeIndex2d(x,y),
          unknown,
          dt,
          QOut,
          QOutEnumerator
        );
      }
    }
    else if (evaluateNonconservativeProduct and Dimensions==3) {
        #pragma omp parallel for simd collapse(3)
        for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
        for (int x = 0; x < numberOfVolumesPerAxisInPatch+2*solversHaloSize-1; x++) {
          internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
            QIn,
            QInEnumerator,
            patchCentre,
            patchSize,
            patchIndex,
            volumeIndex3d(x-solversHaloSize,y,z),
            t,
            dt,
            0, // normal
            tempNonconservativeProductX,
            ncpEnumerator
          );
        }

        #pragma omp parallel for simd collapse(3)
        for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch+2*solversHaloSize-1; y++)
        for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
          internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
            QIn,
            QInEnumerator,
            patchCentre,
            patchSize,
            patchIndex,
            volumeIndex3d(x,y-solversHaloSize,z),
            t,
            dt,
            1, // normal
            tempNonconservativeProductY,
            ncpEnumerator
          );
        }

        #pragma omp parallel for simd collapse(3)
        for (int z = 0; z < numberOfVolumesPerAxisInPatch+2*solversHaloSize-1; z++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
        for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
          internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
            QIn,
            QInEnumerator,
            patchCentre,
            patchSize,
            patchIndex,
            volumeIndex3d(x,y,z-solversHaloSize),
            t,
            dt,
            2, // normal
            tempNonconservativeProductZ,
            ncpEnumerator
          );
        }

        #pragma omp parallel for simd collapse(4)
        for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
        for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int unknown=0; unknown<unknowns; unknown++) {
          internal::updateSolutionWithNonconservativeFlux_LoopBody(
            tempNonconservativeProductX, tempNonconservativeProductY, tempNonconservativeProductZ,
            ncpEnumerator,
            patchCentre,
            patchSize,
            patchIndex,
            volumeIndex3d(x,y,z),
            unknown,
            dt,
            QOut,
            QOutEnumerator
          );
        }
    }
    if (evaluateMaximumEigenvalueAfterTimeStep and Dimensions==2) {
      double newMaxEigenvalue = 0.0;
      #pragma omp parallel for simd collapse(2) reduction(max:newMaxEigenvalue)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        newMaxEigenvalue = std::max(
          newMaxEigenvalue,
          internal::reduceMaxEigenvalue_LoopBody<Solver>(
            QOut,
            QOutEnumerator,
            patchCentre,
            patchSize,
            patchIndex,
            volumeIndex2d(x,y),
            t,
            dt
          )
        );
      }
      maxEigenvalues[patchIndex] = newMaxEigenvalue;
    }
    else if (evaluateMaximumEigenvalueAfterTimeStep) {
      double newMaxEigenvalue = 0.0;
      #pragma omp parallel for simd collapse(3) reduction(max:newMaxEigenvalue)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        newMaxEigenvalue = std::max(
          newMaxEigenvalue,
          internal::reduceMaxEigenvalue_LoopBody<Solver>(
            QOut,
            QOutEnumerator,
            patchCentre,
            patchSize,
            patchIndex,
            volumeIndex3d(x,y,z),
            t,
            dt
          )
        );
      }
      maxEigenvalues[patchIndex] = newMaxEigenvalue;
    }
  } // This is the end of the target offloading block

  std::vector<double> tmpQOut(QOutCount);
  omp_target_memcpy(&tmpQOut[0], mappedPointersToQOuts, QOutCount * sizeof(double), 0, 0, hostId, targetDevice);
  omp_target_memcpy(hostPatchData.maxEigenvalue, maxEigenvalues, hostPatchData.numberOfCells * sizeof(double), 0, 0, hostId, targetDevice);

  tarch::accelerator::omp::GPUMemoryManager::getInstance().free( tempFluxX, targetDevice );
  tarch::accelerator::omp::GPUMemoryManager::getInstance().free( tempFluxY, targetDevice );
  tarch::accelerator::omp::GPUMemoryManager::getInstance().free( tempFluxZ, targetDevice );
  tarch::accelerator::omp::GPUMemoryManager::getInstance().free( tempNonconservativeProductX, targetDevice );
  tarch::accelerator::omp::GPUMemoryManager::getInstance().free( tempNonconservativeProductY, targetDevice );
  tarch::accelerator::omp::GPUMemoryManager::getInstance().free( tempNonconservativeProductZ, targetDevice );
  tarch::accelerator::omp::GPUMemoryManager::getInstance().free( tempEigenvalueX, targetDevice );
  tarch::accelerator::omp::GPUMemoryManager::getInstance().free( tempEigenvalueY, targetDevice );
  tarch::accelerator::omp::GPUMemoryManager::getInstance().free( tempEigenvalueZ, targetDevice );

  #if defined(__AMDGPU__) or defined(__clang__)
  tarch::accelerator::omp::GPUMemoryManager::getInstance().free( mappedPointersToQIns, targetDevice );
  #endif
  tarch::accelerator::omp::GPUMemoryManager::getInstance().free( mappedPointersToQOuts, targetDevice );
  tarch::accelerator::omp::GPUMemoryManager::getInstance().free( rawPointerToCellCentres, targetDevice );
  tarch::accelerator::omp::GPUMemoryManager::getInstance().free( rawPointerToCellSizes, targetDevice );
  tarch::accelerator::omp::GPUMemoryManager::getInstance().free( ts, targetDevice );
  tarch::accelerator::omp::GPUMemoryManager::getInstance().free( dts, targetDevice );
  tarch::accelerator::omp::GPUMemoryManager::getInstance().free( maxEigenvalues, targetDevice );

  for (int patchIndex=0; patchIndex<hostPatchData.numberOfCells; patchIndex++) {
    std::memcpy(hostPatchData.QOut[patchIndex], &tmpQOut[patchIndex * QOutHostEnumerator.size()], QOutHostEnumerator.size() * sizeof(double));
  }

#else
  assertionMsg(false, "this routine should only be used in combination with OpenMP offloading" );
#endif
}
