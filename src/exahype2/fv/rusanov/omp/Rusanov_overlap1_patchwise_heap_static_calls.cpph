#include "Rusanov.h"
#include "tarch/compiler/CompilerSpecificSettings.h"


template <
  typename Solver,
  int      numberOfVolumesPerAxisInPatch,
  int      unknowns,
  int      auxiliaryVariables,
  typename TempDataEnumerator
>
void exahype2::fv::rusanov::omp::timeStepWithRusanov_overlap1_patchwise_heap_static_calls(
  int                     targetDevice,
  ::exahype2::CellData&   patchData,
  bool                    evaluateFlux,
  bool                    evaluateNonconservativeProduct,
  bool                    evaluateSource,
  bool                    evaluateMaximumEigenvalueAfterTimeStep
) {
  constexpr int haloSize        = 1;

  exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator QInEnumerator       (                        1, numberOfVolumesPerAxisInPatch,haloSize,unknowns,auxiliaryVariables);
  exahype2::fv::enumerator::AoSLexicographicVolumeEnumerator QOutEnumerator      (                        1, numberOfVolumesPerAxisInPatch,       0,unknowns,auxiliaryVariables);
  TempDataEnumerator fluxEnumerator      (patchData.numberOfCells, numberOfVolumesPerAxisInPatch,haloSize,unknowns,0);
  TempDataEnumerator ncpEnumerator       (patchData.numberOfCells, numberOfVolumesPerAxisInPatch+1,haloSize,unknowns,0);
  TempDataEnumerator eigenvalueEnumerator(patchData.numberOfCells, numberOfVolumesPerAxisInPatch,haloSize,1,0);


  #if defined(GPUOffloadingOMP)
  double* tempFluxX                   = nullptr;
  double* tempFluxY                   = nullptr;
  double* tempFluxZ                   = nullptr;
  double* tempNonconservativeProductX = nullptr;
  double* tempNonconservativeProductY = nullptr;
  double* tempNonconservativeProductZ = nullptr;
  double* tempEigenvalueX             = nullptr;
  double* tempEigenvalueY             = nullptr;
  double* tempEigenvalueZ             = nullptr;

  #pragma omp target enter data map(alloc:tempFluxX[0:fluxEnumerator.size()] ) device(targetDevice)
  #pragma omp target enter data map(alloc:tempFluxY[0:fluxEnumerator.size()] ) device(targetDevice)
  #pragma omp target enter data map(alloc:tempFluxZ[0:fluxEnumerator.size()] ) device(targetDevice)
  #pragma omp target enter data map(alloc:tempNonconservativeProductX[0:ncpEnumerator.size()] ) device(targetDevice)
  #pragma omp target enter data map(alloc:tempNonconservativeProductY[0:ncpEnumerator.size()] ) device(targetDevice)
  #pragma omp target enter data map(alloc:tempNonconservativeProductZ[0:ncpEnumerator.size()] ) device(targetDevice)
  #pragma omp target enter data map(alloc:tempEigenvalueX[0:eigenvalueEnumerator.size()] ) device(targetDevice)
  #pragma omp target enter data map(alloc:tempEigenvalueY[0:eigenvalueEnumerator.size()] ) device(targetDevice)
  #pragma omp target enter data map(alloc:tempEigenvalueZ[0:eigenvalueEnumerator.size()] ) device(targetDevice)

  double* serialisedPatchCentres = tarch::allocateMemory( patchData.numberOfCells*Dimensions, tarch::MemoryLocation::ManagedAcceleratorMemory );
  double* serialisedPatchSizes   = tarch::allocateMemory( patchData.numberOfCells*Dimensions, tarch::MemoryLocation::ManagedAcceleratorMemory );

  for (int patchIndex=0; patchIndex<patchData.numberOfCells; patchIndex++) {
    const double* currentQIn  = patchData.QIn[patchIndex];
    double*       currentQOut = patchData.QOut[patchIndex];

    for (int d=0; d<Dimensions; d++) {
      serialisedPatchCentres[patchIndex*Dimensions+d] = patchData.patchCentre[patchIndex](d);
      serialisedPatchSizes[patchIndex*Dimensions+d]   = patchData.patchSize[patchIndex](d);
    }

    #pragma omp target enter data map(to:currentQIn[0:QInEnumerator.size()] ) device(targetDevice)
    #pragma omp target enter data map(alloc:currentQOut[0:QOutEnumerator.size()] ) device(targetDevice)
  }

  #pragma omp target enter data map(to:serialisedPatchCentres[0:patchData.numberOfCells*Dimensions] ) device(targetDevice)
  #pragma omp target enter data map(to:serialisedPatchSizes[0:patchData.numberOfCells*Dimensions] ) device(targetDevice)
  #else
  double* tempFluxX                  = evaluateFlux                     ? tarch::allocateMemory( fluxEnumerator.size(),      tarch::MemoryLocation::Heap ) : nullptr;
  double* tempFluxY                  = evaluateFlux                     ? tarch::allocateMemory( fluxEnumerator.size(),      tarch::MemoryLocation::Heap ) : nullptr;
  double* tempFluxZ                  = (evaluateFlux and Dimensions==3) ? tarch::allocateMemory( fluxEnumerator.size(),      tarch::MemoryLocation::Heap ) : nullptr;
  double* tempNonconservativeProductX = evaluateNonconservativeProduct                     ? tarch::allocateMemory( ncpEnumerator.size(),        tarch::MemoryLocation::Heap ) : nullptr;
  double* tempNonconservativeProductY = evaluateNonconservativeProduct                     ? tarch::allocateMemory( ncpEnumerator.size(),        tarch::MemoryLocation::Heap ) : nullptr;
  double* tempNonconservativeProductZ = (evaluateNonconservativeProduct and Dimensions==3) ? tarch::allocateMemory( ncpEnumerator.size(),        tarch::MemoryLocation::Heap ) : nullptr;
  double* tempEigenvalueX            =                                    tarch::allocateMemory( eigenvalueEnumerator.size(),      tarch::MemoryLocation::Heap );
  double* tempEigenvalueY            =                                    tarch::allocateMemory( eigenvalueEnumerator.size(),      tarch::MemoryLocation::Heap );
  double* tempEigenvalueZ            = (Dimensions==3)                  ? tarch::allocateMemory( eigenvalueEnumerator.size(),      tarch::MemoryLocation::Heap ) : nullptr;
  #endif

  #pragma omp target teams distribute device(targetDevice) \
    map(to:patchData.t[0:patchData.numberOfCells]) \
    map(to:patchData.dt[0:patchData.numberOfCells]) \
    map(from:patchData.maxEigenvalue[0:patchData.numberOfCells])
  for (int patchIndex=0; patchIndex<patchData.numberOfCells; patchIndex++) {

    #if defined(GPUOffloadingOMP)
    for (int d=0; d<Dimensions; d++) {
      patchData.patchCentre[patchIndex](d) = serialisedPatchCentres[patchIndex*Dimensions+d];
      patchData.patchSize[patchIndex](d)   = serialisedPatchSizes[patchIndex*Dimensions+d];
	}
    #endif

    if (Dimensions==2 and evaluateSource) {
      #pragma omp parallel for collapse(2)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        otterLoopIterationBegin();
        internal::copySolutionAndAddSourceTerm_LoopBody<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          patchData.QOut[patchIndex],
          QOutEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();
    }
    else if (Dimensions==3 and evaluateSource) {
      #pragma omp parallel for collapse(3)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        otterLoopIterationBegin();
        internal::copySolutionAndAddSourceTerm_LoopBody<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          patchData.QOut[patchIndex],
          QOutEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();
    }
    else if (Dimensions==2) {
      otterLoopBegin();
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      #if defined(SharedOMP)
      #pragma omp simd collapse(2)
      #endif
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int unknown=0; unknown<unknowns+auxiliaryVariables; unknown++) {
        otterLoopIterationBegin();
        internal::copySolution_LoopBody(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchIndex,
          volumeIndex2d(x,y),
          unknown,
          patchData.QOut[patchIndex],
          QOutEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();
    }
    else {
      otterLoopBegin();
      #pragma omp parallel for collapse(4)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int unknown=0; unknown<unknowns+auxiliaryVariables; unknown++) {
        otterLoopIterationBegin();
        internal::copySolution_LoopBody(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchIndex,
          volumeIndex3d(x,y,z),
          unknown,
          patchData.QOut[patchIndex],
          QOutEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();
    }


    if (Dimensions==2) {
      otterLoopBegin();
      #pragma omp parallel for collapse(2)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = -haloSize; x < numberOfVolumesPerAxisInPatch+haloSize; x++) {
        otterLoopIterationBegin();
        internal::computeMaxEigenvalue_LoopBody<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            patchData.t[patchIndex], patchData.dt[patchIndex],
            0,
            tempEigenvalueX,
            eigenvalueEnumerator
        );
      }

      #pragma omp parallel for collapse(2)
      for (int y = -haloSize; y < numberOfVolumesPerAxisInPatch+haloSize; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        otterLoopIterationBegin();
        internal::computeMaxEigenvalue_LoopBody<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            patchData.t[patchIndex], patchData.dt[patchIndex],
            1,
            tempEigenvalueY,
            eigenvalueEnumerator
        );
        otterLoopIterationEnd();
      }


      #pragma omp parallel for collapse(3)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int unknown = 0; unknown < unknowns; unknown++) {
        internal::updateSolutionWithEigenvalueDamping_LoopBody(
          patchData.QIn[patchIndex],
          QInEnumerator,
          tempEigenvalueX,
          tempEigenvalueY,
          tempEigenvalueZ,
          eigenvalueEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          unknown,
          patchData.dt[patchIndex],
          patchData.QOut[patchIndex],
          QOutEnumerator
        );
      }
    }
    else {
      #pragma omp parallel for collapse(3)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = -haloSize; x < numberOfVolumesPerAxisInPatch+haloSize; x++) {
        internal::computeMaxEigenvalue_LoopBody<Solver>(
              patchData.QIn[patchIndex],
              QInEnumerator,
              patchData.patchCentre[patchIndex],
              patchData.patchSize[patchIndex],
              patchIndex,
              volumeIndex3d(x,y,z),
              patchData.t[patchIndex], patchData.dt[patchIndex],
              0,
              tempEigenvalueX,
              eigenvalueEnumerator
        );
      }


      #pragma omp parallel for collapse(3)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int y = -haloSize; y < numberOfVolumesPerAxisInPatch+haloSize; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        internal::computeMaxEigenvalue_LoopBody<Solver>(
              patchData.QIn[patchIndex],
              QInEnumerator,
              patchData.patchCentre[patchIndex],
              patchData.patchSize[patchIndex],
              patchIndex,
              volumeIndex3d(x,y,z),
              patchData.t[patchIndex], patchData.dt[patchIndex],
              1,
              tempEigenvalueY,
              eigenvalueEnumerator
        );
      }


      #pragma omp parallel for collapse(3)
      for (int z = -haloSize; z < numberOfVolumesPerAxisInPatch+haloSize; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        internal::computeMaxEigenvalue_LoopBody<Solver>(
              patchData.QIn[patchIndex],
              QInEnumerator,
              patchData.patchCentre[patchIndex],
              patchData.patchSize[patchIndex],
              patchIndex,
              volumeIndex3d(x,y,z),
              patchData.t[patchIndex], patchData.dt[patchIndex],
              2,
              tempEigenvalueZ,
              eigenvalueEnumerator
        );
      }


      #pragma omp parallel for collapse(4)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int unknown = 0; unknown < unknowns; unknown++) {
        otterLoopIterationBegin();
        internal::updateSolutionWithEigenvalueDamping_LoopBody(
          patchData.QIn[patchIndex],
          QInEnumerator,
          tempEigenvalueX,
          tempEigenvalueY,
          tempEigenvalueZ,
          eigenvalueEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          unknown,
          patchData.dt[patchIndex],
          patchData.QOut[patchIndex],
          QOutEnumerator
        );
      }
    }

    if (evaluateFlux and Dimensions==2) {
      #pragma omp parallel for collapse(2)
      for (int y =         0; y < numberOfVolumesPerAxisInPatch;          y++)
      for (int x = -haloSize; x < numberOfVolumesPerAxisInPatch+haloSize; x++) {
        internal::computeFlux_LoopBody<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          0, // normal
          tempFluxX,
          fluxEnumerator
        );
      }


      #pragma omp parallel for collapse(2)
      for (int y = -haloSize; y < numberOfVolumesPerAxisInPatch+haloSize;  y++)
      for (int x =         0; x < numberOfVolumesPerAxisInPatch;           x++) {
        internal::computeFlux_LoopBody<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          1, // normal
          tempFluxY,
          fluxEnumerator
        );
      }


      #pragma omp parallel for collapse(3)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int unknown=0; unknown<unknowns; unknown++) {
        otterLoopIterationBegin();
        internal::updateSolutionWithFlux_LoopBody(
          tempFluxX, tempFluxY, tempFluxZ,
          fluxEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          unknown,
          patchData.dt[patchIndex],
          *(patchData.QOut + patchIndex),
          QOutEnumerator
        );
      }
    }
    else if (evaluateFlux and Dimensions==3) {
      #pragma omp parallel for collapse(3)
      for (int z =         0; z < numberOfVolumesPerAxisInPatch;          z++)
      for (int y =         0; y < numberOfVolumesPerAxisInPatch;          y++)
      for (int x = -haloSize; x < numberOfVolumesPerAxisInPatch+haloSize; x++) {
        internal::computeFlux_LoopBody<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          0, // normal
          tempFluxX,
          fluxEnumerator
        );
      }


      #pragma omp parallel for collapse(3)
      for (int z =         0; z < numberOfVolumesPerAxisInPatch;           z++)
      for (int y = -haloSize; y < numberOfVolumesPerAxisInPatch+haloSize;  y++)
      for (int x =         0; x < numberOfVolumesPerAxisInPatch;           x++) {
        internal::computeFlux_LoopBody<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          1, // normal
          tempFluxY,
          fluxEnumerator
        );
      }


      #pragma omp parallel for collapse(3)
      for (int z = -haloSize; z < numberOfVolumesPerAxisInPatch+haloSize;  z++)
      for (int y =         0; y < numberOfVolumesPerAxisInPatch;           y++)
      for (int x =         0; x < numberOfVolumesPerAxisInPatch;           x++) {
        internal::computeFlux_LoopBody<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          2, // normal
          tempFluxZ,
          fluxEnumerator
        );
      }


      #pragma omp parallel for collapse(4)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int unknown=0; unknown<unknowns; unknown++) {
        otterLoopIterationBegin();
        internal::updateSolutionWithFlux_LoopBody(
          tempFluxX, tempFluxY, tempFluxZ,
          fluxEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          unknown,
          patchData.dt[patchIndex],
          *(patchData.QOut + patchIndex),
          QOutEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();
    }


    if (evaluateNonconservativeProduct and Dimensions==2) {
      #pragma omp parallel for collapse(2)
      for (int y =         0; y < numberOfVolumesPerAxisInPatch;            y++)
      for (int x = -haloSize; x < numberOfVolumesPerAxisInPatch+haloSize-1; x++) {
        internal::computeNonconservativeFlux_LoopBody<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          0, // normal
          tempNonconservativeProductX,
          ncpEnumerator
        );
      }


      #pragma omp parallel for collapse(2)
      for (int y = -haloSize; y < numberOfVolumesPerAxisInPatch+haloSize-1; y++)
      for (int x =         0; x < numberOfVolumesPerAxisInPatch;            x++) {
        internal::computeNonconservativeFlux_LoopBody<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          1, // normal
          tempNonconservativeProductY,
          ncpEnumerator
        );
      }


      #pragma omp parallel for collapse(3)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int unknown=0; unknown<unknowns; unknown++) {
        internal::updateSolutionWithNonconservativeFlux_LoopBody(
          tempNonconservativeProductX, tempNonconservativeProductY, tempNonconservativeProductZ,
          ncpEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          unknown,
          patchData.dt[patchIndex],
          *(patchData.QOut + patchIndex),
          QOutEnumerator
        );
      }
    }
    else if (evaluateNonconservativeProduct and Dimensions==3) {
        #pragma omp parallel for collapse(3)
        for (int z =         0; z < numberOfVolumesPerAxisInPatch;            z++)
        for (int y =         0; y < numberOfVolumesPerAxisInPatch;            y++)
        for (int x = -haloSize; x < numberOfVolumesPerAxisInPatch+haloSize-1; x++) {
          otterLoopIterationBegin();
          internal::computeNonconservativeFlux_LoopBody<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            0, // normal
            tempNonconservativeProductX,
            ncpEnumerator
          );
        }


        #pragma omp parallel for collapse(3)
        for (int z =         0; z < numberOfVolumesPerAxisInPatch;            z++)
        for (int y = -haloSize; y < numberOfVolumesPerAxisInPatch+haloSize-1; y++)
        for (int x =         0; x < numberOfVolumesPerAxisInPatch;            x++) {
          internal::computeNonconservativeFlux_LoopBody<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            1, // normal
            tempNonconservativeProductY,
            ncpEnumerator
          );
        }


        #pragma omp parallel for collapse(3)
        for (int z = -haloSize; z < numberOfVolumesPerAxisInPatch+haloSize-1; z++)
        for (int y =         0; y < numberOfVolumesPerAxisInPatch;            y++)
        for (int x =         0; x < numberOfVolumesPerAxisInPatch;            x++) {
          internal::computeNonconservativeFlux_LoopBody<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            2, // normal
            tempNonconservativeProductZ,
            ncpEnumerator
          );
        }


        #pragma omp parallel for collapse(4)
        for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
        for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int unknown=0; unknown<unknowns; unknown++) {
          otterLoopIterationBegin();
          internal::updateSolutionWithNonconservativeFlux_LoopBody(
            tempNonconservativeProductX, tempNonconservativeProductY, tempNonconservativeProductZ,
            ncpEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            unknown,
            patchData.dt[patchIndex],
            *(patchData.QOut + patchIndex),
            QOutEnumerator
          );
        }
    }

    if (evaluateMaximumEigenvalueAfterTimeStep and Dimensions==2) {
      logDebug( "timeStepWithRusanov_overlap1_sequential(...)", "compute maximum eigenvalue for subsequent time step" );
      double newMaxEigenvalue = 0.0;
      #pragma omp parallel for collapse(2) reduction(max:newMaxEigenvalue)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        otterLoopIterationBegin();
        newMaxEigenvalue = std::max(
          newMaxEigenvalue,
          internal::reduceMaxEigenvalue_LoopBody<Solver>(
            *(patchData.QOut + patchIndex),
            QOutEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            patchData.t[patchIndex],
            patchData.dt[patchIndex]
          )
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();
      patchData.maxEigenvalue[patchIndex] = newMaxEigenvalue;
    }
    else if (evaluateMaximumEigenvalueAfterTimeStep) {
      double newMaxEigenvalue = 0.0;
      #pragma omp parallel for collapse(3) reduction(max:newMaxEigenvalue)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        otterLoopIterationBegin();
        newMaxEigenvalue = std::max(
          newMaxEigenvalue,
          internal::reduceMaxEigenvalue_LoopBody<Solver>(
            *(patchData.QOut + patchIndex),
            QOutEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex]
          )
        );
      }
      patchData.maxEigenvalue[patchIndex] = newMaxEigenvalue;
    }
  }

  #if defined(GPUOffloadingOMP)
  #pragma omp target exit data map(delete:tempFluxX[0:fluxEnumerator.size()] ) device(targetDevice)
  #pragma omp target exit data map(delete:tempFluxY[0:fluxEnumerator.size()] ) device(targetDevice)
  #pragma omp target exit data map(delete:tempFluxZ[0:fluxEnumerator.size()] ) device(targetDevice)
  #pragma omp target exit data map(delete:tempNonconservativeProductX[0:ncpEnumerator.size()] ) device(targetDevice)
  #pragma omp target exit data map(delete:tempNonconservativeProductY[0:ncpEnumerator.size()] ) device(targetDevice)
  #pragma omp target exit data map(delete:tempNonconservativeProductZ[0:ncpEnumerator.size()] ) device(targetDevice)
  #pragma omp target exit data map(delete:tempEigenvalueX[0:eigenvalueEnumerator.size()] ) device(targetDevice)
  #pragma omp target exit data map(delete:tempEigenvalueY[0:eigenvalueEnumerator.size()] ) device(targetDevice)
  #pragma omp target exit data map(delete:tempEigenvalueZ[0:eigenvalueEnumerator.size()] ) device(targetDevice)

  for (int patchIndex=0; patchIndex<patchData.numberOfCells; patchIndex++) {
    const double* currentQIn  = patchData.QIn[patchIndex];
    double*       currentQOut = patchData.QOut[patchIndex];
    #pragma omp target exit data map(delete:currentQIn[0:QInEnumerator.size()] ) device(targetDevice)
    #pragma omp target exit data map(from:currentQOut[0:QOutEnumerator.size()] ) device(targetDevice)
  }

  #pragma omp target exit data map(delete:serialisedPatchCentres[0:patchData.numberOfCells*Dimensions] ) device(targetDevice)
  #pragma omp target exit data map(delete:serialisedPatchSizes[0:patchData.numberOfCells*Dimensions] ) device(targetDevice)

  tarch::freeMemory( serialisedPatchCentres, tarch::MemoryLocation::ManagedAcceleratorMemory );
  tarch::freeMemory( serialisedPatchSizes,   tarch::MemoryLocation::ManagedAcceleratorMemory );
  #else
  if (tempFluxX!=nullptr)               tarch::freeMemory(tempFluxX, tarch::MemoryLocation::Heap);
  if (tempFluxY!=nullptr)               tarch::freeMemory(tempFluxY, tarch::MemoryLocation::Heap);
  if (tempFluxZ!=nullptr)               tarch::freeMemory(tempFluxZ, tarch::MemoryLocation::Heap);
  if (tempNonconservativeProductX!=nullptr) tarch::freeMemory(tempNonconservativeProductX, tarch::MemoryLocation::Heap);
  if (tempNonconservativeProductY!=nullptr) tarch::freeMemory(tempNonconservativeProductY, tarch::MemoryLocation::Heap);
  if (tempNonconservativeProductZ!=nullptr) tarch::freeMemory(tempNonconservativeProductZ, tarch::MemoryLocation::Heap);
  if (tempEigenvalueX!=nullptr)         tarch::freeMemory(tempEigenvalueX, tarch::MemoryLocation::Heap);
  if (tempEigenvalueY!=nullptr)         tarch::freeMemory(tempEigenvalueY, tarch::MemoryLocation::Heap);
  if (tempEigenvalueZ!=nullptr)         tarch::freeMemory(tempEigenvalueZ, tarch::MemoryLocation::Heap);
  #endif
}

