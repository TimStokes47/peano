#include "Rusanov.h"
#include "tarch/compiler/CompilerSpecificSettings.h"
#include "exahype2/fv/rusanov/LoopBody.h"


template <
  typename Solver,
  int      numberOfVolumesPerAxisInPatch,
  int      haloSize,
  int      unknowns,
  int      auxiliaryVariables,
  typename TempDataEnumerator
>
void exahype2::fv::rusanov::omp::timeStepWithRusanov_patchwise_heap_static_calls(
  int                     targetDevice,
  ::exahype2::CellData&   hostPatchData,
  bool                    evaluateFlux,
  bool                    evaluateNonconservativeProduct,
  bool                    evaluateSource,
  bool                    evaluateMaximumEigenvalueAfterTimeStep
) {
  #if defined(GPUOffloadingOMP)
  /**
   * The halo size passed in by the user might differ from the one that we have to evaluate/
   * take into account from the solver's perspective.
   */
  constexpr int solversHaloSize        = 1;

  exahype2::enumerator::AoSLexicographicEnumerator QInHostEnumerator       (                        1, numberOfVolumesPerAxisInPatch, haloSize, unknowns, auxiliaryVariables);
  exahype2::enumerator::AoSLexicographicEnumerator QOutHostEnumerator      (                        1, numberOfVolumesPerAxisInPatch,        0, unknowns, auxiliaryVariables);
  TempDataEnumerator fluxHostEnumerator      (hostPatchData.numberOfCells, numberOfVolumesPerAxisInPatch,   solversHaloSize, unknowns, 0);
  TempDataEnumerator ncpHostEnumerator       (hostPatchData.numberOfCells, numberOfVolumesPerAxisInPatch+1, solversHaloSize, unknowns, 0);
  TempDataEnumerator eigenvalueHostEnumerator(hostPatchData.numberOfCells, numberOfVolumesPerAxisInPatch,   solversHaloSize,        1, 0);

/*
  double* helperArray[9];
  double* tempFluxX = helperArray[0];
  double* tempFluxY = helperArray[1];
  double* tempFluxZ = helperArray[2];
  double* tempNonconservativeProductX = helperArray[3];
  double* tempNonconservativeProductY = helperArray[4];
  double* tempNonconservativeProductZ = helperArray[5];
  double* tempEigenvalueX = helperArray[6];
  double* tempEigenvalueY = helperArray[7];
  double* tempEigenvalueZ = helperArray[8];
*/

// @todo docu
/*
  double* tempFluxXHostPointer                   = (double*) omp_target_alloc( fluxHostEnumerator.size(), targetDevice); 
  double* tempFluxYHostPointer                   = (double*) omp_target_alloc( fluxHostEnumerator.size(), targetDevice);
  double* tempFluxZHostPointer                   = (double*) omp_target_alloc( fluxHostEnumerator.size(), targetDevice);
  double* tempNonconservativeProductXHostPointer = (double*) omp_target_alloc( ncpHostEnumerator.size(), targetDevice);
  double* tempNonconservativeProductYHostPointer = (double*) omp_target_alloc( ncpHostEnumerator.size(), targetDevice);
  double* tempNonconservativeProductZHostPointer = (double*) omp_target_alloc( ncpHostEnumerator.size(), targetDevice);
  double* tempEigenvalueXHostPointer             = (double*) omp_target_alloc( eigenvalueHostEnumerator.size(), targetDevice);
  double* tempEigenvalueYHostPointer             = (double*) omp_target_alloc( eigenvalueHostEnumerator.size(), targetDevice);
  double* tempEigenvalueZHostPointer             = (double*) omp_target_alloc( eigenvalueHostEnumerator.size(), targetDevice);

  double* tempFluxX                   = (double*) omp_get_mapped_ptr( tempFluxXHostPointer, targetDevice );
  double* tempFluxY                   = (double*) omp_get_mapped_ptr( tempFluxYHostPointer, targetDevice );
  double* tempFluxZ                   = (double*) omp_get_mapped_ptr( tempFluxZHostPointer, targetDevice );
  double* tempNonconservativeProductX = (double*) omp_get_mapped_ptr( tempNonconservativeProductXHostPointer, targetDevice );
  double* tempNonconservativeProductY = (double*) omp_get_mapped_ptr( tempNonconservativeProductYHostPointer, targetDevice );
  double* tempNonconservativeProductZ = (double*) omp_get_mapped_ptr( tempNonconservativeProductZHostPointer, targetDevice );
  double* tempEigenvalueX             = (double*) omp_get_mapped_ptr( tempEigenvalueXHostPointer, targetDevice );
  double* tempEigenvalueY             = (double*) omp_get_mapped_ptr( tempEigenvalueYHostPointer, targetDevice );
  double* tempEigenvalueZ             = (double*) omp_get_mapped_ptr( tempEigenvalueZHostPointer, targetDevice );
*/

/*
  double* tempFluxX = nullptr;
  double* tempFluxY = nullptr;
  double* tempFluxZ = nullptr;
  double* tempNonconservativeProductX = nullptr;
  double* tempNonconservativeProductY = nullptr;
  double* tempNonconservativeProductZ = nullptr;
  double* tempEigenvalueX = nullptr;
  double* tempEigenvalueY = nullptr;
  double* tempEigenvalueZ = nullptr; 
*/


  double* tempFluxX = new double[fluxHostEnumerator.size()];
  double* tempFluxY = new double[fluxHostEnumerator.size()];
  double* tempFluxZ = new double[fluxHostEnumerator.size()];
  double* tempNonconservativeProductX = new double[ncpHostEnumerator.size()];
  double* tempNonconservativeProductY = new double[ncpHostEnumerator.size()];
  double* tempNonconservativeProductZ = new double[ncpHostEnumerator.size()];
  double* tempEigenvalueX = new double[eigenvalueHostEnumerator.size()];
  double* tempEigenvalueY = new double[eigenvalueHostEnumerator.size()];
  double* tempEigenvalueZ = new double[eigenvalueHostEnumerator.size()];

  #pragma omp target enter data map(alloc:tempFluxX[0:fluxHostEnumerator.size()] ) device(targetDevice)
  #pragma omp target enter data map(alloc:tempFluxY[0:fluxHostEnumerator.size()] ) device(targetDevice)
  #pragma omp target enter data map(alloc:tempFluxZ[0:fluxHostEnumerator.size()] ) device(targetDevice)
  #pragma omp target enter data map(alloc:tempNonconservativeProductX[0:ncpHostEnumerator.size()] ) device(targetDevice)
  #pragma omp target enter data map(alloc:tempNonconservativeProductY[0:ncpHostEnumerator.size()] ) device(targetDevice)
  #pragma omp target enter data map(alloc:tempNonconservativeProductZ[0:ncpHostEnumerator.size()] ) device(targetDevice)
  #pragma omp target enter data map(alloc:tempEigenvalueX[0:eigenvalueHostEnumerator.size()] ) device(targetDevice)
  #pragma omp target enter data map(alloc:tempEigenvalueY[0:eigenvalueHostEnumerator.size()] ) device(targetDevice)
  #pragma omp target enter data map(alloc:tempEigenvalueZ[0:eigenvalueHostEnumerator.size()] ) device(targetDevice)


  double**  mappedPointersToQIn          = new double*[ hostPatchData.numberOfCells ];
  double**  mappedPointersToQOut         = new double*[ hostPatchData.numberOfCells ];

  for (int patchIndex=0; patchIndex<hostPatchData.numberOfCells; patchIndex++) {
    const double* currentQIn  = hostPatchData.QIn[patchIndex];
    double*       currentQOut = hostPatchData.QOut[patchIndex];

    #pragma omp target enter data map(to:currentQIn[0:QInHostEnumerator.size()] ) device(targetDevice)
    #pragma omp target enter data map(alloc:currentQOut[0:QOutHostEnumerator.size()] ) device(targetDevice)
    
    mappedPointersToQIn[patchIndex]  = (double*) omp_get_mapped_ptr( currentQIn,  targetDevice );
    mappedPointersToQOut[patchIndex] = (double*) omp_get_mapped_ptr( currentQOut, targetDevice );
  }

  const int numberOfCells            = hostPatchData.numberOfCells;
  double*   rawPointerToCellCentres  = hostPatchData.cellCentre[0].data();
  double*   rawPointerToCellSizes    = hostPatchData.cellSize[0].data();
  double*   t                        = hostPatchData.t;
  double*   dt                       = hostPatchData.dt;
  double*   maxEigenvalue            = hostPatchData.maxEigenvalue;

  #pragma omp target teams distribute device(targetDevice) \
    map(to:rawPointerToCellCentres[0:hostPatchData.numberOfCells*Dimensions]) \
    map(to:rawPointerToCellSizes  [0:hostPatchData.numberOfCells*Dimensions]) \
    map(to:mappedPointersToQIn     [0:hostPatchData.numberOfCells])            \
    map(to:mappedPointersToQOut    [0:hostPatchData.numberOfCells])            \
    map(to:t[0:hostPatchData.numberOfCells]) \
    map(to:dt[0:hostPatchData.numberOfCells]) \
    map(from:maxEigenvalue[0:hostPatchData.numberOfCells])
  for (int patchIndex=0; patchIndex<numberOfCells; patchIndex++) {
    // @todo docu manual assembly of patch data meta object on GPU
    GPUCellData patchData;
    patchData.numberOfCells = numberOfCells;
    patchData.cellCentre   = (tarch::la::Vector<Dimensions,double>*)(rawPointerToCellCentres);
    patchData.cellSize     = (tarch::la::Vector<Dimensions,double>*)(rawPointerToCellSizes);
    patchData.QIn           = mappedPointersToQIn;
    patchData.QOut          = mappedPointersToQOut;
    patchData.t             = t;
    patchData.dt            = dt;
    patchData.maxEigenvalue = maxEigenvalue;

    exahype2::enumerator::AoSLexicographicEnumerator QInEnumerator       (                        1, numberOfVolumesPerAxisInPatch,haloSize,unknowns,auxiliaryVariables);
    exahype2::enumerator::AoSLexicographicEnumerator QOutEnumerator      (                        1, numberOfVolumesPerAxisInPatch,       0,unknowns,auxiliaryVariables);
    TempDataEnumerator fluxEnumerator      (patchData.numberOfCells, numberOfVolumesPerAxisInPatch,haloSize,unknowns,0);
    TempDataEnumerator ncpEnumerator       (patchData.numberOfCells, numberOfVolumesPerAxisInPatch+1,haloSize,unknowns,0);
    TempDataEnumerator eigenvalueEnumerator(patchData.numberOfCells, numberOfVolumesPerAxisInPatch,haloSize,1,0);

    if (Dimensions==2 and evaluateSource) {
      #pragma omp parallel for simd collapse(2)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        internal::copySolutionAndAddSourceTerm_LoopBody<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.cellCentre[patchIndex],
          patchData.cellSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          patchData.QOut[patchIndex],
          QOutEnumerator
        );
      }
    }
    else if (Dimensions==3 and evaluateSource) {
      #pragma omp parallel for simd collapse(3)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        internal::copySolutionAndAddSourceTerm_LoopBody<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.cellCentre[patchIndex],
          patchData.cellSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          patchData.QOut[patchIndex],
          QOutEnumerator
        );
      }
    } 
    else if (Dimensions==2) {
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      #pragma omp parallel for simd collapse(2)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int unknown=0; unknown<unknowns+auxiliaryVariables; unknown++) {
        internal::copySolution_LoopBody(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchIndex,
          volumeIndex2d(x,y),
          unknown,
          patchData.QOut[patchIndex],
          QOutEnumerator
        );
      }
    }
    else {
      #pragma omp parallel for simd collapse(4)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int unknown=0; unknown<unknowns+auxiliaryVariables; unknown++) {
        internal::copySolution_LoopBody(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchIndex,
          volumeIndex3d(x,y,z),
          unknown,
          patchData.QOut[patchIndex],
          QOutEnumerator
        );
      }
    }

    if (Dimensions==2) {
      #pragma omp parallel for collapse(2)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = -solversHaloSize; x < numberOfVolumesPerAxisInPatch+solversHaloSize; x++) {
        internal::computeMaxEigenvalue_LoopBody<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.cellCentre[patchIndex],
            patchData.cellSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            patchData.t[patchIndex], patchData.dt[patchIndex],
            0,
            tempEigenvalueX,
            eigenvalueEnumerator
        );
      }

      #pragma omp parallel for collapse(2)
      for (int y = -solversHaloSize; y < numberOfVolumesPerAxisInPatch+solversHaloSize; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        internal::computeMaxEigenvalue_LoopBody<Solver>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.cellCentre[patchIndex],
            patchData.cellSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            patchData.t[patchIndex], patchData.dt[patchIndex],
            1,
            tempEigenvalueY,
            eigenvalueEnumerator
        );
      }


      #pragma omp parallel for collapse(3)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int unknown = 0; unknown < unknowns; unknown++) {
        internal::updateSolutionWithEigenvalueDamping_LoopBody(
          patchData.QIn[patchIndex],
          QInEnumerator,
          tempEigenvalueX,
          tempEigenvalueY,
          tempEigenvalueZ,
          eigenvalueEnumerator,
          patchData.cellCentre[patchIndex],
          patchData.cellSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          unknown,
          patchData.dt[patchIndex],
          patchData.QOut[patchIndex],
          QOutEnumerator
        );
      } 
    }
    else {
      #pragma omp parallel for collapse(3)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = -solversHaloSize; x < numberOfVolumesPerAxisInPatch+solversHaloSize; x++) {
        internal::computeMaxEigenvalue_LoopBody<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.cellCentre[patchIndex],
          patchData.cellSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          patchData.t[patchIndex], patchData.dt[patchIndex],
          0,
          tempEigenvalueX,
          eigenvalueEnumerator
        );
      }


      #pragma omp parallel for collapse(3)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int y = -solversHaloSize; y < numberOfVolumesPerAxisInPatch+solversHaloSize; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        internal::computeMaxEigenvalue_LoopBody<Solver>(
              patchData.QIn[patchIndex],
              QInEnumerator,
              patchData.cellCentre[patchIndex],
              patchData.cellSize[patchIndex],
              patchIndex,
              volumeIndex3d(x,y,z),
              patchData.t[patchIndex], patchData.dt[patchIndex],
              1,
              tempEigenvalueY,
              eigenvalueEnumerator
        );
      }


      #pragma omp parallel for collapse(3)
      for (int z = -solversHaloSize; z < numberOfVolumesPerAxisInPatch+solversHaloSize; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        internal::computeMaxEigenvalue_LoopBody<Solver>(
              patchData.QIn[patchIndex],
              QInEnumerator,
              patchData.cellCentre[patchIndex],
              patchData.cellSize[patchIndex],
              patchIndex,
              volumeIndex3d(x,y,z),
              patchData.t[patchIndex], patchData.dt[patchIndex],
              2,
              tempEigenvalueZ,
              eigenvalueEnumerator
        );
      }


      #pragma omp parallel for collapse(4)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int unknown = 0; unknown < unknowns; unknown++) {
        internal::updateSolutionWithEigenvalueDamping_LoopBody(
          patchData.QIn[patchIndex],
          QInEnumerator,
          tempEigenvalueX,
          tempEigenvalueY,
          tempEigenvalueZ,
          eigenvalueEnumerator,
          patchData.cellCentre[patchIndex],
          patchData.cellSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          unknown,
          patchData.dt[patchIndex],
          patchData.QOut[patchIndex],
          QOutEnumerator
        );
      }
    }


    if (evaluateFlux and Dimensions==2) {
      #pragma omp parallel for collapse(2)
      for (int y =         0; y < numberOfVolumesPerAxisInPatch;          y++)
      for (int x = -solversHaloSize; x < numberOfVolumesPerAxisInPatch+solversHaloSize; x++) {
        internal::computeFlux_LoopBody<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.cellCentre[patchIndex],
          patchData.cellSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          0, // normal
          tempFluxX,
          fluxEnumerator
        );
      }


      #pragma omp parallel for collapse(2)
      for (int y = -solversHaloSize; y < numberOfVolumesPerAxisInPatch+solversHaloSize;  y++)
      for (int x =         0; x < numberOfVolumesPerAxisInPatch;           x++) {
        internal::computeFlux_LoopBody<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.cellCentre[patchIndex],
          patchData.cellSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          1, // normal
          tempFluxY,
          fluxEnumerator
        );
      }


      #pragma omp parallel for collapse(3)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int unknown=0; unknown<unknowns; unknown++) {
        internal::updateSolutionWithFlux_LoopBody(
          tempFluxX, tempFluxY, tempFluxZ,
          fluxEnumerator,
          patchData.cellCentre[patchIndex],
          patchData.cellSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          unknown,
          patchData.dt[patchIndex],
          *(patchData.QOut + patchIndex),
          QOutEnumerator
        );
      }
    }
    else if (evaluateFlux and Dimensions==3) {
      #pragma omp parallel for collapse(3)
      for (int z =         0; z < numberOfVolumesPerAxisInPatch;          z++)
      for (int y =         0; y < numberOfVolumesPerAxisInPatch;          y++)
      for (int x = -solversHaloSize; x < numberOfVolumesPerAxisInPatch+solversHaloSize; x++) {
        internal::computeFlux_LoopBody<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.cellCentre[patchIndex],
          patchData.cellSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          0, // normal
          tempFluxX,
          fluxEnumerator
        );
      }


      #pragma omp parallel for collapse(3)
      for (int z =                0; z < numberOfVolumesPerAxisInPatch;                  z++)
      for (int y = -solversHaloSize; y < numberOfVolumesPerAxisInPatch+solversHaloSize;  y++)
      for (int x =         0; x < numberOfVolumesPerAxisInPatch;           x++) {
        internal::computeFlux_LoopBody<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.cellCentre[patchIndex],
          patchData.cellSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          1, // normal
          tempFluxY,
          fluxEnumerator
        );
      }


      #pragma omp parallel for collapse(3)
      for (int z = -solversHaloSize; z < numberOfVolumesPerAxisInPatch+solversHaloSize; z++)
      for (int y =                0; y < numberOfVolumesPerAxisInPatch;                 y++)
      for (int x =                0; x < numberOfVolumesPerAxisInPatch;                 x++) {
        internal::computeFlux_LoopBody<Solver>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.cellCentre[patchIndex],
          patchData.cellSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          2, // normal
          tempFluxZ,
          fluxEnumerator
        );
      }


      #pragma omp parallel for collapse(4)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int unknown=0; unknown<unknowns; unknown++) {
        internal::updateSolutionWithFlux_LoopBody(
          tempFluxX, tempFluxY, tempFluxZ,
          fluxEnumerator,
          patchData.cellCentre[patchIndex],
          patchData.cellSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          unknown,
          patchData.dt[patchIndex],
          *(patchData.QOut + patchIndex),
          QOutEnumerator
        );
      }
    }


    if (evaluateNonconservativeProduct and Dimensions==2) {
      #pragma omp parallel for collapse(2)
      for (int y =                0; y < numberOfVolumesPerAxisInPatch;                   y++)
      for (int x = -solversHaloSize; x < numberOfVolumesPerAxisInPatch+solversHaloSize-1; x++) {
        internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.cellCentre[patchIndex],
          patchData.cellSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          0, // normal
          tempNonconservativeProductX,
          ncpEnumerator
        );
      }


      #pragma omp parallel for collapse(2)
      for (int y = -solversHaloSize; y < numberOfVolumesPerAxisInPatch+solversHaloSize-1; y++)
      for (int x =                0; x < numberOfVolumesPerAxisInPatch;                   x++) {
        internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.cellCentre[patchIndex],
          patchData.cellSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          1, // normal
          tempNonconservativeProductY,
          ncpEnumerator
        );
      }


      #pragma omp parallel for collapse(3)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int unknown=0; unknown<unknowns; unknown++) {
        internal::updateSolutionWithNonconservativeFlux_LoopBody(
          tempNonconservativeProductX, tempNonconservativeProductY, tempNonconservativeProductZ,
          ncpEnumerator,
          patchData.cellCentre[patchIndex],
          patchData.cellSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          unknown,
          patchData.dt[patchIndex],
          *(patchData.QOut + patchIndex),
          QOutEnumerator
        );
      }
    }
    else if (evaluateNonconservativeProduct and Dimensions==3) {
        #pragma omp parallel for collapse(3)
        for (int z =         0; z < numberOfVolumesPerAxisInPatch;            z++)
        for (int y =         0; y < numberOfVolumesPerAxisInPatch;            y++)
        for (int x = -solversHaloSize; x < numberOfVolumesPerAxisInPatch+solversHaloSize-1; x++) {
          internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.cellCentre[patchIndex],
            patchData.cellSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            0, // normal
            tempNonconservativeProductX,
            ncpEnumerator
          );
        }


        #pragma omp parallel for collapse(3)
        for (int z =         0; z < numberOfVolumesPerAxisInPatch;            z++)
        for (int y = -solversHaloSize; y < numberOfVolumesPerAxisInPatch+solversHaloSize-1; y++)
        for (int x =         0; x < numberOfVolumesPerAxisInPatch;            x++) {
          internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.cellCentre[patchIndex],
            patchData.cellSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            1, // normal
            tempNonconservativeProductY,
            ncpEnumerator
          );
        }


        #pragma omp parallel for collapse(3)
        for (int z = -solversHaloSize; z < numberOfVolumesPerAxisInPatch+solversHaloSize-1; z++)
        for (int y =         0; y < numberOfVolumesPerAxisInPatch;            y++)
        for (int x =         0; x < numberOfVolumesPerAxisInPatch;            x++) {
          internal::computeNonconservativeFlux_LoopBody<Solver,unknowns,auxiliaryVariables>(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.cellCentre[patchIndex],
            patchData.cellSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            2, // normal
            tempNonconservativeProductZ,
            ncpEnumerator
          );
        }


        #pragma omp parallel for collapse(4)
        for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
        for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int unknown=0; unknown<unknowns; unknown++) {
          internal::updateSolutionWithNonconservativeFlux_LoopBody(
            tempNonconservativeProductX, tempNonconservativeProductY, tempNonconservativeProductZ,
            ncpEnumerator,
            patchData.cellCentre[patchIndex],
            patchData.cellSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            unknown,
            patchData.dt[patchIndex],
            *(patchData.QOut + patchIndex),
            QOutEnumerator
          );
        }
    }
    if (evaluateMaximumEigenvalueAfterTimeStep and Dimensions==2) {
      double newMaxEigenvalue = 0.0;
      #pragma omp parallel for collapse(2) reduction(max:newMaxEigenvalue)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        newMaxEigenvalue = std::max(
          newMaxEigenvalue,
          internal::reduceMaxEigenvalue_LoopBody<Solver>(
            *(patchData.QOut + patchIndex),
            QOutEnumerator,
            patchData.cellCentre[patchIndex],
            patchData.cellSize[patchIndex],
            patchIndex,
            volumeIndex2d(x,y),
            patchData.t[patchIndex],
            patchData.dt[patchIndex]
          )
        );
      }
      patchData.maxEigenvalue[patchIndex] = newMaxEigenvalue;
    }
    else if (evaluateMaximumEigenvalueAfterTimeStep) {
      double newMaxEigenvalue = 0.0;
      #pragma omp parallel for collapse(3) reduction(max:newMaxEigenvalue)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++) {
        newMaxEigenvalue = std::max(
          newMaxEigenvalue,
          internal::reduceMaxEigenvalue_LoopBody<Solver>(
            *(patchData.QOut + patchIndex),
            QOutEnumerator,
            patchData.cellCentre[patchIndex],
            patchData.cellSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex]
          )
        );
      }
    }
  } // This is the end of the target offloading block

  #pragma omp target exit data map(delete:tempFluxX[0:fluxHostEnumerator.size()] ) device(targetDevice)
  #pragma omp target exit data map(delete:tempFluxY[0:fluxHostEnumerator.size()] ) device(targetDevice)
  #pragma omp target exit data map(delete:tempFluxZ[0:fluxHostEnumerator.size()] ) device(targetDevice)
  #pragma omp target exit data map(delete:tempNonconservativeProductX[0:ncpHostEnumerator.size()] ) device(targetDevice)
  #pragma omp target exit data map(delete:tempNonconservativeProductY[0:ncpHostEnumerator.size()] ) device(targetDevice)
  #pragma omp target exit data map(delete:tempNonconservativeProductZ[0:ncpHostEnumerator.size()] ) device(targetDevice)
  #pragma omp target exit data map(delete:tempEigenvalueX[0:eigenvalueHostEnumerator.size()] ) device(targetDevice)
  #pragma omp target exit data map(delete:tempEigenvalueY[0:eigenvalueHostEnumerator.size()] ) device(targetDevice)
  #pragma omp target exit data map(delete:tempEigenvalueZ[0:eigenvalueHostEnumerator.size()] ) device(targetDevice)

  for (int patchIndex=0; patchIndex<hostPatchData.numberOfCells; patchIndex++) {
    const double* currentQIn  = hostPatchData.QIn[patchIndex];
    double*       currentQOut = hostPatchData.QOut[patchIndex];
    #pragma omp target exit data map(delete:currentQIn[0:QInHostEnumerator.size()] ) device(targetDevice)
    #pragma omp target exit data map(from:currentQOut[0:QOutHostEnumerator.size()] ) device(targetDevice)
  }

  delete[] mappedPointersToQIn;
  delete[] mappedPointersToQOut;

  // @todo See comment. Should not be necessary, but it is necessary atm. See documentation.
  if (tempFluxX!=nullptr) delete[] tempFluxX;
  if (tempFluxY!=nullptr) delete[] tempFluxY;
  if (tempFluxZ!=nullptr) delete[] tempFluxZ;
  if (tempNonconservativeProductX!=nullptr) delete[] tempNonconservativeProductX;
  if (tempNonconservativeProductY!=nullptr) delete[] tempNonconservativeProductY;
  if (tempNonconservativeProductZ!=nullptr) delete[] tempNonconservativeProductZ;
  if (tempEigenvalueX!=nullptr) delete[] tempEigenvalueX;
  if (tempEigenvalueY!=nullptr) delete[] tempEigenvalueY;
  if (tempEigenvalueZ!=nullptr) delete[] tempEigenvalueZ;

  #else
  assertionMsg(false, "this routine should only be used in combination with OpenMP offloading, as it has a device parameter" );
  #endif
}

