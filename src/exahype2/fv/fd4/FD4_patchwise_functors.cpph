#include "../../../tarch/multicore/otter.h"
#include "FD4.h"


void exahype2::fv::fd4::timeStepWithFD4_patchwise_heap_functors(
  ::exahype2::CellData&   patchData,
  int                     numberOfVolumesPerAxisInPatch,
  int                     haloSize,
  int                     unknowns,
  int                     auxiliaryVariables,
  bool                    evaluateFlux,
  bool                    evaluateDifferentialSource, //for ncp
  bool                    evaluateAlgebraicSource, //real source
  bool                    evaluateMaximumEigenvalueAfterTimeStep,
  Flux                    flux,
  NonconservativeProduct  DifferentialSource,
  Source                  AlgebraicSource,
  MaxEigenvalue           maxEigenvalue
) {
  static tarch::logging::Log _log( "exahype2::fv::fd4" );

  /**
   * The halo size passed in by the user might differ from the one that we have to evaluate/
   * take into account from the solver's perspective.
   */
  // constexpr int solversHaloSize = 3; // TODO: I think we don't need a solversHaloeSize here, but check

  assertionEquals(haloSize,3); // TODO: this is the data stricture halo size which I think should be 3, but check

  bool evaluateKODissipation=true;
  
  exahype2::enumerator::AoSLexicographicEnumerator QInEnumerator (1,numberOfVolumesPerAxisInPatch,haloSize,unknowns,auxiliaryVariables);
  exahype2::enumerator::AoSLexicographicEnumerator QOutEnumerator(1,numberOfVolumesPerAxisInPatch,0,       unknowns,auxiliaryVariables);

  double* tempDifferentialSourceX =  evaluateDifferentialSource                    ? tarch::allocateMemory( QOutEnumerator.size(),tarch::MemoryLocation::Heap ) : nullptr;
  double* tempDifferentialSourceY =  evaluateDifferentialSource                    ? tarch::allocateMemory( QOutEnumerator.size(),tarch::MemoryLocation::Heap ) : nullptr;
  double* tempDifferentialSourceZ = (evaluateDifferentialSource and Dimensions==3) ? tarch::allocateMemory( QOutEnumerator.size(),tarch::MemoryLocation::Heap ) : nullptr;
  double* tempKODissipationX      =  evaluateKODissipation                         ? tarch::allocateMemory( QOutEnumerator.size(),tarch::MemoryLocation::Heap ) : nullptr;
  double* tempKODissipationY      =  evaluateKODissipation                         ? tarch::allocateMemory( QOutEnumerator.size(),tarch::MemoryLocation::Heap ) : nullptr;
  double* tempKODissipationZ      = (evaluateKODissipation      and Dimensions==3) ? tarch::allocateMemory( QOutEnumerator.size(),tarch::MemoryLocation::Heap ) : nullptr;

  
  // STEP 1: copy solution from old array to new array, and/or add the change due to algebraic source terms
  for (int patchIndex=0; patchIndex<patchData.numberOfCells; patchIndex++) {
    logDebug( "timeStepWithFD4_sequential(...)", "evaluate algebraic source terms and/or copy solution over" );
    if (Dimensions==2 and evaluateAlgebraicSource) {
      otterLoopBegin();
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++) {
        otterLoopIterationBegin();
        internal::copySolutionAndAddAlgebraicSourceTerm_LoopBody(
          patchData.QIn[patchIndex],
          QInEnumerator,
          AlgebraicSource,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          patchData.QOut[patchIndex],
          QOutEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();
    }
    else if (Dimensions==3 and evaluateAlgebraicSource) {
      otterLoopBegin();
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++) {
        otterLoopIterationBegin();
        internal::copySolutionAndAddAlgebraicSourceTerm_LoopBody(
          patchData.QIn[patchIndex],
          QInEnumerator,
          AlgebraicSource,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          patchData.QOut[patchIndex],
          QOutEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();
    }
    else if (Dimensions==2) {
      otterLoopBegin();
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int unknown=0; unknown<unknowns+auxiliaryVariables; unknown++) {
        otterLoopIterationBegin();
        internal::copySolution_LoopBody(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchIndex,
          volumeIndex2d(x,y),
          unknown,
          patchData.QOut[patchIndex],
          QOutEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();
    }
    else {
      otterLoopBegin();
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int unknown=0; unknown<unknowns+auxiliaryVariables; unknown++) {
        otterLoopIterationBegin();
        internal::copySolution_LoopBody(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchIndex,
          volumeIndex3d(x,y,z),
          unknown,
          patchData.QOut[patchIndex],
          QOutEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();
    }


    // STEP 2: Evaluate differential source and update solution accordingly 
    if (evaluateDifferentialSource and Dimensions==2) {
      otterLoopBegin();
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++) {
        otterLoopIterationBegin();
        internal::computeDifferentialSourceTerm_LoopBody(
          patchData.QIn[patchIndex],
          QInEnumerator,
          DifferentialSource,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          0, // normal
          tempDifferentialSourceX,
          QOutEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();

      otterLoopBegin();
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++) {
        otterLoopIterationBegin();
        internal::computeDifferentialSourceTerm_LoopBody(
          patchData.QIn[patchIndex],
          QInEnumerator,
          DifferentialSource,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          1, // normal
          tempDifferentialSourceY,
          QOutEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();

      otterLoopBegin();
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int unknown=0; unknown<unknowns; unknown++) {
        otterLoopIterationBegin();
        internal::updateSolutionWithDifferentialSourceTerm_LoopBody(
          tempDifferentialSourceX, tempDifferentialSourceY, tempDifferentialSourceZ,
          QOutEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          unknown,
          patchData.dt[patchIndex],
          *(patchData.QOut + patchIndex),
          QOutEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();
    }
    else if (evaluateDifferentialSource and Dimensions==3) {
      otterLoopBegin();
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++) {
        otterLoopIterationBegin();
        internal::computeDifferentialSourceTerm_LoopBody(
          patchData.QIn[patchIndex],
          QInEnumerator,
          DifferentialSource,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          0, // normal
          tempDifferentialSourceX,
          QOutEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();

      otterLoopBegin();
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++) {
        otterLoopIterationBegin();
        internal::computeDifferentialSourceTerm_LoopBody(
          patchData.QIn[patchIndex],
          QInEnumerator,
          DifferentialSource,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          1, // normal
          tempDifferentialSourceY,
          QOutEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();

      otterLoopBegin();
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++) {
        otterLoopIterationBegin();
        internal::computeDifferentialSourceTerm_LoopBody(
          patchData.QIn[patchIndex],
          QInEnumerator,
          DifferentialSource,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          2, // normal
          tempDifferentialSourceZ,
          QOutEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();

      otterLoopBegin();
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
      for (int unknown=0; unknown<unknowns; unknown++) {
        otterLoopIterationBegin();
        internal::updateSolutionWithDifferentialSourceTerm_LoopBody(
          tempDifferentialSourceX, tempDifferentialSourceY, tempDifferentialSourceZ,
          QOutEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex3d(x,y,z),
          unknown,
          patchData.dt[patchIndex],
          *(patchData.QOut + patchIndex),
          QOutEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();
    }

    // STEP 3: compute the Kreiss Oliger dissipation and add it to the solution
    if (evaluateKODissipation and Dimensions==2) {
      otterLoopBegin();
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++) {
        otterLoopIterationBegin();
        internal::computeKreissOligerDissipationTerm_LoopBody(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          0, // normal
          tempKODissipationX,
          QOutEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();

      otterLoopBegin();
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++) {
        otterLoopIterationBegin();
        internal::computeKreissOligerDissipationTerm_LoopBody(
          patchData.QIn[patchIndex],
          QInEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          patchData.t[patchIndex],
          patchData.dt[patchIndex],
          1, // normal
          tempKODissipationY,
          QOutEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();

      otterLoopBegin();
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int unknown=0; unknown<unknowns; unknown++) {
        otterLoopIterationBegin();
        internal::updateSolutionWithKODissipationTerm_LoopBody(
          tempKODissipationX, tempKODissipationY, tempKODissipationZ,
          QOutEnumerator,
          patchData.patchCentre[patchIndex],
          patchData.patchSize[patchIndex],
          patchIndex,
          volumeIndex2d(x,y),
          unknown,
          patchData.dt[patchIndex],
          *(patchData.QOut + patchIndex),
          QOutEnumerator
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();
    }
    else if (evaluateKODissipation and Dimensions==3) {
        otterLoopBegin();
        for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
        for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++) {
          otterLoopIterationBegin();
          internal::computeKreissOligerDissipationTerm_LoopBody(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            0, // normal
            tempKODissipationX,
            QOutEnumerator
          );
          otterLoopIterationEnd();
        }
        otterLoopEnd();

        otterLoopBegin();
        for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
        for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++) {
          otterLoopIterationBegin();
          internal::computeKreissOligerDissipationTerm_LoopBody(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            1, // normal
            tempKODissipationY,
            QOutEnumerator
          );
          otterLoopIterationEnd();
        }
        otterLoopEnd();

        otterLoopBegin();
        for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
        for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++) {
          otterLoopIterationBegin();
          internal::computeKreissOligerDissipationTerm_LoopBody(
            patchData.QIn[patchIndex],
            QInEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex],
            2, // normal
            tempKODissipationZ,
            QOutEnumerator
          );
          otterLoopIterationEnd();
        }
        otterLoopEnd();

        otterLoopBegin();
        for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
        for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
        for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++)
        for (int unknown=0; unknown<unknowns; unknown++) {
          otterLoopIterationBegin();
          internal::updateSolutionWithKODissipationTerm_LoopBody(
            tempKODissipationX, tempKODissipationY, tempKODissipationZ,
            QOutEnumerator,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            unknown,
            patchData.dt[patchIndex],
            *(patchData.QOut + patchIndex),
            QOutEnumerator
          );
          otterLoopIterationEnd();
        }
        otterLoopEnd();
    }


    // STEP4: compute maximum eigenvalue for subsequent time step
    if (evaluateMaximumEigenvalueAfterTimeStep) {
      double newMaxEigenvalue = 0.0;
      otterLoopBegin(); // TODO: how do I clarify that this is a reduction? Do we need this info here?
      for (int x = 0; x < numberOfVolumesPerAxisInPatch; x++)
      for (int y = 0; y < numberOfVolumesPerAxisInPatch; y++)
      for (int z = 0; z < numberOfVolumesPerAxisInPatch; z++) {
        otterLoopIterationBegin();
        newMaxEigenvalue = std::max(
          newMaxEigenvalue,
          internal::reduceMaxEigenvalue_LoopBody(
            *(patchData.QOut + patchIndex),
            QOutEnumerator,
            maxEigenvalue,
            patchData.patchCentre[patchIndex],
            patchData.patchSize[patchIndex],
            patchIndex,
            volumeIndex3d(x,y,z),
            patchData.t[patchIndex],
            patchData.dt[patchIndex]
          )
        );
        otterLoopIterationEnd();
      }
      otterLoopEnd();
      patchData.maxEigenvalue[patchIndex] = newMaxEigenvalue;
    }


  }

  if (tempDifferentialSourceX!=nullptr) tarch::freeMemory(tempDifferentialSourceX, tarch::MemoryLocation::Heap);
  if (tempDifferentialSourceY!=nullptr) tarch::freeMemory(tempDifferentialSourceY, tarch::MemoryLocation::Heap);
  if (tempDifferentialSourceZ!=nullptr) tarch::freeMemory(tempDifferentialSourceZ, tarch::MemoryLocation::Heap);
  if (tempKODissipationX!=nullptr)      tarch::freeMemory(tempKODissipationX,      tarch::MemoryLocation::Heap);
  if (tempKODissipationY!=nullptr)      tarch::freeMemory(tempKODissipationY,      tarch::MemoryLocation::Heap);
  if (tempKODissipationZ!=nullptr)      tarch::freeMemory(tempKODissipationZ,      tarch::MemoryLocation::Heap);

}
