#include "exahype2/Solver.h"
#include "exahype2/fv/PatchUtils.h"
#include "tarch/compiler/CompilerSpecificSettings.h"

#if defined(GPUOffloadingOMP)
#pragma omp declare target
#endif
template <class QInEnumeratorType, class QOutEnumeratorType>
void exahype2::fv::riemann::internal::copySolution_LoopBody(
  const double* __restrict__ QIn,
  const QInEnumeratorType&                  QInEnumerator,
  int                                       patchIndex,
  const tarch::la::Vector<Dimensions, int>& volumeIndex,
  int                                       unknown,
  double* __restrict__ QOut,
  const QOutEnumeratorType& QOutEnumerator
) {
  QOut[QOutEnumerator(patchIndex, volumeIndex, unknown)] = QIn[QInEnumerator(patchIndex, volumeIndex, unknown)];
}
#if defined(GPUOffloadingOMP)
#pragma omp end declare target
#endif
void exahype2::fv::riemann::internal::computeEigenvalues_LoopBody(
          const double* __restrict__ QIn,
          exahype2::enumerator::AoSLexicographicEnumerator QInEnumerator,
          exahype2::fv::riemann::Eigenvalues               eigenvalues,
          const tarch::la::Vector<Dimensions, double>&     patchCentre,
          const tarch::la::Vector<Dimensions, double>&     patchSize,
          int                                              patchIndex,
          const tarch::la::Vector<Dimensions, int>&        volumeIndex,
          double                                           t,
          double                                           dt,
          int                                              normal,
          double* __restrict__ QEigenvalues,
          exahype2::enumerator::AoSLexicographicEnumerator QEigenvaluesEnumerator
        )  {
          eigenvalues(
            QIn + QInEnumerator(patchIndex, volumeIndex, 0),
            ::exahype2::fv::getVolumeCentre(patchCentre, patchSize, QInEnumerator._numberOfDoFsPerAxisInCell, volumeIndex),
            ::exahype2::fv::getVolumeSize(patchSize, QInEnumerator._numberOfDoFsPerAxisInCell),
            t,
            dt,
            normal,
            QEigenvalues + QEigenvaluesEnumerator(patchIndex, volumeIndex, 0)
          );
  
}

double exahype2::fv::riemann::internal::reduceMaxEigenvalue_LoopBody(
  const double* __restrict__ QOut,
  exahype2::enumerator::AoSLexicographicEnumerator QOutEnumerator,
  const double* __restrict__ tempMaxEigenvalueX,
  const double* __restrict__ tempMaxEigenvalueY,
  const double* __restrict__ tempMaxEigenvalueZ,
  exahype2::enumerator::AoSLexicographicEnumerator maxEigenvalueEnumerator,
  const tarch::la::Vector<Dimensions, double>&     patchCentre,
  const tarch::la::Vector<Dimensions, double>&     patchSize,
  int                                              patchIndex,
  const tarch::la::Vector<Dimensions, int>&        volumeIndex,
  double                                           t,
  double                                           dt,
  int                                              unknowns
) {
  double result = 0.0;
  result = std::max(result, tempMaxEigenvalueX[maxEigenvalueEnumerator(patchIndex, volumeIndex, 0)]);
  result = std::max(result, tempMaxEigenvalueY[maxEigenvalueEnumerator(patchIndex, volumeIndex, 0)]);
  if (Dimensions == 3)
    result = std::max(result, tempMaxEigenvalueZ[maxEigenvalueEnumerator(patchIndex, volumeIndex, 0)]);
    
  return result;
}

void exahype2::fv::riemann::internal::computeFlux_LoopBody(
  const double* __restrict__ QIn,
  exahype2::enumerator::AoSLexicographicEnumerator QInEnumerator,
  exahype2::fv::riemann::Flux                      flux,
  const tarch::la::Vector<Dimensions, double>&     patchCentre,
  const tarch::la::Vector<Dimensions, double>&     patchSize,
  int                                              patchIndex,
  const tarch::la::Vector<Dimensions, int>&        volumeIndex,
  double                                           t,
  double                                           dt,
  int                                              normal,
  double* __restrict__ QFlux,
  exahype2::enumerator::AoSLexicographicEnumerator QFluxEnumerator
) {
  flux(
    QIn + QInEnumerator(patchIndex, volumeIndex, 0),
    ::exahype2::fv::getVolumeCentre(patchCentre, patchSize, QInEnumerator._numberOfDoFsPerAxisInCell, volumeIndex),
    ::exahype2::fv::getVolumeSize(patchSize, QInEnumerator._numberOfDoFsPerAxisInCell),
    t,
    dt,
    normal,
    QFlux + QFluxEnumerator(patchIndex, volumeIndex, 0)
  );
}

void exahype2::fv::riemann::internal::computeRiemannSolution_LoopBody(
  const double* __restrict__ QIn,
  exahype2::enumerator::AoSLexicographicEnumerator QInEnumerator,
  exahype2::fv::riemann::SolveRiemannProblem       solveRiemannProblem,
  const double* __restrict__ QFlux,
  exahype2::enumerator::AoSLexicographicEnumerator QFluxEnumerator,
  const double* __restrict__ QEigenvalues,
  exahype2::enumerator::AoSLexicographicEnumerator QEigenvaluesEnumerator,
  const tarch::la::Vector<Dimensions, double>&     patchCentre,
  const tarch::la::Vector<Dimensions, double>&     patchSize,
  int                                              patchIndex,
  const tarch::la::Vector<Dimensions, int>&        volumeIndex,
  double                                           t,
  double                                           dt,
  int                                              normal,
  double* __restrict__ APDQ,
  double* __restrict__ AMDQ,
  exahype2::enumerator::AoSLexicographicEnumerator DQEnumerator,
  double* __restrict__ QMaxEigenvalue,
  exahype2::enumerator::AoSLexicographicEnumerator QMaxEigenvalueEnumerator
)  {
  tarch::la::Vector<Dimensions, int> leftVolume  = volumeIndex;
  tarch::la::Vector<Dimensions, int> rightVolume = volumeIndex;
  rightVolume(normal)++;
  double smax = solveRiemannProblem(
    QIn + QInEnumerator(patchIndex, rightVolume, 0),
    QIn + QInEnumerator(patchIndex, leftVolume,  0),
    QFlux + QFluxEnumerator(patchIndex, rightVolume, 0),
    QFlux + QFluxEnumerator(patchIndex, leftVolume, 0),
    QEigenvalues + QEigenvaluesEnumerator(patchIndex, rightVolume, 0),
    QEigenvalues + QEigenvaluesEnumerator(patchIndex, leftVolume, 0),
    ::exahype2::fv::getVolumeCentre(patchCentre, patchSize, QInEnumerator._numberOfDoFsPerAxisInCell, rightVolume),
    ::exahype2::fv::getVolumeCentre(patchCentre, patchSize, QInEnumerator._numberOfDoFsPerAxisInCell, leftVolume),
    ::exahype2::fv::getVolumeSize(patchSize, QInEnumerator._numberOfDoFsPerAxisInCell),
    t,
    dt,
    normal,
    APDQ + DQEnumerator(patchIndex, leftVolume, 0),
    AMDQ + DQEnumerator(patchIndex, leftVolume, 0)
  );
  QMaxEigenvalue[QMaxEigenvalueEnumerator(patchIndex, leftVolume, 0)] = smax;
}

template <typename QRiemannEnumeratorType, typename QOutEnumeratorType>
void exahype2::fv::riemann::internal::updateSolutionWithRiemannSolution_LoopBody(
  const double* __restrict__ tempLeftUpdatesX,
  const double* __restrict__ tempRightUpdatesX,
  const double* __restrict__ tempBelowUpdatesY,
  const double* __restrict__ tempAboveUpdatesY,
  const double* __restrict__ tempBackwardsUpdatesZ,
  const double* __restrict__ tempForwardsUpdatesZ,
  const QRiemannEnumeratorType&                riemannEnumerator,
  const tarch::la::Vector<Dimensions, double>& patchCentre,
  const tarch::la::Vector<Dimensions, double>& patchSize,
  int                                          patchIndex,
  const tarch::la::Vector<Dimensions, int>&    volumeIndex,
  int                                          unknown,
  double                                       dt,
  double* __restrict__ QOut,
  const QOutEnumeratorType& QOutEnumerator
) {
  auto updateAlongOneDirection = [=](const double* __restrict__ tempLeft, const double* __restrict__ tempRight, const int normal) {
    tarch::la::Vector<Dimensions, int> leftVolume  = volumeIndex;
    tarch::la::Vector<Dimensions, int> rightVolume = volumeIndex;
    leftVolume(normal)--;

    const double fluxPos = tempRight[riemannEnumerator(patchIndex, leftVolume, unknown)];
    const double fluxNeg = tempLeft[riemannEnumerator(patchIndex, rightVolume, unknown)];

    QOut[QOutEnumerator(
      patchIndex, volumeIndex, unknown
    )] -= dt / patchSize(normal) * QOutEnumerator._numberOfDoFsPerAxisInCell * (fluxNeg - fluxPos);
  };

  updateAlongOneDirection(tempLeftUpdatesX, tempRightUpdatesX, 0);
  updateAlongOneDirection(tempBelowUpdatesY, tempAboveUpdatesY, 1);
  if (Dimensions == 3)
    updateAlongOneDirection(tempBackwardsUpdatesZ, tempForwardsUpdatesZ, 2);
}