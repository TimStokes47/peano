#include "tarch/accelerator/accelerator.h"

template <class T>
tarch::logging::Log peano4::stacks::STDVectorStackOverObjectsWithSmartPointers<T>::_log("peano4::stacks::"
                                                                             "STDVectorStackOverObjectsWithSmartPointers<T>");

template <class T>
peano4::stacks::STDVectorStackOverObjectsWithSmartPointers<T>::STDVectorStackOverObjectsWithSmartPointers():
  _data(),
  _flattenedData(),
  _ioMode(IOMode::None),
  _ioRank(-1),
  _ioTag(-1)
#ifdef Parallel
  , _ioMPIRequest(nullptr)
#endif
{
}

template <class T>
peano4::stacks::STDVectorStackOverObjectsWithSmartPointers<T>::STDVectorStackOverObjectsWithSmartPointers(
  const STDVectorStackOverObjectsWithSmartPointers<T>& copy
):
  _data(),
  _flattenedData(nullptr),
  _ioMode(IOMode::None)
#ifdef Parallel
  , _ioMPIRequest(nullptr)
#endif
{
  assertionMsg(_data.empty(), "may not copy non-empty stack");
  assertionMsg(copy._data.empty(), "may not copy non-empty stack");
#ifdef Parallel
  assertionMsg(_ioMPIRequest == nullptr, "may not copy sending/receiving stack");
  assertionMsg(copy._ioMPIRequest == nullptr, "may not copy sending/receiving stack");
#endif
}

template <class T>
void peano4::stacks::STDVectorStackOverObjectsWithSmartPointers<T>::clone(const STDVectorStackOverObjectsWithSmartPointers<T>& data) {
  assertion1(_data.empty(), toString());

  _data.clear();
  _data.resize(data._data.size(), T(T::ObjectConstruction::NoData));

  logDebug("clone()", "copy over stack of size " << data.size());

  for (int stackElement = 0; stackElement < size(); stackElement++) {
    typename T::FlattenedType copy = T::flatten( data._data[stackElement] );
    _data[stackElement] = T::unflatten(copy);
  }
}

template <class T>
void peano4::stacks::STDVectorStackOverObjectsWithSmartPointers<T>::startSend(
  peano4::grid::TraversalObserver::SendReceiveContext context, int rank, int tag, MPI_Comm comm
) {
#ifdef Parallel
  assertion(_ioMode == IOMode::None);
  assertion(_ioMPIRequest == nullptr);

  _ioMode = IOMode::MPISend;
  _ioTag  = tag;
  _ioRank = rank;

  _flattenedData.resize(size());
  for (int i=0; i<size(); i++) {
    _flattenedData[i] = T::flatten( _data[i] );
  }
  _data.clear();

  logInfo( "startSend()", "send out flattened data of size " << _flattenedData.size() << " on tag " << _ioTag );
  _ioMPIRequest = new MPI_Request;

  int result = MPI_Isend(
    _flattenedData.data(),
    _flattenedData.size(),
    translateContextIntoDatatype<typename T::FlattenedType>( context ),
    _ioRank, _ioTag, comm, _ioMPIRequest
  );

  if  (result!=MPI_SUCCESS) {
    std::ostringstream msg;
    logError( "startSend(int,int)", "was not able to send to node " << rank << " on tag " << tag
      << ": " << tarch::mpi::MPIReturnValueToString(result)
    );
  }
#endif
}

template <class T>
void peano4::stacks::STDVectorStackOverObjectsWithSmartPointers<T>::startReceive(
  peano4::grid::TraversalObserver::SendReceiveContext context, int rank, int tag, MPI_Comm comm, int numberOfElements
) {
#ifdef Parallel
  assertion3(_ioMode == IOMode::None, rank, tag, numberOfElements);
  assertion3(numberOfElements > 0, rank, tag, numberOfElements);

  _ioMode = IOMode::MPIReceive;
  _ioTag  = tag;
  _ioRank = rank;

  _data.clear();
  _flattenedData.resize(numberOfElements, typename T::FlattenedType(T::FlattenedType::ObjectConstruction::NoData));

  assertionEquals( _flattenedData.size(), numberOfElements );

  logInfo( "startReceive()", "trigger receive of " << numberOfElements << " elements on tag " << _ioTag );

  assertion3( _ioMPIRequest == nullptr, rank, tag, numberOfElements );
  _ioMPIRequest = new MPI_Request;

  int result = MPI_Irecv(
    _flattenedData.data(),
    numberOfElements,
    translateContextIntoDatatype<typename T::FlattenedType>( context ),
    _ioRank, _ioTag, comm, _ioMPIRequest
  );

  if  (result!=MPI_SUCCESS) {
    logError( "startReceive(int,int)", "was not able to receive " << numberOfElements << " values from node " << rank << " on tag " << tag
      << ": " << tarch::mpi::MPIReturnValueToString(result)
    );
  }

  logTraceOut( "startReceive(int,int,int)" );
#endif
}

template <class T>
bool peano4::stacks::STDVectorStackOverObjectsWithSmartPointers<T>::tryToFinishSendOrReceive() {
#ifdef Parallel
  logTraceInWith4Arguments("tryToFinishSendOrReceive()", ::toString(_ioMode), size(), _ioRank, _ioTag);
  bool result = true;
  if ( _ioMode==IOMode::MPISend or _ioMode==IOMode::MPIReceive ) {
    assertion( _ioMPIRequest!=nullptr );

    assertion1(_flattenedData.size()>0, _flattenedData.size() );
    assertion1( _data.empty(), _data.size() );

    int          flag = 0;
    MPI_Test( _ioMPIRequest, &flag, MPI_STATUS_IGNORE );

    if (flag) {
      result = true;
      logInfo( "tryToFinishSendOrReceive()", "send/receive complete, free MPI request: " << toString() );
      delete _ioMPIRequest;
      _ioMPIRequest = nullptr;

      _ioMode = IOMode::None;

      if (_ioMode==IOMode::MPISend ) {
        logInfo( "tryToFinishSendOrReceive()", "free flattened data structure" );
        _flattenedData.clear();
      }
      else {
        logInfo( "tryToFinishSendOrReceive()", "have received " << _flattenedData.size() << " entries. Copy flattened data over" );
        _data.resize(_flattenedData.size()>0, T(T::ObjectConstruction::NoData));
        for (int i=0; i<_flattenedData.size(); i++) {
          _data[i] = T::unflatten( _flattenedData[i] );
        }
        _flattenedData.clear();
      }
    } else {
      result = false;
    }
  }
  logTraceOutWith1Argument("tryToFinishSendOrReceive()", result);
  return result;
#else
  return true;
#endif
}

template <class T>
int peano4::stacks::STDVectorStackOverObjectsWithSmartPointers<T>::size() const {
  return _data.size();
}

template <class T>
bool peano4::stacks::STDVectorStackOverObjectsWithSmartPointers<T>::empty() const {
  return _data.empty();
}

template <class T>
void peano4::stacks::STDVectorStackOverObjectsWithSmartPointers<T>::clear() {
  _data.clear();
}

template <class T>
int peano4::stacks::STDVectorStackOverObjectsWithSmartPointers<T>::sendingOrReceiving() const {
  return _ioMode == IOMode::None ? -1 : _ioRank;
}

template <class T>
void peano4::stacks::STDVectorStackOverObjectsWithSmartPointers<T>::reverse() {
  std::reverse(std::begin(_data), std::end(_data));
}

template <class T>
std::string peano4::stacks::STDVectorStackOverObjectsWithSmartPointers<T>::toString() const {
  std::ostringstream msg;
  msg << "(size=" << size() << ",io-mode=" << ::toString(_ioMode) << ",rank=" << _ioRank << ",tag=" << _ioTag << ")";
  return msg.str();
}

template <class T>
T peano4::stacks::STDVectorStackOverObjectsWithSmartPointers<T>::pop() {
  assertion(not empty());
  T result = std::move(_data.back());
  _data.pop_back();
  return result;
}

template <class T>
T& peano4::stacks::STDVectorStackOverObjectsWithSmartPointers<T>::top(int shift) {
  assertion(not empty());
  return _data[_data.size() - 1 - shift];
}

template <class T>
const T& peano4::stacks::STDVectorStackOverObjectsWithSmartPointers<T>::top(int shift) const {
  assertion(not empty());
  return _data[_data.size() - 1 - shift];
}

template <class T>
void peano4::stacks::STDVectorStackOverObjectsWithSmartPointers<T>::push(const T& element) {
  _data.push_back(element);
}

template <class T>
typename peano4::stacks::STDVectorStackOverObjectsWithSmartPointers<T>::PopBlockStackView peano4::stacks::STDVectorStackOverObjectsWithSmartPointers<T>::popBlock(int numberOfElements) {
  return PopBlockStackView(numberOfElements, this);
}

template <class T>
typename peano4::stacks::STDVectorStackOverObjectsWithSmartPointers<T>::PushBlockStackView peano4::stacks::STDVectorStackOverObjectsWithSmartPointers<T>::pushBlock(int numberOfElements) {
  typename peano4::stacks::STDVectorStackOverObjectsWithSmartPointers<T>::PushBlockStackView result(numberOfElements, this);

  _data.resize(_data.size() + numberOfElements, T(T::ObjectConstruction::NoData));

  return result;
}
