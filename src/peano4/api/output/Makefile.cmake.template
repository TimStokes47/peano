.PHONY: all solver clean help distclean maintainter-clean

all: solver

solver:
	bash -c "mkdir -p build.{{EXECUTABLENAME}} && cd build.{{EXECUTABLENAME}} && cmake .. && make $(MAKEFLAGS)"

clean:
	bash -c "cd build.{{EXECUTABLENAME}} && make clean"

help:
	bash -c "cd build.{{EXECUTABLENAME}} && make help"

GENERATED_H_HEADERS={% for item in GENERATED_H_HEADERS -%} {{item+" "}} {%- endfor %}
GENERATED_CXX_SOURCES={% for item in GENERATED_CXX_SOURCES -%} {{item+" "}} {%- endfor %}
GENERATED_FORTRAN_SOURCES={% for item in GENERATED_FORTRAN_SOURCES -%} {{item+" "}} {%- endfor %}
{% if APP_SUBDIRECTORY %}APP_SUBDIRECTORY={{APP_SUBDIRECTORY}}{% endif %}

distclean:
	rm -f {{EXECUTABLENAME}}
	rm -rf build.{{EXECUTABLENAME}}
	rm -f ${GENERATED_H_HEADERS}
	rm -f ${GENERATED_CXX_SOURCES}
	rm -f ${GENERATED_FORTRAN_SOURCES}
	{% if APP_SUBDIRECTORY %}cd ${APP_SUBDIRECTORY}{% endif %}
	rm -rf globaldata celldata facedata vertexdata observers repositories tasks kernels runners
	rm -f Constants.h
	{% if APP_SUBDIRECTORY %}cd ..
	rm -rf ${APP_SUBDIRECTORY}{% endif %}
	rm -f README-*
	rm -f .gitignore
	rm -f Makefile
	rm -f CMakeLists.txt

maintainer-clean: distclean
