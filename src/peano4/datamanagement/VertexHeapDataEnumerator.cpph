template <class Vertex>
peano4::datamanagement::VertexHeapDataEnumerator<Vertex>::VertexHeapDataEnumerator(const VertexEnumerator<Vertex>& vertices) {
  _vertices.reserve(TwoPowerD);
  for (int i = 0; i < TwoPowerD; i++) {
    _vertices.push_back(vertices(i));
  }
}


template <class Vertex>
Vertex& peano4::datamanagement::VertexHeapDataEnumerator<Vertex>::operator()(int i) {
  assertion1(i >= 0, i);
  assertion1(i < TwoPowerD, i);
  return _vertices[i];
}


template <class Vertex>
const Vertex& peano4::datamanagement::VertexHeapDataEnumerator<Vertex>::operator()(int i) const {
  assertion1(i >= 0, i);
  assertion1(i < TwoPowerD, i);
  return _vertices[i];
}
