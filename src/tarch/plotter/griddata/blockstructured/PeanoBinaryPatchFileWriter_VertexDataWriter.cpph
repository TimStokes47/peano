template<typename T>
void tarch::plotter::griddata::blockstructured::PeanoBinaryPatchFileWriter::VertexDataWriter::plotVertex( int index, T* values ) {
  for (int i=0; i<_numberOfUnknowns; i++) {
    _out.push_back( static_cast<double>(values[i]) );
    _entryCounter++;
  }
  flushIfPatchIsComplete();
}
