int toolbox::particles::ParticleSet<T>::_numberOfDroppedIncomingVirtualParticles;

template <typename T>
int toolbox::particles::ParticleSet<T>::_numberOfIncomingParticlesWhichWerePreviouslyKnownAsVirtual;

