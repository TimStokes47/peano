#if PeanoDebug >= 1 and !defined(Parallel) and !defined(SharedMemoryParallelisation)
template <typename T>
int toolbox::particles::ParticleSet<T>::_numberOfParticlesInLastClear{0};
#endif


#if PeanoDebug >= 1
template <typename T>
void toolbox::particles::ParticleSet<T>::setDebugX(const tarch::la::Vector<Dimensions, double>& data) {
  _debugX = data;
}


template <typename T>
void toolbox::particles::ParticleSet<T>::setDebugH(const tarch::la::Vector<Dimensions, double>& data) {
  _debugH = data;
}


