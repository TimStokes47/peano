tarch::la::Vector<Dimensions, double> toolbox::particles::ParticleSet<T>::getDebugX() const {
  return _debugX;
}


template <typename T>
tarch::la::Vector<Dimensions, double> toolbox::particles::ParticleSet<T>::getDebugH() const {
  return _debugH;
}
#endif


template <typename T>
void toolbox::particles::ParticleSet<T>::clearReassignmentStatistics() {
  _numberOfLifts                    = 0;
  _numberOfDrops                    = 0;
  _numberOfLiftsIntoSieveSet        = 0;
  _numberOfDropsFromSieveSet        = 0;
  _numberOfSkippedDropsFromSieveSet = 0;
  _numberOfReassignments            = 0;
}


template <typename T>
void toolbox::particles::ParticleSet<T>::clearParticleStateStatistics() {
#if PeanoDebug >= 1 and !defined(Parallel) and !defined(SharedMemoryParallelisation)
  nonCriticalAssertion11(
    _numberOfRemainingLocalParticles == 0 or _numberOfRemainingLocalParticles == _numberOfParticlesInLastClear or _numberOfParticlesInLastClear == 0,
    _numberOfParticlesInLastClear,
    _numberOfRemainingLocalParticles,
    _numberOfIncomingLocalParticles,
    _numberOfLeavingLocalParticles,
    _numberOfExpiredHaloParticles,
    _numberOfLeavingLocalParticles,
    _numberOfAddedVirtualParticles,
    _numberOfReplacedVirtualParticles,
    _numberOfDroppedVirtualParticles,
    _numberOfLocalEliminatedSpatialDuplicates,
    _numberOfVirtualEliminatedSpatialDuplicates
  );

  _numberOfParticlesInLastClear = _numberOfRemainingLocalParticles;
#endif

  _numberOfRemainingLocalParticles = 0;
  _numberOfExpiredHaloParticles    = 0;
  _numberOfLeavingLocalParticles   = 0;

  _numberOfDroppedIncomingVirtualParticles                    = 0;
  _numberOfIncomingParticlesWhichWerePreviouslyKnownAsVirtual = 0;
  _numberOfRedundantlySharedLocalParticles                    = 0;
  _numberOfNewIncomingLocalParticles                          = 0;
  _numberOfReplacedVirtualParticles                           = 0;

  _numberOfLocalEliminatedSpatialDuplicates   = 0;
  _numberOfVirtualEliminatedSpatialDuplicates = 0;
}


template <typename T>
void toolbox::particles::ParticleSet<T>::reduceAndPrintStatistics() {
  int globalNumberOfLifts                    = 0;
  int globalNumberOfDrops                    = 0;
  int globalNumberOfLiftsIntoSieveSet        = 0;
  int globalNumberOfDropsFromSieveSet        = 0;
  int globalNumberOfSkippedDropsFromSieveSet = 0;
  int globalNumberOfReassignments            = 0;

  int globalNumberOfRemainingLocalParticles = 0;
  int globalNumberOfExpiredHaloParticles    = 0;
  int globalNumberOfLeavingLocalParticles   = 0;

  int globalNumberOfDroppedIncomingVirtualParticles                    = 0;
  int globalNumberOfIncomingParticlesWhichWerePreviouslyKnownAsVirtual = 0;
  int globalNumberOfRedundantlySharedLocalParticles                    = 0;
  int globalNumberOfNewIncomingLocalParticles                          = 0;
  int globalNumberOfReplacedVirtualParticles                           = 0;
  int globalNumberOfAddedVirtualParticles                              = 0;

  int globalNumberOfVirtualEliminatedSpatialDuplicates = 0;
  int globalNumberOfLocalEliminatedSpatialDuplicates   = 0;

#if Parallel
  tarch::mpi::Rank::getInstance().reduce(&_numberOfLifts, &globalNumberOfLifts, 1, MPI_INT, MPI_SUM, tarch::mpi::Rank::getGlobalMasterRank(), [&]() -> void {
    tarch::services::ServiceRepository::getInstance().receiveDanglingMessages();
  });
  tarch::mpi::Rank::getInstance().reduce(&_numberOfDrops, &globalNumberOfDrops, 1, MPI_INT, MPI_SUM, tarch::mpi::Rank::getGlobalMasterRank(), [&]() -> void {
    tarch::services::ServiceRepository::getInstance().receiveDanglingMessages();
  });
  tarch::mpi::Rank::getInstance()
    .reduce(&_numberOfLiftsIntoSieveSet, &globalNumberOfLiftsIntoSieveSet, 1, MPI_INT, MPI_SUM, tarch::mpi::Rank::getGlobalMasterRank(), [&]() -> void {
      tarch::services::ServiceRepository::getInstance().receiveDanglingMessages();
    });
  tarch::mpi::Rank::getInstance()
    .reduce(&_numberOfDropsFromSieveSet, &globalNumberOfDropsFromSieveSet, 1, MPI_INT, MPI_SUM, tarch::mpi::Rank::getGlobalMasterRank(), [&]() -> void {
      tarch::services::ServiceRepository::getInstance().receiveDanglingMessages();
    });
  tarch::mpi::Rank::getInstance()
    .reduce(&_numberOfSkippedDropsFromSieveSet, &globalNumberOfSkippedDropsFromSieveSet, 1, MPI_INT, MPI_SUM, tarch::mpi::Rank::getGlobalMasterRank(), [&]() -> void {
      tarch::services::ServiceRepository::getInstance().receiveDanglingMessages();
    });

  tarch::mpi::Rank::getInstance().reduce(&_numberOfReassignments, &globalNumberOfReassignments, 1, MPI_INT, MPI_SUM, tarch::mpi::Rank::getGlobalMasterRank(), [&]() -> void {
    tarch::services::ServiceRepository::getInstance().receiveDanglingMessages();
  });

  tarch::mpi::Rank::getInstance()
    .reduce(&_numberOfRemainingLocalParticles, &globalNumberOfRemainingLocalParticles, 1, MPI_INT, MPI_SUM, tarch::mpi::Rank::getGlobalMasterRank(), [&]() -> void {
      tarch::services::ServiceRepository::getInstance().receiveDanglingMessages();
    });
  tarch::mpi::Rank::getInstance()
    .reduce(&_numberOfIncomingLocalParticles, &globalNumberOfIncomingLocalParticles, 1, MPI_INT, MPI_SUM, tarch::mpi::Rank::getGlobalMasterRank(), [&]() -> void {
      tarch::services::ServiceRepository::getInstance().receiveDanglingMessages();
    });
  tarch::mpi::Rank::getInstance()
    .reduce(&_numberOfLeavingLocalParticles, &globalNumberOfLeavingLocalParticles, 1, MPI_INT, MPI_SUM, tarch::mpi::Rank::getGlobalMasterRank(), [&]() -> void {
      tarch::services::ServiceRepository::getInstance().receiveDanglingMessages();
    });
  tarch::mpi::Rank::getInstance()
    .reduce(&_numberOfExpiredHaloParticles, &globalNumberOfExpiredHaloParticles, 1, MPI_INT, MPI_SUM, tarch::mpi::Rank::getGlobalMasterRank(), [&]() -> void {
      tarch::services::ServiceRepository::getInstance().receiveDanglingMessages();
    });
  tarch::mpi::Rank::getInstance()
    .reduce(&_numberOfLeavingLocalParticles, &globalNumberOfLeavingLocalParticles, 1, MPI_INT, MPI_SUM, tarch::mpi::Rank::getGlobalMasterRank(), [&]() -> void {
      tarch::services::ServiceRepository::getInstance().receiveDanglingMessages();
    });


  tarch::mpi::Rank::getInstance()
    .reduce(&_numberOfAddedVirtualParticles, &globalNumberOfAddedVirtualParticles, 1, MPI_INT, MPI_SUM, tarch::mpi::Rank::getGlobalMasterRank(), [&]() -> void {
      tarch::services::ServiceRepository::getInstance().receiveDanglingMessages();
    });
  tarch::mpi::Rank::getInstance()
    .reduce(&_numberOfReplacedVirtualParticles, &globalNumberOfReplacedVirtualParticles, 1, MPI_INT, MPI_SUM, tarch::mpi::Rank::getGlobalMasterRank(), [&]() -> void {
      tarch::services::ServiceRepository::getInstance().receiveDanglingMessages();
    });
  tarch::mpi::Rank::getInstance()
    .reduce(&_numberOfDroppedVirtualParticles, &globalNumberOfDroppedVirtualParticles, 1, MPI_INT, MPI_SUM, tarch::mpi::Rank::getGlobalMasterRank(), [&]() -> void {
      tarch::services::ServiceRepository::getInstance().receiveDanglingMessages();
    });

  tarch::mpi::Rank::getInstance().reduce(
    &_numberOfVirtualEliminatedSpatialDuplicates,
    &globalNumberOfVirtualEliminatedSpatialDuplicates,
    1,
    MPI_INT,
    MPI_SUM,
    tarch::mpi::Rank::getGlobalMasterRank(),
    [&]() -> void { tarch::services::ServiceRepository::getInstance().receiveDanglingMessages(); }
  );
  tarch::mpi::Rank::getInstance().reduce(
    &_numberOfLocalEliminatedSpatialDuplicates,
    &globalNumberOfLocalEliminatedSpatialDuplicates,
    1,
    MPI_INT,
    MPI_SUM,
    tarch::mpi::Rank::getGlobalMasterRank(),
    [&]() -> void { tarch::services::ServiceRepository::getInstance().receiveDanglingMessages(); }
  );
#else
  globalNumberOfLifts                    = _numberOfLifts;
  globalNumberOfDrops                    = _numberOfDrops;
  globalNumberOfLiftsIntoSieveSet        = _numberOfLiftsIntoSieveSet;
  globalNumberOfDropsFromSieveSet        = _numberOfDropsFromSieveSet;
  globalNumberOfSkippedDropsFromSieveSet = _numberOfSkippedDropsFromSieveSet;
  globalNumberOfReassignments            = _numberOfReassignments;

  globalNumberOfRemainingLocalParticles = _numberOfRemainingLocalParticles;
  globalNumberOfExpiredHaloParticles    = _numberOfExpiredHaloParticles;
  globalNumberOfLeavingLocalParticles   = _numberOfLeavingLocalParticles;

  globalNumberOfDroppedIncomingVirtualParticles                    = _numberOfDroppedIncomingVirtualParticles;
  globalNumberOfIncomingParticlesWhichWerePreviouslyKnownAsVirtual = _numberOfIncomingParticlesWhichWerePreviouslyKnownAsVirtual;
  globalNumberOfRedundantlySharedLocalParticles                    = _numberOfRedundantlySharedLocalParticles;
  globalNumberOfNewIncomingLocalParticles                          = _numberOfNewIncomingLocalParticles;
  globalNumberOfReplacedVirtualParticles                           = _numberOfReplacedVirtualParticles;
  globalNumberOfAddedVirtualParticles                              = _numberOfAddedVirtualParticles;

  globalNumberOfVirtualEliminatedSpatialDuplicates = _numberOfVirtualEliminatedSpatialDuplicates;
  globalNumberOfLocalEliminatedSpatialDuplicates   = _numberOfLocalEliminatedSpatialDuplicates;
#endif

  if (tarch::mpi::Rank::getInstance().isGlobalMaster()) {
    logInfo(
      "reduceAndPrintStatistics()",
      "subdomain-local sorting statistics"
        << ": #lifts=" << globalNumberOfLifts << ", #drops=" << globalNumberOfDrops << ", #lifts-into-sieve-set=" << globalNumberOfLiftsIntoSieveSet << ", #drops-from-sieve-set="
        << globalNumberOfDropsFromSieveSet << ", #skipped-drops-from-sieve-set=" << globalNumberOfSkippedDropsFromSieveSet << ", #reassignments=" << globalNumberOfReassignments
    );
    logInfo(
      "reduceAndPrintStatistics()",
      "particle state updates"
        << ": #remaining=" << globalNumberOfRemainingLocalParticles << ", #expired=" << globalNumberOfExpiredHaloParticles << ", #leaving=" << globalNumberOfLeavingLocalParticles
    );
    logInfo(
      "reduceAndPrintStatistics()",
      "boundary merge statistics"
        << ": #incoming particles (previously known as halos)=" << globalNumberOfIncomingParticlesWhichWerePreviouslyKnownAsVirtual << ", #incoming particles (previously unseen)="
        << globalNumberOfNewIncomingLocalParticles << ", #redundantly shared particles (local on multiple trees)=" << globalNumberOfRedundantlySharedLocalParticles
        << ", #added virtual particles (flying into halo)=" << globalNumberOfAddedVirtualParticles << ", #replaced virtual particles (halo updates)="
        << globalNumberOfReplacedVirtualParticles << ", #dropped virtual particles=" << globalNumberOfDroppedIncomingVirtualParticles
    );
    logInfo(
      "reduceAndPrintStatistics()",
      "replica deletion statistics"
        << ": #eliminated local spatial duplicates=" << globalNumberOfLocalEliminatedSpatialDuplicates
        << ", #eliminated virtual spatial duplicates=" << globalNumberOfVirtualEliminatedSpatialDuplicates
    );
  }
}


template <typename T>
void toolbox::particles::ParticleSet<T>::updateLiftDropStatistics(
  int numberOfLiftsInThisTree,
  int numberOfDropsInThisTree,
  int numberOfReassignmentsInThisTree,
  int numberOfLiftsIntoSieveSetInThisTree,
  int numberOfDropsFromSieveSetInThisTree,
  int numberOfSkippedDropsFromSieveSetInThisTree
) {
  tarch::multicore::Lock lock(_statisticsSemaphore);
  _numberOfLifts += numberOfLiftsInThisTree;
  _numberOfDrops += numberOfDropsInThisTree;
  _numberOfReassignments += numberOfReassignmentsInThisTree;
  _numberOfLiftsIntoSieveSet += numberOfLiftsIntoSieveSetInThisTree;
  _numberOfDropsFromSieveSet += numberOfDropsFromSieveSetInThisTree;
  _numberOfSkippedDropsFromSieveSet += numberOfSkippedDropsFromSieveSetInThisTree;
}


template <typename T>
void toolbox::particles::ParticleSet<T>::updateNumberOfLocalAndExpiredParticles(
  int numberOfRemainingLocalParticles, int numberOfExpiredHaloParticles, int numberOfLeavingLocalParticles
) {
  tarch::multicore::Lock lock(_statisticsSemaphore);
  _numberOfRemainingLocalParticles += numberOfRemainingLocalParticles;
  _numberOfExpiredHaloParticles += numberOfExpiredHaloParticles;
  _numberOfLeavingLocalParticles += numberOfLeavingLocalParticles;
}


#ifdef Parallel
template <typename T>
void toolbox::particles::ParticleSet<T>::initDatatype() {
  T::initDatatype();
}


template <typename T>
void toolbox::particles::ParticleSet<T>::shutdownDatatype() {
  T::shutdownDatatype();
}
#endif


template <typename T>
void toolbox::particles::ParticleSet<T>::finishedTraversal() {
  _sieveParticles.exchangeSieveListsGlobally();
}


template <typename T>
typename toolbox::particles::ParticleSet<T>::ParticleList toolbox::particles::ParticleSet<T>::getParticlesToBeSievedIntoVertex(
  const peano4::datamanagement::VertexMarker& marker, int originatingTree, int callingTree
) {
  return _sieveParticles.getParticlesToBeSievedIntoVertex(marker, originatingTree, callingTree);
}


template <typename T>
bool toolbox::particles::ParticleSet<T>::hasParticlesToBeSievedIntoVertices(int tree) {
  logDebug("hasParticlesToBeSievedIntoVertices(int)", "got invoked for tree " << tree);
  return _sieveParticles.hasParticlesToBeSievedIntoVertices(tree);
}


template <typename T>
std::string toolbox::particles::ParticleSet<T>::toString(bool addBrackets) const {
  std::ostringstream msg;
  if (addBrackets)
    msg << "(";

  msg
    << "#lifts=" << _numberOfLifts << ", #drops=" << _numberOfDrops << ", #assignments=" << _numberOfReassignments << ", #lifts-into-sieve-set=" << _numberOfLiftsIntoSieveSet
    << ", #drops-from-sieve-set=" << _numberOfDropsFromSieveSet << ", #remaining-particles=" << _numberOfRemainingLocalParticles
    << ", #eliminated-virtual-duplicates=" << _numberOfVirtualEliminatedSpatialDuplicates << ", #eliminated-local-duplicates=" << _numberOfLocalEliminatedSpatialDuplicates;

#if PeanoDebug >= 1
  msg << ",x=" << _debugX << ",h=" << _debugH;
#endif

  if (addBrackets)
    msg << ")";
  return msg.str();
}
