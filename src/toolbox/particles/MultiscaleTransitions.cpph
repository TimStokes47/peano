#include "peano4/datamanagement/CellMarker.h"
#include "peano4/datamanagement/VertexMarker.h"
#include "tarch/la/VectorOperations.h"


template <typename Particle>
toolbox::particles::ParticleReassociationInstruction toolbox::particles::
  getParticleReassociationInstructionWithinCellWithIntraCellReassignment(
    const Particle& particle, const ::peano4::datamanagement::CellMarker& marker, int numberOfVertexWithinCell
  ) {
  static tarch::logging::Log _log("toolbox::particles");

  if (
    not marker.isContained(particle.getX(), relativeSpatialSortingTolerance(marker) * tarch::la::NUMERICAL_ZERO_DIFFERENCE)
    or
    particle.getParallelState()!=Particle::ParallelState::Local
  ) {
    return ParticleReassociationInstruction_Keep;
  } else {
    std::bitset<Dimensions> currentAssociation = numberOfVertexWithinCell;
    std::bitset<Dimensions> destAssociation;
    bool                    remainsOnSameLevel = tarch::la::min(marker.h()) * MultilevelSortingTolerance
                              >= 2.0 * particle.getSearchRadius();

    // marker.x() gives me the centre of the cell
    for (int d = 0; d < Dimensions; d++) {
      destAssociation[d] = tarch::la::greaterEquals(particle.getX(d), marker.x()(d));
      remainsOnSameLevel &= tarch::la::smallerEquals(
        std::abs(particle.getX(d) - marker.x()(d)), marker.h()(d) * MultilevelSortingTolerance
      );
    }

    if (remainsOnSameLevel and currentAssociation == destAssociation) {
      return ParticleReassociationInstruction_Keep;
    } else if (remainsOnSameLevel) {
      logDebug(
        "getParticleReassociationInstructionWithinCellWithIntraCellReassignment(...)",
        "reassign particle "
          << particle.toString() << " within cell " << marker.toString() << " which had been associated with vertex "
          << currentAssociation << " but belongs to " << destAssociation
      );
      return destAssociation.to_ulong();
    } else if (not marker.isParentLocal()) {
      return ParticleReassociationInstruction_SieveGlobally;
    } else {
      logDebug(
        "getParticleReassociationInstructionWithinCellWithIntraCellReassignment(...)",
        "lift particle "
          << particle.toString() << " from cell " << marker.toString() << " as difference is "
          << (particle.getX() - marker.x())
      );
      return destAssociation.to_ulong() + TwoPowerD;
    }
  }
  return -65536;
}

template <typename Particle>
toolbox::particles::ParticleReassociationInstruction toolbox::particles::liftParticleAssociatedWithVertex(
  const Particle& particle, const peano4::datamanagement::VertexMarker marker
) {
  if (particle.getParallelState() != Particle::ParallelState::Local) {
    return ParticleReassociationInstruction_Keep;
  }
  else if (
    tarch::la::min(marker.h()) * MultilevelSortingTolerance >= 2.0 * particle.getSearchRadius()
    and
    marker.isContainedInAdjacentCells( particle.getX(), 0.5, relativeSpatialSortingTolerance(marker) * tarch::la::NUMERICAL_ZERO_DIFFERENCE)
  ) {
    return ParticleReassociationInstruction_Keep;
  } else if (not marker.isParentCellLocal()) {
    return ParticleReassociationInstruction_SieveGlobally;
  } else {
    std::bitset<Dimensions> target;
    for (int d = 0; d < Dimensions; d++) {
      target[d] = marker.getRelativePositionWithinFatherCell()(d) >= 2;
    }

    if (marker.isParentVertexLocal(target.to_ulong())) {
      return target.to_ulong();
    } else {
      return ParticleReassociationInstruction_SieveGlobally;
    }
  }
  return -65536;
}

template <typename Particle>
std::bitset<Dimensions> toolbox::particles::getParticleAssociationWithinCell(
  const Particle& particle, const peano4::datamanagement::CellMarker marker
) {
  std::bitset<Dimensions> destAssociation;

  // marker.x() gives me the centre of the cell
  for (int d = 0; d < Dimensions; d++) {
    destAssociation[d] = tarch::la::greaterEquals(particle.getX(d), marker.x()(d));
  }

  return destAssociation;
}

template <typename Particle>
bool toolbox::particles::sieveParticle(const Particle& particle, const ::peano4::datamanagement::VertexMarker& marker) {
  bool belongsIntoNeighbouringCells = marker.isContainedInAdjacentCells(
    particle.getX(),
    0.5,
    relativeSpatialSortingTolerance(marker) * AsymmetricSortingDamping * tarch::la::NUMERICAL_ZERO_DIFFERENCE
  );
  bool fitsIntoCurrentMeshLevel = tarch::la::min(marker.h()) * MultilevelSortingTolerance * AsymmetricSortingDamping
                                  >= 2.0 * particle.getSearchRadius();
  bool willNotBeDroppedFurther = tarch::la::greater(2.0 * particle.getSearchRadius(), tarch::la::min(marker.h()) / 3.0)
                                 or not marker.hasBeenRefined();

  return belongsIntoNeighbouringCells and fitsIntoCurrentMeshLevel and willNotBeDroppedFurther;
}


template <typename Particle>
bool toolbox::particles::particleWillBeDroppedFurther(
  const Particle& particle, const peano4::datamanagement::CellMarker& marker
) {
  static tarch::logging::Log _log("toolbox::particles");
  bool                       result = marker.hasBeenRefined()
                and tarch::la::smallerEquals(particle.getSearchRadius() * 2.0, tarch::la::min(marker.h()) / 3.0);
  if (result) {
    logDebug(
      "particleWillBeDroppedFurther(...)",
      "particle " << particle.toString() << " within " << marker.toString() << " will be dropped further"
    );
  }
  return result;
}


template <typename Particle>
bool toolbox::particles::dropParticle(const Particle& particle, const peano4::datamanagement::VertexMarker& marker) {
  return tarch::la::min(marker.h()) > 2.0 * particle.getSearchRadius()
         and marker.isContainedInAdjacentCells(
           particle.getX(),
           0.5,
           relativeSpatialSortingTolerance(marker) * AsymmetricSortingDamping * tarch::la::NUMERICAL_ZERO_DIFFERENCE
         );
}
