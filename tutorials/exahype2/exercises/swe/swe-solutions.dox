\tableofcontents


# The Shallow Water Equations: solutions


initial conditions:

    void exahype2::training::swe::SWESolver::initialCondition(
      double * __restrict__ Q, //Q[4+0]
      const tarch::la::Vector<Dimensions,double>&  x,
      const tarch::la::Vector<Dimensions,double>&  h,
      bool                                         gridIsConstructed
    ) {

      Q[s.hu + 0] = 0.0; // v_x
      Q[s.hu + 1] = 0.0; // v_y
      Q[s.h] = x[0] < 0.0 ? 1.0 : 2.0; // h
      Q[s.b] = 0.0;

    }


boundary conditions:

    void exahype2::training::swe::SWESolver::boundaryConditions(
      const double * __restrict__                  Qinside, // Qinside[4+0]
      double * __restrict__                        Qoutside, // Qoutside[4+0]
      const tarch::la::Vector<Dimensions,double>&  faceCentre,
      const tarch::la::Vector<Dimensions,double>&  volumeH,
      double                                       t,
      int                                          normal
    ){

      Qoutside[s.h]      = 1.0; // h
      Qoutside[s.hu + 0] = 0.0; // v_x
      Qoutside[s.hu + 1] = 0.0; // v_y
      Qoutside[s.b]      = 0.0; // b

    }

max eigenvalue:

    double ::exahype2::training::swe::SWESolver::maxEigenvalue(
      const double* __restrict__ Q, // Q[4+0]
      const tarch::la::Vector<Dimensions,double>&  volumeCentre,
      const tarch::la::Vector<Dimensions,double>&  volumeSize,
      double                                       t,
      double                                       dt,
      int                                          normal
    ){

      constexpr double grav = 9.81;

      const double u = Q[s.hu + normal] / Q[s.h];
      const double c = std::sqrt(grav * Q[s.h]);

      return std::max(std::abs(u + c), std::abs(u - c));

    }


flux:

    void ::exahype2::training::swe::SWESolver::flux(
      const double* __restrict__ Q, // Q[4+0]
      const tarch::la::Vector<Dimensions,double>&  volumeX,
      const tarch::la::Vector<Dimensions,double>&  volumeH,
      double                                       t,
      double                                       dt,
      int                                          normal,
      double* __restrict__ F // F[4]
    ) {

      double ih = 1.0 / Q[s.h];

      constexpr double grav = 9.81;
      F[s.h]      = Q[s.hu + normal];
      F[s.hu + 0] = Q[s.hu + normal] * Q[s.hu + 0] * ih;
      F[s.hu + 1] = Q[s.hu + normal] * Q[s.hu + 1] * ih;
      F[s.b]      = 0.0;

      F[s.hu + normal] += 0.5 * grav * Q[s.h] * Q[s.h];

    }

nonconservative product:

    void ::exahype2::training::swe::SWESolver::nonconservativeProduct(
      const double *__restrict__ Q, //Q[4+0]
      const double *__restrict__ deltaQ, //deltaQ[4+0]
      const tarch::la::Vector<Dimensions, double> &volumeX,
      const tarch::la::Vector<Dimensions, double> &volumeH,
      double t,
      double dt,
      int normal,
      double *__restrict__ BTimesDeltaQ //BTimesDeltaQ[4]
    ){

      BTimesDeltaQ[s.h]      = 0.0;
      BTimesDeltaQ[s.hu + 0] = 0.0;
      BTimesDeltaQ[s.hu + 1] = 0.0;
      BTimesDeltaQ[s.b]      = 0.0;

    }

refinement criterion:

    ::exahype2::RefinementCommand exahype2::training::swe::SWESolver::refinementCriterion(
      const double * __restrict__ Q,               // Q[4+0]
      const tarch::la::Vector<Dimensions,double>&  x,
      const tarch::la::Vector<Dimensions,double>&  h,
      double                                       t
    ) {

      return ::exahype2::RefinementCommand::Keep;

    }

Overall these should yield following end results:

