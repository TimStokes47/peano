// clang-format off

double applications::exahype2::landslide::maxEigenvalue(
  [[maybe_unused]] const double* const __restrict__             Q,
  [[maybe_unused]] const tarch::la::Vector<Dimensions, double>& x,
  [[maybe_unused]] const tarch::la::Vector<Dimensions, double>& h,
  [[maybe_unused]] const double                                 t,
  [[maybe_unused]] const double                                 dt,
  [[maybe_unused]] const int                                    normal
) {
  using s = VariableShortcuts;

#ifdef GPUOffloadingOff
  assertion(normal >= 0);
  assertion(normal < Dimensions);
  assertion(!std::isnan(Q[s::h]));
  assertion(!std::isnan(Q[s::hu]));
  assertion(!std::isnan(Q[s::hv]));
  assertion(!std::isnan(Q[s::z]));
  nonCriticalAssertion(Q[s::h] == Q[s::h]);
  nonCriticalAssertion(Q[s::hu] == Q[s::hu]);
  nonCriticalAssertion(Q[s::hv] == Q[s::hv]);
  nonCriticalAssertion(Q[s::z] == Q[s::z]);
  nonCriticalAssertion(tarch::la::greaterEquals(Q[s::h], 0.0)); // Negative granular material height does not make sense
#endif

  double result{0.0};

  if (tarch::la::greater(Q[s::h], 0.0)) { // Granular material height can also be 0. Then we do nothing
    const double u = Q[s::hu + normal] / Q[s::h];
    const double c = std::sqrt(g * std::cos(frictionlaw::Zeta) * Q[s::h]);

#ifdef GPUOffloadingOff
    assertion(Q[s::h] > 0.0);
    assertion(!std::isnan(u));
    assertion(!std::isnan(c));
#endif

    result = std::fmax(std::fabs(u - c), std::fabs(u + c));

#ifdef GPUOffloadingOff
    assertion(!std::isnan(result));
#endif
  }

  return result;
}


void applications::exahype2::landslide::flux(
  [[maybe_unused]] const double* const __restrict__             Q,
  [[maybe_unused]] const tarch::la::Vector<Dimensions, double>& x,
  [[maybe_unused]] const tarch::la::Vector<Dimensions, double>& h,
  [[maybe_unused]] const double                                 t,
  [[maybe_unused]] const double                                 dt,
  [[maybe_unused]] const int                                    normal,
  [[maybe_unused]] double* const __restrict__                   F
) {
  using s = VariableShortcuts;

#ifdef GPUOffloadingOff
  assertion(normal >= 0);
  assertion(normal < Dimensions);
  assertion(!std::isnan(Q[s::h]));
  assertion(!std::isnan(Q[s::hu]));
  assertion(!std::isnan(Q[s::hv]));
  assertion(!std::isnan(Q[s::z]));
  assertion(!std::isnan(F[s::h]));
  assertion(!std::isnan(F[s::hu]));
  assertion(!std::isnan(F[s::hv]));
  nonCriticalAssertion(Q[s::h] == Q[s::h]);
  nonCriticalAssertion(Q[s::hu] == Q[s::hu]);
  nonCriticalAssertion(Q[s::hv] == Q[s::hv]);
  nonCriticalAssertion(Q[s::z] == Q[s::z]);
  nonCriticalAssertion(F[s::h] == F[s::h]);
  nonCriticalAssertion(F[s::hu] == F[s::hu]);
  nonCriticalAssertion(F[s::hv] == F[s::hv]);
  nonCriticalAssertion(tarch::la::greaterEquals(Q[s::h], 0.0));
#endif

  if (tarch::la::greater(Q[s::h], 0.0)) {
    const double ih = 1.0 / Q[s::h];

#ifdef GPUOffloadingOff
    assertion(!std::isnan(ih));
#endif

    F[s::h] = Q[s::hu + normal];
    switch (normal) {
    case 0:
      F[s::hu] = ih * Q[s::hu] * Q[s::hu] + 0.5 * g * std::cos(frictionlaw::Zeta) * Q[s::h] * Q[s::h];
      F[s::hv] = ih * Q[s::hu] * Q[s::hv];
      break;
    case 1:
      F[s::hu] = ih * Q[s::hv] * Q[s::hu];
      F[s::hv] = ih * Q[s::hv] * Q[s::hv] + 0.5 * g * std::cos(frictionlaw::Zeta) * Q[s::h] * Q[s::h];
      break;
    }
  } else {
    F[s::h]  = 0.0;
    F[s::hu] = 0.0;
    F[s::hv] = 0.0;
  }

#ifdef GPUOffloadingOff
  assertion(!std::isnan(F[s::h]));
  assertion(!std::isnan(F[s::hu]));
  assertion(!std::isnan(F[s::hv]));
  nonCriticalAssertion(F[s::h] == F[s::h]);
  nonCriticalAssertion(F[s::hu] == F[s::hu]);
  nonCriticalAssertion(F[s::hv] == F[s::hv]);
#endif
}


void applications::exahype2::landslide::nonconservativeProduct(
  [[maybe_unused]] const double* __restrict__                    Q,
  [[maybe_unused]] const double* __restrict__                    deltaQ,
  [[maybe_unused]] const tarch::la::Vector<Dimensions, double>&  x,
  [[maybe_unused]] const tarch::la::Vector<Dimensions, double>&  h,
  [[maybe_unused]] double                                        t,
  [[maybe_unused]] double                                        dt,
  [[maybe_unused]] int                                           normal,
  [[maybe_unused]] double* __restrict__                          BTimesDeltaQ
) {
  using s = VariableShortcuts;

#ifdef GPUOffloadingOff
  assertion(normal >= 0);
  assertion(normal < Dimensions);
  assertion(!std::isnan(Q[s::h]));
  assertion(!std::isnan(Q[s::hu]));
  assertion(!std::isnan(Q[s::hv]));
  assertion(!std::isnan(Q[s::z]));
  assertion(!std::isnan(deltaQ[s::h]));
  assertion(!std::isnan(deltaQ[s::hu]));
  assertion(!std::isnan(deltaQ[s::hv]));
  assertion(!std::isnan(deltaQ[s::z]));
  nonCriticalAssertion(Q[s::h] == Q[s::h]);
  nonCriticalAssertion(Q[s::hu] == Q[s::hu]);
  nonCriticalAssertion(Q[s::hv] == Q[s::hv]);
  nonCriticalAssertion(Q[s::z] == Q[s::z]);
  nonCriticalAssertion(deltaQ[s::h] == deltaQ[s::h]);
  nonCriticalAssertion(deltaQ[s::hu] == deltaQ[s::hu]);
  nonCriticalAssertion(deltaQ[s::hv] == deltaQ[s::hv]);
  nonCriticalAssertion(deltaQ[s::z] == deltaQ[s::z]);
  nonCriticalAssertion(tarch::la::greaterEquals(Q[s::h], 0.0));
#endif

  const double hx = (Q[s::hx] - 0.5 * deltaQ[s::hx]) / (1.0 * h(0));
  const double hy = (Q[s::hy] - 0.5 * deltaQ[s::hy]) / (1.0 * h(1));

#ifdef GPUOffloadingOff
  assertion(!std::isnan(hx));
  assertion(!std::isnan(hy));
#endif

  // u
  const double ux  = (Q[s::ux] - 0.5 * deltaQ[s::ux]) / (1.0 * h(0));
  const double uy  = (Q[s::uy] - 0.5 * deltaQ[s::uy]) / (1.0 * h(1));
  const double uxx = (Q[s::uxx] - 0.5 * deltaQ[s::uxx]) / (h(0) * h(0));
  const double uyy = (Q[s::uyy] - 0.5 * deltaQ[s::uyy]) / (h(1) * h(1));
  const double uxy = (Q[s::uxy] - 0.5 * deltaQ[s::uxy]) / (4.0 * h(0) * h(1));

#ifdef GPUOffloadingOff
  assertion(!std::isnan(ux));
  assertion(!std::isnan(uy));
  assertion(!std::isnan(uxx));
  assertion(!std::isnan(uyy));
  assertion(!std::isnan(uxy));
#endif

  // v
  const double vx  = (Q[s::vx] - 0.5 * deltaQ[s::vx]) / (1.0 * h(0));
  const double vy  = (Q[s::vy] - 0.5 * deltaQ[s::vy]) / (1.0 * h(1));
  const double vxx = (Q[s::vxx] - 0.5 * deltaQ[s::vxx]) / (h(0) * h(0));
  const double vyy = (Q[s::vyy] - 0.5 * deltaQ[s::vyy]) / (h(1) * h(1));
  const double vxy = (Q[s::vxy] - 0.5 * deltaQ[s::vxy]) / (4.0 * h(0) * h(1));

#ifdef GPUOffloadingOff
  assertion(!std::isnan(vx));
  assertion(!std::isnan(vy));
  assertion(!std::isnan(vxx));
  assertion(!std::isnan(vyy));
  assertion(!std::isnan(vxy));
#endif

  BTimesDeltaQ[s::h] = 0.0;

  switch (normal) {
  case 0: // x
    BTimesDeltaQ[s::hu] = -(h(0) * frictionlaw::Nu * std::sqrt(Q[s::h]) * (1.5 * hx * ux + Q[s::h] * uxx));
    BTimesDeltaQ[s::hv] = -(h(0) * 0.5 * frictionlaw::Nu * std::sqrt(Q[s::h]) * (1.5 * hx * (uy + vx) + Q[s::h] * (uxy + vxx)));
    break;
  case 1: // y
    BTimesDeltaQ[s::hu] = -(h(1) * 0.5 * frictionlaw::Nu * std::sqrt(Q[s::h]) * (1.5 * hy * (uy + vx) + Q[s::h] * (uyy + vxy)));
    BTimesDeltaQ[s::hv] = -(h(1) * frictionlaw::Nu * std::sqrt(Q[s::h]) * (1.5 * hy * vy + Q[s::h] * vyy));
    break;
  }

#ifdef GPUOffloadingOff
  assertion(!std::isnan(BTimesDeltaQ[s::h]));
  assertion(!std::isnan(BTimesDeltaQ[s::hu]));
  assertion(!std::isnan(BTimesDeltaQ[s::hv]));
  nonCriticalAssertion(BTimesDeltaQ[s::h] == BTimesDeltaQ[s::h]);
  nonCriticalAssertion(BTimesDeltaQ[s::hu] == BTimesDeltaQ[s::hu]);
  nonCriticalAssertion(BTimesDeltaQ[s::hv] == BTimesDeltaQ[s::hv]);
#endif
}


void applications::exahype2::landslide::nonconservativeProductWithElevation(
  [[maybe_unused]] const double* __restrict__                    Q,
  [[maybe_unused]] const double* __restrict__                    deltaQ,
  [[maybe_unused]] const tarch::la::Vector<Dimensions, double>&  x,
  [[maybe_unused]] const tarch::la::Vector<Dimensions, double>&  h,
  [[maybe_unused]] double                                        t,
  [[maybe_unused]] double                                        dt,
  [[maybe_unused]] int                                           normal,
  [[maybe_unused]] double* __restrict__                          BTimesDeltaQ
) {
  using s = VariableShortcuts;

#ifdef GPUOffloadingOff
  assertion(normal >= 0);
  assertion(normal < Dimensions);
  assertion(!std::isnan(Q[s::h]));
  assertion(!std::isnan(Q[s::hu]));
  assertion(!std::isnan(Q[s::hv]));
  assertion(!std::isnan(Q[s::z]));
  assertion(!std::isnan(deltaQ[s::h]));
  assertion(!std::isnan(deltaQ[s::hu]));
  assertion(!std::isnan(deltaQ[s::hv]));
  assertion(!std::isnan(deltaQ[s::z]));
  nonCriticalAssertion(Q[s::h] == Q[s::h]);
  nonCriticalAssertion(Q[s::hu] == Q[s::hu]);
  nonCriticalAssertion(Q[s::hv] == Q[s::hv]);
  nonCriticalAssertion(Q[s::z] == Q[s::z]);
  nonCriticalAssertion(deltaQ[s::h] == deltaQ[s::h]);
  nonCriticalAssertion(deltaQ[s::hu] == deltaQ[s::hu]);
  nonCriticalAssertion(deltaQ[s::hv] == deltaQ[s::hv]);
  nonCriticalAssertion(deltaQ[s::z] == deltaQ[s::z]);
  nonCriticalAssertion(tarch::la::greaterEquals(Q[s::h], 0.0));
#endif

  BTimesDeltaQ[s::h] = 0.0;
  BTimesDeltaQ[s::hu] = 0.0;
  BTimesDeltaQ[s::hv] = 0.0;
  BTimesDeltaQ[s::hu + normal] += g * Q[s::h] * deltaQ[s::z];

#ifdef GPUOffloadingOff
  assertion(!std::isnan(BTimesDeltaQ[s::h]));
  assertion(!std::isnan(BTimesDeltaQ[s::hu]));
  assertion(!std::isnan(BTimesDeltaQ[s::hv]));
  nonCriticalAssertion(BTimesDeltaQ[s::h] == BTimesDeltaQ[s::h]);
  nonCriticalAssertion(BTimesDeltaQ[s::hu] == BTimesDeltaQ[s::hu]);
  nonCriticalAssertion(BTimesDeltaQ[s::hv] == BTimesDeltaQ[s::hv]);
#endif
}


void applications::exahype2::landslide::sourceTerm(
  [[maybe_unused]] const double* __restrict__                    Q,
  [[maybe_unused]] const tarch::la::Vector<Dimensions, double>&  x,
  [[maybe_unused]] const tarch::la::Vector<Dimensions, double>&  h,
  [[maybe_unused]] double                                        t,
  [[maybe_unused]] double                                        dt,
  [[maybe_unused]] double* __restrict__                          S
) {
  using s = VariableShortcuts;

#ifdef GPUOffloadingOff
  assertion(!std::isnan(Q[s::h]));
  assertion(!std::isnan(Q[s::hu]));
  assertion(!std::isnan(Q[s::hv]));
  assertion(!std::isnan(Q[s::z]));
  assertion(!std::isnan(S[s::h]));
  assertion(!std::isnan(S[s::hu]));
  assertion(!std::isnan(S[s::hv]));
  assertion(!std::isnan(S[s::z]));
  nonCriticalAssertion(Q[s::h] == Q[s::h]);
  nonCriticalAssertion(Q[s::hu] == Q[s::hu]);
  nonCriticalAssertion(Q[s::hv] == Q[s::hv]);
  nonCriticalAssertion(Q[s::z] == Q[s::z]);
  nonCriticalAssertion(S[s::h] == S[s::h]);
  nonCriticalAssertion(S[s::hu] == S[s::hu]);
  nonCriticalAssertion(S[s::hv] == S[s::hv]);
  nonCriticalAssertion(S[s::z] == S[s::z]);
  nonCriticalAssertion(tarch::la::greaterEquals(Q[s::h], 0.0));
#endif

  if (tarch::la::greater(Q[s::h], 0.0)) {
    const double ih       = 1.0 / Q[s::h];
    const double u        = ih * Q[s::hu];
    const double v        = ih * Q[s::hv];
    const double ubar     = std::sqrt(Q[s::hu] * Q[s::hu] + Q[s::hv] * Q[s::hv]) * ih;
    const double Fr       = ubar / std::sqrt(g * Q[s::h] * std::cos(frictionlaw::Zeta));
    const double Hstar    = (frictionlaw::BetaStar + frictionlaw::Gamma) * frictionlaw::Hstop / frictionlaw::Beta;

#ifdef GPUOffloadingOff
    assertion(Q[s::h] > 0.0);
    assertion(!std::isnan(ih));
    assertion(!std::isnan(u));
    assertion(!std::isnan(v));
    assertion(!std::isnan(Fr));
    assertion(!std::isnan(ubar));
    assertion(!std::isnan(Hstar));
#endif

    double Mu = 1.0;
    if (Fr > frictionlaw::BetaStar) {
      const double vstop    = (Q[s::h] * frictionlaw::Beta) / (Fr + frictionlaw::Gamma);
      const double Mustop   = frictionlaw::Mu1 + (frictionlaw::Mu1 - frictionlaw::Mu2) / (1.0 + vstop / frictionlaw::FrictionLengthScale);
      Mu = Mustop;
    } else if (Fr > 0.0 && Fr <= frictionlaw::BetaStar) {
      const double vstart   = Q[s::h];
      const double vstop    = Q[s::h] * frictionlaw::Beta / (frictionlaw::BetaStar + frictionlaw::Gamma);
      const double Mustart  = frictionlaw::Mu3 + (frictionlaw::Mu1 - frictionlaw::Mu2) / (1.0 + vstart / frictionlaw::FrictionLengthScale);
      const double Mustop   = frictionlaw::Mu1 + (frictionlaw::Mu1 - frictionlaw::Mu2) / (1.0 + vstop / frictionlaw::FrictionLengthScale);
      const double T = Mustart + (Mustop - Mustart) * std::pow((Fr / frictionlaw::BetaStar), frictionlaw::Kappa);
      Mu = T;
    } else if (tarch::la::equals(Fr, 0.0)) {
      const double vstart   = Q[s::h];
      const double Mustart  = frictionlaw::Mu3 + (frictionlaw::Mu1 - frictionlaw::Mu2) / (1.0 + vstart / frictionlaw::FrictionLengthScale);
      Mu = Mustart;
    }

    if (tarch::la::equals(ubar, 0.0)) {
      const double hx = Q[s::hx] / h(0);
      const double hy = Q[s::hy] / h(1);
      const tarch::la::Vector<Dimensions, double> frictionVector = {std::tan(frictionlaw::Zeta) - hx, -hy};
      const double frictionVectorMagnitude = tarch::la::norm2(frictionVector);
      if (tarch::la::greater(Mu, frictionVectorMagnitude)) {
        Mu = frictionVectorMagnitude;
      }

#ifdef GPUOffloadingOff
    assertion(!std::isnan(Mu));
#endif

      if (tarch::la::equals(Mu, 0.0)) {
        S[s::h]  = 0.0;
        S[s::hu] = Q[s::h] * g * std::sin(frictionlaw::Zeta);
        S[s::hv] = 0.0;
      } else {
        S[s::h]  = 0.0;
        S[s::hu] = Q[s::h] * g * std::sin(frictionlaw::Zeta) - Mu * (frictionVector(0) / frictionVectorMagnitude) * Q[s::h] * g * std::cos(frictionlaw::Zeta);
        S[s::hv] = -Mu * (frictionVector(1) / frictionVectorMagnitude) * Q[s::h] * g * std::cos(frictionlaw::Zeta);
      }
    } else if (tarch::la::greater(ubar, 0.0)) {
      S[s::h]  = 0.0;
      S[s::hu] = Q[s::h] * g * std::sin(frictionlaw::Zeta) - Mu * (u / ubar) * Q[s::h] * g * std::cos(frictionlaw::Zeta);
      S[s::hv] = -Mu * (v / ubar) * Q[s::h] * g * std::cos(frictionlaw::Zeta);
    }
  } else {
    S[s::h]  = 0.0;
    S[s::hu] = 0.0;
    S[s::hv] = 0.0;
  }

  assertion(!std::isnan(S[s::h]));
  assertion(!std::isnan(S[s::hu]));
  assertion(!std::isnan(S[s::hv]));
  nonCriticalAssertion(S[s::h] == S[s::h]);
  nonCriticalAssertion(S[s::hu] == S[s::hu]);
  nonCriticalAssertion(S[s::hv] == S[s::hv]);
}


void applications::exahype2::landslide::sourceTermWithCoulombFriction(
  [[maybe_unused]] const double* __restrict__                    Q,
  [[maybe_unused]] const tarch::la::Vector<Dimensions, double>&  x,
  [[maybe_unused]] const tarch::la::Vector<Dimensions, double>&  h,
  [[maybe_unused]] double                                        t,
  [[maybe_unused]] double                                        dt,
  [[maybe_unused]] double* __restrict__                          S
) {
  using s = VariableShortcuts;

#ifdef GPUOffloadingOff
  assertion(!std::isnan(Q[s::h]));
  assertion(!std::isnan(Q[s::hu]));
  assertion(!std::isnan(Q[s::hv]));
  assertion(!std::isnan(Q[s::z]));
  assertion(!std::isnan(S[s::h]));
  assertion(!std::isnan(S[s::hu]));
  assertion(!std::isnan(S[s::hv]));
  assertion(!std::isnan(S[s::z]));
  nonCriticalAssertion(Q[s::h] == Q[s::h]);
  nonCriticalAssertion(Q[s::hu] == Q[s::hu]);
  nonCriticalAssertion(Q[s::hv] == Q[s::hv]);
  nonCriticalAssertion(Q[s::z] == Q[s::z]);
  nonCriticalAssertion(S[s::h] == S[s::h]);
  nonCriticalAssertion(S[s::hu] == S[s::hu]);
  nonCriticalAssertion(S[s::hv] == S[s::hv]);
  nonCriticalAssertion(S[s::z] == S[s::z]);
  nonCriticalAssertion(tarch::la::greaterEquals(Q[s::h], 0.0));
#endif

  S[s::h] = 0.0;
  S[s::hu] = 0.0;
  S[s::hv] = 0.0;

  if (tarch::la::greater(Q[s::h], 0.0)) {
    const double u{Q[s::hu + 0] / Q[s::h]};
    const double v{Q[s::hu + 1] / Q[s::h]};
    const double velMagnitudeSqr{u * u + v * v};
    if (tarch::la::greater(velMagnitudeSqr, 0.0)) {
      const double zx{Q[s::zx] / h(0)};
      const double zy{Q[s::zy] / h(1)};
      const double c{1.0 / std::sqrt(1.0 + zx * zx + zy * zy)};
      const double friction{-g * (frictionlaw::Mu1 * Q[s::h] * c)};
      const double velMagnitude{std::sqrt(velMagnitudeSqr)};
      S[s::hu] += u / velMagnitude * friction;
      S[s::hv] += v / velMagnitude * friction;
    }
  }

  assertion(!std::isnan(S[s::h]));
  assertion(!std::isnan(S[s::hu]));
  assertion(!std::isnan(S[s::hv]));
  nonCriticalAssertion(S[s::h] == S[s::h]);
  nonCriticalAssertion(S[s::hu] == S[s::hu]);
  nonCriticalAssertion(S[s::hv] == S[s::hv]);
}

// clang-format on
