#!/bin/bash

#SBATCH -A EUHPC_D03_043
#SBATCH -p boost_usr_prod
#SBATCH --job-name=ExaSeis
#SBATCH --time 00:30:00
#SBATCH --output=slurm.%j.out
#SBATCH -N 1 # Number of nodes
#SBATCH --ntasks-per-node=1 # Out of 32 -> Should match --gres=gpu:N for multi-GPU runs.
#SBATCH --cpus-per-task=16 # Out of (32 / ntasks-per-node)
#SBATCH --gres=gpu:1 # GPUs per node out of 4

export OMP_PLACES="cores($SLURM_CPUS_PER_TASK)"
export OMP_BIND="spread"
export OMP_PROC_BIND=close
export SRUN_CPUS_PER_TASK=$SLURM_CPUS_PER_TASK
export SLURM_CPU_BIND_TYPE="cores"
ulimit -c unlimited
ulimit -s unlimited

module load gcc/11.3.0
module load nvhpc/23.5
module load openmpi/4.1.4--nvhpc--23.1-cuda-11.8

# Score-P: Enable if desired.
#export SCOREP_EXPERIMENT_DIRECTORY=ExaSeis-ScoreP
#export SCOREP_TOTAL_MEMORY=4000M
#export SCOREP_CUDA_ENABLE=runtime,kernel,idle
#export SCOREP_ENABLE_TRACING=true
#export SCOREP_METRIC_PAPI=PAPI_TOT_INS,PAPI_TOT_CYC,PAPI_RES_STL
#export SCOREP_METRIC_PERF=instructions,cycles
#export SCOREP_MPI_MAX_COMMUNICATORS=5000
#export SCOREP_VERBOSE=true

export PATH=/leonardo/home/userexternal/mwille00/scorep-nvhpc-23.5/bin:$PATH
export LD_LIBRARY_PATH=/leonardo/home/userexternal/mwille00/scorep-nvhpc-23.5/lib:$LD_LIBRARY_PATH
export LD_LIBRARY_PATH=/leonardo/prod/spack/03/install/0.19/linux-rhel8-icelake/gcc-11.3.0/otf2-3.0-rbwihnagnkj4c7fezkkv5bwflo7qmef4/lib:$LD_LIBRARY_PATH
export LD_LIBRARY_PATH=/leonardo/prod/spack/03/install/0.19/linux-rhel8-icelake/nvhpc-23.1/cubew-4.8.2-m7cpfpuohf6jh32qslnrzp6u3xtbb45z/lib:$LD_LIBRARY_PATH
export LIBRARY_PATH=/leonardo/home/userexternal/mwille00/scorep-nvhpc-23.5/lib:$LIBRARY_PATH
export CPATH=/leonardo/home/userexternal/mwille00/scorep-nvhpc-23.5/include:$CPATH

srun --cpu-bind=cores ./gpu-launch ./ExaSeis-ADERDGRusanovGlobalFixedEnclave-Stateless-Release

# For reading the SLURM output in realtime:
# tail -f

# For interactive runs:
# salloc -N 1 --ntasks-per-node=1  --cpus-per-task=16 --gres=gpu:1 --time=01:00:00 --partition boost_usr_prod --account EUHPC_D03_043
# OMP_NUM_THREADS=16 srun -N 1 -n 1 ./gpu-launch ./ExaSeis-ADERDGRusanovGlobalFixedEnclave-Stateless-Release

# To watch used cores and memory:
# htop
# watch -n 0.1 nvidia-smi

# For checking the spent core-hours:
# saldo -b
