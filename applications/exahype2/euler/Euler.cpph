double applications::exahype2::euler::maxEigenvalue(
  [[maybe_unused]] const double* const __restrict__             Q,
  [[maybe_unused]] const tarch::la::Vector<Dimensions, double>& x,
  [[maybe_unused]] const tarch::la::Vector<Dimensions, double>& h,
  [[maybe_unused]] const double                                 t,
  [[maybe_unused]] const double                                 dt,
  [[maybe_unused]] const int                                    normal
) {
  using s = VariableShortcuts;

  #if defined(GPUOffloadingOff)
  assertion(normal >= 0);
  assertion(normal < Dimensions);
  assertion(Q[s::rho] > 0);
  assertion(!std::isnan(Q[s::rho]));
  nonCriticalAssertion(Q[s::rho] == Q[s::rho]);
  #endif

  const double irho = 1.0 / std::fabs(Q[s::rho]);
  const double p = (GAMMA - 1.0) * (Q[s::e] - 0.5 * irho * (Q[s::u] * Q[s::u] + Q[s::v] * Q[s::v]
  #if Dimensions == 3
    + Q[s::w] * Q[s::w]
  #endif
  ));

  #if defined(GPUOffloadingOff)
  assertion(tarch::la::greaterEquals(p, 0.0));
  #endif

  const double speedOfSound = sqrt(GAMMA * std::fabs(p) * irho);
  const double u_n          = Q[normal + 1] * irho;
  const double result       = std::fmax(std::fabs(u_n - speedOfSound), std::fabs(u_n + speedOfSound));

  #if defined(GPUOffloadingOff)
  assertion(tarch::la::greaterEquals(result, 0.0));
  #endif

  return result;
}

void applications::exahype2::euler::flux(
  [[maybe_unused]] const double* const __restrict__             Q,
  [[maybe_unused]] const tarch::la::Vector<Dimensions, double>& x,
  [[maybe_unused]] const tarch::la::Vector<Dimensions, double>& h,
  [[maybe_unused]] const double                                 t,
  [[maybe_unused]] const double                                 dt,
  [[maybe_unused]] const int                                    normal,
  [[maybe_unused]] double* const __restrict__                   F
) {
  using s = VariableShortcuts;

  #if defined(GPUOffloadingOff)
  assertion(normal >= 0);
  assertion(normal < Dimensions);
  assertion(Q[s::rho] > 0);
  assertion(!std::isnan(Q[s::rho]));
  nonCriticalAssertion(Q[s::rho] == Q[s::rho]);
  #endif

  const double irho = 1.0 / std::fabs(Q[s::rho]);
  const double p = (GAMMA - 1.0) * (Q[s::e] - 0.5 * irho * (Q[s::u] * Q[s::u] + Q[s::v] * Q[s::v]
  #if Dimensions == 3
    + Q[s::w] * Q[s::w]
  #endif
  ));

  #if defined(GPUOffloadingOff)
  assertion(tarch::la::greaterEquals(p, 0.0));
  #endif

  const double coeff = irho * Q[normal + 1];
  F[s::rho]          = coeff * Q[s::rho];
  F[s::u]            = coeff * Q[s::u];
  F[s::v]            = coeff * Q[s::v];
  #if Dimensions == 3
  F[s::w]            = coeff * Q[s::w];
  F[s::e]            = coeff * Q[s::e] + coeff * p;
  #endif
  F[s::e]            = coeff * Q[s::e] + coeff * p;

  F[normal + 1] += p;
}
