// clang-format off

template <int NumberOfDofs, int NumberOfUnknowns, int NumberOfAuxiliaryVariables>
void applications::exahype2::swe::computeFirstDerivatives(double* const __restrict__ oldQWithHalo) {
  using s = VariableShortcuts;

  static constexpr int NumberOfTotalVariables = NumberOfUnknowns + NumberOfAuxiliaryVariables;

  for (int y = 1; y < NumberOfDofs + 1; y++) {
    for (int x = 1; x < NumberOfDofs + 1; x++) {
      const tarch::la::Vector<Dimensions, int> currentCell                = {x,     y};
      const tarch::la::Vector<Dimensions, int> xLeftNeighbourCell         = {x - 1, y};
      const tarch::la::Vector<Dimensions, int> xRightNeighbourCell        = {x + 1, y};
      const tarch::la::Vector<Dimensions, int> yLeftNeighbourCell         = {x,     y - 1};
      const tarch::la::Vector<Dimensions, int> yRightNeighbourCell        = {x,     y + 1};
      const tarch::la::Vector<Dimensions, int> xLeftYLeftNeighbourCell    = {x - 1, y - 1};
      const tarch::la::Vector<Dimensions, int> xLeftYRightNeighbourCell   = {x - 1, y + 1};
      const tarch::la::Vector<Dimensions, int> xRightYLeftNeighbourCell   = {x + 1, y - 1};
      const tarch::la::Vector<Dimensions, int> xRightYRightNeighbourCell  = {x + 1, y + 1};

      const int currentCellSerialized = peano4::utils::dLinearised(currentCell, NumberOfDofs + 2);

      const int xLeftNeighbourCellSerialized = peano4::utils::dLinearised(xLeftNeighbourCell, NumberOfDofs + 2);
      const int xRightNeighbourCellSerialized = peano4::utils::dLinearised(xRightNeighbourCell, NumberOfDofs + 2);
      const int yLeftNeighbourCellSerialized = peano4::utils::dLinearised(yLeftNeighbourCell, NumberOfDofs + 2);
      const int yRightNeighbourCellSerialized = peano4::utils::dLinearised(yRightNeighbourCell, NumberOfDofs + 2);

      const int xLeftYLeftNeighbourCellSerialized = peano4::utils::dLinearised(xLeftYLeftNeighbourCell, NumberOfDofs + 2);
      const int xLeftYRightNeighbourCellSerialized = peano4::utils::dLinearised(xLeftYRightNeighbourCell, NumberOfDofs + 2);
      const int xRightYLeftNeighbourCellSerialized = peano4::utils::dLinearised(xRightYLeftNeighbourCell, NumberOfDofs + 2);
      const int xRightYRightNeighbourCellSerialized = peano4::utils::dLinearised(xRightYRightNeighbourCell, NumberOfDofs + 2);

      const double hCurrentCell = oldQWithHalo[currentCellSerialized * NumberOfTotalVariables + s::h];
      const double uCurrentCell = tarch::la::greater(oldQWithHalo[currentCellSerialized * NumberOfTotalVariables + s::h], 0.0)
                                ? oldQWithHalo[currentCellSerialized * NumberOfTotalVariables + s::hu] / oldQWithHalo[currentCellSerialized * NumberOfTotalVariables + s::h]
                                : 0.0;
      const double vCurrentCell = tarch::la::greater(oldQWithHalo[currentCellSerialized * NumberOfTotalVariables + s::h], 0.0)
                                ? oldQWithHalo[currentCellSerialized * NumberOfTotalVariables + s::hv] / oldQWithHalo[currentCellSerialized * NumberOfTotalVariables + s::h]
                                : 0.0;
      const double zCurrentCell = oldQWithHalo[currentCellSerialized * NumberOfTotalVariables + s::b];

      const double hXLeftNeighbourCell = oldQWithHalo[xLeftNeighbourCellSerialized * NumberOfTotalVariables + s::h];
      const double uXLeftNeighbourCell = tarch::la::greater(oldQWithHalo[xLeftNeighbourCellSerialized * NumberOfTotalVariables + s::h], 0.0)
                                       ? oldQWithHalo[xLeftNeighbourCellSerialized * NumberOfTotalVariables + s::hu] / oldQWithHalo[xLeftNeighbourCellSerialized * NumberOfTotalVariables + s::h]
                                       : 0.0;
      const double vXLeftNeighbourCell = tarch::la::greater(oldQWithHalo[xLeftNeighbourCellSerialized * NumberOfTotalVariables + s::h], 0.0)
                                       ? oldQWithHalo[xLeftNeighbourCellSerialized * NumberOfTotalVariables + s::hv] / oldQWithHalo[xLeftNeighbourCellSerialized * NumberOfTotalVariables + s::h]
                                       : 0.0;
      const double zXLeftNeighbourCell = oldQWithHalo[xLeftNeighbourCellSerialized * NumberOfTotalVariables + s::b];

      const double hXRightNeighbourCell = oldQWithHalo[xRightNeighbourCellSerialized * NumberOfTotalVariables + s::h];
      const double uXRightNeighbourCell = tarch::la::greater(oldQWithHalo[xRightNeighbourCellSerialized * NumberOfTotalVariables + s::h], 0.0)
                                        ? oldQWithHalo[xRightNeighbourCellSerialized * NumberOfTotalVariables + s::hu] / oldQWithHalo[xRightNeighbourCellSerialized * NumberOfTotalVariables + s::h]
                                        : 0.0;
      const double vXRightNeighbourCell = tarch::la::greater(oldQWithHalo[xRightNeighbourCellSerialized * NumberOfTotalVariables + s::h], 0.0)
                                        ? oldQWithHalo[xRightNeighbourCellSerialized * NumberOfTotalVariables + s::hv] / oldQWithHalo[xRightNeighbourCellSerialized * NumberOfTotalVariables + s::h]
                                        : 0.0;

      const double hYLeftNeighbourCell = oldQWithHalo[yLeftNeighbourCellSerialized * NumberOfTotalVariables + s::h];
      const double uYLeftNeighbourCell = tarch::la::greater(oldQWithHalo[yLeftNeighbourCellSerialized * NumberOfTotalVariables + s::h], 0.0)
                                       ? oldQWithHalo[yLeftNeighbourCellSerialized * NumberOfTotalVariables + s::hu] / oldQWithHalo[yLeftNeighbourCellSerialized * NumberOfTotalVariables + s::h]
                                       : 0.0;
      const double vYLeftNeighbourCell = tarch::la::greater(oldQWithHalo[yLeftNeighbourCellSerialized * NumberOfTotalVariables + s::h], 0.0)
                                       ? oldQWithHalo[yLeftNeighbourCellSerialized * NumberOfTotalVariables + s::hv] / oldQWithHalo[yLeftNeighbourCellSerialized * NumberOfTotalVariables + s::h]
                                       : 0.0;
      const double zYLeftNeighbourCell = oldQWithHalo[yLeftNeighbourCellSerialized * NumberOfTotalVariables + s::b];

      const double hYRightNeighbourCell = oldQWithHalo[yRightNeighbourCellSerialized * NumberOfTotalVariables + s::h];
      const double uYRightNeighbourCell = tarch::la::greater(oldQWithHalo[yRightNeighbourCellSerialized * NumberOfTotalVariables + s::h], 0.0)
                                        ? oldQWithHalo[yRightNeighbourCellSerialized * NumberOfTotalVariables + s::hu] / oldQWithHalo[yRightNeighbourCellSerialized * NumberOfTotalVariables + s::h]
                                        : 0.0;
      const double vYRightNeighbourCell = tarch::la::greater(oldQWithHalo[yRightNeighbourCellSerialized * NumberOfTotalVariables + s::h], 0.0)
                                        ? oldQWithHalo[yRightNeighbourCellSerialized * NumberOfTotalVariables + s::hv] / oldQWithHalo[yRightNeighbourCellSerialized * NumberOfTotalVariables + s::h]
                                        : 0.0;

      const double uXLeftYLeftNeighbourCell = tarch::la::greater(oldQWithHalo[xLeftYLeftNeighbourCellSerialized * NumberOfTotalVariables + s::h], 0.0)
                                            ? oldQWithHalo[xLeftYLeftNeighbourCellSerialized * NumberOfTotalVariables + s::hu] / oldQWithHalo[xLeftYLeftNeighbourCellSerialized * NumberOfTotalVariables + s::h]
                                            : 0.0;
      const double vXLeftYLeftNeighbourCell = tarch::la::greater(oldQWithHalo[xLeftYLeftNeighbourCellSerialized * NumberOfTotalVariables + s::h], 0.0)
                                            ? oldQWithHalo[xLeftYLeftNeighbourCellSerialized * NumberOfTotalVariables + s::hv] / oldQWithHalo[xLeftYLeftNeighbourCellSerialized * NumberOfTotalVariables + s::h]
                                            : 0.0;

      const double uXLeftYRightNeighbourCell = tarch::la::greater(oldQWithHalo[xLeftYRightNeighbourCellSerialized * NumberOfTotalVariables + s::h], 0.0)
                                             ? oldQWithHalo[xLeftYRightNeighbourCellSerialized * NumberOfTotalVariables + s::hu] / oldQWithHalo[xLeftYRightNeighbourCellSerialized * NumberOfTotalVariables + s::h]
                                             : 0.0;
      const double vXLeftYRightNeighbourCell = tarch::la::greater(oldQWithHalo[xLeftYRightNeighbourCellSerialized * NumberOfTotalVariables + s::h], 0.0)
                                             ? oldQWithHalo[xLeftYRightNeighbourCellSerialized * NumberOfTotalVariables + s::hv] / oldQWithHalo[xLeftYRightNeighbourCellSerialized * NumberOfTotalVariables + s::h]
                                             : 0.0;

      const double uXRightYLeftNeighbourCell = tarch::la::greater(oldQWithHalo[xRightYLeftNeighbourCellSerialized * NumberOfTotalVariables + s::h], 0.0)
                                             ? oldQWithHalo[xRightYLeftNeighbourCellSerialized * NumberOfTotalVariables + s::hu] / oldQWithHalo[xRightYLeftNeighbourCellSerialized * NumberOfTotalVariables + s::h]
                                             : 0.0;
      const double vXRightYLeftNeighbourCell = tarch::la::greater(oldQWithHalo[xRightYLeftNeighbourCellSerialized * NumberOfTotalVariables + s::h], 0.0)
                                             ? oldQWithHalo[xRightYLeftNeighbourCellSerialized * NumberOfTotalVariables + s::hv] / oldQWithHalo[xRightYLeftNeighbourCellSerialized * NumberOfTotalVariables + s::h]
                                             : 0.0;

      const double uXRightYRightNeighbourCell = tarch::la::greater(oldQWithHalo[xRightYRightNeighbourCellSerialized * NumberOfTotalVariables + s::h], 0.0)
                                              ? oldQWithHalo[xRightYRightNeighbourCellSerialized * NumberOfTotalVariables + s::hu] / oldQWithHalo[xRightYRightNeighbourCellSerialized * NumberOfTotalVariables + s::h]
                                              : 0.0;
      const double vXRightYRightNeighbourCell = tarch::la::greater(oldQWithHalo[xRightYRightNeighbourCellSerialized * NumberOfTotalVariables + s::h], 0.0)
                                              ? oldQWithHalo[xRightYRightNeighbourCellSerialized * NumberOfTotalVariables + s::hv] / oldQWithHalo[xRightYRightNeighbourCellSerialized * NumberOfTotalVariables + s::h]
                                              : 0.0;

      oldQWithHalo[currentCellSerialized * NumberOfTotalVariables + s::hx] = (hCurrentCell - hXLeftNeighbourCell);
      oldQWithHalo[currentCellSerialized * NumberOfTotalVariables + s::hy] = (hCurrentCell - hYLeftNeighbourCell);
      oldQWithHalo[currentCellSerialized * NumberOfTotalVariables + s::ux] = (uCurrentCell - uXLeftNeighbourCell);
      oldQWithHalo[currentCellSerialized * NumberOfTotalVariables + s::uy] = (uCurrentCell - uYLeftNeighbourCell);
      oldQWithHalo[currentCellSerialized * NumberOfTotalVariables + s::uxx] = (uXRightNeighbourCell - 2 * uCurrentCell + uXLeftNeighbourCell);
      oldQWithHalo[currentCellSerialized * NumberOfTotalVariables + s::uyy] = (uYRightNeighbourCell - 2 * uCurrentCell + uYLeftNeighbourCell);
      oldQWithHalo[currentCellSerialized * NumberOfTotalVariables + s::uxy] = (uXRightYRightNeighbourCell - uXLeftYRightNeighbourCell - uXRightYLeftNeighbourCell + uXLeftYLeftNeighbourCell);
      oldQWithHalo[currentCellSerialized * NumberOfTotalVariables + s::vx] = (vCurrentCell - vXLeftNeighbourCell);
      oldQWithHalo[currentCellSerialized * NumberOfTotalVariables + s::vy] = (vCurrentCell - vYLeftNeighbourCell);
      oldQWithHalo[currentCellSerialized * NumberOfTotalVariables + s::vxx] = (vXRightNeighbourCell - 2 * vCurrentCell + vXLeftNeighbourCell);
      oldQWithHalo[currentCellSerialized * NumberOfTotalVariables + s::vyy] = (vYRightNeighbourCell - 2 * vCurrentCell + vYLeftNeighbourCell);
      oldQWithHalo[currentCellSerialized * NumberOfTotalVariables + s::vxy] = (vXRightYRightNeighbourCell - vXLeftYRightNeighbourCell - vXRightYLeftNeighbourCell + vXLeftYLeftNeighbourCell);
      oldQWithHalo[currentCellSerialized * NumberOfTotalVariables + s::bx] = (zCurrentCell - zXLeftNeighbourCell);
      oldQWithHalo[currentCellSerialized * NumberOfTotalVariables + s::by] = (zCurrentCell - zYLeftNeighbourCell);
    }
  }
}

template <int NumberOfDofs, int NumberOfUnknowns, int NumberOfAuxiliaryVariables>
void applications::exahype2::swe::extrapolateHalo(double* const __restrict__ oldQWithHalo) {
  tarch::la::Vector<Dimensions, int> topLeftCell      = {0, NumberOfDofs + 1};
  tarch::la::Vector<Dimensions, int> topRightCell     = {NumberOfDofs + 1, NumberOfDofs + 1};
  tarch::la::Vector<Dimensions, int> bottomLeftCell   = {0, 0};
  tarch::la::Vector<Dimensions, int> bottomRightCell  = {NumberOfDofs + 1, 0};

  tarch::la::Vector<Dimensions, int> topLeftCellN1 = topLeftCell;
  topLeftCellN1(0)++;
  tarch::la::Vector<Dimensions, int> topLeftCellN2 = topLeftCell;
  topLeftCellN2(1)--;

  tarch::la::Vector<Dimensions, int> topRightCellN1 = topRightCell;
  topRightCellN1(0)--;
  tarch::la::Vector<Dimensions, int> topRightCellN2 = topRightCell;
  topRightCellN2(1)--;

  tarch::la::Vector<Dimensions, int> bottomLeftCellN1 = bottomLeftCell;
  bottomLeftCellN1(0)++;
  tarch::la::Vector<Dimensions, int> bottomLeftCellN2 = bottomLeftCell;
  bottomLeftCellN2(1)++;

  tarch::la::Vector<Dimensions, int> bottomRightCellN1 = bottomRightCell;
  bottomRightCellN1(0)--;
  tarch::la::Vector<Dimensions, int> bottomRightCellN2 = bottomRightCell;
  bottomRightCellN2(1)++;

  const int topLeftCellSerialised = peano4::utils::dLinearised(topLeftCell, NumberOfDofs + 2);
  const int topRightCellSerialised = peano4::utils::dLinearised(topRightCell, NumberOfDofs + 2);

  const int bottomLeftCellSerialised = peano4::utils::dLinearised(bottomLeftCell, NumberOfDofs + 2);
  const int bottomRightCellSerialised = peano4::utils::dLinearised(bottomRightCell, NumberOfDofs + 2);

  const int topLeftCellN1Serialised = peano4::utils::dLinearised(topLeftCellN1, NumberOfDofs + 2);
  const int topLeftCellN2Serialised = peano4::utils::dLinearised(topLeftCellN2, NumberOfDofs + 2);

  const int topRightCellN1Serialised = peano4::utils::dLinearised(topRightCellN1, NumberOfDofs + 2);
  const int topRightCellN2Serialised = peano4::utils::dLinearised(topRightCellN2, NumberOfDofs + 2);

  const int bottomLeftCellN1Serialised = peano4::utils::dLinearised(bottomLeftCellN1, NumberOfDofs + 2);
  const int bottomLeftCellN2Serialised = peano4::utils::dLinearised(bottomLeftCellN2, NumberOfDofs + 2);

  const int bottomRightCellN1Serialised = peano4::utils::dLinearised(bottomRightCellN1, NumberOfDofs + 2);
  const int bottomRightCellN2Serialised = peano4::utils::dLinearised(bottomRightCellN2, NumberOfDofs + 2);

  for (int i = 0; i < NumberOfUnknowns + NumberOfAuxiliaryVariables; i++) {
    oldQWithHalo[(topLeftCellSerialised) * (NumberOfUnknowns + NumberOfAuxiliaryVariables) + i] = 0.5 * (
      oldQWithHalo[(topLeftCellN1Serialised) * (NumberOfUnknowns + NumberOfAuxiliaryVariables) + i] +
      oldQWithHalo[(topLeftCellN2Serialised) * (NumberOfUnknowns + NumberOfAuxiliaryVariables) + i]
    );

    oldQWithHalo[(topRightCellSerialised) * (NumberOfUnknowns + NumberOfAuxiliaryVariables) + i] = 0.5 * (
      oldQWithHalo[(topRightCellN1Serialised) * (NumberOfUnknowns + NumberOfAuxiliaryVariables) + i] +
      oldQWithHalo[(topRightCellN2Serialised) * (NumberOfUnknowns + NumberOfAuxiliaryVariables) + i]
    );

    oldQWithHalo[(bottomLeftCellSerialised) * (NumberOfUnknowns + NumberOfAuxiliaryVariables) + i] = 0.5 * (
      oldQWithHalo[(bottomLeftCellN1Serialised) * (NumberOfUnknowns + NumberOfAuxiliaryVariables) + i] +
      oldQWithHalo[(bottomLeftCellN2Serialised) * (NumberOfUnknowns + NumberOfAuxiliaryVariables) + i]
    );

    oldQWithHalo[(bottomRightCellSerialised) * (NumberOfUnknowns + NumberOfAuxiliaryVariables) + i] = 0.5 * (
      oldQWithHalo[(bottomRightCellN1Serialised) * (NumberOfUnknowns + NumberOfAuxiliaryVariables) + i] +
      oldQWithHalo[(bottomRightCellN2Serialised) * (NumberOfUnknowns + NumberOfAuxiliaryVariables) + i]
    );
  }
}

// clang-format on
