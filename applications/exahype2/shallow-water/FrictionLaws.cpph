double applications::exahype2::swe::frictionlaws::maxEigenvalue(
  const double* const __restrict__             Q,
  const tarch::la::Vector<Dimensions, double>& x,
  const tarch::la::Vector<Dimensions, double>& h,
  const double                                 t,
  const double                                 dt,
  const int                                    normal
) {
  using s = VariableShortcuts;

#ifdef GPUOffloadingOff
  assertion(normal >= 0);
  assertion(normal < Dimensions);
  assertion(!std::isnan(Q[s::h]));
  assertion(!std::isnan(Q[s::hu]));
  assertion(!std::isnan(Q[s::hv]));
  assertion(!std::isnan(Q[s::b]));
  nonCriticalAssertion(Q[s::h] == Q[s::h]);
  nonCriticalAssertion(Q[s::hu] == Q[s::hu]);
  nonCriticalAssertion(Q[s::hv] == Q[s::hv]);
  nonCriticalAssertion(Q[s::b] == Q[s::b]);
  nonCriticalAssertion(tarch::la::greaterEquals(Q[s::h], 0.0));
#endif

  double result{0.0};

  if (tarch::la::greater(Q[s::h], 0.0)) {
    const double u = Q[s::hu + normal] / Q[s::h];
    const double c = std::sqrt(GRAV * std::cos(Zeta) * Q[s::h]);

#ifdef GPUOffloadingOff
    assertion(Q[s::h] > 0.0);
    assertion(!std::isnan(u));
    assertion(!std::isnan(c));
#endif

    result = std::fmax(std::fabs(u - c), std::fabs(u + c));

#ifdef GPUOffloadingOff
    assertion(!std::isnan(result));
#endif
  }

  return result;
}

void applications::exahype2::swe::frictionlaws::maxEigenvalue(
    const double* const __restrict__             Q,
    const tarch::la::Vector<Dimensions, double>& x,
    const tarch::la::Vector<Dimensions, double>& h,
    const double                                 t,
    const double                                 dt,
    const int                                    normal,
    double* const __restrict__                   maxEigenvalue
  ){
    maxEigenvalue[0] = ::applications::exahype2::swe::frictionlaws::maxEigenvalue(Q, x, h, t, dt, normal);
  }

void applications::exahype2::swe::frictionlaws::flux(
  const double* const __restrict__             Q,
  const tarch::la::Vector<Dimensions, double>& /*x*/,
  const tarch::la::Vector<Dimensions, double>& /*h*/,
  const double                                 /*t*/,
  const double                                 /*dt*/,
  const int                                    normal,
  double* const __restrict__                   F
) {
  using s = VariableShortcuts;

#ifdef GPUOffloadingOff
  assertion(normal >= 0);
  assertion(normal < Dimensions);
  assertion(!std::isnan(Q[s::h]));
  assertion(!std::isnan(Q[s::hu]));
  assertion(!std::isnan(Q[s::hv]));
  assertion(!std::isnan(Q[s::b]));
  assertion(!std::isnan(F[s::h]));
  assertion(!std::isnan(F[s::hu]));
  assertion(!std::isnan(F[s::hv]));
  nonCriticalAssertion(Q[s::h] == Q[s::h]);
  nonCriticalAssertion(Q[s::hu] == Q[s::hu]);
  nonCriticalAssertion(Q[s::hv] == Q[s::hv]);
  nonCriticalAssertion(Q[s::b] == Q[s::b]);
  nonCriticalAssertion(F[s::h] == F[s::h]);
  nonCriticalAssertion(F[s::hu] == F[s::hu]);
  nonCriticalAssertion(F[s::hv] == F[s::hv]);
  nonCriticalAssertion(tarch::la::greaterEquals(Q[s::h], 0.0));
#endif

  if (tarch::la::greater(Q[s::h], 0.0)) {
    const double ih = 1.0 / Q[s::h];

#ifdef GPUOffloadingOff
    assertion(!std::isnan(ih));
#endif

    F[s::h] = Q[s::hu + normal];
    switch (normal) {
    case 0:
      F[s::hu] = ih * Q[s::hu] * Q[s::hu] + 0.5 * GRAV * std::cos(Zeta) * Q[s::h] * Q[s::h];
      F[s::hv] = ih * Q[s::hu] * Q[s::hv];
      break;
    case 1:
      F[s::hu] = ih * Q[s::hv] * Q[s::hu];
      F[s::hv] = ih * Q[s::hv] * Q[s::hv] + 0.5 * GRAV * std::cos(Zeta) * Q[s::h] * Q[s::h];
      break;
    }
  } else {
    F[s::h]  = 0.0;
    F[s::hu] = 0.0;
    F[s::hv] = 0.0;
  }

#ifdef GPUOffloadingOff
  assertion(!std::isnan(F[s::h]));
  assertion(!std::isnan(F[s::hu]));
  assertion(!std::isnan(F[s::hv]));
  nonCriticalAssertion(F[s::h] == F[s::h]);
  nonCriticalAssertion(F[s::hu] == F[s::hu]);
  nonCriticalAssertion(F[s::hv] == F[s::hv]);
#endif
}


void applications::exahype2::swe::frictionlaws::nonconservativeProduct(
  const double* const __restrict__             Q,
  const double* const __restrict__             deltaQ,
  const tarch::la::Vector<Dimensions, double>& x,
  const tarch::la::Vector<Dimensions, double>& h,
  const double                                 t,
  const double                                 dt,
  const int                                    normal,
  double* const __restrict__                   BTimesDeltaQ
) {
  using s = VariableShortcuts;

#ifdef GPUOffloadingOff
  assertion(normal >= 0);
  assertion(normal < Dimensions);
  assertion(!std::isnan(Q[s::h]));
  assertion(!std::isnan(Q[s::hu]));
  assertion(!std::isnan(Q[s::hv]));
  assertion(!std::isnan(Q[s::b]));
  assertion(!std::isnan(deltaQ[s::h]));
  assertion(!std::isnan(deltaQ[s::hu]));
  assertion(!std::isnan(deltaQ[s::hv]));
  assertion(!std::isnan(deltaQ[s::b]));
  nonCriticalAssertion(Q[s::h] == Q[s::h]);
  nonCriticalAssertion(Q[s::hu] == Q[s::hu]);
  nonCriticalAssertion(Q[s::hv] == Q[s::hv]);
  nonCriticalAssertion(Q[s::b] == Q[s::b]);
  nonCriticalAssertion(deltaQ[s::h] == deltaQ[s::h]);
  nonCriticalAssertion(deltaQ[s::hu] == deltaQ[s::hu]);
  nonCriticalAssertion(deltaQ[s::hv] == deltaQ[s::hv]);
  nonCriticalAssertion(deltaQ[s::b] == deltaQ[s::b]);
  nonCriticalAssertion1(tarch::la::greaterEquals(Q[s::h], 0.0), Q[s::h]);
#endif

  BTimesDeltaQ[s::h] = 0.0;
  BTimesDeltaQ[s::hu] = 0.0;
  BTimesDeltaQ[s::hv] = 0.0;
  BTimesDeltaQ[s::b] = 0.0;

  const double hx = (Q[s::hx] - 0.5 * deltaQ[s::hx]) / (1.0 * h(0));
  const double hy = (Q[s::hy] - 0.5 * deltaQ[s::hy]) / (1.0 * h(1));

#ifdef GPUOffloadingOff
  assertion(!std::isnan(hx));
  assertion(!std::isnan(hy));
#endif

  // u
  const double ux  = (Q[s::ux] - 0.5 * deltaQ[s::ux]) / (1.0 * h(0));
  const double uy  = (Q[s::uy] - 0.5 * deltaQ[s::uy]) / (1.0 * h(1));
  const double uxx = (Q[s::uxx] - 0.5 * deltaQ[s::uxx]) / (h(0) * h(0));
  const double uyy = (Q[s::uyy] - 0.5 * deltaQ[s::uyy]) / (h(1) * h(1));
  const double uxy = (Q[s::uxy] - 0.5 * deltaQ[s::uxy]) / (4.0 * h(0) * h(1));

#ifdef GPUOffloadingOff
  assertion(!std::isnan(ux));
  assertion(!std::isnan(uy));
  assertion(!std::isnan(uxx));
  assertion(!std::isnan(uyy));
  assertion(!std::isnan(uxy));
#endif

  // v
  const double vx  = (Q[s::vx] - 0.5 * deltaQ[s::vx]) / (1.0 * h(0));
  const double vy  = (Q[s::vy] - 0.5 * deltaQ[s::vy]) / (1.0 * h(1));
  const double vxx = (Q[s::vxx] - 0.5 * deltaQ[s::vxx]) / (h(0) * h(0));
  const double vyy = (Q[s::vyy] - 0.5 * deltaQ[s::vyy]) / (h(1) * h(1));
  const double vxy = (Q[s::vxy] - 0.5 * deltaQ[s::vxy]) / (4.0 * h(0) * h(1));

#ifdef GPUOffloadingOff
  assertion(!std::isnan(vx));
  assertion(!std::isnan(vy));
  assertion(!std::isnan(vxx));
  assertion(!std::isnan(vyy));
  assertion(!std::isnan(vxy));
#endif

  switch (normal) {
  case 0: // x
    BTimesDeltaQ[s::hu] = -(h(0) * Nu * std::sqrt(Q[s::h]) * (1.5 * hx * ux + Q[s::h] * uxx));
    BTimesDeltaQ[s::hv] = -(h(0) * 0.5 * Nu * std::sqrt(Q[s::h]) * (1.5 * hx * (uy + vx) + Q[s::h] * (uxy + vxx)));
    break;
  case 1: // y
    BTimesDeltaQ[s::hu] = -(h(1) * 0.5 * Nu * std::sqrt(Q[s::h]) * (1.5 * hy * (uy + vx) + Q[s::h] * (uyy + vxy)));
    BTimesDeltaQ[s::hv] = -(h(1) * Nu * std::sqrt(Q[s::h]) * (1.5 * hy * vy + Q[s::h] * vyy));
    break;
  }

#ifdef GPUOffloadingOff
  assertion(!std::isnan(BTimesDeltaQ[s::h]));
  assertion(!std::isnan(BTimesDeltaQ[s::hu]));
  assertion(!std::isnan(BTimesDeltaQ[s::hv]));
  nonCriticalAssertion(BTimesDeltaQ[s::h] == BTimesDeltaQ[s::h]);
  nonCriticalAssertion(BTimesDeltaQ[s::hu] == BTimesDeltaQ[s::hu]);
  nonCriticalAssertion(BTimesDeltaQ[s::hv] == BTimesDeltaQ[s::hv]);
#endif
}


void applications::exahype2::swe::frictionlaws::coulombFriction(
  const double* __restrict__                   Q,
  const tarch::la::Vector<Dimensions, double>& x,
  const tarch::la::Vector<Dimensions, double>& h,
  double                                       t,
  double                                       dt,
  double* __restrict__                         S
) {
  using s = VariableShortcuts;

#ifdef GPUOffloadingOff
  assertion(!std::isnan(Q[s::h]));
  assertion(!std::isnan(Q[s::hu]));
  assertion(!std::isnan(Q[s::hv]));
  assertion(!std::isnan(Q[s::b]));
  assertion(!std::isnan(S[s::h]));
  assertion(!std::isnan(S[s::hu]));
  assertion(!std::isnan(S[s::hv]));
  assertion(!std::isnan(S[s::b]));
  nonCriticalAssertion(Q[s::h] == Q[s::h]);
  nonCriticalAssertion(Q[s::hu] == Q[s::hu]);
  nonCriticalAssertion(Q[s::hv] == Q[s::hv]);
  nonCriticalAssertion(Q[s::b] == Q[s::b]);
  nonCriticalAssertion(S[s::h] == S[s::h]);
  nonCriticalAssertion(S[s::hu] == S[s::hu]);
  nonCriticalAssertion(S[s::hv] == S[s::hv]);
  nonCriticalAssertion(S[s::b] == S[s::b]);
  nonCriticalAssertion(tarch::la::greaterEquals(Q[s::h], 0.0));
#endif

  S[s::h] = 0.0;
  S[s::hu] = 0.0;
  S[s::hv] = 0.0;

  if (tarch::la::greater(Q[s::h], 0.0)) {
    const double u{Q[s::hu + 0] / Q[s::h]};
    const double v{Q[s::hu + 1] / Q[s::h]};
    const double velMagnitudeSqr{u * u + v * v};
    if (tarch::la::greater(velMagnitudeSqr, 0.0)) {
      const double zx{Q[s::bx] / h(0)};
      const double zy{Q[s::by] / h(1)};
      const double c{1.0 / std::sqrt(1.0 + zx * zx + zy * zy)};
      const double friction{-GRAV * (Mu1 * Q[s::h] * c)};
      const double velMagnitude{std::sqrt(velMagnitudeSqr)};
      S[s::hu] += u / velMagnitude * friction;
      S[s::hv] += v / velMagnitude * friction;
    }
  }

#ifdef GPUOffloadingOff
  assertion(!std::isnan(S[s::h]));
  assertion(!std::isnan(S[s::hu]));
  assertion(!std::isnan(S[s::hv]));
  nonCriticalAssertion(S[s::h] == S[s::h]);
  nonCriticalAssertion(S[s::hu] == S[s::hu]);
  nonCriticalAssertion(S[s::hv] == S[s::hv]);
#endif
}


void applications::exahype2::swe::frictionlaws::materialDependentBasalFriction(
  const double* __restrict__                   Q,
  const tarch::la::Vector<Dimensions, double>& x,
  const tarch::la::Vector<Dimensions, double>& h,
  double                                       t,
  double                                       dt,
  double* __restrict__                         S
) {
  using s = VariableShortcuts;

#ifdef GPUOffloadingOff
  assertion(!std::isnan(Q[s::h]));
  assertion(!std::isnan(Q[s::hu]));
  assertion(!std::isnan(Q[s::hv]));
  assertion(!std::isnan(Q[s::b]));
  assertion(!std::isnan(S[s::h]));
  assertion(!std::isnan(S[s::hu]));
  assertion(!std::isnan(S[s::hv]));
  assertion(!std::isnan(S[s::b]));
  nonCriticalAssertion(Q[s::h] == Q[s::h]);
  nonCriticalAssertion(Q[s::hu] == Q[s::hu]);
  nonCriticalAssertion(Q[s::hv] == Q[s::hv]);
  nonCriticalAssertion(Q[s::b] == Q[s::b]);
  nonCriticalAssertion(S[s::h] == S[s::h]);
  nonCriticalAssertion(S[s::hu] == S[s::hu]);
  nonCriticalAssertion(S[s::hv] == S[s::hv]);
  nonCriticalAssertion(S[s::b] == S[s::b]);
  nonCriticalAssertion(tarch::la::greaterEquals(Q[s::h], 0.0));
#endif

  if (tarch::la::greater(Q[s::h], 0.0)) {
    const double ih    = 1.0 / Q[s::h];
    const double u     = ih * Q[s::hu];
    const double v     = ih * Q[s::hv];
    const double ubar  = std::sqrt(Q[s::hu] * Q[s::hu] + Q[s::hv] * Q[s::hv]) * ih;
    const double Fr    = ubar / std::sqrt(GRAV * Q[s::h] * std::cos(Zeta));
    const double Hstar = (BetaStar + Gamma) * Hstop / Beta;

#ifdef GPUOffloadingOff
    assertion(Q[s::h] > 0.0);
    assertion(!std::isnan(ih));
    assertion(!std::isnan(u));
    assertion(!std::isnan(v));
    assertion(!std::isnan(Fr));
    assertion(!std::isnan(ubar));
    assertion(!std::isnan(Hstar));
#endif

    double Mu = 1.0;
    if (Fr > BetaStar) {
      const double vstop    = (Q[s::h] * Beta) / (Fr + Gamma);
      const double Mustop   = Mu1 + (Mu1 - Mu2) / (1.0 + vstop / FrictionLengthScale);
      Mu = Mustop;
    } else if (Fr > 0.0 && Fr <= BetaStar) {
      const double vstart   = Q[s::h];
      const double vstop    = Q[s::h] * Beta / (BetaStar + Gamma);
      const double Mustart  = Mu3 + (Mu1 - Mu2) / (1.0 + vstart / FrictionLengthScale);
      const double Mustop   = Mu1 + (Mu1 - Mu2) / (1.0 + vstop / FrictionLengthScale);
      const double T = Mustart + (Mustop - Mustart) * std::pow((Fr / BetaStar), Kappa);
      Mu = T;
    } else if (tarch::la::equals(Fr, 0.0)) {
      const double vstart   = Q[s::h];
      const double Mustart  = Mu3 + (Mu1 - Mu2) / (1.0 + vstart / FrictionLengthScale);
      Mu = Mustart;
    }

    if (tarch::la::equals(ubar, 0.0)) {
      const double hx = Q[s::hx] / h(0);
      const double hy = Q[s::hy] / h(1);
      const tarch::la::Vector<Dimensions, double> frictionVector = {std::tan(Zeta) - hx, -hy};
      const double frictionVectorMagnitude = tarch::la::norm2(frictionVector);
      if (tarch::la::greater(Mu, frictionVectorMagnitude)) {
        Mu = frictionVectorMagnitude;
      }

#ifdef GPUOffloadingOff
    assertion(!std::isnan(Mu));
#endif

      if (tarch::la::equals(Mu, 0.0)) {
        S[s::h]  = 0.0;
        S[s::hu] = Q[s::h] * GRAV * std::sin(Zeta);
        S[s::hv] = 0.0;
      } else {
        S[s::h]  = 0.0;
        S[s::hu] = Q[s::h] * GRAV * std::sin(Zeta) - Mu * (frictionVector(0) / frictionVectorMagnitude) * Q[s::h] * GRAV * std::cos(Zeta);
        S[s::hv] = -Mu * (frictionVector(1) / frictionVectorMagnitude) * Q[s::h] * GRAV * std::cos(Zeta);
      }
    } else if (tarch::la::greater(ubar, 0.0)) {
      S[s::h]  = 0.0;
      S[s::hu] = Q[s::h] * GRAV * std::sin(Zeta) - Mu * (u / ubar) * Q[s::h] * GRAV * std::cos(Zeta);
      S[s::hv] = -Mu * (v / ubar) * Q[s::h] * GRAV * std::cos(Zeta);
    }
  } else {
    S[s::h]  = 0.0;
    S[s::hu] = 0.0;
    S[s::hv] = 0.0;
  }

#ifdef GPUOffloadingOff
  assertion(!std::isnan(S[s::h]));
  assertion(!std::isnan(S[s::hu]));
  assertion(!std::isnan(S[s::hv]));
  nonCriticalAssertion(S[s::h] == S[s::h]);
  nonCriticalAssertion(S[s::hu] == S[s::hu]);
  nonCriticalAssertion(S[s::hv] == S[s::hv]);
#endif
}

// clang-format on
