FROM peanoframework/spack:latest as builder

WORKDIR /opt/spack-environment

COPY spack/repo.yaml .
COPY spack/packages/exahype2 packages/exahype2
COPY tests/exahype2/ /exahype2/tests
COPY tutorials/exahype2/ /exahype2/tutorials
COPY applications/exahype2/ /exahype2/applications
COPY benchmarks/exahype2/ /exahype2/benchmarks

RUN . /opt/spack/share/spack/setup-env.sh && \
    spack env create -d . && \
    spack env activate -p . && \
    spack config add packages:all:target:[x86_64] && \
    spack config add config:install_tree:/opt/software && \
    spack config add concretizer:unify:true && \
    spack external find && \
    spack repo add . && \
    spack add exahype2 && \
    spack concretize --reuse && \
    spack install --fail-fast && \
    spack gc -y && \
    spack clean -a

RUN . /opt/spack/share/spack/setup-env.sh && spack env activate --sh -d . > activate.sh

RUN { \
      echo '#!/bin/sh' \
      && echo '.' /opt/spack-environment/activate.sh \
      && echo 'exec "$@"'; \
    } > /entrypoint.sh \
&& chmod a+x /entrypoint.sh \
&& ln -s /opt/views/view /opt/view

FROM peanoframework/base:latest

COPY --from=builder /exahype2 /exahype2
COPY --from=builder /opt/spack-environment /opt/spack-environment
COPY --from=builder /opt/software /opt/software
COPY --from=builder /entrypoint.sh /entrypoint.sh

WORKDIR /exahype2

ENTRYPOINT ["/entrypoint.sh"]
CMD ["/bin/bash"]
