FROM ubuntu:22.04
# https://hub.docker.com/r/intel/oneapi-basekit

ENV FORCE_UNSAFE_CONFIGURE=1 \
  SPACK_ROOT=/usr/local \
  DEBIAN_FRONTEND=noninteractive \
  TZ=Europe/Berlin \
  DISPLAY=host.docker.internal:0.0 \
  OMPI_ALLOW_RUN_AS_ROOT=1 \
  OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1

COPY install-packages.sh /
RUN chmod +x /install-packages.sh && ./install-packages.sh && rm ./install-packages.sh

RUN curl -s -L https://api.github.com/repos/spack/spack/tarball | tar xzC $SPACK_ROOT --strip 1 && \
spack -L install environment-modules target=x86_64 lmod target=x86_64 && \
spack -L clean -a && \
echo "source $(spack location -i lmod)/lmod/lmod/init/bash" >> /etc/profile.d/spack.sh && \
echo "source $(spack location -i environment-modules)/init/bash" >> /etc/profile.d/spack.sh && \
echo "source $SPACK_ROOT/share/spack/setup-env.sh" >> /etc/profile.d/spack.sh && \
rm -rf /tmp/root/spack-stage/

# https://www.intel.com/content/www/us/en/develop/documentation/installation-guide-for-intel-oneapi-toolkits-linux/top/prerequisites/install-intel-gpu-drivers.html
RUN cd /opt && wget https://registrationcenter-download.intel.com/akdlm/irc_nas/19079/l_BaseKit_p_2023.0.0.25537_offline.sh && \
  sh ./l_BaseKit_p_2023.0.0.25537_offline.sh -a -s --eula accept --install-dir=/opt/intel/oneapi --log-dir=/opt/intel/build-log --action=install --intel-sw-improvement-program-consent=decline --components intel.oneapi.lin.dpcpp-cpp-compiler:intel.oneapi.lin.dpl && \
  ln -s /opt/intel/oneapi/compiler/latest/linux/bin/* /usr/local/bin && \
  echo "/opt/intel/oneapi/compiler/latest/linux/compiler/lib/intel64_lin" > /etc/ld.so.conf.d/usr-local.conf && ldconfig

RUN cd /opt && wget https://registrationcenter-download.intel.com/akdlm/irc_nas/19084/l_HPCKit_p_2023.0.0.25400_offline.sh && \
  sh ./l_HPCKit_p_2023.0.0.25400_offline.sh -a -s --eula accept --install-dir=/opt/intel/oneapi --log-dir=/opt/intel/build-log --action=install --intel-sw-improvement-program-consent=decline --components intel.oneapi.lin.mpi.devel:intel.oneapi.lin.dpcpp-cpp-compiler-pro

ENTRYPOINT ["/bin/bash", "-l", "-c"]
