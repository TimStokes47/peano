FROM nvcr.io/nvidia/nvhpc:22.11-devel-cuda_multi-ubuntu22.04

ARG SPACK_ROOT=/usr/local
ENV FORCE_UNSAFE_CONFIGURE=1 \
  DEBIAN_FRONTEND=noninteractive \
  TZ=Europe/Berlin \
  DISPLAY=host.docker.internal:0.0 \
  OMPI_ALLOW_RUN_AS_ROOT=1 \
  OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1

COPY install-packages.sh /
RUN chmod +x /install-packages.sh && ./install-packages.sh && rm ./install-packages.sh

RUN curl -s -L https://api.github.com/repos/spack/spack/tarball | tar xzC $SPACK_ROOT --strip 1 && \
spack -L install environment-modules target=x86_64 lmod target=x86_64 && \
spack -L clean -a && \
echo "source $(spack location -i lmod)/lmod/lmod/init/bash" >> /etc/profile.d/spack.sh && \
echo "source $(spack location -i environment-modules)/init/bash" >> /etc/profile.d/spack.sh && \
echo "source $SPACK_ROOT/share/spack/setup-env.sh" >> /etc/profile.d/spack.sh && \
rm -rf /tmp/root/spack-stage/

RUN echo '#include <iostream>' > check_cuda_offload.cu && \
echo '__global__ void kernel(int *a, int *b, int *c) { *c = *a + *b; }' >> check_cuda_offload.cu && \
echo 'int main() {' >> check_cuda_offload.cu && \
echo '  int a = 2, b = 3, c = 0;' >> check_cuda_offload.cu && \
echo '  int *d_a, *d_b, *d_c;' >> check_cuda_offload.cu && \
echo '  cudaMalloc(&d_a, sizeof(int));' >> check_cuda_offload.cu && \
echo '  cudaMalloc(&d_b, sizeof(int));' >> check_cuda_offload.cu && \
echo '  cudaMalloc(&d_c, sizeof(int));' >> check_cuda_offload.cu && \
echo '  cudaMemcpy(d_a, &a, sizeof(int), cudaMemcpyHostToDevice);' >> check_cuda_offload.cu && \
echo '  cudaMemcpy(d_b, &b, sizeof(int), cudaMemcpyHostToDevice);' >> check_cuda_offload.cu && \
echo '  kernel<<<1,1>>>(d_a, d_b, d_c);' >> check_cuda_offload.cu && \
echo '  cudaMemcpy(&c, d_c, sizeof(int), cudaMemcpyDeviceToHost);' >> check_cuda_offload.cu && \
echo '  if (c == 5) {' >> check_cuda_offload.cu && \
echo '    std::cout << "CUDA offloading is supported." << std::endl;' >> check_cuda_offload.cu && \
echo '    return 0;' >> check_cuda_offload.cu && \
echo '  } else {' >> check_cuda_offload.cu && \
echo '    std::cout << "CUDA offloading is NOT supported." << std::endl;' >> check_cuda_offload.cu && \
echo '    return 1;' >> check_cuda_offload.cu && \
echo '  }' >> check_cuda_offload.cu && \
echo '}' >> check_cuda_offload.cu && \
nvc++ check_cuda_offload.cu -o check_cuda_offload

RUN echo '#include <iostream>' > check_openmp_offload.cpp && \
echo '#include <omp.h>' >> check_openmp_offload.cpp && \
echo 'int main() {' >> check_openmp_offload.cpp && \
echo '  int canOffload = 1;' >> check_openmp_offload.cpp && \
echo '  #pragma omp target map(tofrom : canOffload)' >> check_openmp_offload.cpp && \
echo '  {' >> check_openmp_offload.cpp && \
echo '    if (!omp_is_initial_device()) {' >> check_openmp_offload.cpp && \
echo '      canOffload = 0;' >> check_openmp_offload.cpp && \
echo '    }' >> check_openmp_offload.cpp && \
echo '  }' >> check_openmp_offload.cpp && \
echo '  if (canOffload == 0) {' >> check_openmp_offload.cpp && \
echo '    std::cout << "OpenMP offloading is supported." << std::endl;' >> check_openmp_offload.cpp && \
echo '  } else {' >> check_openmp_offload.cpp && \
echo '    std::cout << "OpenMP offloading is NOT supported." << std::endl;' >> check_openmp_offload.cpp && \
echo '  }' >> check_openmp_offload.cpp && \
echo '  return canOffload;' >> check_openmp_offload.cpp && \
echo '}' >> check_openmp_offload.cpp && \
nvc++ -mp=gpu check_openmp_offload.cpp -o check_openmp_offload

ENTRYPOINT ["/bin/bash", "-l", "-c"]
